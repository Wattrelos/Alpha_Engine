classDiagram
    class Order {
        -float total
        -string paymentMethod
        -DateTime createdAt
        +getCustomer() Customer
        +getProducts() Collection
        +getTotals() Collection
        +getHistory() Collection
    }

    class OrderProduct {
        -int productId
        -string name
        -int quantity
        -float price
    }

    class OrderTotal {
        -string code
        -string title
        -float value
    }

    class OrderStatus {
        -int id
    }

    Order "1" *-- "many" OrderProduct : OneToMany
    Order "1" *-- "many" OrderTotal : OneToMany
    Order "many" o-- "1" OrderStatus : ManyToOne

    note for Order "Raiz de Agregado: Toda alteração em itens ou totais deve ser orquestrada por esta entidade para manter a consistência."
    note for OrderProduct "Snapshot: Armazena dados fixos (preço, nome) no momento da venda, protegendo o pedido de alterações futuras no catálogo."
    note for OrderTotal "Cálculos: Discrimina Frete, Impostos e Descontos de forma auditável."
    note for Order "Automatização: Os Attributes permitem que o DataAccessObject gere queries de INSERT/UPDATE seguras sem concatenação manual de strings."