@startuml "Diagrama_Classes_Entidades"

' --- Estilo CSS Moderno ---
<style>
classDiagram {
    BackgroundColor #FAFAFA
    BorderColor #37474F
    LineColor #263238
    FontName "Helvetica Neue"
    FontSize 13
    
    class {
        BackgroundColor #E3F2FD
        BorderColor #1565C0
        HeaderBackgroundColor #90CAF9
    }
}
</style>

package "Camada de Domínio (Entities)" {
    
    class Cart {
        - int id
        - int customer_id
        - string session_id
        - string option
        - int subscriptionPlanId
        + addItem()
        + clearItems()
        + applyCoupon(Coupon coupon)
    }

    class Coupon {
        - int id
        - string code
        - string type
        - float discount_value
        - bool status
        + isValid() : bool
    }

    class Address {
        - int id
        - string address_1
        - string city
        - string postcode
    }

    class Country {
        - int id
        - string iso_code_2
        - string iso_code_3
        - int address_format_id
        - bool postcode_required
        - bool status
        + getName() : string
        + getDescriptions() : array
    }

    class CountryDescription {
        - int language_id
        - string name
    }
}

' --- Relações ---
Cart "1" o-- "0..1" Coupon : aplica >
Cart "1" *-- "1..2" Address : possui (entrega/cobrança) >
Address "0..*" -right- "1" Country : localiza-se em >
Country "1" *-- "1..*" CountryDescription : #[OneToMany] traduções >

@enduml