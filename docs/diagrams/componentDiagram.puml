@startuml "Diagrama_Componentes_Arquitetura_Ecommerce"

<style>
componentDiagram {
    BackgroundColor #FAFAFA
    BorderColor #37474F
    LineColor #263238
    FontName "Helvetica Neue"
    FontSize 13
    
    component {
        BorderThickness 1.5
        FontColor #2E3440
    }
    interface {
        LineColor #5E81AC
        BackgroundColor #88C0D0
    }
}
</style>

package "Camada de Apresentação / Web" {
    [Slim Framework (Router)] as Slim <<Framework>> #90CAF9
    [Twig Template Engine] as Twig <<View Engine>> #90CAF9
    [Actions / Controllers] as Actions #64B5F6
}

package "Core / Dependency Injection" {
    [AppContainer] as DI <<PSR-11>> #CE93D8
    [RepositoryFactory] as RepoFac #E1BEE7
    [MapperFactory] as MapperFac #E1BEE7
}

package "Camada de Domínio (DDD Core)" {
    [Entities (e.g., Cart, Country, Address)] as Entities #81C784
    interface "BaseRepositoryInterface" as RepoInterface
}

package "Camada de Infraestrutura / Persistência" {
    [AbstractRepository (Impl)] as RepoImpl #FFB74D
    [Data Mappers (e.g., CartMapper)] as Mapper #FFA726
    [EntityHydrator] as Hydrator #FFB74D
    [CacheStrategyInterface] as Cache #FFB74D
    [Unit Of Work (UoW)] as UoW #FFB74D
    [ConnectionDB (PDO Singleton)] as DBConn #FB8C00
}

database "Banco de Dados Relacional" as DB #FFCC80

' --- Definição das Conexões e Dependências ---

Slim ..> Actions : Envia Request
Actions ..> Twig : Renderiza views com dados
Actions --> DI : Resolve dependências (Auto-wiring)

DI --> RepoFac : Fornece instância
DI --> MapperFac : Fornece instância

Actions --> RepoInterface : Busca/Salva dados de negócio
Actions --> UoW : Controla escopo (beginTransaction/commit)

RepoImpl -up-|> RepoInterface : Implementa contrato de Domínio
RepoImpl --> MapperFac : Obtém Mappers nativos
RepoImpl --> Cache : Intercepta buscas (APCu/Redis)
RepoImpl ..> Hydrator : Popula propriedades da Entidade
RepoImpl --> Entities : Retorna/Manipula Entidades Ricas

RepoImpl --> UoW : Registra entidades alteradas
UoW --> Mapper : Dispara persistência pendente no commit
Mapper --> DBConn : Executa queries e mapeamentos
DBConn --> DB : Instruções DML/DDL via PDO

@enduml
