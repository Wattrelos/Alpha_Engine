sequenceDiagram
    package "0. Slim 4 Framework" as Slim {
    [public_html/index.php] as Entrypoint
    [Config/Routes.php] as Routes
    [AppContainer (PSR-11)] as Container
    }
    package "1. Middleware Stack" as Middlewares {
    [LanguageMiddleware] as graph TD
    %% --- ENTRYPOINT & FRAMEWORK ---
    subgraph Slim ["0. Slim 4 Framework"]
        Entrypoint["public_html/index.php"]
        Routes["Config/Routes.php"]
        Container["AppContainer (PSR-11)"]
    end

    %% --- MIDDLEWARE STACK ---
    subgraph Middlewares ["1. Middleware Stack"]
        LangMW["LanguageMiddleware"]
        AdminMW["AdminSessionMiddleware"]
        SessionMW["SessionMiddleware"]
        LegacyMW["LegacyRouteRedirectMiddleware"]
    end

    %% --- ACTIONS (CONTROLLERS) ---
    subgraph Actions ["2. Application Actions"]
        FrontAction["Front-end Actions<br>(implements ActionInterface)"]
        AdminAction["Admin Actions<br>(extends BaseController)"]
        BaseCtrl["BaseController"]
        AuthServices["Auth Services"]
    end

    %% --- PRESENTATION LAYER ---
    subgraph TwigLayer ["3. Presentation (Twig)"]
        Twig["TwigEnvironment"]
        Views["Twig Templates<br>(resources/views/)"]
    end

    %% --- DOMAIN LAYER (DDD) ---
    subgraph Domain ["4. Domain Layer"]
        RepoFactory["RepositoryFactory"]
        Repos["AbstractRepository"]
        Entities["BaseEntity"]
        AlphaContainer["AlphaContainer (Legacy Resolver)"]
        Events["EventDispatcher & Events"]
    end

    %% --- PERSISTENCE LAYER ---
    subgraph Persistence ["5. Persistence Infrastructure"]
        MapperFactory["MapperFactory"]
        Mappers["BaseMapper"]
        Observers["Observers"]
        DAO["DataAccessObject (DAO)"]
        QB["QueryBuilder"]
        UoW["UnitOfWork (UoW)"]
        IdentityMap["Identity Map"]
    end

    %% --- INFRASTRUCTURE & SUPPORT ---
    subgraph SupportLayer ["6. Support & Database"]
        MySQL[("MySQL 8.0")]
        Redis[("Redis (Cache & Session)")]
        Support["Support Utils"]
        Queue["RabbitMQ & QueueService"]
        Worker["Worker CLI Consumer"]
    end

    %% --- RELATIONSHIPS (FLOW OF COUPLING) ---
    
    %% Bootstrapping
    Entrypoint -->|Defines| Routes
    Entrypoint -->|Configures| Container
    Entrypoint -->|Injects| Twig

    %% Routing to Actions
    Routes -->|Global| LangMW
    Routes -->|Admin Group| AdminMW
    Routes -->|Account Group| SessionMW
    Routes -->|Legacy Group| LegacyMW
    Routes -->|Dispatches| FrontAction
    Routes -->|Dispatches| AdminAction

    %% Session / Middleware Persistence
    AdminMW -->|Validates admin session| Redis
    SessionMW -->|Validates customer session| Redis

    %% Action Resolution & Execution
    Container -.->|DI Constructor Injection| FrontAction
    Container -.->|DI Constructor Injection| AdminAction
    AdminAction -->|Inherits| BaseCtrl
    BaseCtrl -->|Requests Repositories| RepoFactory
    BaseCtrl -->|Renders Views| Twig
    FrontAction -->|Renders Views| Twig
    FrontAction -->|Dependency injection| Repos
    FrontAction -->|Session management| AuthServices
    AuthServices -->|Credentials check| Repos
    FrontAction -->|Transactional operations<br>e.g. Checkout| UoW
    AdminAction -->|Transactional operations<br>e.g. POS Sale| UoW

    %% View Layer
    Twig -->|Compiles| Views

    %% Domain Layer
    RepoFactory -.->|Instantiates| Repos
    Repos -->|Hydrates| Entities
    Repos -->|Requests Mapper| MapperFactory
    Repos -->|Read/Write query cache| Redis
    Repos -->|Transactional boundary| UoW
    AlphaContainer -->|Resolves legacy calls| Repos
    AlphaContainer -->|Resolves legacy mappers| Mappers

    %% Persistence Layer
    MapperFactory -.->|Instantiates| Mappers
    Mappers -.->|Triggers hooks events| Observers
    Mappers -->|Executes statements| DAO
    DAO -->|Builds query statements| QB
    DAO -->|Memory RAM Caching<br>N+1 prevention| IdentityMap
    DAO -->|Persistent state updates| MySQL
    QB -->|Safe SQL execution| MySQL
    UoW -->|Coordinates ACID transactions<br>start/commit/rollback| DAO

    %% Support cross-cutting concerns
    Repos -->|Calculations| Support
    FrontAction -->|Formats| Support

    %% Asynchronous Events & Messaging Stack
    FrontAction -->|Dispatches OrderCreatedEvent| Events
    Events -->|Publishes to queue via QueueService| Queue
    Queue -->|Asynchronously consumed by worker| Worker
LangMW
    [AdminSessionMiddleware] as AdminMW
    [SessionMiddleware] as SessionMW
    [LegacyRouteRedirectMiddleware] as LegacyMW
    }
    package "2. Application Actions" as Actions {
    [Front-end Actions<br/>(implements ActionInterface)] as FrontAction
    [Admin Actions<br/>(extends BaseController)] as AdminAction
    [BaseController] as BaseCtrl
    [Auth Services] as AuthServices
    }
    package "3. Presentation (Twig)" as TwigLayer {
    [TwigEnvironment] as Twig
    [Twig Templates<br/>(resources/views/)] as Views
    }
    package "4. Domain Layer" as Domain {
    [RepositoryFactory] as RepoFactory
    [AbstractRepository] as Repos
    [BaseEntity] as Entities
    [AlphaContainer (Legacy Resolver)] as AlphaContainer
    [EventDispatcher & Events] as Events
    }
    package "5. Persistence Infrastructure" as Persistence {
    [MapperFactory] as MapperFactory
    [BaseMapper] as Mappers
    [Observers] as Observers
    [DataAccessObject (DAO)] as DAO
    [QueryBuilder] as QB
    [UnitOfWork (UoW)] as UoW
    [Identity Map] as IdentityMap
    }
    package "6. Support & Database" as SupportLayer {
    participant MySQL as MySQL 8.0
    participant Redis as Redis (Cache & Session)
    [Support Utils] as Support
    [RabbitMQ & QueueService] as Queue
    [Worker CLI Consumer] as Worker
    }
    Entrypoint -->> Routes: Defines
    Entrypoint -->> Container: Configures
    Entrypoint -->> Twig: Injects
    Routes -->> LangMW: Global
    Routes -->> AdminMW: Admin Group
    Routes -->> SessionMW: Account Group
    Routes -->> LegacyMW: Legacy Group
    Routes -->> FrontAction: Dispatches
    Routes -->> AdminAction: Dispatches
    AdminMW -->> Redis: Validates admin session
    SessionMW -->> Redis: Validates customer session
    Container ..> FrontAction : DI Constructor Injection
    Container ..> AdminAction : DI Constructor Injection
    AdminAction -->> BaseCtrl: Inherits
    BaseCtrl -->> RepoFactory: Requests Repositories
    BaseCtrl -->> Twig: Renders Views
    FrontAction -->> Twig: Renders Views
    FrontAction -->> Repos: Dependency injection
    FrontAction -->> AuthServices: Session management
    AuthServices -->> Repos: Credentials check
    FrontAction -->> UoW: Transactional operations (e.g. Checkout)
    AdminAction -->> UoW: Transactional operations (e.g. POS Sale)
    Twig -->> Views: Compiles
    RepoFactory ..> Repos : Instantiates
    Repos -->> Entities: Hydrates
    Repos -->> MapperFactory: Requests Mapper
    Repos -->> Redis: Read/Write query cache
    Repos -->> UoW: Transactional boundary
    AlphaContainer -->> Repos: Resolves legacy calls
    AlphaContainer -->> Mappers: Resolves legacy mappers
    MapperFactory ..> Mappers : Instantiates
    Mappers ..> Observers : Triggers hooks (events)
    Mappers -->> DAO: Executes statements
    DAO -->> QB: Builds query statements
    DAO -->> IdentityMap: Memory RAM Caching (N+1 prevention)
    DAO -->> MySQL: Persistent state updates
    QB -->> MySQL: Safe SQL execution
    UoW -->> DAO: Coordinates ACID transactions (start/commit/rollback)
    Repos -->> Support: Calculations
    FrontAction -->> Support: Formats
    FrontAction -->> Events: Dispatches OrderCreatedEvent
    Events -->> Queue: Publishes to queue via QueueService
    Queue -->> Worker: Asynchronously consumed by worker
