@startuml "Complete product return flow - Secure Architecture"
autonumber "<b>00:"

box "Infrastructure / HTTP / Async"
    actor "Client / Admin" as Ator
    participant "Slim Middleware" as Middleware
    participant "Slim Action" as Action
    participant "Queue / Event Bus" as Queue
    participant "Twig Engine" as Twig
end box

box "Domain / Application"
    participant "Domain Service" as Domain
    participant "Repository" as Repo
end box

box "Persistence / Data"
    participant "Unit Of Work" as UoW
    participant "Data Mapper" as Mapper
    participant "Query Builder" as QB
    participant "Dynamic DAO" as DAO
    database "Database" as DB
end box

Ator -> Middleware : HTTP Request (Product Return)
activate Middleware
    Middleware -> Action : __invoke(Request)
    activate Action
        
    alt READ ROUTE (HTTP GET /devolucao/{id})
        Action -> Repo : findById(id)
        activate Repo
            Repo -> QB : select()->where('return_id', id)
            activate QB
                QB -> QB : buildSQL()
                QB --> Repo : SQL String
            deactivate QB
            
            Repo -> DAO : query(SQL)
            activate DAO
                DAO -> DB : SELECT * FROM oc_return ...
                activate DB
                DB --> DAO : Raw Data + version_id
                deactivate DB
                DAO --> Repo : Raw Data
            deactivate DAO
            
            Repo -> Mapper : mapToDomain(RawData)
            activate Mapper
                Mapper --> Repo : ProductReturn (Entity with current version)
            deactivate Mapper
            Repo --> Action : ProductReturn
        deactivate Repo
        
        Action -> Twig : render('detalhes_devolucao.twig', ProductReturn)
        activate Twig
            Twig --> Action : HTML / JSON Response
        deactivate Twig
        
    else WRITE ROUTE (HTTP POST /LPDHED2dC7Gjrg2b/devolucoes/{id}/status)
        ' MEMORY EXECUTED BUSINESS RULES FIRST (No active DB transaction yet to avoid long locks)
        Action -> Domain : atualizarStatusDevolucao(ProductReturn, novo_status)
        activate Domain
            ' Business rules check current state and change values in memory
            Domain -> Repo : save(ProductReturn)
            activate Repo
                ' UoW tracks change but does not open DB connection yet
                Repo -> UoW : registerDirty(ProductReturn)
                activate UoW
                    UoW --> Repo : OK
                deactivate UoW
                Repo --> Domain : OK
            deactivate Repo
            Domain --> Action : StateUpdated
        deactivate Domain
        
        ' TRANSACTION BOUNDARY & ERROR HANDLING SCOPE (Try/Catch)
        Action -> UoW : commit()
        activate UoW
            ' DB transaction starts inside the UoW commit block, lasting milliseconds
            UoW -> DB : BEGIN TRANSACTION
            
            UoW -> Mapper : mapToDatabase(ProductReturn)
            activate Mapper
                ' OPTIMISTIC LOCKING: WHERE clause includes old version_id to prevent race conditions
                Mapper -> QB : update('oc_return')->set('status', 'version=version+1')->where('id', 'version')
                activate QB
                    QB -> QB : buildSQL()
                    QB --> Mapper : SQL UPDATE + Bindings
                deactivate QB
                
                Mapper -> DAO : execute(SQL, Bindings)
                activate DAO
                    DAO -> DB : UPDATE oc_return ... WHERE version_id = current_version
                    activate DB
                    ' Safety Check: If rows affected == 0, throws ConcurrencyException
                    DB --> DAO : DB_Success (Rows Affected: 1)
                    deactivate DB
                    DAO --> Mapper : Success Status
                deactivate Mapper
                
                UoW -> DB : COMMIT
                UoW --> Action : Committed Successfully
                
        else #FFEBEE [Catch / Rollback Flow]
            ' Triggered automatically by UoW if Mapping, DAO, DB or Optimistic Lock fails
            UoW -> DB : ROLLBACK TRANSACTION
            UoW --> Action : Throws Exception (Rollback Executed)
        deactivate UoW

        alt Success Path
            ' TRUE ASYNCHRONOUS EVENT DISPATCH: Fire and forget to background workers
            Action -> Queue : publishEvent('ProductReturnUpdated', payload)
            activate Queue
                Queue --> Action : Ack
            deactivate Queue
            
            Action -> Twig : render('devolucao_sucesso.twig')
            activate Twig
                Twig --> Action : HTML Success Response
            deactivate Twig
            
        else Error Path (Exception Caught)
            Action -> Twig : render('devolucao_erro.twig', error_message)
            activate Twig
                Twig --> Action : HTML Error Page
            deactivate Twig
        end
    end

    Action --> Middleware : Response Object
    deactivate Action
    Middleware --> Ator : HTTP Response
deactivate Middleware
@enduml
