    Product {
        BIGINT id PK
        varchar(64) model
        varchar(64) sku
        varchar(12) upc
        varchar(14) ean
        varchar(13) jan
        varchar(13) isbn
        varchar(64) mpn
        varchar(128) location
        varchar(255) variant
        text override
        decimal(15,4) price
        int quantity
        int stock_status_id FK
        varchar(255) image
        int manufacturer_id FK
        tinyint(1) shipping
        int points
        int tax_class_id FK
        date date_available
        decimal(15,8) weight
        int weight_class_id FK
        decimal(15,8) length
        decimal(15,8) width
        decimal(15,8) height
        int length_class_id FK
        tinyint(1) subtract
        int minimum
        int rating
        tinyint(1) status
        int sort_order
        datetime date_added
        datetime date_modified
        int master_id FK
    }

    ProductDescription {
        int product_id PK, FK
