flowchart TD
    %% Estilos Globais e Configurações
    classDef default fill:#F8FAFC,stroke:#475569,stroke-width:1px,font-family:Inter,Arial,sans-serif;
    classDef startEnd fill:#2563EB,stroke:#1D4ED8,color:#FFFFFF,font-weight:bold;
    classDef errNode fill:#FEF2F2,stroke:#EF4444,color:#991B1B,font-weight:500;
    classDef noteNode fill:#EFF6FF,stroke:#3B82F6,stroke-dasharray: 5 5;

    %% --- RAIA: VENDEDOR ---
    subgraph Vendedor ["🧑‍💼 Vendedor"]
        style Vendedor fill:#FFF9C4,stroke:#F59E0B,stroke-width:2px
        Start([Início]):::startEnd
        SolicitaProd[Solicitar produtos desejados ao Cliente]
        BuscaProd[Buscar produtos por nome ou código no sistema]
        CheckEstoque{Produto tem estoque?}
        InfoIndisp[Informar indisponibilidade ao Cliente]:::errNode
        AddCarrinho[Adicionar itens ao carrinho]
        IdentificaCliente[Identificar o Cliente no sistema]
        ComandaSalvar[Comandar 'Salvar Pedido']
        ImprimeTicket[Imprimir ticket de pré-venda]
        EntregaTicket[Entregar ticket ao Cliente]
    end

    %% --- RAIA: SISTEMA POS (BACK-END) ---
    subgraph Backend ["⚙️ Sistema POS (Back-end)"]
        style Backend fill:#DCFCE7,stroke:#16A34A,stroke-width:2px
        CheckDuplicidade[Verificar duplicidade do pedido - Idempotência]
        NotaRedis["<b>Evita cliques duplos:</b><br>Salva chaves temporárias no Redis."]:::noteNode
        InitTransacao[Iniciar transação no banco de dados]
        GravaPendente[Gravar o pedido com status 'Pendente']
        
        NotaRegra["<b>=== REGRA DE NEGÓCIO DE ESTOQUE ===</b><br>Como não existe reserva de estoque no POS,<br>o vendedor deve retirar os produtos da prateleira<br>e guardar em uma sacola na área do caixa para<br>garantir a mercadoria até o cliente finalizar o<br>pagamento ou ocorrer a devolução manual."]:::noteNode
        
        ConfirmaTransacao[Confirmar transação e gerar número do pedido #150]
        RecuperaDados[Recuperar dados do pedido e validar valores]
        
        StatusPago[Atualizar status do pedido para 'Pago']
        BaixaEstoque[Confirmar baixa definitiva do estoque]
        
        StatusCancelado[Alterar status do pedido para 'Cancelado']
        EstornaEstoque[Estornar reserva - devolver itens ao estoque disponível]
        NotaEstorno["<b>Garantia de Estoque:</b><br>Libera os produtos imediatamente<br>para que voltem a ficar visíveis<br>no catálogo de vendas ou e-commerce."]:::noteNode
    end

    %% --- RAIA: CAIXA ---
    subgraph Caixa ["🛍️ Caixa"]
        style Caixa fill:#FEF3C7,stroke:#D97706,stroke-width:2px
        
        %% Ponto de Destino do Loop (Antigo Goto)
        RecebeTicket[Receber ticket do Cliente e digitar o número #150]
        
        ProcPag[Processar pagamento<br>Cartão de Crédito/Débito]
        CheckPag{Pagamento aprovado?}
        EmitiCupom[Fluxo de Sucesso: Emitir cupom fiscal da venda]
        EntregaProd[Entregar produtos ao Cliente]
        
        InfoRejeicao[Fluxo de Exceção: Informar prevenção/rejeição ao Cliente]:::errNode
        CheckRetentativa{Cliente deseja<br>tentar outra forma?}
        
        NotaRetentativa["<b>Política de Retentativa:</b><br>O caixa pode tentar até 3 vezes<br>com meios diferentes antes de<br>sugerir o cancelamento."]:::noteNode
        
        TrocaMeio[Selecionar nova forma de pagamento no terminal]
        
        ComandaCancelar[Comandar 'Cancelar Pedido' no terminal]
        NotaGarantia["<b>Garantia de Estoque:</b><br>Se o cliente optar por desistir,<br>o pedido é cancelado e os produtos<br>voltam para o estoque imediatamente."]:::noteNode
        
        InfoCancelamento[Informar cancelamento e encerrar atendimento]:::errNode
    end

    %% --- CONEXÕES DO FLUXO ---
    Start --> SolicitaProd
    SolicitaProd --> BuscaProd
    BuscaProd --> CheckEstoque
    
    %% Sem Estoque
    CheckEstoque -- Não --> InfoIndisp
    InfoIndisp --> FimIndisp([Fim]):::startEnd
    
    %% Com Estoque
    CheckEstoque -- Sim --> AddCarrinho
    AddCarrinho --> IdentificaCliente
    IdentificaCliente --> ComandaSalvar
    
    %% Gravação Back-end
    ComandaSalvar --> CheckDuplicidade
    CheckDuplicidade -.-> NotaRedis
    CheckDuplicidade --> InitTransacao
    InitTransacao --> GravaPendente
    GravaPendente -.-> NotaRegra
    GravaPendente --> ConfirmaTransacao
    
    %% Impressão e Envio ao Caixa
    ConfirmaTransacao --> ImprimeTicket
    ImprimeTicket --> EntregaTicket
    EntregaTicket --> RecebeTicket
    
    %% Validação e Processamento de Pagamento
    RecebeTicket --> RecuperaDados
    RecuperaDados --> ProcPag
    ProcPag --> CheckPag
    
    %% Pagamento Aprovado
    CheckPag -- Sim --> EmitiCupom
    EmitiCupom --> StatusPago
    StatusPago --> BaixaEstoque
    BaixaEstoque --> EntregaProd
    EntregaProd --> FimSucesso([Fim]):::startEnd
    
    %% Pagamento Rejeitado
    CheckPag -- Não --> InfoRejeicao
    InfoRejeicao --> CheckRetentativa
    
    %% Loop de Retentativa (Substituição do GOTO)
    CheckRetentativa -- "Sim (Dinheiro, PIX ou outro cartão)" --> TrocaMeio
    TrocaMeio -.-> NotaRetentativa
    TrocaMeio --> RecebeTicket
    
    %% Desistência e Cancelamento
    CheckRetentativa -- "Não (Deseja cancelar o pedido)" --> ComandaCancelar
    ComandaCancelar -.-> NotaGarantia
    ComandaCancelar --> StatusCancelado
    StatusCancelado --> EstornaEstoque
    EstornaEstoque -.-> NotaEstorno
    EstornaEstoque --> InfoCancelamento
    InfoCancelamento --> FimCancelado([Fim]):::startEnd
