flowchart TD
    %% Estilos Globais e Configurações
    classDef default fill:#F8FAFC,stroke:#475569,stroke-width:1px,font-family:Inter,Arial,sans-serif;
    classDef startEnd fill:#2563EB,stroke:#1D4ED8,color:#FFFFFF,font-weight:bold;
    classDef errNode fill:#FEF2F2,stroke:#EF4444,color:#991B1B,font-weight:500;

    %% --- CAMADA: REQUISIÇÃO DE ENTRADA ---
    subgraph Entrada ["🌐 Requisição de Entrada / Saída"]
        style Entrada fill:#E0F2FE,stroke:#0284C7,stroke-width:2px
        Start([Início / Requisição HTTP chega]):::startEnd
        Http200[Envia Resposta HTTP 200 OK ao Navegador do Cliente]
        EndNormal([Fim]):::startEnd
    end

    %% --- CAMADA: CORS MIDDLEWARE ---
    subgraph CorsLayer ["🛡️ CorsMiddleware"]
        style CorsLayer fill:#FFF9C4,stroke:#F59E0B,stroke-width:2px
        ValidaCors[Valida Origem e Método HTTP]
        CheckPreflight{É requisição<br>Preflight OPTIONS?}
        Http24[Retorna HTTP 204 No Content<br>com Headers CORS]:::errNode
    end

    %% --- CAMADA: RATE LIMIT MIDDLEWARE ---
    subgraph RateLimitLayer ["⏳ RateLimitMiddleware"]
        style RateLimitLayer fill:#FFF9C4,stroke:#F59E0B,stroke-width:2px
        CheckRedis[Verifica contagem de requisições por IP/Cliente no Redis]
        CheckRate{Taxa Limite Excedida?}
        Http429[Retorna HTTP 429 Too Many Requests]:::errNode
    end

    %% --- CAMADA: CSRF GUARD MIDDLEWARE ---
    subgraph CsrfLayer ["🔒 CsrfGuardMiddleware"]
        style CsrfLayer fill:#FFF9C4,stroke:#F59E0B,stroke-width:2px
        CheckMutation{É método de mutação?<br>POST / PUT / DELETE}
        ValidaCsrf[Valida Token Anti-CSRF enviado contra a Sessão]
        CheckCsrf{Token CSRF Válido?}
        Http400[Retorna HTTP 400 Bad Request<br>CSRF Token Mismatch]:::errNode
    end

    %% --- CAMADA: SESSION / ADMIN SESSION MIDDLEWARE ---
    subgraph SessionLayer ["🔑 SessionMiddleware / AdminSessionMiddleware"]
        style SessionLayer fill:#DCFCE7,stroke:#16A34A,stroke-width:2px
        ValidaSessao[Valida sessão do cliente<br>Redis com Fallback local PHP]
        CheckAuthReq{Rota Requer Autenticação?}
        CheckAuthed{Usuário Autenticado?}
        CheckRbac{É Rota Admin com<br>controle RBAC?}
        CheckPerms{Possui permissão<br>para a Ação?}
        
        Http403[Retorna HTTP 403 Forbidden<br>Acesso Negado]:::errNode
        Http401[Retorna HTTP 401 Unauthorized<br>ou Redireciona /login]:::errNode
    end

    %% --- CAMADA: LANGUAGE MIDDLEWARE ---
    subgraph LangLayer ["🌐 LanguageMiddleware"]
        style LangLayer fill:#FFF9C4,stroke:#F59E0B,stroke-width:2px
        DetectaLang[Detecta idioma da requisição]
        InjetaTwig[Injeta 'lang', 'logged', 'cart_count'<br>e traduções globais no Twig]
    end

    %% --- CAMADA: SLIM ACTION / CONTROLLER TARGET ---
    subgraph ActionLayer ["🎯 Slim Action / Controller Target"]
        style ActionLayer fill:#FEF3C7,stroke:#D97706,stroke-width:2px
        ExecHandler[Executa Action::handlerRequest, Response]
        ProcessaNegocio[Processa lógica de negócio e consultas ao repositório]
        Renderiza[Renderiza Template Twig ou Resposta JSON]
    end

    %% --- CONEXÕES DO FLUXO ---
    Start --> ValidaCors
    ValidaCors --> CheckPreflight
    
    %% Validação CORS
    CheckPreflight -- Sim --> Http24
    Http24 --> End24([Fim]):::startEnd
    CheckPreflight -- Não --> CheckRedis
    
    %% Validação Rate Limit
    CheckRedis --> CheckRate
    CheckRate -- Sim --> Http429
    Http429 --> End429([Fim]):::startEnd
    CheckRate -- Dentro do limite --> CheckMutation
    
    %% Validação CSRF
    CheckMutation -- Sim --> ValidaCsrf
    ValidaCsrf --> CheckCsrf
    CheckCsrf -- Inválido / Expirado --> Http400
    Http400 --> End400([Fim]):::startEnd
    CheckCsrf -- Sim --> ValidaSessao
    CheckMutation -- GET / HEAD --> ValidaSessao
    
    %% Validação de Sessão e Autenticação
    ValidaSessao --> CheckAuthReq
    CheckAuthReq -- Rota Pública --> DetectaLang
    
    CheckAuthReq -- Sim --> CheckAuthed
    CheckAuthed -- Não Autenticado --> Http401
    Http401 --> End401([Fim]):::startEnd
    
    CheckAuthed -- Sim --> CheckRbac
    CheckRbac -- Não --> DetectaLang
    
    CheckRbac -- Sim --> CheckPerms
    CheckPerms -- Não Autorizado --> Http403
    Http403 --> End403([Fim]):::startEnd
    CheckPerms -- Sim --> DetectaLang
    
    %% Inicialização de Idioma e Execução do Controller
    DetectaLang --> InjetaTwig
    InjetaTwig --> ExecHandler
    ExecHandler --> ProcessaNegocio
    ProcessaNegocio --> Renderiza
    
    %% Retorno de Saída
    Renderiza --> Http200
    Http200 --> EndNormal
