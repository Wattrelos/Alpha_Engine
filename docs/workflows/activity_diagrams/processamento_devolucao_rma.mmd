flowchart TD
    %% Estilos Globais e Configurações
    classDef default fill:#F8FAFC,stroke:#475569,stroke-width:1px,font-family:Inter,Arial,sans-serif;
    classDef startEnd fill:#2563EB,stroke:#1D4ED8,color:#FFFFFF,font-weight:bold;
    classDef errNode fill:#FEF2F2,stroke:#EF4444,color:#991B1B,font-weight:500;

    %% --- RAIA: CLIENTE ---
    subgraph Cliente ["👤 Cliente"]
        style Cliente fill:#E0F2FE,stroke:#0284C7,stroke-width:2px
        Start([Início]):::startEnd
        AcessaPedido[Acessa detalhes do pedido<br><code>/account/order/return</code>]
        PreencheMotivo[Preenche motivo e envia solicitação com fotos]
        RecebeRecusa[Recebe e-mail de solicitação recusada]:::errNode
        RecebeCodigo[Recebe e-mail com código de postagem e orientações]
        PostaProduto[Embala o produto e realiza postagem na agência]
        RecebeRecusaTriagem[Recebe notificação de recusa com laudo anexado]:::errNode
        RecebeFim[Recebe confirmação de estorno / cupom de crédito]
        Fim([Fim]):::startEnd
    end

    %% --- RAIA: PAINEL ADMIN / ATENDIMENTO ---
    subgraph Admin ["🧑‍💻 Painel Admin / Atendimento"]
        style Admin fill:#FFF9C4,stroke:#F59E0B,stroke-width:2px
        RecebeNotif[Recebe notificação de nova solicitação de RMA]
        AnalisaJustif[Analisa justificativa e imagens do produto]
        CheckPolitica{Solicitação cumpre a<br>política de trocas/CDC?}
        RegistraIndeferimento[Registra justificativa de indeferimento]
        GeraCodigo[Gera código de postagem reversa<br>Correios / Logística]
        SelectRessarcimento{Seleciona tipo de<br>ressarcimento acordado}
        GeraCupom[Gera Cupom de Crédito no valor total da devolução]
        AtualizaStatus[Atualiza status do RMA para<br>'FINALIZADO / REEMBOLSADO']
    end

    %% --- RAIA: ESTOQUE / TRIAGEM LOGÍSTICA ---
    subgraph Estoque ["📦 Estoque / Triagem Logística"]
        style Estoque fill:#DCFCE7,stroke:#16A34A,stroke-width:2px
        RecebePacote[Recebe pacote devolvido no Centro de Distribuição]
        InspecaoFisica[Realiza inspeção física de qualidade e conferência]
        CheckTriagem{Produto em estado adequado<br>e com acessórios?}
        RegistraLaudo[Registra laudo de recusa por avaria do usuário]
        DevolveItem[Devolve o item ao endereço do cliente]
        AprovaEstoque[Aprova recebimento no sistema de estoque]
        EstornoEstoque[Executa retorno do item ao estoque disponível<br>Estorno de Estoque]
    end

    %% --- RAIA: GATEWAY DE PAGAMENTO ---
    subgraph Gateway ["💳 Engine / Gateway de Pagamento"]
        style Gateway fill:#FEE2E2,stroke:#EF4444,stroke-width:2px
        ExecutaEstorno[Executa estorno via<br><code>PaymentGatewayInterface</code><br>PIX / Cartão]
    end

    %% --- CONEXÕES DO FLUXO ---
    Start --> AcessaPedido
    AcessaPedido --> PreencheMotivo
    PreencheMotivo --> RecebeNotif
    RecebeNotif --> AnalisaJustif
    AnalisaJustif --> CheckPolitica
    
    %% Primeira Decisão: Política / CDC
    CheckPolitica -- Não --> RegistraIndeferimento
    RegistraIndeferimento --> RecebeRecusa
    RecebeRecusa --> FimRecusa([Fim]):::startEnd
    
    CheckPolitica -- Sim (Aprovado) --> GeraCodigo
    GeraCodigo --> RecebeCodigo
    RecebeCodigo --> PostaProduto
    
    %% Triagem Logística
    PostaProduto --> RecebePacote
    RecebePacote --> InspecaoFisica
    InspecaoFisica --> CheckTriagem
    
    %% Segunda Decisão: Estado do Produto
    CheckTriagem -- Não (Avariado) --> RegistraLaudo
    RegistraLaudo --> DevolveItem
    DevolveItem --> RecebeRecusaTriagem
    RecebeRecusaTriagem --> FimAvaria([Fim]):::startEnd
    
    CheckTriagem -- Sim (Aprovado) --> AprovaEstoque
    AprovaEstoque --> EstornoEstoque
    EstornoEstoque --> SelectRessarcimento
    
    %% Terceira Decisão: Modalidade de Reembolso
    SelectRessarcimento -- Estorno Financeiro --> ExecutaEstorno
    SelectRessarcimento -- Vale-Compras / Cupom --> GeraCupom
    
    ExecutaEstorno --> AtualizaStatus
    GeraCupom --> AtualizaStatus
    
    AtualizaStatus --> RecebeFim
    RecebeFim --> Fim
