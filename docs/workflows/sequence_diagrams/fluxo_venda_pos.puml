@startuml "POS - Sales and Checkout Sequence Diagram"

' Ativando numeração automática formatada
autonumber "<b>00:"

header Alpha Engine POS Architecture: Ponto de Venda (POS) - Fluxo de Venda Balcão e Checkout
title Fluxo Completo de Venda Balcão (POS) e Checkout com Slim 4, Redis e MySQL

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif"
skinparam defaultFontSize 12
skinparam defaultFontColor #1E293B

' Hierarquia Visual de Cabeçalho e Título
skinparam TitleFontColor #0F172A
skinparam TitleFontSize 15
skinparam TitleFontStyle bold
skinparam HeaderFontColor #64748B
skinparam HeaderFontSize 10

' Configurações Globais de Espaçamento e Caixas
skinparam BoxPadding 12
skinparam ParticipantPadding 8

skinparam sequenceBoxBorderColor #CBD5E1
skinparam sequenceBoxFontColor #334155
skinparam sequenceBoxFontSize 13
skinparam sequenceBoxFontStyle bold

' Estilo das Linhas de Vida e Ativações
skinparam SequenceLifeLineBorderColor #64748B
skinparam SequenceLifeLineBackgroundColor #F8FAFC

' Estilo dos Grupos e Divisores de Fase
skinparam SequenceGroupBorderColor #94A3B8
skinparam SequenceGroupBackgroundColor #F8FAFC
skinparam SequenceGroupHeaderFontColor #1E293B
skinparam SequenceGroupFontColor #475569

skinparam SequenceDividerBorderColor #CBD5E1
skinparam SequenceDividerBackgroundColor #F1F5F9
skinparam SequenceDividerFontColor #0F172A
skinparam SequenceDividerFontSize 13
skinparam SequenceDividerFontStyle bold

' Estilo das Setas de Mensagens
skinparam ArrowColor #475569
skinparam ArrowFontColor #334155
skinparam ArrowFontSize 11
skinparam ArrowThickness 1.2

' Estilo dos Atores (Customer, Sales Rep, Cashier)
skinparam ActorBackgroundColor #DBEAFE
skinparam ActorBorderColor #2563EB
skinparam ActorFontColor #1E293B
skinparam ActorFontSize 13

' Estilo dos Participantes
skinparam ParticipantBackgroundColor #F1F5F9
skinparam ParticipantBorderColor #64748B
skinparam ParticipantFontColor #0F172A
skinparam ParticipantFontSize 12

' Estilo das Telas/Fronteiras (UI Interfaces)
skinparam BoundaryBackgroundColor #EFF6FF
skinparam BoundaryBorderColor #2563EB
skinparam BoundaryFontColor #1E3A8A
skinparam BoundaryFontSize 12

' Estilo dos Controles e Handlers de Aplicação (Slim 4 Actions, Repos, Mappers)
skinparam ControlBackgroundColor #EDE9FE
skinparam ControlBorderColor #7C3AED
skinparam ControlFontColor #4C1D95
skinparam ControlFontSize 12

' Estilo das Bases de Dados e Cache
skinparam DatabaseBackgroundColor #FEF3C7
skinparam DatabaseBorderColor #D97706
skinparam DatabaseFontColor #78350F
skinparam DatabaseFontSize 12

' Estilo das Notas de Negócio / Idempotência
skinparam NoteBackgroundColor #FFFBEB
skinparam NoteBorderColor #F59E0B
skinparam NoteFontColor #92400E
skinparam NoteFontSize 11
skinparam NoteTextAlignment left

actor "Customer" as Customer
actor "Sales Rep" as SalesRep

box "POS Web Interface (Frontend)" #E0F2FE
    boundary "Catalog / Create Order Screen" as SalesScreen
    boundary "Cashier Checkout Screen" as CashierScreen
end box

box "Slim 4 Entry & Middleware Stack" #EDE9FE
    control "Router" as Router
    control "AdminSessionMiddleware" as Middleware
end box

box "Application Actions (Slim Actions)" #FFF9C4
    control "SearchProductAction" as SearchAction
    control "CreatePreOrderAction" as CreatePreOrderAction
    control "GetPreOrderAction" as GetPreOrderAction
    control "PayOrderAction" as PayOrderAction
end box

box "Domain & Persistence Layer" #DCFCE7
    control "ProductRepository" as ProductRepo
    control "OrderRepository" as OrderRepo
    control "UnitOfWork" as UoW
    control "ProductMapper" as ProductMapper
    control "OrderMapper" as OrderMapper
    control "DataAccessObject (DAO)" as DAO
end box

box "Infrastructure Support" #F1F5F9
    database "MySQL Database" as DB
    database "Redis Cache (Session & Idempotency)" as Redis
end box

actor "Cashier" as Cashier

== Phase 1: Sales Rep Creates Pre-Order ==

Customer -> SalesRep : Requests products
SalesRep -> SalesScreen : Search product by name/code
SalesScreen -> Router : GET /LPDHED2dC7Gjrg2b/pos/produtos/buscar?q=...
activate Router
    Router -> Middleware : process(Request, Handler)
    activate Middleware
        Middleware -> Redis : Check session token (sessao:admin:{sessionId})
        activate Redis
            Redis --> Middleware : Session valid (Sales Rep role)
        deactivate Redis
        Middleware -> SearchAction : __invoke(Request)
        activate SearchAction
            SearchAction -> ProductRepo : searchProducts(query)
            activate ProductRepo
                ProductRepo -> DAO : query(SQL)
                activate DAO
                    DAO -> DB : SELECT * FROM oc_product ...
                    activate DB
                        DB --> DAO : Raw Product Data
                    deactivate DB
                    DAO --> ProductRepo : Raw Product Data
                deactivate DAO
                ProductRepo -> ProductMapper : mapToDomain(RawData)
                activate ProductMapper
                    ProductMapper --> ProductRepo : Product Entities list
                deactivate ProductMapper
                ProductRepo --> SearchAction : Product Entities list
            deactivate ProductRepo
            SearchAction --> SalesScreen : Return JSON (Product details + stock)
        deactivate SearchAction
        Middleware --> Router : Response
    deactivate Middleware
    Router --> SalesScreen : Response (JSON)
deactivate Router
SalesScreen --> SalesRep : Display products with photos & stock

SalesRep -> SalesScreen : Add items to cart & Identify Customer
SalesRep -> SalesScreen : Click "Save Order"
SalesScreen -> Router : POST /LPDHED2dC7Gjrg2b/pos/pedidos/salvar\n(Cart JSON + Customer ID + Idempotency-Key)
activate Router
    Router -> Middleware : process(Request, Handler)
    activate Middleware
        Middleware -> CreatePreOrderAction : __invoke(Request)
        activate CreatePreOrderAction
            
            note over CreatePreOrderAction, Redis: **Idempotency Control (Redis Lock):** Prevents duplicate pre-order creation (SETNX ttl=5min)
            CreatePreOrderAction -> Redis : SETNX(Idempotency-Key, "PROCESSING", expire: 5min)
            activate Redis
                Redis --> CreatePreOrderAction : OK (Lock acquired)
            deactivate Redis
            
            CreatePreOrderAction -> UoW : transaction(callback)
            activate UoW
                UoW -> DB : BEGIN TRANSACTION
                
                CreatePreOrderAction -> OrderRepo : save(OrderEntity)
                activate OrderRepo
                    OrderRepo -> OrderMapper : mapToDatabase(OrderEntity)
                    activate OrderMapper
                        OrderMapper -> DAO : execute(INSERT INTO oc_order...)
                        activate DAO
                            DAO -> DB : INSERT INTO orders (status='pending')
                            activate DB
                                DB --> DAO : Order ID (e.g. #150)
                            deactivate DB
                            DAO -> DB : INSERT INTO order_items...
                            activate DB
                                DB --> DAO : Insert Success
                            deactivate DB
                            DAO --> OrderMapper : Mapping Done
                        deactivate DAO
                        OrderMapper --> OrderRepo : Success
                    deactivate OrderMapper
                    OrderRepo --> CreatePreOrderAction : Success
                deactivate OrderRepo
                
                CreatePreOrderAction -> ProductRepo : reserveStock(items)
                activate ProductRepo
                    ProductRepo -> ProductMapper : mapToDatabase(ProductEntity)
                    activate ProductMapper
                        ProductMapper -> DAO : execute(UPDATE stock...)
                        activate DAO
                            DAO -> DB : UPDATE inventory (temporary block)
                            activate DB
                                DB --> DAO : Rows affected
                            deactivate DB
                            DAO --> ProductMapper : Success
                        deactivate DAO
                        ProductMapper --> ProductRepo : Success
                    deactivate ProductMapper
                    ProductRepo --> CreatePreOrderAction : Success
                deactivate ProductRepo
                
                UoW -> DB : COMMIT
                UoW --> CreatePreOrderAction : Committed
            deactivate UoW
            
            CreatePreOrderAction -> Redis : SET(Idempotency-Key, "SUCCESS", expire: 5min)
            activate Redis
                Redis --> CreatePreOrderAction : OK
            deactivate Redis
            
            CreatePreOrderAction --> SalesScreen : Return JSON (Success + Order ID #150)
        deactivate CreatePreOrderAction
        Middleware --> Router : Response
    deactivate Middleware
    Router --> SalesScreen : Response (JSON)
deactivate Router
SalesScreen --> SalesRep : Show success message & Print pre-order ticket
SalesRep -> Customer : Hand over Order Ticket (#150)

== Phase 2: Cashier Processes Payment ==

Customer -> Cashier : Presents Order Ticket (#150)
Cashier -> CashierScreen : Input Order ID (#150) & press Enter
CashierScreen -> Router : GET /LPDHED2dC7Gjrg2b/pos/pedidos/150
activate Router
    Router -> Middleware : process(Request, Handler)
    activate Middleware
        Middleware -> Redis : Check session token (sessao:admin:{sessionId})
        activate Redis
            Redis --> Middleware : Session valid (Cashier role)
        deactivate Redis
        Middleware -> GetPreOrderAction : __invoke(Request)
        activate GetPreOrderAction
            GetPreOrderAction -> OrderRepo : getOrder(150)
            activate OrderRepo
                OrderRepo -> DAO : query(SQL)
                activate DAO
                    DAO -> DB : SELECT * FROM oc_order WHERE order_id=150
                    activate DB
                        DB --> DAO : Raw Order Data
                    deactivate DB
                    DAO --> OrderRepo : Raw Order Data
                deactivate DAO
                OrderRepo -> OrderMapper : mapToDomain(RawData)
                activate OrderMapper
                    OrderMapper --> OrderRepo : Order Entity
                deactivate OrderMapper
                OrderRepo --> GetPreOrderAction : Order Entity
            deactivate OrderRepo
            GetPreOrderAction --> CashierScreen : Return JSON (Order details)
        deactivate GetPreOrderAction
        Middleware --> Router : Response
    deactivate Middleware
    Router --> CashierScreen : Response (JSON)
deactivate Router
CashierScreen --> Cashier : Display cart items, total and payment options

Customer -> Cashier : Pay via Pix / Card / Cash
Cashier -> CashierScreen : Select payment method & click "Complete Sale"
CashierScreen -> Router : POST /LPDHED2dC7Gjrg2b/pos/pedidos/150/pagar (Payment Details)
activate Router
    Router -> Middleware : process(Request, Handler)
    activate Middleware
        Middleware -> PayOrderAction : __invoke(Request)
        activate PayOrderAction
            
            PayOrderAction -> UoW : transaction(callback)
            activate UoW
                UoW -> DB : BEGIN TRANSACTION
                
                PayOrderAction -> OrderRepo : confirm(150, status='completed', cashier_id)
                activate OrderRepo
                    OrderRepo -> OrderMapper : mapToDatabase(OrderEntity)
                    activate OrderMapper
                        OrderMapper -> DAO : execute(UPDATE oc_order...)
                        activate DAO
                            DAO -> DB : UPDATE orders (status='completed')
                            activate DB
                                DB --> DAO : Success
                            deactivate DB
                            DAO --> OrderMapper : Success
                        deactivate DAO
                        OrderMapper --> OrderRepo : Success
                    deactivate OrderMapper
                    OrderRepo --> PayOrderAction : Success
                deactivate OrderRepo
                
                PayOrderAction -> ProductRepo : deductStock(items)
                activate ProductRepo
                    ProductRepo -> ProductMapper : mapToDatabase(ProductEntity)
                    activate ProductMapper
                        ProductMapper -> DAO : execute(UPDATE stock...)
                        activate DAO
                            DAO -> DB : UPDATE inventory (deduct definitively)
                            activate DB
                                DB --> DAO : Rows affected
                            deactivate DB
                            DAO --> ProductMapper : Success
                        deactivate DAO
                        ProductMapper --> ProductRepo : Success
                    deactivate ProductMapper
                    ProductRepo --> PayOrderAction : Success
                deactivate ProductRepo
                
                UoW -> DB : COMMIT
                UoW --> PayOrderAction : Committed
            deactivate UoW
            
            PayOrderAction --> CashierScreen : Return JSON (Success)
        deactivate PayOrderAction
        Middleware --> Router : Response
    deactivate Middleware
    Router --> CashierScreen : Response (JSON)
deactivate Router

CashierScreen -> Cashier : Trigger receipt printing
Cashier -> Customer : Deliver products and printed receipt

@enduml
