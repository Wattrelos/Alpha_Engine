@startuml "Optimistic Lock Failure Flow"
autonumber "<b>00:"

box "Frontend / Client"
    actor "Admin B (Tela Desatualizada)" as Admin
    participant "Frontend App (JS)" as Front
end box

box "Backend / Infrastructure"
    participant "Slim Action" as Action
    participant "Unit Of Work" as UoW
    participant "Data Mapper" as Mapper
    database "Database" as DB
end box

Admin -> Front : Clica em "Recusar Devolução"
activate Front
    ' Envia a requisição contendo os dados e a versão antiga (versão 1)
    Front -> Action : HTTP POST /LPDHED2dC7Gjrg2b/devolucoes/102/status {version: 1}
    activate Action
        
        Action -> UoW : commit()
        activate UoW
            UoW -> DB : BEGIN TRANSACTION
            UoW -> Mapper : mapToDatabase(ProductReturn)
            activate Mapper
                
                ' O banco tenta atualizar onde version = 1, mas o Admin A já mudou para 2
                Mapper -> DB : UPDATE oc_product_return SET return_status_id=5, version=3 WHERE id=102 AND version=1
                activate DB
                    DB --> Mapper : Rows Affected: 0 (Falha)
                deactivate DB
                
                ' Mapper detecta 0 linhas afetadas e lança uma exceção de concorrência
                Mapper --> UoW : Throws ConcurrencyException
            deactivate Mapper
            
            UoW -> DB : ROLLBACK TRANSACTION
            UoW --> Action : Throws ConcurrencyException
        deactivate UoW
        
        ' Backend captura o erro e responde com HTTP 409 Conflict + Dados atuais
        Action --> Front : HTTP 409 Conflict { error: "DATA_STALE", current_data: { status_name: "Aprovado", version: 2 } }
    deactivate Action

    ' TRATAMENTO NO FRONTEND
    Front -> Front : Detecta HTTP 409
    Front -> Admin : Exibe Modal: "Dados desatualizados. Outro usuário já modificou este registro."
    
    ' Frontend atualiza a tela automaticamente com os dados novos trazidos no payload do erro
    Front -> Front : Atualiza Estado Local (Status: Aprovado, Versão: 2)
deactivate Front
@enduml
