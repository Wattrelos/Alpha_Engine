{
    "autoload": {
        "psr-4": {
            "Alpha\\": "core/",
            "Containers\\": "Containers/",
            "Config\\": "Config/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "sort-packages": true
    },
    "require": {
        "erusev/parsedown": "^1.8",
        "illuminate/collections": "^13.12",
        "php-amqplib/php-amqplib": "^3.7",
        "predis/predis": "^3.4",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "scssphp/scssphp": "^2.1",
        "slim/csrf": "^1.5",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "slim/twig-view": "^3.4",
        "symfony/config": "^8.1",
        "symfony/translation": "^8.1",
        "twig/twig": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "scripts": {
        "alpha:evo": "php -r \"require 'vendor/autoload.php'; (new Alpha\\Support\\EvolutionGenerator())->run();\"",
        "build-css": "php scratch/compile-scss.php",
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress",
        "stan:report": [
            "mkdir -p .reports",
            "phpstan analyse --error-format=json > .reports/phpstan-report.json || true"
        ],
        "stan:baseline": "phpstan analyse --generate-baseline phpstan-baseline.neon",
        "package": "php scripts/build-release.php",
        "build-release": "php scripts/build-release.php"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3"
    }
}