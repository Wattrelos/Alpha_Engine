        <mxCell id="jiAAAqqnnyP7G_3Xw-GS-1" parent="jiAAAqqnnyP7G_3Xw-GS-0" />
        <UserObject label="" plantUmlData="{&#10;  &quot;data&quot;: &quot;@startuml EER_Diagram\n!theme plain\nskinparam linetype ortho\nskinparam packageStyle rectangle\nskinparam shadow shading false\nskinparam class {\n    BorderColor #444444\n    ArrowColor #555555\n}\n\nheader Alpha Engine Domain Model\ntitle Enhanced Entity-Relationship (EER) Diagram for AI Agents\n\npackage \&quot;Catalog Module\&quot; #FFF2CC {\n    entity Product #FFF9E6 {\n        * id : BIGINT &lt;&lt;PK&gt;&gt;\n        --\n        * model : varchar(64)\n        * sku : varchar(64)\n        * upc : varchar(12)\n        * ean : varchar(14)\n        * jan : varchar(13)\n        * isbn : varchar(13)\n        * mpn : varchar(64)\n        * location : varchar(128)\n        * variant : varchar(255)\n        * override : text\n        * price : decimal(15,4)\n        * quantity : int\n        * stock_status_id : int &lt;&lt;FK&gt;&gt;\n        * image : varchar(255)\n        * manufacturer_id : int &lt;&lt;FK&gt;&gt;\n        * shipping : tinyint(1)\n        * points : int\n        * tax_class_id : int &lt;&lt;FK&gt;&gt;\n        * date_available : date\n        * weight : decimal(15,8)\n        * weight_class_id : int &lt;&lt;FK&gt;&gt;\n        * length : decimal(15,8)\n        * width : decimal(15,8)\n        * height : decimal(15,8)\n        * length_class_id : int &lt;&lt;FK&gt;&gt;\n        * subtract : tinyint(1)\n        * minimum : int\n        * rating : int\n        * status : tinyint(1)\n        * sort_order : int\n        * date_added : datetime\n        * date_modified : datetime\n        * master_id : int &lt;&lt;FK&gt;&gt;\n    }\n\n    entity ProductDescription #FFF9E6 {\n        * product_id : int &lt;&lt;PK, FK&gt;&gt;\n        * language_id : int &lt;&lt;PK, FK&gt;&gt;\n        --\n        * name : varchar(255) &lt;&lt;FULLTEXT idx_ft_product_search&gt;&gt;\n        * description : text &lt;&lt;FULLTEXT idx_ft_product_search&gt;&gt;\n        * tag : text &lt;&lt;FULLTEXT idx_ft_product_search&gt;&gt;\n        * meta_title : varchar(255)\n        * meta_description : varchar(255)\n        * meta_keyword : varchar(255)\n    }\n\n    entity Category #FFF9E6 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * image : varchar(255)\n        * parent_id : int &lt;&lt;FK&gt;&gt;\n        * sort_order : int\n        * status : tinyint(1)\n    }\n\n    entity CategoryDescription #FFF9E6 {\n        * category_id : int &lt;&lt;PK, FK&gt;&gt;\n        * language_id : int &lt;&lt;PK, FK&gt;&gt;\n        --\n        * name : varchar(255)\n        * description : text\n        * meta_title : varchar(255)\n        * meta_description : varchar(255)\n        * meta_keyword : varchar(255)\n    }\n\n    entity Manufacturer #FFF9E6 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * name : varchar(64)\n        * image : varchar(255)\n        * sort_order : int\n    }\n\n    entity ProductImage #FFF9E6 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * product_id : int &lt;&lt;FK&gt;&gt;\n        * image : varchar(255)\n        * sort_order : int\n    }\n\n    entity ProductToCategory #FFF9E6 {\n        * product_id : int &lt;&lt;PK, FK&gt;&gt;\n        * category_id : int &lt;&lt;PK, FK&gt;&gt;\n    }\n\n    entity Option #FFF9E6 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * type : varchar(32)\n        * sort_order : int\n    }\n\n    entity OptionValue #FFF9E6 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * option_id : int &lt;&lt;FK&gt;&gt;\n        * image : varchar(255)\n        * sort_order : int\n    }\n\n    entity ProductOption #FFF9E6 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * product_id : int &lt;&lt;FK&gt;&gt;\n        * option_id : int &lt;&lt;FK&gt;&gt;\n        * value : text\n        * required : tinyint(1)\n    }\n\n    entity ProductOptionValue #FFF9E6 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * product_option_id : int &lt;&lt;FK&gt;&gt;\n        * product_id : int &lt;&lt;FK&gt;&gt;\n        * option_id : int &lt;&lt;FK&gt;&gt;\n        * option_value_id : int &lt;&lt;FK&gt;&gt;\n        * quantity : int\n        * subtract : tinyint(1)\n        * price : decimal(15,4)\n        * price_prefix : varchar(1)\n        * points : int\n        * points_prefix : varchar(1)\n        * weight : decimal(15,8)\n        * weight_prefix : varchar(1)\n    }\n\n    entity Review #FFF9E6 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * product_id : int &lt;&lt;FK&gt;&gt;\n        * customer_id : int &lt;&lt;FK&gt;&gt;\n        * author : varchar(64)\n        * text : text\n        * rating : int\n        * status : tinyint(1)\n        * date_added : datetime\n        * date_modified : datetime\n    }\n\n    entity ProductDiscount #FFF9E6 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * product_id : int &lt;&lt;FK&gt;&gt;\n        * customer_group_id : int &lt;&lt;FK&gt;&gt;\n        * quantity : int\n        * priority : int\n        * price : decimal(15,4)\n        * date_start : date\n        * date_end : date\n    }\n\n    entity Attribute #FFF9E6 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * attribute_group_id : int &lt;&lt;FK&gt;&gt;\n        * sort_order : int\n    }\n\n    entity AttributeGroup #FFF9E6 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * sort_order : int\n    }\n\n    entity ProductAttribute #FFF9E6 {\n        * product_id : int &lt;&lt;PK, FK&gt;&gt;\n        * attribute_id : int &lt;&lt;PK, FK&gt;&gt;\n        * language_id : int &lt;&lt;PK, FK&gt;&gt;\n        --\n        * text : text\n    }\n\n    entity Identifier #FFF9E6 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * name : varchar(64)\n        * code : varchar(64)\n        * validation : varchar(255)\n        * status : tinyint(1)\n    }\n\n    entity ProductCode #FFF9E6 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * product_id : int &lt;&lt;FK&gt;&gt;\n        * code : varchar(64)\n        * value : varchar(255)\n    }\n}\n\npackage \&quot;Customer Module\&quot; #D5E8D4 {\n    entity Customer #F5FBF3 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * customer_group_id : int &lt;&lt;FK&gt;&gt;\n        * store_id : int &lt;&lt;FK&gt;&gt;\n        * language_id : int &lt;&lt;FK&gt;&gt;\n        * firstname : varchar(32)\n        * lastname : varchar(32)\n        * email : varchar(96)\n        * telephone : varchar(32)\n        * password : varchar(255)\n        * newsletter : tinyint(1)\n        * ip : varchar(40)\n        * status : tinyint(1)\n        * safe : tinyint(1)\n        * commenter : tinyint(1)\n        * token : varchar(255)\n        * code : varchar(40)\n        * date_added : datetime\n        * cpf_cnpj : varchar(20)\n        * persontype : varchar(20)\n        * address_id : int &lt;&lt;FK&gt;&gt;\n    }\n\n    entity CustomerGroup #F5FBF3 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * approval : int\n        * sort_order : int\n    }\n\n    entity Address #F5FBF3 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * customer_id : int &lt;&lt;FK&gt;&gt;\n        * firstname : varchar(32)\n        * lastname : varchar(32)\n        * company : varchar(40)\n        * street : varchar(128)\n        * number : int\n        * complement : varchar(128)\n        * district : varchar(128)\n        * city : varchar(128)\n        * postcode : varchar(10)\n        * country_id : int &lt;&lt;FK&gt;&gt;\n        * zone_id : int &lt;&lt;FK&gt;&gt;\n    }\n\n    entity CustomerAddresses #F5FBF3 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * customer_id : int &lt;&lt;FK&gt;&gt;\n        * country_id : int &lt;&lt;FK&gt;&gt;\n        * zone_id : int &lt;&lt;FK&gt;&gt;\n        * city_id : int &lt;&lt;FK&gt;&gt;\n        * postal_code : varchar(10)\n        * street : varchar(255)\n        * number : varchar(32)\n        complement : varchar(255)\n        district : varchar(128)\n    }\n\n    entity CustomerAffiliate #F5FBF3 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * customer_id : int &lt;&lt;FK&gt;&gt;\n        * company : varchar(255)\n        * website : varchar(255)\n        * tracking : varchar(64)\n        * commission : decimal(15,4)\n        * status : tinyint(1)\n        * date_added : datetime\n    }\n\n    entity CustomerWishlist #F5FBF3 {\n        * customer_id : int &lt;&lt;PK, FK&gt;&gt;\n        * product_id : int &lt;&lt;PK, FK&gt;&gt;\n        --\n        * date_added : datetime\n    }\n    \n    entity CustomerIp #F5FBF3 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * customer_id : int &lt;&lt;FK&gt;&gt;\n        * ip : varchar(40)\n        * store_id : int\n        * country : varchar(64)\n        * date_added : datetime\n    }\n}\n\npackage \&quot;Checkout &amp; Sales Module\&quot; #F8CECC {\n    entity Cart #FDF5F5 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * store_id : int &lt;&lt;FK&gt;&gt;\n        * customer_id : int &lt;&lt;FK&gt;&gt;\n        * token_session : varchar(255)\n        * product_id : int &lt;&lt;FK&gt;&gt;\n        * subscription_plan_id : int &lt;&lt;FK&gt;&gt;\n        * option : text\n        * quantity : int\n        * override : text\n        * price : decimal(15,4)\n        * date_added : datetime\n    }\n\n    entity Order #FDF5F5 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * store_id : int &lt;&lt;FK&gt;&gt;\n        * customer_id : int &lt;&lt;FK&gt;&gt;\n        * customer_group_id : int\n        * firstname : varchar(32)\n        * lastname : varchar(32)\n        * email : varchar(96)\n        * telephone : varchar(32)\n        * payment_firstname : varchar(32)\n        * payment_lastname : varchar(32)\n        * payment_company : varchar(40)\n        * payment_street : varchar(128)\n        * payment_number : int\n        * payment_complement : varchar(128)\n        * payment_district : varchar(128)\n        * payment_city : varchar(128)\n        * payment_postcode : varchar(10)\n        * payment_country : varchar(128)\n        * payment_country_id : int\n        * payment_zone : varchar(128)\n        * payment_zone_id : int\n        * payment_method : varchar(128)\n        * shipping_firstname : varchar(32)\n        * shipping_lastname : varchar(32)\n        * shipping_company : varchar(40)\n        * shipping_street : varchar(128)\n        * shipping_number : int\n        * shipping_complement : varchar(128)\n        * shipping_district : varchar(128)\n        * shipping_city : varchar(128)\n        * shipping_postcode : varchar(10)\n        * shipping_country : varchar(128)\n        * shipping_country_id : int\n        * shipping_zone : varchar(128)\n        * shipping_zone_id : int\n        * shipping_method : varchar(128)\n        * total : decimal(15,4)\n        * order_status_id : int &lt;&lt;FK&gt;&gt;\n        * affiliate_id : int\n        * commission : decimal(15,4)\n        * marketing_id : int\n        * tracking : varchar(64)\n        * language_id : int &lt;&lt;FK&gt;&gt;\n        * currency_id : int &lt;&lt;FK&gt;&gt;\n        * currency_code : varchar(3)\n        * currency_value : decimal(15,8)\n        * ip : varchar(40)\n        * forwarded_ip : varchar(40)\n        * user_agent : varchar(255)\n        * accept_language : varchar(255)\n        * date_added : datetime\n        * date_modified : datetime\n    }\n\n    entity OrderProduct #FDF5F5 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * order_id : int &lt;&lt;FK&gt;&gt;\n        * product_id : int &lt;&lt;FK&gt;&gt;\n        * name : varchar(255)\n        * model : varchar(64)\n        * quantity : int\n        * price : decimal(15,4)\n        * total : decimal(15,4)\n        * tax : decimal(15,4)\n        * reward : int\n    }\n\n    entity OrderOption #FDF5F5 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * order_id : int &lt;&lt;FK&gt;&gt;\n        * order_product_id : int &lt;&lt;FK&gt;&gt;\n        * product_option_id : int\n        * product_option_value_id : int\n        * name : varchar(255)\n        * value : text\n        * type : varchar(32)\n    }\n\n    entity OrderHistory #FDF5F5 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * order_id : int &lt;&lt;FK&gt;&gt;\n        * order_status_id : int &lt;&lt;FK&gt;&gt;\n        * notify : tinyint(1)\n        * comment : text\n        * date_added : datetime\n    }\n\n    entity OrderTotal #FDF5F5 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * order_id : int &lt;&lt;FK&gt;&gt;\n        * code : varchar(32)\n        * title : varchar(255)\n        * value : decimal(15,4)\n        * sort_order : int\n    }\n\n    entity OrderStatus #FDF5F5 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * name : varchar(32)\n    }\n}\n\npackage \&quot;Subscription Module\&quot; #E1D5E7 {\n    entity SubscriptionPlan #F7F3FA {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * trial_frequency : varchar(10)\n        * trial_cycle : int\n        * trial_duration : int\n        * trial_status : tinyint(1)\n        * frequency : varchar(10)\n        * cycle : int\n        * duration : int\n        * sort_order : int\n        * status : tinyint(1)\n    }\n\n    entity SubscriptionPlanDescription #F7F3FA {\n        * subscription_plan_id : int &lt;&lt;PK, FK&gt;&gt;\n        * language_id : int &lt;&lt;PK, FK&gt;&gt;\n        --\n        * name : varchar(255)\n    }\n\n    entity Subscription #F7F3FA {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * order_id : int &lt;&lt;FK&gt;&gt;\n        * customer_id : int &lt;&lt;FK&gt;&gt;\n        * subscription_plan_id : int &lt;&lt;FK&gt;&gt;\n        * store_id : int &lt;&lt;FK&gt;&gt;\n        * payment_address_id : int\n        * payment_method : varchar(128)\n        * shipping_address_id : int\n        * shipping_method : varchar(128)\n        * trial_price : decimal(15,4)\n        * trial_tax : decimal(15,4)\n        * trial_frequency : varchar(10)\n        * trial_cycle : int\n        * trial_duration : int\n        * trial_remaining : int\n        * trial_status : tinyint(1)\n        * price : decimal(15,4)\n        * tax : decimal(15,4)\n        * frequency : varchar(10)\n        * cycle : int\n        * duration : int\n        * remaining : int\n        * date_next : datetime\n        * language : varchar(64)\n        * currency : varchar(64)\n        * subscription_status_id : int &lt;&lt;FK&gt;&gt;\n        * comment : text\n        * date_added : datetime\n        * date_modified : datetime\n    }\n\n    entity SubscriptionStatus #F7F3FA {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * name : varchar(32)\n    }\n}\n\npackage \&quot;Localization Module\&quot; #DAE8FC {\n    entity Language #F2F7FF {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * name : varchar(32)\n        * code : varchar(5)\n        * locale : varchar(255)\n        * image : varchar(64)\n        * directory : varchar(32)\n        * status : tinyint(1)\n        * sort_order : int\n    }\n\n    entity Currency #F2F7FF {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * title : varchar(32)\n        * code : varchar(3)\n        * symbol_left : varchar(12)\n        * symbol_right : varchar(12)\n        * decimal_place : char(1)\n        * value : float(15,8)\n        * status : tinyint(1)\n        * date_modified : datetime\n    }\n\n    entity Country #F2F7FF {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * name : varchar(128)\n        * iso_code_2 : varchar(2)\n        * iso_code_3 : varchar(3)\n        * address_format : text\n        * postcode_required : tinyint(1)\n        * status : tinyint(1)\n    }\n\n    entity Zone #F2F7FF {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * country_id : int &lt;&lt;FK&gt;&gt;\n        * name : varchar(128)\n        * code : varchar(32)\n        * status : tinyint(1)\n    }\n\n    entity City #F2F7FF {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * zone_id : int &lt;&lt;FK&gt;&gt;\n        * name : varchar(128)\n        * is_served : tinyint(1)\n    }\n\n    entity TaxClass #F2F7FF {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * title : varchar(32)\n        * description : varchar(255)\n        * date_added : datetime\n        * date_modified : datetime\n    }\n\n    entity TaxRate #F2F7FF {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * name : varchar(32)\n        * rate : decimal(15,4)\n        * type : char(1)\n        * date_added : datetime\n        * date_modified : datetime\n    }\n\n    entity TaxRule #F2F7FF {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * tax_class_id : int &lt;&lt;FK&gt;&gt;\n        * tax_rate_id : int &lt;&lt;FK&gt;&gt;\n        * based : varchar(10)\n        * priority : int\n    }\n}\n\npackage \&quot;System &amp; Store\&quot; #E3E3E3 {\n    entity Store #F9F9F9 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * name : varchar(64)\n        * url : varchar(255)\n    }\n\n    entity Extension #F9F9F9 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * extension : varchar(255)\n        * type : varchar(32)\n        * code : varchar(32)\n    }\n\n    entity SeoUrl #F9F9F9 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * store_id : int &lt;&lt;FK&gt;&gt;\n        * language_id : int &lt;&lt;FK&gt;&gt;\n        * key : varchar(64)\n        * value : varchar(255)\n        * keyword : varchar(255)\n        * sort_order : int\n    }\n\n    entity Setting #F9F9F9 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * store_id : int &lt;&lt;FK&gt;&gt;\n        * code : varchar(128)\n        * key : varchar(128)\n        * value : text\n        * serialized : tinyint(1)\n    }\n\n    entity Session #F9F9F9 {\n        * session_id : varchar(255) &lt;&lt;PK&gt;&gt;\n        --\n        * data : text\n        * expire : datetime\n    }\n\n    entity Cron #F9F9F9 {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * code : varchar(64)\n        * description : text\n        * cycle : varchar(12)\n        * action : text\n        * status : tinyint(1)\n        * date_added : datetime\n        * date_modified : datetime\n    }\n}\n\npackage \&quot;Procurement Module\&quot; #E0F2F1 {\n    entity Supplier #E0F7FA {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * company_name : varchar(255)\n        * trade_name : varchar(255)\n        * tax_id : varchar(14)\n        * state_registration : varchar(32)\n        * municipal_registration : varchar(32)\n        * email : varchar(96)\n        * phone : varchar(32)\n        * website : varchar(255)\n        * is_active : tinyint(1)\n        * created_at : datetime\n        * updated_at : datetime\n    }\n\n    entity Contact #E0F7FA {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * name : varchar(120)\n        * email : varchar(120)\n        * phone : varchar(50)\n        * position : varchar(100)\n        * is_active : tinyint(1)\n        * created_at : datetime\n        * updated_at : datetime\n    }\n\n    entity SupplierAddress #E0F7FA {\n        * id : int &lt;&lt;PK&gt;&gt;\n        --\n        * supplier_id : int &lt;&lt;FK&gt;&gt;\n        * country_id : int &lt;&lt;FK&gt;&gt;\n        * zone_id : int &lt;&lt;FK&gt;&gt;\n        * city_id : int &lt;&lt;FK&gt;&gt;\n        * postal_code : varchar(10)\n        * street : varchar(255)\n        * number : varchar(32)\n        complement : varchar(255)\n        district : varchar(128)\n    }\n\n    entity SupplierContactManufacturer #E0F7FA {\n        * supplier_id : int &lt;&lt;PK, FK&gt;&gt;\n        * contact_id : int &lt;&lt;PK, FK&gt;&gt;\n        * manufacturer_id : int &lt;&lt;PK, FK&gt;&gt;\n        --\n        * created_at : datetime\n    }\n}\n\n' --- RELATIONSHIPS (Catalog Module) ---\nProduct \&quot;1\&quot; ||--|{ ProductDescription : \&quot;described by\&quot;\nProduct \&quot;1\&quot; ||--|{ ProductImage : \&quot;has\&quot;\nProduct \&quot;1\&quot; ||--|{ ProductToCategory : \&quot;categorized in\&quot;\nCategory \&quot;1\&quot; ||--|{ ProductToCategory : \&quot;holds\&quot;\nCategory \&quot;1\&quot; ||--|{ CategoryDescription : \&quot;described by\&quot;\nCategory \&quot;0..1\&quot; |o--|{ Category : \&quot;parent of\&quot;\nManufacturer \&quot;1\&quot; |o--|{ Product : \&quot;manufactures\&quot;\n\nOption \&quot;1\&quot; ||--|{ OptionValue : \&quot;defines values\&quot;\nOption \&quot;1\&quot; ||--|{ ProductOption : \&quot;offered by\&quot;\nProductOption \&quot;1\&quot; ||--|{ ProductOptionValue : \&quot;variants\&quot;\nOptionValue \&quot;1\&quot; ||--|{ ProductOptionValue : \&quot;instantiates\&quot;\nProduct \&quot;1\&quot; ||--|{ ProductOption : \&quot;has options\&quot;\nProduct \&quot;1\&quot; ||--|{ ProductOptionValue : \&quot;has variant details\&quot;\n\nProduct \&quot;1\&quot; ||--|{ ProductDiscount : \&quot;offered with discount\&quot;\nProduct \&quot;1\&quot; ||--|{ ProductAttribute : \&quot;specified by\&quot;\nProduct \&quot;1\&quot; ||--|{ ProductCode : \&quot;has codes\&quot;\nAttribute \&quot;1\&quot; ||--|{ ProductAttribute : \&quot;defines type\&quot;\nAttributeGroup \&quot;1\&quot; ||--|{ Attribute : \&quot;groups\&quot;\nIdentifier \&quot;1\&quot; |o--|{ ProductCode : \&quot;formats code\&quot;\nIdentifier \&quot;1\&quot; |o--|{ Product : \&quot;validates code format for\&quot;\n\n' --- RELATIONSHIPS (Customer Module) ---\nCustomerGroup \&quot;1\&quot; ||--|{ Customer : \&quot;classifies\&quot;\nCustomerGroup \&quot;1\&quot; ||--|{ ProductDiscount : \&quot;targets\&quot;\nCustomer \&quot;1\&quot; ||--|{ Address : \&quot;has\&quot;\nCustomer \&quot;1\&quot; |o--|| Address : \&quot;default address\&quot;\nCustomer \&quot;1\&quot; ||--|{ CustomerAddresses : \&quot;has addresses\&quot;\nCustomer \&quot;1\&quot; |o--|| CustomerAffiliate : \&quot;has affiliate profile\&quot;\nCustomer \&quot;1\&quot; ||--|{ CustomerWishlist : \&quot;saves to\&quot;\nProduct \&quot;1\&quot; ||--|{ CustomerWishlist : \&quot;saved on\&quot;\nCustomer \&quot;1\&quot; ||--|{ CustomerIp : \&quot;logs IP\&quot;\nCustomer \&quot;1\&quot; ||--|{ Review : \&quot;writes\&quot;\nProduct \&quot;1\&quot; ||--|{ Review : \&quot;rated by\&quot;\n\n' --- RELATIONSHIPS (Checkout &amp; Sales Module) ---\nCustomer \&quot;1\&quot; ||--|{ Cart : \&quot;has active items\&quot;\nProduct \&quot;1\&quot; ||--|{ Cart : \&quot;item in cart\&quot;\nSubscriptionPlan \&quot;1\&quot; |o--|{ Cart : \&quot;item subscription billing plan\&quot;\nStore \&quot;1\&quot; ||--|{ Cart : \&quot;contains cart context\&quot;\n\nCustomer \&quot;1\&quot; ||--|{ Order : \&quot;places\&quot;\nStore \&quot;1\&quot; ||--|{ Order : \&quot;records order in context\&quot;\nOrderStatus \&quot;1\&quot; ||--|{ Order : \&quot;indicates status\&quot;\nLanguage \&quot;1\&quot; ||--|{ Order : \&quot;placed using\&quot;\nCurrency \&quot;1\&quot; ||--|{ Order : \&quot;billed in\&quot;\n\nOrder \&quot;1\&quot; ||--|{ OrderProduct : \&quot;contains\&quot;\nProduct \&quot;1\&quot; ||--|{ OrderProduct : \&quot;sold in\&quot;\nOrderProduct \&quot;1\&quot; ||--|{ OrderOption : \&quot;configured by\&quot;\nOrder \&quot;1\&quot; ||--|{ OrderTotal : \&quot;tallies cost\&quot;\nOrder \&quot;1\&quot; ||--|{ OrderHistory : \&quot;audited by\&quot;\nOrderStatus \&quot;1\&quot; ||--|{ OrderHistory : \&quot;stage reached\&quot;\n\n' --- RELATIONSHIPS (Subscription Module) ---\nSubscriptionPlan \&quot;1\&quot; ||--|{ SubscriptionPlanDescription : \&quot;described by\&quot;\nSubscriptionPlan \&quot;1\&quot; ||--|{ Subscription : \&quot;bills under\&quot;\nCustomer \&quot;1\&quot; ||--|{ Subscription : \&quot;holds subscription\&quot;\nOrder \&quot;1\&quot; ||--|{ Subscription : \&quot;billed in order\&quot;\nSubscriptionStatus \&quot;1\&quot; ||--|{ Subscription : \&quot;indicates current state\&quot;\n\n' --- RELATIONSHIPS (Localization Module) ---\nLanguage \&quot;1\&quot; ||--|{ ProductDescription : \&quot;translation\&quot;\nLanguage \&quot;1\&quot; ||--|{ CategoryDescription : \&quot;translation\&quot;\nLanguage \&quot;1\&quot; ||--|{ ProductAttribute : \&quot;translation\&quot;\nLanguage \&quot;1\&quot; ||--|{ SubscriptionPlanDescription : \&quot;translation\&quot;\n\nCountry \&quot;1\&quot; ||--|{ Zone : \&quot;contains zones\&quot;\nZone \&quot;1\&quot; ||--|{ City : \&quot;contains cities\&quot;\nCountry \&quot;1\&quot; ||--|{ Address : \&quot;address country\&quot;\nZone \&quot;1\&quot; ||--|{ Address : \&quot;address state/zone\&quot;\n\nTaxClass \&quot;1\&quot; ||--|{ TaxRule : \&quot;contains rules\&quot;\nTaxRate \&quot;1\&quot; ||--|{ TaxRule : \&quot;applied rate\&quot;\nTaxClass \&quot;1\&quot; ||--|{ Product : \&quot;tax configuration\&quot;\n\n' --- RELATIONSHIPS (Procurement Module) ---\nSupplier \&quot;1\&quot; ||--|| SupplierAddress : \&quot;located at\&quot;\nSupplier \&quot;1\&quot; ||--|{ SupplierContactManufacturer : \&quot;associated through\&quot;\nContact \&quot;1\&quot; ||--|{ SupplierContactManufacturer : \&quot;linked to\&quot;\nManufacturer \&quot;1\&quot; ||--|{ SupplierContactManufacturer : \&quot;represented by\&quot;\nCountry \&quot;1\&quot; ||--|{ SupplierAddress : \&quot;address country\&quot;\nZone \&quot;1\&quot; ||--|{ SupplierAddress : \&quot;address state/zone\&quot;\nCity \&quot;1\&quot; ||--|{ SupplierAddress : \&quot;address city\&quot;\n\n' --- RELATIONSHIPS (System &amp; Store) ---\nExtension \&quot;1\&quot; |o--|{ Store : \&quot;configured for\&quot;\nStore \&quot;1\&quot; ||--|{ SeoUrl : \&quot;defines URL keywords\&quot;\nLanguage \&quot;1\&quot; ||--|{ SeoUrl : \&quot;localized keyword\&quot;\nStore \&quot;1\&quot; ||--|{ Setting : \&quot;configures store\&quot;\nStore \&quot;1\&quot; ||--|{ Session : \&quot;stores session context\&quot;\n\nlegend right\n  == Mapeamento de Tipos (Arquitetura)\n  * **Banco de Dados (DB)** -&gt; **PHP (64-bit)**\n  * BIGINT (8 bytes, PK/FK) -&gt; int (8-byte integer)\n  * INT (4 bytes) -&gt; int\n  * TINYINT(1) -&gt; bool\n  * VARCHAR / TEXT -&gt; string\n  * DECIMAL -&gt; string\n  * DATETIME / DATE -&gt; DateTimeInterface\nendlegend\n\n@enduml\n&quot;,&#10;  &quot;config&quot;: null&#10;}" id="pOXqP8lsqwrXa7mYaLlK-1">
