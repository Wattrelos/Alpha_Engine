@startuml
autonumber "<b>[00]"

header "Alpha Engine Workflow: Technical Idempotency & Queue Protection"
title "Idempotency Control Sequence (Redis Lock, UnitOfWork & RabbitMQ)"

box "Frontend / Web Client"
    actor "Client" as Client
    participant "Frontend (JS)" as Front
end box

box "Application Layer"
    participant "CheckoutAction" as Action
    participant "IdempotencyService" as Idempotency
    participant "EventDispatcher" as Events
end box

box "Infrastructure Layer"
    database "Redis Cache" as Redis
    participant "UnitOfWork" as UoW
    database "MySQL Database" as MySQL
    participant "QueueService (RabbitMQ)" as RabbitMQ
    participant "Worker CLI Consumer" as Worker
end box

' === FIRST REQUEST (ORIGINAL) ===
Client -> Front : Click "Submit Order"
activate Front
    Front -> Front : generateUUID() -> idempotencyKey
    Front -> Action : HTTP POST /{lang}/checkout\n[Header: X-Idempotency-Key = "uuid-1234"]
    activate Action
        
        Action -> Idempotency : acquireLock("uuid-1234", ttl = 300)
        activate Idempotency
            Idempotency -> Redis : SETNX("idempotency:uuid-1234", "PROCESSING", EX 300)
            activate Redis
                Redis --> Idempotency : 1 (Lock Acquired)
            deactivate Redis
            Idempotency --> Action : true (Lock Granted)
        deactivate Idempotency
        
        Action -> UoW : transaction(callable)
        activate UoW
            UoW -> MySQL : BEGIN TRANSACTION
            UoW -> MySQL : INSERT INTO tbkk_order (...)
            activate MySQL

' === SECOND CONCURRENT REQUEST (DOUBLE CLICK) ===
Client -> Front : Click "Submit Order" (Double Click)
    Front -> Action : HTTP POST /{lang}/checkout\n[Header: X-Idempotency-Key = "uuid-1234"]
    activate Action
        Action -> Idempotency : acquireLock("uuid-1234", ttl = 300)
        activate Idempotency
            Idempotency -> Redis : SETNX("idempotency:uuid-1234", "PROCESSING", EX 300)
            activate Redis
                Redis --> Idempotency : 0 (Key Exists / Locked)
            deactivate Redis
            Idempotency -> Idempotency : throw new IdempotencyLockException("Duplicate request")
            Idempotency --> Action : throws IdempotencyLockException
        deactivate Idempotency
        
        Action --> Front : HTTP 429 Too Many Requests\n{error: "DUPLICATE_REQUEST"}
    deactivate Action

' === FIRST REQUEST TRANSACTION COMPLETION & MESSAGING ===
            MySQL --> UoW : Rows Inserted
            deactivate MySQL
            UoW -> MySQL : COMMIT TRANSACTION
            UoW --> Action : Transaction Success (orderId = 1050)
        deactivate UoW
        
        Action -> Events : dispatch(new OrderCreatedEvent(1050))
        activate Events
            Events -> RabbitMQ : publish("order.created", payload)
            activate RabbitMQ
                RabbitMQ --> Events : ACK (Enqueued)
            deactivate RabbitMQ
            Events --> Action : Event Dispatched
        deactivate Events
        
        Action --> Front : HTTP 201 Created\n{success: true, order_id: 1050}
    deactivate Action

    ' ASYNCHRONOUS CONSUMPTION BY WORKER
    RabbitMQ -> Worker : Consume Message (order_id: 1050)
    activate Worker
        Worker -> Worker : Process Payment & Email Notification
        Worker --> RabbitMQ : ACK
    deactivate Worker

    Front -> Front : Ignore HTTP 429 Error
    Front -> Front : Process HTTP 201 Response
    Front -> Client : Redirect to /checkout/success?order_id=1050
deactivate Front

@enduml
