{% extends 'layouts/base.html.twig' %}

{% block page_title %}{{ title }}{% endblock %}

{% block content %}
	<div id="account-page">
		{# ── Hero ── #}
		<div class="account-hero">
			<div class="account-hero-inner">
				<nav class="account-breadcrumb" aria-label="Navegação">
					{% for breadcrumb in breadcrumbs %}
						{% if not loop.last %}
							<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
							<span class="sep">›</span>
						{% else %}
							<span class="current">{{ breadcrumb.text }}</span>
						{% endif %}
					{% endfor %}
				</nav>
				<div class="account-hero-content">
					<div class="account-avatar">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
						</svg>
					</div>
					<div>
						<h1 class="account-hero-title">{{ title }}</h1>
						<p class="account-hero-sub">Seus produtos favoritos salvos</p>
					</div>
				</div>
			</div>
		</div>

		{# ── Wrapper ── #}
		<div class="account-wrapper">
		{# Exibição de alertas de sucesso/erro vindos da sessão #}
		{% if success %}
			<div class="egen-alert egen-alert--success account-slide-card">
				<i class="fa-solid fa-circle-check"></i>
				{{ success }}
			</div>
		{% endif %}
		{% if error_warning %}
			<div class="egen-alert egen-alert--danger account-slide-card">
				<i class="fa-solid fa-circle-exclamation"></i>
				{{ error_warning }}
			</div>
		{% endif %}

		{% if wishlist_items %}
			<div class="egen-wishlist-grid">
				{% for item in wishlist_items %}
					<div class="egen-wishlist-card">
						<div class="egen-wishlist-card__image">
							{% if item.thumb %}
								<a href="{{ item.href }}">
									<img src="{{ item.thumb }}" alt="{{ item.name }}" title="{{ item.name }}"/>
								</a>
							{% endif %}
						</div>

						<div class="egen-wishlist-card__details">
							<div>
								<h3 class="egen-wishlist-card__title">
									<a href="{{ item.href }}">{{ item.name }}</a>
								</h3>
								<div class="egen-wishlist-card__meta">
									<span class="egen-badge">Mod: {{ item.model }}</span>
								</div>
							</div>

							<div class="egen-wishlist-card__price-box">
								{% if item.price %}
									{% if not item.special %}
										<span class="egen-price-regular">{{ item.price }}</span>
									{% else %}
										<span class="egen-price-old">{{ item.price }}</span>
										<span class="egen-price-special">{{ item.special }}</span>
									{% endif %}
								{% endif %}
							</div>
						</div>

						<div class="egen-wishlist-card__actions">
							<form action="/{{ lang }}/carrinho/adicionar" method="POST" class="egen-wishlist-card__buy-form">
								{% if csrf %}
									<input type="hidden" name="{{ csrf.keys.name }}" value="{{ csrf.name }}">
									<input type="hidden" name="{{ csrf.keys.value }}" value="{{ csrf.value }}">
								{% endif %}
								<input type="hidden" name="product_id" value="{{ item.product_id }}">
								<input type="hidden" name="quantity" value="{{ item.minimum|default(1) }}">
								<button type="submit" class="egen-btn egen-btn-primary">
									<i class="fas fa-shopping-cart"></i>
									Comprar
								</button>
							</form>
							<a href="{{ item.remove }}" class="egen-btn-danger-icon" title="Remover da Lista">
								<i class="fas fa-trash-alt"></i>
							</a>
						</div>
					</div>
				{% endfor %}
			</div>
		{% else %}
			<div class="egen-empty-state">
				<div class="egen-empty-state__icon">
					<i class="fas fa-heart-broken egen-empty-icon"></i>
				</div>
				<h2 class="egen-empty-state__title">Sua lista de desejos está vazia</h2>
				<p class="egen-empty-state__text">Você ainda não salvou nenhum produto para comprar depois. Navegue por nossos departamentos e adicione seus favoritos aqui!</p>
				<a href="{{ continue_url }}" class="egen-btn egen-btn-primary">Explorar Produtos</a>
			</div>
		{% endif %}
	</div>
	</div>
	{# /#account-page #}
{% endblock %}
