{% extends 'layouts/base.html.twig' %}

{% block title %}
	Pedido #{{ order_id }} | meusite
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="/css/custom/orders.css">
{% endblock %}

{% block content %}
	<div id="account-order-detail-page">

		{# ── Hero ── #}
		<div class="orders-hero">
			<div class="orders-hero-inner">
				<nav class="orders-breadcrumb" aria-label="Navegação">
					{% for breadcrumb in breadcrumbs %}
						{% if not loop.last %}
							<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
							<span class="sep">›</span>
						{% else %}
							<span class="current">{{ breadcrumb.text }}</span>
						{% endif %}
					{% endfor %}
				</nav>
				<h1 class="orders-title">
					<span class="orders-title-icon">📝</span>
					Pedido #{{ order_id }}
				</h1>
				<p class="orders-subtitle">Cadastrado em {{ date_added }}</p>
			</div>
		</div>

		{# ── Conteúdo Principal ── #}
		<div class="orders-wrapper">

			{# ── Grid de Detalhes (Endereço, Envio e Pagamento) ── #}
			<div class="detail-grid">
				<div class="detail-card">
					<h3 class="detail-card-title">
						<span>💳</span> {{ text_payment_address }}
					</h3>
					<div class="detail-card-content font-tabular">
						{{ payment_address|raw }}
						<div class="meta-item">
							<strong>Método:</strong> {{ payment_method }}
						</div>
					</div>
				</div>

				{% if shipping_address %}
					<div class="detail-card">
						<h3 class="detail-card-title">
							<span>🚚</span> {{ text_shipping_address }}
						</h3>
						<div class="detail-card-content font-tabular">
							{{ shipping_address|raw }}
							<div class="meta-item">
								<strong>Método:</strong> {{ shipping_method }}
							</div>
						</div>
					</div>
				{% endif %}
			</div>

			{# ── Lista de Produtos ── #}
			<div class="orders-card">
				<div class="orders-card-header">
					<h3 class="orders-card-header-title">Itens do Pedido</h3>
				</div>
				<div class="orders-table-wrap">
					<table class="orders-table">
						<thead>
							<tr>
								<th>{{ column_name }}</th>
								<th>{{ column_model }}</th>
								<th class="col-center">{{ column_quantity }}</th>
								<th class="col-right">{{ column_price }}</th>
								<th class="col-right">{{ column_total }}</th>
								<th class="col-center">Ações</th>
							</tr>
						</thead>
						<tbody>
							{% for product in products %}
								<tr class="order-row">
									<td>
										<strong class="product-name-text">{{ product.name }}</strong>
										{% for option in product.option %}
											<br/>
											<small class="product-option-text">&nbsp;- {{ option.name }}: {{ option.value }}</small>
										{% endfor %}
									</td>
									<td><span class="model-text">{{ product.model }}</span></td>
									<td class="col-center font-tabular">{{ product.quantity }}</td>
									<td class="col-right font-tabular">{{ product.price }}</td>
									<td class="col-right font-tabular"><strong class="order-total-value">{{ product.total }}</strong></td>
									<td class="col-center">
										<a href="/{{ lang }}/account/return/add?order_id={{ order_id }}&product_id={{ product.product_id }}" class="btn-return-action" title="Devolver Produto">
											🔄 Devolver
										</a>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				{# ── Totais do Pedido ── #}
				<div class="totals-wrap font-tabular">
					{% for total in totals %}
						<div class="total-row {% if loop.last %}total-row--final{% endif %}">
							<span class="total-row-title">{{ total.title }}:</span>
							<strong class="total-row-val">{{ total.text }}</strong>
						</div>
					{% endfor %}
				</div>
			</div>

			{# ── Histórico de Situações (Timeline) ── #}
			<div class="orders-card">
				<div class="orders-card-header">
					<h3 class="orders-card-header-title">{{ text_history }}</h3>
				</div>
				<div class="timeline-wrap">
					{% if histories %}
						<div class="timeline">
							{% for history in histories %}
								<div class="timeline-item">
									<div class="timeline-dot"></div>
									<div class="timeline-content">
										<div class="timeline-header">
											<span class="timeline-status-pill status-{{ history.status|lower|replace({' ': '-'}) }}">
												{{ history.status }}
											</span>
											<span class="timeline-date font-tabular">{{ history.date_added }}</span>
										</div>
										{% if history.comment %}
											<div class="timeline-comment font-tabular">
												{{ history.comment|raw }}
											</div>
										{% endif %}
									</div>
								</div>
							{% endfor %}
						</div>
					{% else %}
						<p class="timeline-empty">{{ text_no_results }}</p>
					{% endif %}
				</div>
			</div>

			{# ── Ações de Rodapé ── #}
			<div class="orders-footer">
				<a href="{{ continue }}" class="btn-back">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<polyline points="15 18 9 12 15 6"/>
					</svg>
					Voltar para Meus Pedidos
				</a>
			</div>

		</div>
	</div>


{% endblock %}
