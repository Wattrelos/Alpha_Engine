{% extends 'layouts/base.html.twig' %}

{% block title %}
	{{ title|default('Minha Conta | meusite') }}
{% endblock %}

{% block content %}
	<div
		id="account-page"
	>

		{# ── Hero ── #}
		<div class="account-hero">
			<div class="account-hero-inner">
				<nav class="account-breadcrumb" aria-label="Navegação">
					{% for breadcrumb in breadcrumbs %}
						{% if not loop.last %}
							<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
							<span class="sep">›</span>
						{% else %}
							<span class="current">{{ breadcrumb.text }}</span>
						{% endif %}
					{% endfor %}
				</nav>
				<div class="account-hero-content">
					<div class="account-avatar">
						<svg width="32" height="32" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
							<circle cx="12" cy="7" r="4"/>
						</svg>
					</div>
					<div>
						<h1 class="account-hero-title">{{ text.myAccount }}</h1>
						<p class="account-hero-sub">Gerencie seus dados, pedidos e preferências</p>
					</div>
				</div>
			</div>
		</div>

		{# ── Dashboard Grid ── #}
		<div
			class="account-wrapper"
		>

			{# Exibição de alertas de sucesso/erro vindos da sessão #}
			{% if success %}
				<div class="egen-alert egen-alert--success account-slide-card">
					<i class="fa-solid fa-circle-check"></i>
					{{ success }}
				</div>
			{% endif %}
			{% if error_warning %}
				<div class="egen-alert egen-alert--danger account-slide-card">
					<i class="fa-solid fa-circle-exclamation"></i>
					{{ error_warning }}
				</div>
			{% endif %}

			{# ── Seção: Minha Conta ── #}
			<section class="account-section">
				<div class="section-header">
					<div class="section-icon section-icon--profile">
						<svg width="18" height="18" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
						</svg>
					</div>
					<h2 class="section-title">{{ text.myAccount }}</h2>
				</div>
				<div class="account-cards">
					<a href="{{ edit }}" class="account-card" id="link-edit-account">
						<div class="card-icon">
							<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
								<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
							</svg>
						</div>
						<div class="card-text">
							<span class="card-label">{{ text.edit }}</span>
							<span class="card-hint">Nome, e-mail, telefone</span>
						</div>
						<div class="card-arrow">›</div>
					</a>

					<a href="{{ password }}" class="account-card" id="link-change-password">
						<div class="card-icon">
							<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
								<path d="M7 11V7a5 5 0 0 1 10 0v4"/>
							</svg>
						</div>
						<div class="card-text">
							<span class="card-label">{{ text.password }}</span>
							<span class="card-hint">Segurança da sua conta</span>
						</div>
						<div class="card-arrow">›</div>
					</a>

					<a href="{{ address }}" class="account-card" id="link-address">
						<div class="card-icon">
							<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
								<circle cx="12" cy="10" r="3"/>
							</svg>
						</div>
						<div class="card-text">
							<span class="card-label">{{ text.address }}</span>
							<span class="card-hint">Endereços de entrega</span>
						</div>
						<div class="card-arrow">›</div>
					</a>

					<a href="{{ wishlist }}" class="account-card" id="link-wishlist">
						<div class="card-icon">
							<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
							</svg>
						</div>
						<div class="card-text">
							<span class="card-label">{{ text.wishlist }}</span>
							<span class="card-hint">Produtos salvos</span>
						</div>
						<div class="card-arrow">›</div>
					</a>
				</div>
			</section>

			{# ── Seção: Meus Pedidos ── #}
			<section class="account-section">
				<div class="section-header">
					<div class="section-icon section-icon--orders">
						<svg width="18" height="18" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
							<line x1="3" y1="6" x2="21" y2="6"/>
							<path d="M16 10a4 4 0 0 1-8 0"/>
						</svg>
					</div>
					<h2 class="section-title">{{ text.myOrders }}</h2>
				</div>
				<div class="account-cards">
					<a href="{{ order }}" class="account-card account-card--highlight" id="link-orders">
						<div class="card-icon">
							<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="9 11 12 14 22 4"/>
								<path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
							</svg>
						</div>
						<div class="card-text">
							<span class="card-label">{{ text.order }}</span>
							<span class="card-hint">Ver todos os pedidos</span>
						</div>
						<div class="card-arrow">›</div>
					</a>
					{% if reward %}
						<a href="{{ reward }}" class="account-card" id="link-rewards">
							<div class="card-icon card-icon--gold">
								<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
								</svg>
							</div>
							<div class="card-text">
								<span class="card-label">{{ text.reward }}</span>
								<span class="card-hint">Seus pontos acumulados</span>
							</div>
							<div class="card-arrow">›</div>
						</a>
					{% endif %}

					<a href="{{ return }}" class="account-card" id="link-returns">
						<div class="card-icon">
							<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="1 4 1 10 7 10"/>
								<path d="M3.51 15a9 9 0 1 0 .49-3.51"/>
							</svg>
						</div>
						<div class="card-text">
							<span class="card-label">{{ text.return }}</span>
							<span class="card-hint">Devoluções e trocas</span>
						</div>
						<div class="card-arrow">›</div>
					</a>

					<a href="{{ transaction }}" class="account-card" id="link-transactions">
						<div class="card-icon">
							<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="12" y1="1" x2="12" y2="23"/>
								<path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
							</svg>
						</div>
						<div class="card-text">
							<span class="card-label">{{ text.transaction }}</span>
							<span class="card-hint">Extrato financeiro</span>
						</div>
						<div class="card-arrow">›</div>
					</a>
				</div>
			</section>

			{# ── Seção: Projetos, Obras & Serviços (RFQ / BoQ) ── #}
			<section class="account-section">
				<div class="section-header">
					<div class="section-icon section-icon--orders" style="background:rgba(255,107,0,0.1); color:#ff6b00;">
						<svg width="18" height="18" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
						</svg>
					</div>
					<h2 class="section-title">Obras, Projetos & Prestadores</h2>
				</div>
				<div class="account-cards">
					<a href="/{{ lang }}/prestador/oportunidades" class="account-card account-card--highlight" id="link-provider-portal">
						<div class="card-icon" style="color:#ff6b00;">
							<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
								<path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
							</svg>
						</div>
						<div class="card-text">
							<span class="card-label">Portal do Prestador</span>
							<span class="card-hint">Oportunidades no seu raio e envio de orçamentos</span>
						</div>
						<div class="card-arrow">›</div>
					</a>

					<a href="/{{ lang }}/account/projetos" class="account-card" id="link-my-projects">
						<div class="card-icon">
							<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
								<rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
							</svg>
						</div>
						<div class="card-text">
							<span class="card-label">Meus Projetos (RFQ)</span>
							<span class="card-hint">Comparar propostas e aprovar listas BoQ</span>
						</div>
						<div class="card-arrow">›</div>
					</a>

					<a href="/{{ lang }}/projetos/novo" class="account-card" id="link-create-project">
						<div class="card-icon">
							<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"/>
								<line x1="12" y1="8" x2="12" y2="16"/>
								<line x1="8" y1="12" x2="16" y2="12"/>
							</svg>
						</div>
						<div class="card-text">
							<span class="card-label">Solicitar Orçamento</span>
							<span class="card-hint">Cadastre uma obra para receber orçamentos</span>
						</div>
						<div class="card-arrow">›</div>
					</a>
				</div>
			</section>

			{# ── Seção: Newsletter ── #}
			<section class="account-section">
				<div class="section-header">
					<div class="section-icon section-icon--news">
						<svg width="18" height="18" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
							<polyline points="22,6 12,13 2,6"/>
						</svg>
					</div>
					<h2 class="section-title">{{ text.myNewsletter }}</h2>
				</div>
				<div class="account-cards">
					<form id="form-newsletter" action="{{ newsletter_action_url|default('#') }}" method="post">
						{% if csrf %}
							<input type="hidden" name="{{ csrf.keys.name }}" value="{{ csrf.name }}">
							<input type="hidden" name="{{ csrf.keys.value }}" value="{{ csrf.value }}">
						{% endif %}
						<div class="account-card account-card--toggle">
							<div class="card-icon">
								<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
									<polyline points="22,6 12,13 2,6"/>
								</svg>
							</div>
							<div class="card-text">
								<span class="card-label">{{ text.newsletter }}</span>
								<span class="card-hint" id="newsletter-hint">{{ newsletter_status ? 'Você recebe nossas ofertas e novidades' : 'Receba ofertas e novidades por e-mail' }}</span>
							</div>
							<div class="card-toggle">
								<input type="checkbox" id="newsletter-toggle" name="newsletter" value="1" {% if newsletter_status %}checked{% endif %} aria-label="Newsletter subscription toggle">
							</div>
						</div>
					</form>
				</div>
			</section>

			{# ── Seção: Afiliado (condicional) ── #}
			{% if affiliate %}
				<section class="account-section">
					<div class="section-header">
						<div class="section-icon section-icon--affiliate">
							<svg width="18" height="18" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
								<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
								<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
							</svg>
						</div>
						<h2 class="section-title">{{ text.myAffiliate }}</h2>
					</div>
					<div class="account-cards">
						{% if not tracking %}
							<a href="{{ affiliate }}" class="account-card" id="link-affiliate-add">
								<div class="card-icon">
									<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>
									</svg>
								</div>
								<div class="card-text">
									<span class="card-label">{{ text.affiliateAdd }}</span>
									<span class="card-hint">Comece a ganhar comissões</span>
								</div>
								<div class="card-arrow">›</div>
							</a>
						{% else %}
							<a href="{{ affiliate }}" class="account-card" id="link-affiliate-edit">
								<div class="card-icon">
									<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
										<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
									</svg>
								</div>
								<div class="card-text">
									<span class="card-label">{{ text.affiliateEdit }}</span>
									<span class="card-hint">Dados do afiliado</span>
								</div>
								<div class="card-arrow">›</div>
							</a>
							<a href="{{ tracking }}" class="account-card" id="link-tracking">
								<div class="card-icon">
									<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
										<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
									</svg>
								</div>
								<div class="card-text">
									<span class="card-label">{{ text.tracking }}</span>
									<span class="card-hint">Gere seu link de afiliado</span>
								</div>
								<div class="card-arrow">›</div>
							</a>
						{% endif %}
					</div>
				</section>
			{% endif %}

		</div>
		{# /.account-wrapper #}
	</div>
	{# /#account-page #}

	<script>
		document.addEventListener("DOMContentLoaded", function () {
			const toggle = document.getElementById("newsletter-toggle");
			if (!toggle) return;

			const hint = document.getElementById("newsletter-hint");
			const form = toggle.closest("form");

			toggle.addEventListener("change", function () {
				const isChecked = this.checked;
				const formData = new FormData(form);
				if (!formData.has("newsletter")) {
					formData.append("newsletter", isChecked ? "1" : "0");
				}
				const metaNameKey =
					document.querySelector('meta[name="csrf-key-name"]')?.content ||
					"csrf_name";
				const metaValueKey =
					document.querySelector('meta[name="csrf-key-value"]')?.content ||
					"csrf_value";
				const metaName = document.querySelector(
					'meta[name="csrf-name"]',
				)?.content;
				const metaValue = document.querySelector(
					'meta[name="csrf-value"]',
				)?.content;
				if (metaName && metaValue && !formData.has(metaNameKey)) {
					formData.append(metaNameKey, metaName);
					formData.append(metaValueKey, metaValue);
				}

				const originalHint = hint.textContent;
				hint.textContent = isChecked
					? "Você recebe nossas ofertas e novidades"
					: "Receba ofertas e novidades por e-mail";

				fetch(form.action, {
					method: "POST",
					body: formData,
					headers: {
						"X-Requested-With": "XMLHttpRequest",
					},
				})
					.then((response) => response.json())
					.then((data) => {
						if (!data.success) {
							throw new Error(data.error || "Falha ao atualizar status.");
						}
					})
					.catch((error) => {
						console.error("Error:", error);
						toggle.checked = !isChecked;
						hint.textContent = originalHint;
						alert("Ocorreu um erro de comunicação. Tente novamente.");
					});
			});
		});
	</script>
{% endblock %}
