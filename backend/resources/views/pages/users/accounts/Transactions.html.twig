{% extends 'layouts/base.html.twig' %}

{% block page_title %}{{ heading_title }}{% endblock %}

{% block content %}
	<div id="account-page">
		{# ── Hero ── #}
		<div class="account-hero">
			<div class="account-hero-inner">
				<nav class="account-breadcrumb" aria-label="Navegação">
					{% for breadcrumb in breadcrumbs %}
						{% if not loop.last %}
							<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
							<span class="sep">›</span>
						{% else %}
							<span class="current">{{ breadcrumb.text }}</span>
						{% endif %}
					{% endfor %}
				</nav>
				<div class="account-hero-content">
					<div class="account-avatar">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<line x1="12" y1="1" x2="12" y2="23"/>
							<path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
						</svg>
					</div>
					<div>
						<h1 class="account-hero-title">{{ heading_title }}</h1>
						<p class="account-hero-sub">Histórico de créditos e débitos da conta</p>
					</div>
				</div>
			</div>
		</div>

		{# ── Wrapper ── #}
		<div class="account-wrapper">
		{# Card do saldo atual #}
		<div class="egen-login-card tx-summary-card">
			<div class="tx-summary-header">
				<div>
					<h2 class="egen-login-title tx-summary-title">{{ text_total }}</h2>
					<p class="tx-summary-amount">{{ total }}</p>
				</div>
				<i class="fas fa-coins tx-summary-icon"></i>
			</div>
		</div>

		{% if transactions %}
			<div class="egen-cart-main tx-table-card">
				<div class="egen-table-responsive">
					<table class="egen-cart-table tx-table">
						<thead>
							<tr>
								<th class="tx-th-left">{{ column_date_added }}</th>
								<th class="tx-th-left">{{ column_description }}</th>
								<th class="tx-th-right">{{ column_amount }}</th>
							</tr>
						</thead>
						<tbody>
							{% for transaction in transactions %}
								<tr>
									<td class="tx-td-date">{{ transaction.date_added }}</td>
									<td class="tx-td-desc">{{ transaction.description }}</td>
									<td class="{% if '-' in transaction.amount %}tx-td-amount-neg{% else %}tx-td-amount-pos{% endif %}">
										{{ transaction.amount }}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		{% else %}
			<div class="egen-empty-state tx-empty-container">
				<div class="egen-empty-state__icon tx-empty-icon-wrap">
					<i class="fas fa-wallet egen-empty-icon tx-empty-icon"></i>
				</div>
				<h2 class="egen-empty-state__title tx-empty-title">{{ text_no_results }}</h2>
				<p class="egen-empty-state__text tx-empty-desc">Qualquer crédito ou débito adicionado à sua conta será listado nesta página.</p>
			</div>
		{% endif %}

		<div class="tx-actions-footer">
			<a href="{{ continue }}" class="egen-btn egen-btn-primary">Voltar</a>
		</div>
	</div>
	</div>
	{# /#account-page #}
{% endblock %}
