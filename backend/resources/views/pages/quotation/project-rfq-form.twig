{% extends 'layouts/base.html.twig' %}

{% block title %}Solicitar Orçamento de Projeto (RFQ) | meusite{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/css/custom/quotation.css">
{% endblock %}

{% block content %}
    <div class="rfq-container">
        <div class="rfq-hero">
            <nav class="rfq-breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                    {% if not loop.last %}
                        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
                        <span>›</span>
                    {% else %}
                        <span>{{ breadcrumb.text }}</span>
                    {% endif %}
                {% endfor %}
            </nav>
            <h1 class="rfq-hero-title">
                <span>📋</span> Solicitar Orçamento de Projeto & Serviços (RFQ)
            </h1>
            <p class="rfq-hero-desc">Cadastre os dados e localização da sua obra para receber propostas de profissionais credenciados na sua região.</p>
        </div>

        {% if error %}
            <div style="background:#fee2e2; border:1px solid #ef4444; color:#991b1b; padding:1rem 1.25rem; border-radius:8px; margin-bottom:1.5rem;">
                {{ error }}
            </div>
        {% endif %}

        {% if pre_product %}
            <div style="background:#eff6ff; border:1px solid #3b82f6; color:#1e40af; padding:1rem 1.25rem; border-radius:8px; margin-bottom:1.5rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
                <div>
                    <strong>📦 Material Pré-Selecionado:</strong> {{ pre_product.name }} (Qtd: {{ pre_product.qty }})
                    <small style="display:block; color:#2563eb;">Este material será adicionado automaticamente ao levantamento técnico (BoQ) desta obra.</small>
                </div>
                <input type="hidden" name="pre_product_id" value="{{ pre_product.id }}">
                <input type="hidden" name="pre_qty" value="{{ pre_product.qty }}">
            </div>
        {% endif %}

        <div class="rfq-card">
            <form method="POST" action="/{{ lang }}/projetos/novo">
                <h2 style="font-size:1.3rem; margin-bottom:1.25rem; color:#1e293b;">1. Dados da Obra e Escopo</h2>
                <div class="rfq-form-grid">
                    <div class="rfq-form-group full-width">
                        <label class="rfq-label" for="title">Título do Projeto / Obra *</label>
                        <input type="text" id="title" name="title" class="rfq-input" placeholder="Ex: Reforma de banheiro com colocação de piso cerâmico" required>
                    </div>

                    <div class="rfq-form-group">
                        <label class="rfq-label" for="category">Categoria do Serviço *</label>
                        <select id="category" name="category" class="rfq-select" required>
                            <option value="revestimento">Pisos e Revestimentos</option>
                            <option value="pintura">Pintura e Acabamentos</option>
                            <option value="alvenaria">Alvenaria e Construção Geral</option>
                            <option value="eletrica">Instalações Elétricas</option>
                            <option value="hidraulica">Instalações Hidráulicas</option>
                            <option value="telhado">Coberturas e Telhados</option>
                        </select>
                    </div>

                    <div class="rfq-form-group">
                        <label class="rfq-label" for="budget_expectation">Expectativa de Orçamento (R$)</label>
                        <input type="number" step="0.01" id="budget_expectation" name="budget_expectation" class="rfq-input" placeholder="Ex: 3500.00">
                    </div>

                    <div class="rfq-form-group">
                        <label class="rfq-label" for="desired_deadline_days">Prazo Desejado de Conclusão (dias)</label>
                        <input type="number" id="desired_deadline_days" name="desired_deadline_days" class="rfq-input" value="30" min="1">
                    </div>

                    <div class="rfq-form-group full-width">
                        <label class="rfq-label" for="description">Descrição Detalhada do Serviço *</label>
                        <textarea id="description" name="description" class="rfq-textarea" rows="4" placeholder="Descreva as especificações, metragem estimada, estado atual do ambiente e materiais necessários..." required></textarea>
                    </div>
                </div>

                <h2 style="font-size:1.3rem; margin:2rem 0 1.25rem 0; color:#1e293b;">2. Localização da Obra (Para Matching por Raio)</h2>
                <div class="rfq-form-grid">
                    <div class="rfq-form-group">
                        <label class="rfq-label" for="address_cep">CEP da Obra *</label>
                        <input type="text" id="address_cep" name="address_cep" class="rfq-input" placeholder="00000-000" required>
                    </div>

                    <div class="rfq-form-group">
                        <label class="rfq-label" for="address_city">Cidade *</label>
                        <input type="text" id="address_city" name="address_city" class="rfq-input" placeholder="Ex: São Paulo" required>
                    </div>

                    <div class="rfq-form-group">
                        <label class="rfq-label" for="address_state">UF (Estado) *</label>
                        <input type="text" id="address_state" name="address_state" class="rfq-input" maxlength="2" placeholder="SP" value="SP" required>
                    </div>

                    <div class="rfq-form-group">
                        <label class="rfq-label" for="address_neighborhood">Bairro</label>
                        <input type="text" id="address_neighborhood" name="address_neighborhood" class="rfq-input" placeholder="Bairro">
                    </div>

                    <div class="rfq-form-group full-width">
                        <label class="rfq-label" for="address_street">Logradouro e Número</label>
                        <input type="text" id="address_street" name="address_street" class="rfq-input" placeholder="Rua / Avenida, Número e Complemento">
                    </div>
                </div>

                <div style="display:flex; justify-content:flex-end; gap:1rem; margin-top:2rem;">
                    <a href="/{{ lang }}/account/projetos" class="rfq-btn rfq-btn-secondary">Cancelar</a>
                    <button type="submit" class="rfq-btn rfq-btn-primary">
                        <span>🚀</span> Publicar Pedido de Orçamento
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
