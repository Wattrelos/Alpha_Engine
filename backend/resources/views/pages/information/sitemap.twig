{% extends 'layouts/base.html.twig' %}

{% block title %}
	{{ Sitemap.headingTitle|default(seo.title)|default('Mapa do Site') }} | AgSonhos
{% endblock %}

{% block content %}
	<div id="information-sitemap" class="egen-sitemap-page">
		<div
			class="egen-sitemap-container">

			{# ── Breadcrumbs ── #}
			<nav class="egen-sitemap-breadcrumb" aria-label="Navegação">
				{% for breadcrumb in breadcrumbs %}
					{% if not loop.last %}
						<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
						<span class="sep">›</span>
					{% else %}
						<span class="current">{{ breadcrumb.text }}</span>
					{% endif %}
				{% endfor %}
			</nav>

			<div class="egen-sitemap-hero">
				<div class="egen-sitemap-icon">
					<svg width="28" height="28" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
						<polyline points="2 17 12 22 22 17"></polyline>
						<polyline points="2 12 12 17 22 12"></polyline>
					</svg>
				</div>
				<div>
					<h1 class="egen-sitemap-title">{{ Sitemap.headingTitle }}</h1>
					<p class="egen-sitemap-subtitle">{{ Sitemap.subtitle }}</p>
				</div>
			</div>

			<div class="egen-sitemap-content-wrapper">
				{{ column_left }}

				<div id="content" class="egen-sitemap-main">
					{{ content_top }}

					<div
						class="egen-sitemap-grid">

						{# ── Coluna 1: Categorias ── #}
						<div class="egen-sitemap-card">
							<h2 class="egen-sitemap-card-title">
								<svg width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
								</svg>
								{{ Sitemap.departmentsTitle }}
							</h2>
							<ul class="egen-sitemap-list">
								{% for category_1 in categories %}
									<li class="egen-sitemap-item depth-1">
										<a href="{{ category_1.href }}">{{ category_1.name }}</a>
										{% if category_1.children %}
											<ul class="egen-sitemap-sublist">
												{% for category_2 in category_1.children %}
													<li class="egen-sitemap-item depth-2">
														<a href="{{ category_2.href }}">{{ category_2.name }}</a>
														{% if category_2.children %}
															<ul class="egen-sitemap-sublist-3">
																{% for category_3 in category_2.children %}
																	<li class="egen-sitemap-item depth-3">
																		<a href="{{ category_3.href }}">{{ category_3.name }}</a>
																	</li>
																{% endfor %}
															</ul>
														{% endif %}
													</li>
												{% endfor %}
											</ul>
										{% endif %}
									</li>
								{% endfor %}
							</ul>
						</div>

						{# ── Coluna 2: Páginas e Conta ── #}
						<div class="egen-sitemap-card">
							<h2 class="egen-sitemap-card-title">
								<svg width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
									<circle cx="12" cy="7" r="4"></circle>
								</svg>
								{{ Sitemap.pagesTitle }}
							</h2>
							<ul class="egen-sitemap-list">
								<li class="egen-sitemap-item depth-1">
									<a href="{{ special }}">{{ Sitemap.textSpecial }}</a>
								</li>
								<li class="egen-sitemap-item depth-1">
									<a href="{{ account }}">{{ Sitemap.textAccount }}</a>
									<ul class="egen-sitemap-sublist">
										<li class="egen-sitemap-item depth-2">
											<a href="{{ edit }}">{{ Sitemap.textEdit }}</a>
										</li>
										<li class="egen-sitemap-item depth-2">
											<a href="{{ password }}">{{ Sitemap.textPassword }}</a>
										</li>
										<li class="egen-sitemap-item depth-2">
											<a href="{{ address }}">{{ Sitemap.textAddress }}</a>
										</li>
										<li class="egen-sitemap-item depth-2">
											<a href="{{ history }}">{{ Sitemap.textHistory }}</a>
										</li>
									</ul>
								</li>
								<li class="egen-sitemap-item depth-1">
									<a href="{{ cart }}">{{ Sitemap.textCart }}</a>
								</li>
								<li class="egen-sitemap-item depth-1">
									<a href="{{ checkout }}">{{ Sitemap.textCheckout }}</a>
								</li>
								<li class="egen-sitemap-item depth-1">
									<a href="{{ search }}">{{ Sitemap.textSearch }}</a>
								</li>
								<li class="egen-sitemap-item depth-1 has-children">
									<span class="egen-sitemap-label">{{ Sitemap.textInformation }}</span>
									<ul class="egen-sitemap-sublist">
										{% for information in informations %}
											<li class="egen-sitemap-item depth-2">
												<a href="{{ information.href }}">{{ information.title }}</a>
											</li>
										{% endfor %}
										<li class="egen-sitemap-item depth-2">
											<a href="{{ contact }}">{{ Sitemap.textContact }}</a>
										</li>
									</ul>
								</li>
							</ul>
						</div>

					</div>

					{{ content_bottom }}
				</div>

				{{ column_right }}
			</div>
		</div>
	</div>

{% endblock %}
