{% extends 'layouts/base.html.twig' %}

{% block title %}
	{{ seo.title }}
{% endblock %}

{% block content %}
	<div id="egen-category-page" class="egen-search-page">

		{# ── Hero / Cabeçalho da Busca ── #}
		<div class="egen-cat-hero">
			<div class="egen-cat-hero-inner">
				{# Breadcrumb #}
				<nav class="egen-cat-breadcrumb" aria-label="Navegação">
					<a href="{{ url_for('home', {'lang': lang}) }}">{{ Search.breadcrumbHome }}</a>
					<span class="sep">›</span>
					<span class="current">{{ Search.breadcrumbSearch }}</span>
				</nav>

				<h1 class="egen-cat-hero-title">{{ Search.headingTitle }}</h1>

				{# Formulário de busca interno na página #}
				<div class="egen-search-form-container search-form-wrap">
					<form action="{{ url_for('search', {'lang': lang}) }}" method="GET" class="egen-search-page-form search-form-row">
						<input 
							type="text" 
							name="busca" 
							value="{{ term }}" 
							placeholder="{{ Search.searchPlaceholder }}" 
							class="egen-form-input search-input-field" 
							required
						>
						<button 
							type="submit" 
							class="egen-btn-primary search-submit-btn" 
						>
							{{ Search.buttonSearch }}
						</button>
					</form>
				</div>

				{# Contagem de produtos #}
				{% if search_data.products %}
					<div class="egen-cat-hero-count search-sub-title">
						<span class="egen-count-badge">
							{{ search_data.product_total }} {{ search_data.product_total != 1 ? Search.textProductPlural : Search.textProductSingular }} {{ search_data.product_total != 1 ? Search.textFoundPlural : Search.textFoundSingular }}
						</span>
					</div>
				{% endif %}
			</div>
		</div>

		<div class="egen-cat-wrapper">

			{% if search_data.products %}
				{# ── Barra de Filtros / Ordenação ── #}
				<div class="egen-cat-toolbar">
					<div class="egen-cat-toolbar-info">
						{{ Search.textResultFor }} "<strong>{{ term }}</strong>": {{ Search.textShowing }} <strong>{{ search_data.products|length }}</strong> {{ Search.textOf }} <strong>{{ search_data.product_total }}</strong> {{ search_data.product_total != 1 ? Search.textProductPlural : Search.textProductSingular }}
					</div>
					<div class="egen-cat-toolbar-controls">
						<div class="egen-cat-select-wrap">
							<label for="select-sort">{{ Search.textSort }}</label>
							<select id="select-sort" class="egen-cat-select" onchange="location = this.value;">
								{% for option in search_data.sorts %}
									<option value="{{ option.href }}" {% if option.value == search_data.sort ~ '-' ~ search_data.order %} selected {% endif %}>{{ option.text }}</option>
								{% endfor %}
							</select>
							<svg class="egen-cat-select-arrow" width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
						</div>
						<div class="egen-cat-select-wrap">
							<label for="select-limit">{{ Search.textLimit }}</label>
							<select id="select-limit" class="egen-cat-select" onchange="location = this.value;">
								{% for option in search_data.limits %}
									<option value="{{ option.href }}" {% if option.value == search_data.limit %} selected {% endif %}>{{ option.text }}</option>
								{% endfor %}
							</select>
							<svg class="egen-cat-select-arrow" width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
						</div>
					</div>
				</div>

				<div class="egen-category-layout">
					{# Filtros para faixa de preços, fabricantes, categorias... #}
					{% include 'components/organisms/aside_filters.html.twig' %}

					<div class="egen-category-main">
						{# ── Grade de Produtos ── #}
						<div class="egen-cat-grid" id="products-grid">
							{% for prod in search_data.products %}
								{% include 'pages/product/product-card.html.twig' with {'prod': prod} %}
							{% endfor %}
						</div>

						{# ── Paginação ── #}
						{% include 'components/molecules/pagination.html.twig' with {
							'total': search_data.product_total,
							'limit': search_data.limit,
							'current_page': search_data.pagination.page,
							'url': search_data.pagination.url
						} %}
					</div>
				</div>

			{% else %}
				{# ── Estado vazio ── #}
				<div class="egen-cat-empty search-empty-box">
					<div class="egen-cat-empty-icon search-empty-icon">🔍</div>
					<h2 class="egen-cat-empty-title search-empty-h2">{{ Search.textNoResults }}</h2>
					<p class="egen-cat-empty-desc search-empty-p">{{ Search.textEmptyDesc|format(term) }}</p>
				</div>
			{% endif %}

		</div>
	</div>
{% endblock %}
