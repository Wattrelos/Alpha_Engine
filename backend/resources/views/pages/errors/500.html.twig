{% extends 'layouts/base.html.twig' %}

{% block title %}{{ title|default('Erro Interno no Servidor | meusite') }}{% endblock %}

{% block content %}
    <div class="error-card">
        <div class="error-emoji">⚙️</div>
        <h1 class="error-title">Erro Interno no Servidor</h1>
        <p class="error-desc">
            Ocorreu um problema inesperado ao processar sua requisição. Nossa equipe já foi notificada e estamos trabalhando na solução.
        </p>
        <a href="/" class="error-btn">
            Voltar para a Página Inicial
        </a>
    </div>
{% endblock %}
