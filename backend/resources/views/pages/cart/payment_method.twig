<!-- Método de Pagamento -->
<div class="egen-payment-method-selection">
	<div class="egen-form-group">
		<label class="egen-form-label">Selecione o método de pagamento:</label>
		
		<div class="egen-payment-methods-grid">
			<label class="egen-payment-method-card active">
				<input type="radio" name="payment_method" value="cod" checked class="egen-payment-method-radio">
				<div class="egen-payment-method-card-content">
					<i class="fa-solid fa-handshake-angle"></i>
					<div>
						<span class="egen-payment-method-name">Pagar na Entrega</span>
						<span class="egen-payment-method-desc">Pague em dinheiro ou cartão ao receber seu pedido.</span>
					</div>
				</div>
			</label>

			<label class="egen-payment-method-card">
				<input type="radio" name="payment_method" value="transferencia" class="egen-payment-method-radio">
				<div class="egen-payment-method-card-content">
					<i class="fa-solid fa-bank"></i>
					<div>
						<span class="egen-payment-method-name">Transferência Bancária</span>
						<span class="egen-payment-method-desc">Realize a transferência e envie o comprovante.</span>
					</div>
				</div>
			</label>

			<label class="egen-payment-method-card">
				<input type="radio" name="payment_method" value="pix" class="egen-payment-method-radio">
				<div class="egen-payment-method-card-content">
					<i class="fa-solid fa-qrcode"></i>
					<div>
						<span class="egen-payment-method-name">Pix</span>
						<span class="egen-payment-method-desc">Aprovação imediata do seu pagamento.</span>
					</div>
				</div>
			</label>

			<label class="egen-payment-method-card">
				<input type="radio" name="payment_method" value="link_pagamento" class="egen-payment-method-radio">
				<div class="egen-payment-method-card-content">
					<i class="fa-solid fa-link"></i>
					<div>
						<span class="egen-payment-method-name">Gerar Link de Pagamento</span>
						<span class="egen-payment-method-desc">Enviaremos um link seguro para pagar online.</span>
					</div>
				</div>
			</label>
		</div>
	</div>

	<div class="egen-form-group egen-payment-note-group">
		<label for="payment_note" class="egen-form-label">Observações sobre o pedido / entrega (opcional)</label>
		<textarea name="payment_note" id="payment_note" class="egen-form-input" rows="3" placeholder="Caso queira, escreva aqui pontos de referência ou observações adicionais."></textarea>
	</div>
</div>
