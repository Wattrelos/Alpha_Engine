{% extends "layouts/base.html.twig" %}

{% block title %}
	{{ Checkout.headingTitle|default(Checkout.buttonConfirm|default('Finalizar Compra')) }}
	| AgSonhos
{% endblock %}

{% block breadcrumbs %}
	<div class="egen-page-header">
		<div class="egen-page-header__inner">
			{% include 'components/molecules/breadcrumbs.twig' with { items: breadcrumbs } %}
		</div>
	</div>
{% endblock %}

{% block content %}
	<div class="egen-checkout-page">
		<div class="egen-checkout-container">
			<h1 class="egen-checkout-title">{{ Checkout.headingTitle|default(Checkout.buttonConfirm|default('Finalizar Compra')) }}</h1>

			{% if error_warning %}
				<div class="egen-alert egen-alert--danger">
					<i class="fa-solid fa-circle-exclamation"></i>
					{{ error_warning }}
				</div>
			{% endif %}

			<!-- Indicador de Progresso das Etapas -->
			<div class="egen-checkout-progress" id="checkout-progress-bar">
				<div class="egen-checkout-progress__line"></div>
				<div class="egen-checkout-progress__step active" data-progress-step="1">
					<div class="egen-checkout-progress__circle">1</div>
					<span class="egen-checkout-progress__label">{{ Checkout.step1Label|default('Identificação') }}</span>
				</div>
				<div class="egen-checkout-progress__step" data-progress-step="2">
					<div class="egen-checkout-progress__circle">2</div>
					<span class="egen-checkout-progress__label">{{ Checkout.step2Label|default('Endereço de entrega') }}</span>
				</div>
{#
				<div class="egen-checkout-progress__step" data-progress-step="3">
					<div class="egen-checkout-progress__circle">3</div>
					<span class="egen-checkout-progress__label">{{ Checkout.step3Label|default('Cálculo de frete') }}</span>
				</div>
#}
				<div class="egen-checkout-progress__step" data-progress-step="4">
					<div class="egen-checkout-progress__circle">4</div>
					<span class="egen-checkout-progress__label">{{ Checkout.step4Label|default('Pagamento') }}</span>
				</div>
			</div>

			<form
				action="{{ action }}" method="post" enctype="multipart/form-data" class="egen-checkout-form" id="checkout-main-form" novalidate>
				{% if csrf %}
					<input type="hidden" name="{{ csrf.keys.name }}" value="{{ csrf.name }}">
					<input type="hidden" name="{{ csrf.keys.value }}" value="{{ csrf.value }}">
				{% endif %}

				<!-- Etapas do Checkout -->
				<div
					class="egen-checkout-steps" id="checkout-steps">

					<!-- 1. Identificação -->
					<div class="egen-checkout-step active" data-step="1" id="step-identity">
						<h2 class="egen-checkout-step-title">
							<i class="fa-solid fa-user"></i>
							<span>{{ Checkout.step1Title|default('Identificação') }}</span>
						</h2>

						<div
							class="egen-checkout-step-content">
							<!-- Botões de login/cadastro -->
							<div class="egen-checkout-identity-options">
								<button type="button" class="egen-btn-secondary" data-checkout-action="login">
									<i class="fa-solid fa-right-to-bracket"></i>
									{{ Checkout.buttonLoginChoice|default('Já tenho conta') }}
								</button>
								<button type="button" class="egen-btn-secondary" data-checkout-action="guest">
									<i class="fa-solid fa-user-plus"></i>
									{{ Checkout.buttonGuestChoice|default('Comprar como visitante') }}
								</button>
								<button type="button" class="egen-btn-secondary" data-checkout-action="register">
									<i class="fa-solid fa-user-tie"></i>
									{{ Checkout.buttonRegisterChoice|default('Quero me cadastrar') }}
								</button>
							</div>

							<!-- Formulário de Login -->
							<div id="checkout-login-form" class="egen-checkout-form-hidden">
								<div class="egen-form-group">
									<label for="login-email" class="egen-form-label">{{ Checkout.entryEmail|default('E-mail') }}
										<span class="text-danger">*</span>
									</label>
									<input type="email" name="login[email]" value="{{ login_email }}" placeholder="{{ Checkout.entryEmail|default('E-mail') }}" id="login-email" class="egen-form-input" data-required="true"/>
								</div>
								<div class="egen-form-group">
									<label for="login-password" class="egen-form-label">{{ Checkout.entryPassword|default('Senha') }}
										<span class="text-danger">*</span>
									</label>
									<input type="password" name="login[password]" value="" placeholder="{{ Checkout.entryPassword|default('Senha') }}" id="login-password" class="egen-form-input" data-required="true" autocomplete="current-password"/>
								</div>
								<button type="button" id="login-button" class="egen-btn-primary">
									<i class="fa-solid fa-arrow-right-to-bracket"></i>
									{{ Checkout.buttonLogin|default('Acessar') }}
								</button>
								<a href="{{ forgotten }}" class="egen-link-forgotten">{{ Checkout.textForgotten|default('Solicitar nova senha') }}</a>
							</div>

							<!-- Formulário de Cadastro -->
							<div id="checkout-register-form" class="egen-checkout-form-hidden">
								<div class="egen-form-row">
									<div class="egen-form-group">
										<label for="register-firstname" class="egen-form-label">{{ Checkout.entryFirstname|default('Nome') }}
											<span class="text-danger">*</span>
										</label>
										<input type="text" name="register[firstname]" value="{{ register_firstname }}" placeholder="{{ Checkout.entryFirstname|default('Nome') }}" id="register-firstname" class="egen-form-input" data-required="true"/>
									</div>
									<div class="egen-form-group">
										<label for="register-lastname" class="egen-form-label">{{ Checkout.entryLastname|default('Sobrenome') }}
											<span class="text-danger">*</span>
										</label>
										<input type="text" name="register[lastname]" value="{{ register_lastname }}" placeholder="{{ Checkout.entryLastname|default('Sobrenome') }}" id="register-lastname" class="egen-form-input" data-required="true"/>
									</div>
								</div>
								<div class="egen-form-row">
									<div class="egen-form-group">
										<label for="register-email" class="egen-form-label">{{ Checkout.entryEmail|default('E-mail') }}
											<span class="text-danger">*</span>
										</label>
										<input type="email" name="register[email]" value="{{ register_email }}" placeholder="{{ Checkout.entryEmail|default('E-mail') }}" id="register-email" class="egen-form-input" data-required="true"/>
									</div>
									<div class="egen-form-group">
										<label for="register-telephone" class="egen-form-label">{{ Checkout.entryTelephone|default('Telefone') }}
											<span class="text-danger">*</span>
										</label>
										<input type="tel" name="register[telephone]" value="{{ register_telephone }}" placeholder="{{ Checkout.entryTelephone|default('Telefone') }}" id="register-telephone" class="egen-form-input" data-required="true"/>
									</div>
								</div>
								<div class="egen-form-row">
									<div class="egen-form-group">
										<label for="register-password" class="egen-form-label">{{ Checkout.entryPassword|default('Senha') }}
											<span class="text-danger">*</span>
										</label>
										<input type="password" name="register[password]" value="{{ register_password }}" placeholder="{{ Checkout.entryPassword|default('Senha') }}" id="register-password" class="egen-form-input" data-required="true" autocomplete="new-password"/>
									</div>
									<div class="egen-form-group">
										<label for="register-confirm" class="egen-form-label">{{ Checkout.entryConfirm|default('Confirmar Senha') }}
											<span class="text-danger">*</span>
										</label>
										<input type="password" name="register[confirm]" value="{{ register_confirm }}" placeholder="{{ Checkout.entryConfirm|default('Confirmar Senha') }}" id="register-confirm" class="egen-form-input" data-required="true" autocomplete="new-password"/>
									</div>
								</div>
							</div>

							<div class="egen-checkout-step-nav">
								<button type="button" class="egen-btn-primary" data-checkout-nav="next">
									{{ Checkout.buttonContinue|default('Continuar') }}
									<i class="fa-solid fa-arrow-right"></i>
								</button>
							</div>
						</div>
					</div>

					<!-- 2. Endereço de Cobrança -->
					<div class="egen-checkout-step" data-step="2" id="step-billing">
						<h2 class="egen-checkout-step-title">
							<i class="fa-solid fa-location-dot"></i>
							<span>{{ Checkout.step2Title|default('Endereço de entrega') }}</span>
						</h2>
						<div class="egen-checkout-step-content">
							<!-- Opções de endereço -->
							<div class="egen-checkout-address-options">
								<button type="button" class="egen-btn-secondary" data-checkout-action="same-address">
									<i class="fa-solid fa-user-check"></i>
									{{ Checkout.buttonSameAddress|default('Entregar no endereço de cobrança') }}
								</button>
								<button type="button" class="egen-btn-secondary" data-checkout-action="different-address">
									<i class="fa-solid fa-user-pen"></i>
									{{ Checkout.buttonDifferentAddress|default('Entregar em outro endereço') }}
								</button>
							</div>

							<!-- Formulário de Endereço de Cobrança -->
							<div id="checkout-billing-address" class="egen-checkout-form-hidden">
								<div class="egen-form-grid-premium">
									<div class="egen-form-group-premium">
										<label for="input-payment-firstname" class="egen-form-label-premium">{{ Checkout.entryFirstname|default('Nome') }}
											<span class="text-danger">*</span>
										</label>
										<input type="text" name="payment_firstname" value="{{ payment_firstname }}" placeholder="{{ Checkout.entryFirstname|default('Nome') }}" id="input-payment-firstname" class="egen-form-input-premium" data-required="true"/>
									</div>
									<div class="egen-form-group-premium">
										<label for="input-payment-lastname" class="egen-form-label-premium">{{ Checkout.entryLastname|default('Sobrenome') }}
											<span class="text-danger">*</span>
										</label>
										<input type="text" name="payment_lastname" value="{{ payment_lastname }}" placeholder="{{ Checkout.entryLastname|default('Sobrenome') }}" id="input-payment-lastname" class="egen-form-input-premium" data-required="true"/>
									</div>
								</div>

								<div class="egen-form-grid-premium">
									<div class="egen-form-group-premium">
										<label for="input-payment-company" class="egen-form-label-premium">{{ Checkout.entryCompany|default('Destinatário') }}</label>
										<input type="text" name="payment_company" value="{{ payment_company }}" placeholder="{{ Checkout.entryCompany|default('Destinatário') }}" id="input-payment-company" class="egen-form-input-premium"/>
									</div>
								</div>

								<div class="egen-form-grid-premium">
									<div class="egen-form-group-premium">
										<label for="input-payment-postcode" class="egen-form-label-premium">{{ Checkout.entryPostcode|default('CEP') }}
											<span class="text-danger">*</span>
										</label>
										<input type="text" name="payment_postcode" value="{{ payment_postcode }}" placeholder="{{ Checkout.entryPostcode|default('CEP') }}" id="input-payment-postcode" class="egen-form-input-premium" data-required="true"/>
									</div>
									<div class="egen-form-group-premium">
										<label for="input-payment-address-1" class="egen-form-label-premium">{{ Checkout.entryAddress1|default('Endereço') }}
											<span class="text-danger">*</span>
										</label>
										<input type="text" name="payment_street" value="{{ payment_street }}" placeholder="{{ Checkout.entryAddress1|default('Endereço') }}" id="input-payment-address-1" class="egen-form-input-premium" data-required="true"/>
									</div>
								</div>

								<div class="egen-form-grid-premium">
									<div class="egen-form-group-premium">
										<label for="input-payment-number" class="egen-form-label-premium">{{ Checkout.entryNumber|default('Número') }}
											<span class="text-danger">*</span>
										</label>
										<input type="text" name="payment_number" value="{{ payment_number }}" placeholder="{{ Checkout.entryNumber|default('Número') }}" id="input-payment-number" class="egen-form-input-premium" data-required="true"/>
									</div>
									<div class="egen-form-group-premium">
										<label for="input-payment-address-2" class="egen-form-label-premium">{{ Checkout.entryAddress2|default('Número e complemento') }}</label>
										<input type="text" name="payment_complement" value="{{ payment_complement }}" placeholder="{{ Checkout.entryAddress2|default('Número e complemento') }}" id="input-payment-address-2" class="egen-form-input-premium"/>
									</div>
								</div>

								<div class="egen-form-grid-premium">
									<div class="egen-form-group-premium">
										<label for="input-payment-neighborhood" class="egen-form-label-premium">{{ Checkout.entryNeighborhood|default('Bairro') }}
											<span class="text-danger">*</span>
										</label>
										<input type="text" name="payment_neighborhood" value="{{ payment_neighborhood }}" placeholder="{{ Checkout.entryNeighborhood|default('Bairro') }}" id="input-payment-neighborhood" class="egen-form-input-premium" data-required="true"/>
									</div>
									<div class="egen-form-group-premium">
										<label for="input-payment-city" class="egen-form-label-premium">{{ Checkout.entryCity|default('Cidade') }}
											<span class="text-danger">*</span>
										</label>
										<input type="text" name="payment_city" value="{{ payment_city }}" placeholder="{{ Checkout.entryCity|default('Cidade') }}" id="input-payment-city" class="egen-form-input-premium" data-required="true"/>
									</div>
								</div>

								<div class="egen-form-grid-premium">
									<div class="egen-form-group-premium">
										<label for="input-payment-zone" class="egen-form-label-premium">
											{{ Checkout.entryZone|default('Estado') }}
											<span class="text-danger">*</span>
										</label>
										<input type="text" name="payment_zone_id" id="input-payment-zone" value="{{ payment_zone_id }}" placeholder="{{ Checkout.entryZone|default('Estado') }}" class="egen-form-input-premium" readonly data-required="true"/>
									</div>
									<div class="egen-form-group-premium">
										<label for="input-shipping-country" class="egen-form-label-premium">
											{{ entry_country|default('País') }}
											<span class="text-danger">*</span>
										</label>
										<div class="egen-select-wrapper-premium">
											<select name="shipping_country_id" id="input-shipping-country" class="egen-form-select-premium" data-required="true">
												{% for country in countries %}
													<option value="{{ country.id }}" {% if country.id == shipping_country_id %} selected {% endif %}>{{ country.name }}</option>
												{% endfor %}
											</select>
											<i class="fa-solid fa-chevron-down egen-select-arrow-premium"></i>
										</div>
									</div>
								</div>
							</div>
						</div>

						<div class="egen-checkout-step-nav">
							<button type="button" class="egen-btn-secondary" data-checkout-nav="prev">
								<i class="fa-solid fa-arrow-left"></i>
								{{ Common.button.back|default('Voltar') }}
							</button>
							<button type="button" class="egen-btn-primary" data-checkout-nav="next" id="btn-billing-next">
								{{ Checkout.buttonNext|default('Avançar') }}
								<i class="fa-solid fa-arrow-right"></i>
							</button>
						</div>
					</div>
				</div>

				<!-- 3. Endereço de Entrega -->
				<div class="egen-checkout-step" data-step="3" id="step-shipping">
					<h2 class="egen-checkout-step-title">
						<i class="fa-solid fa-truck-fast"></i>
						<span>{{ Checkout.step3Title|default('Dados de Entrega') }}</span>
					</h2>
					<div class="egen-checkout-step-content">
						{% include 'pages/cart/shipping-address.twig' %}

						<div class="egen-checkout-step-nav">
							<button type="button" class="egen-btn-secondary" data-checkout-nav="prev">
								<i class="fa-solid fa-arrow-left"></i>
								{{ Common.button.back|default('Voltar') }}
							</button>
							<button type="button" class="egen-btn-primary" data-checkout-nav="next" id="btn-shipping-next">
								{{ Checkout.buttonNext|default('Avançar') }}
								<i class="fa-solid fa-arrow-right"></i>
							</button>
						</div>
					</div>
				</div>
				<!-- 4. Método de Pagamento -->
				<div class="egen-checkout-step" data-step="4" id="step-payment-method">
					<h2 class="egen-checkout-step-title">
						<i class="fa-solid fa-credit-card"></i>
						<span>{{ Checkout.step4Title|default('Método de Pagamento') }}</span>
					</h2>
					<div class="egen-checkout-step-content">
						{% include 'pages/cart/payment_method.twig' %}

						<div class="egen-checkout-step-nav">
							<button type="button" class="egen-btn-secondary" data-checkout-nav="prev">
								<i class="fa-solid fa-arrow-left"></i>
								{{ Common.button.back|default('Voltar') }}
							</button>
							<button type="submit" class="egen-btn-primary" id="btn-submit-checkout">
								{{ Checkout.buttonConfirm|default('Finalizar Compra') }}
								<i class="fa-solid fa-check"></i>
							</button>
						</div>
					</div>
				</div>
			</div>
		</form>
	</div>
</div>
<script src="/js/custom/completePurchase.js"></script>
{% endblock %}
