{% set lang = lang|default('pt-br') %}

{# ── Estruturação de Arrays de Links ── #}

{# 1. Links de Informações Institucionais #}
{% set info_links = [] %}
{% if blog %}
  {% set info_links = info_links|merge([{ href: blog, label: Common.footer.blog|default('Blog') }]) %}
{% endif %}
{% for info in informations %}
  {% set info_links = info_links|merge([{ href: info.href, label: info.title }]) %}
{% endfor %}

{# 2. Links de Atendimento/Suporte #}
{% set service_links = [
  { href: contact|default(url('information/contact', {}, lang)), label: Common.footer.contact|default('Fale Conosco') },
  { href: return|default(url('account/return/add', {}, lang)), label: Common.footer.return|default('Devoluções') },
  { href: sitemap|default(url('information/sitemap', {}, lang)), label: Common.footer.sitemap|default('Mapa do Site') }
] %}

{# 3. Links Extras #}
{% set extra_links = [
  { href: manufacturer|default(url('product/manufacturer', {}, lang)), label: Common.footer.manufacturer|default('Marcas/Fabricantes') }
] %}
{% if affiliate %}
  {% set extra_links = extra_links|merge([{ href: affiliate|default(url('account/affiliate', {}, lang)), label: Common.footer.affiliate|default('Afiliados') }]) %}
{% endif %}
{% set extra_links = extra_links|merge([
  { href: special|default(url('product/special', {}, lang)), label: Common.footer.special|default('Ofertas Especiais') },
  { href: '/' ~ lang ~ '/prestador/oportunidades', label: 'Portal do Prestador' },
  { href: '/' ~ lang ~ '/projetos/novo', label: 'Orçar Projeto de Obra' }
]) %}

{# 4. Links de Minha Conta #}
{% set account_links = [
  { href: account|default(url('account', {}, lang)), label: Common.footer.account|default('Minha Conta') },
  { href: order|default(url('account/orders', {}, lang)), label: Common.footer.order|default('Histórico de Pedidos') },
  { href: wishlist|default(url('account/wishlist', {}, lang)), label: Common.footer.wishlist|default('Lista de Desejos') },
  { href: newsletter|default(url('account/newsletter', {}, lang)), label: Common.footer.newsletter|default('Informativo') }
] %}

<footer class="ag-footer">
  <div class="egen-footer__container">

    {# Grid de colunas do rodapé #}
    <div class="egen-footer__grid">

      {# Coluna Institucional — Logo, Resumo e Redes Sociais #}
      <div class="egen-footer__brand-col">
        <div class="egen-footer__brand">
          {% if store.logo %}
            <img src="{{ store.logo }}" alt="{{ store.name }}" class="egen-footer__logo">
          {% else %}
            <h3 class="egen-footer__brand-name">{{ store.name }}</h3>
          {% endif %}
        <p class="egen-footer-desc">
            A parceria ideal para a realização dos seus sonhos e da sua obra. Materiais de construção com qualidade, agilidade e o melhor preço.
          </p>
        </div>

        {# Redes Sociais #}
      <div class="egen-social-icons">
          <a href="{{ store.social.facebook }}" target="_blank" rel="noopener" title="Facebook" aria-label="Facebook"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i></a>
          <a href="{{ store.social.instagram }}" target="_blank" rel="noopener" title="Instagram" aria-label="Instagram"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a>
          <a href="{{ store.social.youtube }}" target="_blank" rel="noopener" title="YouTube" aria-label="YouTube"><i class="fa-brands fa-youtube" aria-hidden="true"></i></a>
          <a href="{{ store.social.whatsapp }}" target="_blank" rel="noopener" title="WhatsApp" aria-label="WhatsApp"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i></a>
        </div>
      </div>

      {# Coluna 1: Informações (Molécula) #}
      {% if info_links is not empty %}
        {% include 'components/molecules/footer-column.twig' with {
          title: Common.footer.information|default('Informações'),
          links: info_links
        } %}
      {% endif %}

      {# Coluna 2: Atendimento (Molécula) #}
      {% include 'components/molecules/footer-column.twig' with {
        title: Common.footer.service|default('Atendimento'),
        links: service_links
      } %}

      {# Coluna 3: Extras (Molécula) #}
      {% include 'components/molecules/footer-column.twig' with {
        title: Common.footer.extra|default('Descubra'),
        links: extra_links
      } %}

      {# Coluna 4: Minha Conta (Molécula) #}
      {% include 'components/molecules/footer-column.twig' with {
        title: Common.footer.account|default('Minha Conta'),
        links: account_links
      } %}

    </div>{# /.egen-footer__grid #}
  </div>{# /.egen-footer__container #}

  {# Rodapé Inferior: Copyright e Formas de Pagamento #}
  <div class="ag-footer-bottom">
    <div class="egen-footer__container">
      <div class="egen-footer__bottom-row">

        <p class="ag-footer-bottom__copy">
          {{ Common.footer.powered|default(powered)|format('Alpha Engine', "now"|date("Y"))|raw }}
        </p>

        <div class="egen-payment-methods">
          <span class="egen-payment-methods__label">Formas de pagamento:</span>
          <i class="fa-brands fa-cc-visa fa-2x" title="Visa" aria-label="Visa"></i>
          <i class="fa-brands fa-cc-mastercard fa-2x" title="Mastercard" aria-label="Mastercard"></i>
          <i class="fa-solid fa-barcode fa-2x" title="Boleto Bancário" aria-label="Boleto Bancário"></i>
          <i class="fa-solid fa-money-bill-transfer fa-2x" title="Pix" aria-label="Pix"></i>
        </div>

      </div>
    </div>
  </div>
</footer>
