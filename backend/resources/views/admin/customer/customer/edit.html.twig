{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default((AdminLang.text_edit_title|default('Editar Cliente')) ~ ' | ' ~ (AdminLang.sidebar.title|default('Painel Administrativo'))) }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>{{ AdminLang.text_edit_title|default('Editar Cliente') }}</h2>
			<p class="page-subtitle">{{ AdminLang.text_edit_subtitle|default('Atualize as informações cadastrais e os endereços do cliente.') }}</p>
		</div>
		<a href="{{ admin_path }}/clientes" class="btn btn-secondary">
			<i class="fas fa-arrow-left"></i>
			<span>{{ AdminLang.button_back|default('Voltar para Lista') }}</span>
		</a>
	</div>

	{% if success %}
		<div class="alert-success-custom">
			{{ success }}
		</div>
	{% endif %}

	{% if error %}
		<div class="alert alert-danger">
			{{ error }}
		</div>
	{% endif %}

	{% if errors.warning %}
		<div class="alert alert-danger">
			{{ errors.warning }}
		</div>
	{% endif %}

	<!-- Navegação por Abas -->
	<div class="tab-nav">
		<button onclick="switchTab('general')" id="tab-btn-general" class="tab-button">
			<i class="fas fa-user-edit icon-mr-2"></i>
			{{ AdminLang.tab_general|default('Dados Gerais') }}
		</button>
		<button onclick="switchTab('addresses')" id="tab-btn-addresses" class="tab-button">
			<i class="fas fa-map-marked-alt icon-mr-2"></i>
			{{ AdminLang.tab_addresses|default('Endereços') }} ({{ addresses|length }})
		</button>
	</div>

	<!-- Conteúdo: Aba Dados Gerais -->
	<div id="tab-content-general" class="tab-content d-none">
		<div class="card card-large">
			<form action="{{ admin_path }}/clientes/{{ customer.id }}/editar" method="POST">
				{% if csrf %}
					<input type="hidden" name="{{ csrf.keys.name }}" value="{{ csrf.name }}">
					<input type="hidden" name="{{ csrf.keys.value }}" value="{{ csrf.value }}">
				{% endif %}
				<input type="hidden" name="action" value="save_profile" />
				
				{% include 'admin/customer/customer/_form.html.twig' %}

				<div class="form-actions">
					<a href="{{ admin_path }}/clientes" class="btn btn-secondary">{{ AdminLang.button_cancel|default('Cancelar') }}</a>
					<button type="submit" class="btn btn-primary">
						<i class="fas fa-save"></i>
						<span>{{ AdminLang.button_save_changes|default('Salvar Alterações') }}</span>
					</button>
				</div>
			</form>
		</div>
	</div>

	<!-- Conteúdo: Aba Endereços -->
	<div id="tab-content-addresses" class="tab-content d-none">
		<div class="card card-large">
			<div class="section-header">
				<h3 class="mb-0 text-dark">{{ AdminLang.title_addresses|default('Endereços Cadastrados') }}</h3>
				<a href="{{ admin_path }}/clientes/{{ customer.id }}/enderecos/criar" class="btn btn-primary btn-with-icon">
					<i class="fas fa-plus"></i>
					<span>{{ AdminLang.text_address_create|default('Adicionar Endereço') }}</span>
				</a>
			</div>
			
			{% if addresses %}
				<div class="grid-cards">
					{% for addr in addresses %}
						<div class="address-card {% if addr.default %}address-default{% endif %}">
							<div>
								{% if addr.default %}
									<span class="badge-primary">{{ AdminLang.text_default|default('Padrão') }}</span>
								{% endif %}
								<p class="mb-2 font-medium text-dark">{{ addr.firstname }} {{ addr.lastname }}</p>
								<p class="mb-1 text-muted text-sm">
									{{ addr.street }}, Nº {{ addr.number }} {% if addr.complement %}({{ addr.complement }}){% endif %}
								</p>
								<p class="mb-1 text-muted text-sm">
									{{ addr.neighborhood }} - {{ addr.city }}/{{ addr.zone_code }}
								</p>
								<p class="mb-0 text-muted text-xs">
									CEP: {{ addr.postcode }} | {{ addr.country }}
								</p>
							</div>
							
							<div class="address-card-actions">
								<a href="{{ admin_path }}/clientes/{{ customer.id }}/enderecos/{{ addr.address_id }}/editar" class="btn btn-primary btn-sm">
									<i class="fas fa-edit"></i>
									<span>{{ AdminLang.text_address_edit|default('Editar') }}</span>
								</a>
								
								<a href="{{ admin_path }}/clientes/{{ customer.id }}/enderecos/{{ addr.address_id }}/excluir" class="btn btn-danger btn-sm" onclick="return confirm('{{ AdminLang.text_address_confirm_delete|default('Deseja realmente excluir este endereço?')|escape('js') }}');">
									<i class="fas fa-trash-alt"></i>
									<span>{{ AdminLang.text_address_delete|default('Excluir') }}</span>
								</a>
							</div>
						</div>
					{% endfor %}
				</div>
			{% else %}
				<div class="empty-box">
					<i class="fas fa-map-marker-alt table-empty-icon"></i>
					{{ AdminLang.text_no_addresses|default('Nenhum endereço cadastrado para este cliente.') }}
				</div>
			{% endif %}
		</div>
	</div>

	<script>
		// Switcher de abas Twig / JS amigável
		function switchTab(tabName) {
			// Esconde todas as abas
			document.querySelectorAll('.tab-content').forEach(el => {
				el.classList.add('d-none');
				el.style.display = 'none';
			});
			// Remove classe de ativação dos botões
			document.querySelectorAll('.tab-button').forEach(el => {
				el.classList.remove('active');
			});

			// Mostra a aba selecionada
			const contentEl = document.getElementById('tab-content-' + tabName);
			if (contentEl) {
				contentEl.classList.remove('d-none');
				contentEl.style.display = 'block';
			}

			// Ativa o botão da aba selecionada
			const btnEl = document.getElementById('tab-btn-' + tabName);
			if (btnEl) {
				btnEl.classList.add('active');
			}

			// Atualiza a URL sem recarregar a página
			const url = new URL(window.location);
			url.searchParams.set('tab', tabName);
			window.history.pushState({}, '', url);
		}

		// Inicializa a aba correta com base no parâmetro 'tab' passado pelo PHP
		document.addEventListener('DOMContentLoaded', function() {
			switchTab('{{ tab }}');
		});
	</script>
{% endblock %}
