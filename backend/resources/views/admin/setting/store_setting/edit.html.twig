		.badge-custom { background: rgba(168, 85, 247, 0.15); color: #c084fc; font-size: 0.75rem; font-weight: 500; padding: 3px 8px; border-radius: 6px; border: 1px solid rgba(168, 85, 247, 0.3); }

		.card-inner { background: rgba(15, 23, 42, 0.4); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 1.5rem; }
