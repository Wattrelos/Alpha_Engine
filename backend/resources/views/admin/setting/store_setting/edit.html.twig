{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default((AdminLang.heading_title|default('Configurações da Loja')) ~ ' | ' ~ (AdminLang.sidebar.title|default('Painel Administrativo'))) }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>{{ AdminLang.heading_title|default('Configurações da Loja') }}</h2>
			<p class="page-subtitle">{{ AdminLang.text_subtitle|default('Gerencie as informações gerais, metadados SEO, imagens e redes sociais da sua loja.') }}</p>
		</div>
	</div>

	{% if success %}
		<div class="alert-success-custom">
			{{ success }}
		</div>
	{% endif %}

	{% if error %}
		<div class="alert alert-danger">
			{{ error }}
		</div>
	{% endif %}

	{% if errors.warning %}
		<div class="alert alert-danger">
			{{ errors.warning }}
		</div>
	{% endif %}

	<!-- Navegação por Abas -->
	<div class="tab-nav">
		<button onclick="switchTab('general')" id="tab-btn-general" class="tab-button">
			<i class="fas fa-store"></i>
			<span>{{ AdminLang.tab_general|default('Geral') }}</span>
		</button>
		<button onclick="switchTab('seo')" id="tab-btn-seo" class="tab-button">
			<i class="fas fa-search"></i>
			<span>{{ AdminLang.tab_seo|default('Metadados (SEO)') }}</span>
		</button>
		<button onclick="switchTab('images')" id="tab-btn-images" class="tab-button">
			<i class="fas fa-images"></i>
			<span>{{ AdminLang.tab_images|default('Imagens') }}</span>
		</button>
		<button type="button" onclick="switchTab('social')" id="tab-btn-social" class="tab-button">
			<i class="fas fa-share-alt"></i>
			<span>{{ AdminLang.tab_social|default('Redes Sociais') }}</span>
		</button>
		<button type="button" onclick="switchTab('information')" id="tab-btn-information" class="tab-button">
			<i class="fas fa-file-alt"></i>
			<span>{{ AdminLang.tab_information|default('Informações') }}</span>
		</button>
	</div>

	<div class="card card-large">
		<form action="{{ admin_path }}/configuracoes" method="POST" enctype="multipart/form-data">
			{% if csrf %}
				<input type="hidden" name="{{ csrf.keys.name }}" value="{{ csrf.name }}">
				<input type="hidden" name="{{ csrf.keys.value }}" value="{{ csrf.value }}">
			{% endif %}

			<!-- 1. Aba: Geral -->
			<div id="tab-content-general" class="tab-content d-none">
				<h3 class="section-title">{{ AdminLang.title_general|default('Informações da Loja') }}</h3>
				
				<div class="grid-2-cols grid-form-row">
					<div>
						<label for="config_name" class="form-label">{{ AdminLang.entry_name|default('Nome da Loja') }} *</label>
						<input type="text" id="config_name" name="config_name" class="form-control" value="{{ settings.config_name }}" required />
						{% if errors.config_name %}<div class="invalid-feedback">{{ errors.config_name }}</div>{% endif %}
					</div>
					<div>
						<label for="config_owner" class="form-label">{{ AdminLang.entry_owner|default('Proprietário da Loja') }} *</label>
						<input type="text" id="config_owner" name="config_owner" class="form-control" value="{{ settings.config_owner }}" required />
						{% if errors.config_owner %}<div class="invalid-feedback">{{ errors.config_owner }}</div>{% endif %}
					</div>
				</div>

				<div class="grid-2-cols grid-form-row">
					<div>
						<label for="config_email" class="form-label">{{ AdminLang.entry_email|default('E-mail de Contato') }} *</label>
						<input type="email" id="config_email" name="config_email" class="form-control" value="{{ settings.config_email }}" required />
						{% if errors.config_email %}<div class="invalid-feedback">{{ errors.config_email }}</div>{% endif %}
					</div>
					<div>
						<label for="config_telephone" class="form-label">{{ AdminLang.entry_telephone|default('Telefone de Contato') }} *</label>
						<input type="text" id="config_telephone" name="config_telephone" class="form-control" value="{{ settings.config_telephone }}" required />
						{% if errors.config_telephone %}<div class="invalid-feedback">{{ errors.config_telephone }}</div>{% endif %}
					</div>
				</div>

				<div class="mb-6">
					<label for="config_address" class="form-label">{{ AdminLang.entry_address|default('Endereço Físico') }} *</label>
					<textarea id="config_address" name="config_address" class="form-control" required>{{ settings.config_address }}</textarea>
					{% if errors.config_address %}<div class="invalid-feedback">{{ errors.config_address }}</div>{% endif %}
				</div>
			</div>

			<!-- 2. Aba: SEO -->
			<div id="tab-content-seo" class="tab-content d-none">
				<h3 class="section-title">{{ AdminLang.title_seo|default('Metadados da Loja (SEO)') }}</h3>
				
				<div class="mb-6">
					<label for="meta_title" class="form-label">{{ AdminLang.entry_meta_title|default('Meta Título') }} *</label>
					<input type="text" id="meta_title" name="meta_title" class="form-control" value="{{ meta_title }}" required />
					{% if errors.meta_title %}<div class="invalid-feedback">{{ errors.meta_title }}</div>{% endif %}
				</div>

				<div class="mb-6">
					<label for="meta_description" class="form-label">{{ AdminLang.entry_meta_description|default('Meta Descrição') }}</label>
					<textarea id="meta_description" name="meta_description" class="form-control">{{ meta_description }}</textarea>
				</div>

				<div class="mb-6">
					<label for="meta_keyword" class="form-label">{{ AdminLang.entry_meta_keyword|default('Meta Palavras-chave') }}</label>
					<textarea id="meta_keyword" name="meta_keyword" class="form-control" placeholder="{{ AdminLang.placeholder_meta_keyword|default('Separadas por vírgula...') }}">{{ meta_keyword }}</textarea>
				</div>
			</div>

			<!-- 3. Aba: Imagens -->
			<div id="tab-content-images" class="tab-content d-none">
				<h3 class="section-title">{{ AdminLang.title_images|default('Imagens e Logotipos') }}</h3>
				
				<div class="grid-images">
					<!-- Logotipo -->
					<div class="image-upload-card">
						<div class="text-center w-100">
							<h4 class="image-upload-title">{{ AdminLang.entry_logo|default('Logotipo da Loja') }}</h4>
							<div class="image-preview-container">
								{% if logo_url %}
									<img src="{{ logo_url }}" alt="Logotipo Atual" class="image-preview-logo" id="logo-preview" />
								{% else %}
									<span class="image-preview-placeholder" id="logo-preview-placeholder">{{ AdminLang.text_no_logo|default('Nenhum logotipo enviado') }}</span>
								{% endif %}
							</div>
						</div>
						<div class="w-100">
							<input type="file" id="config_logo" name="config_logo" accept="image/*" class="d-none" onchange="previewImage(this, 'logo-preview')" />
							<label for="config_logo" class="btn btn-primary btn-upload">
								<i class="fas fa-upload"></i> {{ AdminLang.button_upload_logo|default('Enviar Logotipo') }}
							</label>
							{% if settings.config_logo %}
								<div class="remove-image-wrapper">
									<input type="checkbox" name="remove_logo" id="remove_logo" value="1" class="remove-image-checkbox" />
									<label for="remove_logo" class="remove-image-label">{{ AdminLang.text_remove_logo|default('Remover logotipo atual') }}</label>
								</div>
							{% endif %}
							{% if errors.config_logo %}<div class="invalid-feedback">{{ errors.config_logo }}</div>{% endif %}
						</div>
					</div>

					<!-- Favicon / Ícone -->
					<div class="image-upload-card">
						<div class="text-center w-100">
							<h4 class="image-upload-title">{{ AdminLang.entry_icon|default('Ícone da Loja (Favicon)') }}</h4>
							<div class="image-preview-container">
								{% if icon_url %}
									<img src="{{ icon_url }}" alt="Ícone Atual" class="image-preview-icon" id="icon-preview" />
								{% else %}
									<span class="image-preview-placeholder" id="icon-preview-placeholder">{{ AdminLang.text_no_icon|default('Nenhum ícone enviado') }}</span>
								{% endif %}
							</div>
						</div>
						<div class="w-100">
							<input type="file" id="config_icon" name="config_icon" accept="image/*" class="d-none" onchange="previewImage(this, 'icon-preview')" />
							<label for="config_icon" class="btn btn-primary btn-upload">
								<i class="fas fa-upload"></i> {{ AdminLang.button_upload_icon|default('Enviar Favicon') }}
							</label>
							{% if settings.config_icon %}
								<div class="remove-image-wrapper">
									<input type="checkbox" name="remove_icon" id="remove_icon" value="1" class="remove-image-checkbox" />
									<label for="remove_icon" class="remove-image-label">{{ AdminLang.text_remove_icon|default('Remover favicon atual') }}</label>
								</div>
							{% endif %}
							{% if errors.config_icon %}<div class="invalid-feedback">{{ errors.config_icon }}</div>{% endif %}
						</div>
					</div>
				</div>
			</div>

			<!-- 4. Aba: Redes Sociais -->
			<div id="tab-content-social" class="tab-content d-none">
				<h3 class="section-title">{{ AdminLang.title_social|default('Redes Sociais') }}</h3>
				
				<div class="mb-6">
					<label for="config_facebook" class="form-label">{{ AdminLang.entry_facebook|default('Página do Facebook') }}</label>
					<div class="input-group">
						<span class="input-group-addon"><i class="fab fa-facebook-f"></i></span>
						<input type="url" id="config_facebook" name="config_facebook" class="form-control input-group-control" value="{{ settings.config_facebook|default('https://facebook.com') }}" />
					</div>
				</div>

				<div class="mb-6">
					<label for="config_instagram" class="form-label">{{ AdminLang.entry_instagram|default('Perfil do Instagram') }}</label>
					<div class="input-group">
						<span class="input-group-addon"><i class="fab fa-instagram"></i></span>
						<input type="url" id="config_instagram" name="config_instagram" class="form-control input-group-control" value="{{ settings.config_instagram|default('https://instagram.com') }}" />
					</div>
				</div>

				<div class="mb-8">
					<label for="config_youtube" class="form-label">{{ AdminLang.entry_youtube|default('Canal do YouTube') }}</label>
					<div class="input-group">
						<span class="input-group-addon"><i class="fab fa-youtube"></i></span>
						<input type="url" id="config_youtube" name="config_youtube" class="form-control input-group-control" value="{{ settings.config_youtube|default('https://youtube.com') }}" />
					</div>
				</div>
			</div>

			<!-- 5. Aba: Informações (Páginas Institucionais) -->
			<div id="tab-content-information" class="tab-content d-none">
				<div class="info-header-bar">
					<div>
						<h3 class="section-title mb-1"><i class="fas fa-book-open text-primary"></i> Páginas Institucionais da Loja</h3>
						<p class="text-muted text-sm mb-0">Gerencie o conteúdo de Sobre Nós, Termos, Privacidade, Entregas ou crie novas páginas institucionais.</p>
					</div>
					<div class="header-actions-group store-setting-header-flex">
						<div class="lang-selector-box store-setting-badge-container">
							<label for="info_language_select" class="form-label mb-0 text-xs text-muted"><i class="fas fa-globe text-primary"></i> Idioma do Conteúdo:</label>
							<select id="info_language_select" name="info_language_id" class="form-control form-control-sm store-setting-small-btn" onchange="changeInformationLanguage(this.value)">
								{% for l in languages %}
									<option value="{{ l.id }}" {% if l.id == current_info_language_id %}selected{% endif %}>
										{{ l.name }} ({{ l.code|upper }})
									</option>
								{% endfor %}
							</select>
						</div>
						<button type="button" onclick="switchInfoSubTab('new')" class="btn btn-outline-primary btn-sm">
							<i class="fas fa-plus-circle"></i> Nova Página Institutional
						</button>
					</div>
				</div>

				<!-- Sub-navegação em Pílulas (Sub-tabs) -->
				<div class="info-subnav">
					{% for page in information_pages %}
						<button type="button" onclick="switchInfoSubTab('{{ page.id }}')" id="info-subtab-btn-{{ page.id }}" class="info-subtab-btn {% if loop.first %}active{% endif %}">
							<span>{{ page.title|default('Página #' ~ page.id) }}</span>
							{% if page.status == 1 %}
								<span class="badge badge-success-sub">Ativo</span>
							{% else %}
								<span class="badge badge-secondary-sub">Inativo</span>
							{% endif %}
						</button>
					{% endfor %}
					<button type="button" onclick="switchInfoSubTab('new')" id="info-subtab-btn-new" class="info-subtab-btn info-subtab-btn-add">
						<i class="fas fa-plus"></i> <span>Criar Nova</span>
					</button>
				</div>

				<!-- Painéis das Páginas Institucionais -->
				{% for page in information_pages %}
					<div id="info-subtab-content-{{ page.id }}" class="info-subtab-content {% if not loop.first %}d-none{% endif %}">
						<div class="card card-inner mb-6">
							<div class="info-card-header">
								<h4 class="font-semibold text-lg">
									<i class="fas fa-file-alt text-primary mr-2"></i> {{ page.title }}
									{% if page.id <= 4 %}
										<span class="badge badge-system ml-2">Página de Sistema</span>
									{% else %}
										<span class="badge badge-custom ml-2">Página Personalizada</span>
									{% endif %}
								</h4>
								{% if page.id > 4 %}
									<a href="{{ admin_path }}/configuracoes/informacoes/{{ page.id }}/excluir" class="btn btn-sm btn-danger-outline" onclick="return confirm('Tem certeza que deseja excluir a página {{ page.title }}? Esta ação não pode ser desfeita.');">
										<i class="fas fa-trash-alt"></i> Excluir Página
									</a>
								{% endif %}
							</div>

							<div class="grid-2-cols grid-form-row">
								<div>
									<label for="info_title_{{ page.id }}" class="form-label">Título da Página *</label>
									<input type="text" id="info_title_{{ page.id }}" name="information_pages[{{ page.id }}][title]" class="form-control" value="{{ page.title }}" required />
								</div>
								<div>
									<label for="info_keyword_{{ page.id }}" class="form-label">URL Amigável (Slug SEO)</label>
									<div class="input-group">
										<span class="input-group-addon text-xs">/pagina/</span>
										<input type="text" id="info_keyword_{{ page.id }}" name="information_pages[{{ page.id }}][keyword]" class="form-control input-group-control" value="{{ page.keyword }}" placeholder="ex: sobre-nos" />
									</div>
								</div>
							</div>

							<div class="grid-2-cols grid-form-row mb-6">
								<div>
									<label for="info_status_{{ page.id }}" class="form-label">Status de Exibição</label>
									<select id="info_status_{{ page.id }}" name="information_pages[{{ page.id }}][status]" class="form-control">
										<option value="1" {% if page.status == 1 %}selected{% endif %}>Habilitado (Visível no site)</option>
										<option value="0" {% if page.status == 0 %}selected{% endif %}>Desabilitado (Oculto)</option>
									</select>
								</div>
								<div>
									<label for="info_sort_{{ page.id }}" class="form-label">Ordem de Exibição (Rodapé)</label>
									<input type="number" id="info_sort_{{ page.id }}" name="information_pages[{{ page.id }}][sort_order]" class="form-control" value="{{ page.sort_order|default(0) }}" min="0" />
								</div>
							</div>

							<!-- Editor de Conteúdo com Live Preview -->
							<div class="mb-6">
								<div class="editor-header-tabs">
									<label class="form-label mb-0"><i class="fas fa-edit"></i> Conteúdo da Página (Markdown / HTML)</label>
									<div class="view-mode-buttons">
										<button type="button" onclick="setEditorView('{{ page.id }}', 'split')" id="btn-view-split-{{ page.id }}" class="editor-view-btn active">
											<i class="fas fa-columns"></i> Lado a Lado
										</button>
										<button type="button" onclick="setEditorView('{{ page.id }}', 'write')" id="btn-view-write-{{ page.id }}" class="editor-view-btn">
											<i class="fas fa-pen"></i> Apenas Editor
										</button>
										<button type="button" onclick="setEditorView('{{ page.id }}', 'preview')" id="btn-view-preview-{{ page.id }}" class="editor-view-btn">
											<i class="fas fa-eye"></i> Pré-visualizar
										</button>
									</div>
								</div>

								<div id="editor-container-{{ page.id }}" class="editor-split-container">
									<div id="editor-pane-write-{{ page.id }}" class="editor-pane">
										<textarea id="info_desc_{{ page.id }}" name="information_pages[{{ page.id }}][description]" class="form-control markdown-textarea" rows="14" oninput="renderMarkdownLive('{{ page.id }}')" placeholder="Escreva o conteúdo da página em Markdown ou HTML...">{{ page.description }}</textarea>
									</div>
									<div id="editor-pane-preview-{{ page.id }}" class="editor-pane preview-pane">
										<div class="preview-header"><i class="fas fa-desktop"></i> Pré-visualização ao Vivo</div>
										<div id="info_preview_{{ page.id }}" class="markdown-preview-body"></div>
									</div>
								</div>
							</div>

							<!-- Collapsible Metadados SEO -->
							<details class="seo-accordion">
								<summary class="seo-accordion-summary">
									<i class="fas fa-search-dollar text-primary mr-2"></i> Metadados SEO da Página (Opcional)
								</summary>
								<div class="seo-accordion-content">
									<div class="mb-4">
										<label for="info_meta_title_{{ page.id }}" class="form-label">Meta Título (SEO)</label>
										<input type="text" id="info_meta_title_{{ page.id }}" name="information_pages[{{ page.id }}][meta_title]" class="form-control" value="{{ page.meta_title }}" placeholder="Deixe em branco para usar o título principal" />
									</div>
									<div class="mb-4">
										<label for="info_meta_desc_{{ page.id }}" class="form-label">Meta Descrição</label>
										<textarea id="info_meta_desc_{{ page.id }}" name="information_pages[{{ page.id }}][meta_description]" class="form-control" rows="2">{{ page.meta_description }}</textarea>
									</div>
									<div>
										<label for="info_meta_key_{{ page.id }}" class="form-label">Meta Palavras-chave</label>
										<input type="text" id="info_meta_key_{{ page.id }}" name="information_pages[{{ page.id }}][meta_keyword]" class="form-control" value="{{ page.meta_keyword }}" placeholder="Separadas por vírgulas..." />
									</div>
								</div>
							</details>
						</div>
					</div>
				{% endfor %}

				<!-- Formulário para Criar Nova Página -->
				<div id="info-subtab-content-new" class="info-subtab-content d-none">
					<div class="card card-inner card-new-page mb-6">
						<div class="info-card-header">
							<h4 class="font-semibold text-lg text-primary">
								<i class="fas fa-plus-circle mr-2"></i> Criar Nova Página Institutional
							</h4>
						</div>

						<div class="grid-2-cols grid-form-row">
							<div>
								<label for="new_info_title" class="form-label">Título da Nova Página *</label>
								<input type="text" id="new_info_title" name="new_information[title]" class="form-control" placeholder="ex: Política de Trocas e Devoluções" />
							</div>
							<div>
								<label for="new_info_keyword" class="form-label">URL Amigável (Slug SEO)</label>
								<div class="input-group">
									<span class="input-group-addon text-xs">/pagina/</span>
									<input type="text" id="new_info_keyword" name="new_information[keyword]" class="form-control input-group-control" placeholder="ex: politica-de-trocas" />
								</div>
							</div>
						</div>

						<div class="grid-2-cols grid-form-row mb-6">
							<div>
								<label for="new_info_status" class="form-label">Status Inicial</label>
								<select id="new_info_status" name="new_information[status]" class="form-control">
									<option value="1" selected>Habilitado (Visível no site)</option>
									<option value="0">Desabilitado (Rascunho)</option>
								</select>
							</div>
							<div>
								<label for="new_info_sort" class="form-label">Ordem de Exibição</label>
								<input type="number" id="new_info_sort" name="new_information[sort_order]" class="form-control" value="10" min="0" />
							</div>
						</div>

						<!-- Editor de Conteúdo para Nova Página -->
						<div class="mb-6">
							<div class="editor-header-tabs">
								<label class="form-label mb-0"><i class="fas fa-edit"></i> Conteúdo em Markdown / HTML</label>
								<div class="view-mode-buttons">
									<button type="button" onclick="setEditorView('new', 'split')" id="btn-view-split-new" class="editor-view-btn active">
										<i class="fas fa-columns"></i> Lado a Lado
									</button>
									<button type="button" onclick="setEditorView('new', 'write')" id="btn-view-write-new" class="editor-view-btn">
										<i class="fas fa-pen"></i> Apenas Editor
									</button>
									<button type="button" onclick="setEditorView('new', 'preview')" id="btn-view-preview-new" class="editor-view-btn">
										<i class="fas fa-eye"></i> Pré-visualizar
									</button>
								</div>
							</div>

							<div id="editor-container-new" class="editor-split-container">
								<div id="editor-pane-write-new" class="editor-pane">
									<textarea id="info_desc_new" name="new_information[description]" class="form-control markdown-textarea" rows="12" oninput="renderMarkdownLive('new')" placeholder="Digite aqui o texto da nova página usando Markdown..."></textarea>
								</div>
								<div id="editor-pane-preview-new" class="editor-pane preview-pane">
									<div class="preview-header"><i class="fas fa-desktop"></i> Pré-visualização ao Vivo</div>
									<div id="info_preview_new" class="markdown-preview-body"></div>
								</div>
							</div>
						</div>

						<!-- Metadados SEO Nova Página -->
						<details class="seo-accordion">
							<summary class="seo-accordion-summary">
								<i class="fas fa-search-dollar text-primary mr-2"></i> Metadados SEO (Opcional)
							</summary>
							<div class="seo-accordion-content">
								<div class="mb-4">
									<label for="new_info_meta_title" class="form-label">Meta Título</label>
									<input type="text" id="new_info_meta_title" name="new_information[meta_title]" class="form-control" placeholder="Deixe em branco para usar o título principal" />
								</div>
								<div class="mb-4">
									<label for="new_info_meta_desc" class="form-label">Meta Descrição</label>
									<textarea id="new_info_meta_desc" name="new_information[meta_description]" class="form-control" rows="2"></textarea>
								</div>
								<div>
									<label for="new_info_meta_key" class="form-label">Meta Palavras-chave</label>
									<input type="text" id="new_info_meta_key" name="new_information[meta_keyword]" class="form-control" placeholder="Separadas por vírgulas..." />
								</div>
							</div>
						</details>
					</div>
				</div>
			</div>

			<!-- Campo oculto para preservar a aba ativa ao submeter -->
			<input type="hidden" name="active_tab" id="active_tab_field" value="general">

			<!-- Botões de Ação -->
			<div class="form-actions">
				<button type="submit" class="btn btn-primary btn-lg">
					<i class="fas fa-save"></i>
					<span>{{ AdminLang.button_save|default('Salvar Configurações') }}</span>
				</button>
			</div>
		</form>
	</div>

