	<script>
		// Switcher de abas principais
		function switchTab(tabName) {
			document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
			document.querySelectorAll('.tab-button').forEach(el => el.classList.remove('active'));

			const contentEl = document.getElementById('tab-content-' + tabName);
			if (contentEl) {
				contentEl.style.display = 'block';
			}

			const btnEl = document.getElementById('tab-btn-' + tabName);
			if (btnEl) {
				btnEl.classList.add('active');
			}

			const activeTabField = document.getElementById('active_tab_field');
			if (activeTabField) {
				activeTabField.value = tabName;
			}

			const url = new URL(window.location);
			url.searchParams.set('tab', tabName);
			window.history.pushState({}, '', url);
		}

		// Alternador de Idioma das Páginas Institucionais
		function changeInformationLanguage(langId) {
			const activeTab = document.getElementById('active_tab_field')?.value || 'information';
			const url = new URL(window.location);
			url.searchParams.set('tab', activeTab);
			url.searchParams.set('lang_id', langId);
			window.location.href = url.toString();
		}

		// Switcher de sub-abas das páginas institucionais
		function switchInfoSubTab(subTabId) {
			document.querySelectorAll('.info-subtab-content').forEach(el => el.style.display = 'none');
			document.querySelectorAll('.info-subtab-btn').forEach(el => el.classList.remove('active'));

			const contentEl = document.getElementById('info-subtab-content-' + subTabId);
			if (contentEl) {
				contentEl.style.display = 'block';
			}

			const btnEl = document.getElementById('info-subtab-btn-' + subTabId);
			if (btnEl) {
				btnEl.classList.add('active');
			}

			// Renderiza a pré-visualização ao alternar
			renderMarkdownLive(subTabId);
		}

		// Alterador de visualização do editor (Split / Write / Preview)
		function setEditorView(pageId, mode) {
			const container = document.getElementById('editor-container-' + pageId);
			const writePane = document.getElementById('editor-pane-write-' + pageId);
			const previewPane = document.getElementById('editor-pane-preview-' + pageId);

			if (!container || !writePane || !previewPane) return;

			// Atualiza botões
			['split', 'write', 'preview'].forEach(m => {
				const btn = document.getElementById(`btn-view-${m}-${pageId}`);
				if (btn) btn.classList.remove('active');
			});
			const activeBtn = document.getElementById(`btn-view-${mode}-${pageId}`);
			if (activeBtn) activeBtn.classList.add('active');

			if (mode === 'split') {
				writePane.style.display = 'flex';
				previewPane.style.display = 'flex';
			} else if (mode === 'write') {
				writePane.style.display = 'flex';
				previewPane.style.display = 'none';
			} else if (mode === 'preview') {
				writePane.style.display = 'none';
				previewPane.style.display = 'flex';
			}

			renderMarkdownLive(pageId);
		}

		// Renderizador leve de Markdown para HTML em tempo real
		function renderMarkdownLive(pageId) {
			const textarea = document.getElementById('info_desc_' + pageId);
			const previewBox = document.getElementById('info_preview_' + pageId);

			if (!textarea || !previewBox) return;

			let text = textarea.value || '';
			if (!text.trim()) {
				previewBox.innerHTML = '<span class="text-muted italic store-setting-font-sm">(Nenhum conteúdo digitado)</span>';
				return;
			}

			// Parser simples de Markdown em JS
			let html = text
				// Escape seguro de HTML
				.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
				// Cabeçalhos (#, ##, ###)
				.replace(/^### (.*$)/gim, '<h3>$1</h3>')
				.replace(/^## (.*$)/gim, '<h2>$1</h2>')
				.replace(/^# (.*$)/gim, '<h1>$1</h1>')
				// Negrito e Itálico
				.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
				.replace(/\*(.*?)\*/g, '<em>$1</em>')
				// Citações
				.replace(/^\> (.*$)/gim, '<blockquote>$1</blockquote>')
				// Linha horizontal
				.replace(/^---$/gim, '<hr>')
				// Código inline
				.replace(/`(.*?)`/g, '<code>$1</code>')
				// Listas sem ordenação (- item)
				.replace(/^\- (.*$)/gim, '<li>$1</li>')
				.replace(/^\* (.*$)/gim, '<li>$1</li>')
				// Quebras de linha para parágrafos
				.replace(/\n\n/g, '</p><p>')
				.replace(/\n/g, '<br>');

			// Envolve li em ul se houver
			if (html.includes('<li>')) {
				html = html.replace(/(<li>.*<\/li>)/gs, '<ul>$1</ul>');
			}

			previewBox.innerHTML = '<p>' + html + '</p>';
		}

		// Pré-visualização de imagem selecionada
		function previewImage(input, previewId) {
			const file = input.files[0];
			if (file) {
				const reader = new FileReader();
				reader.onload = function(e) {
					const previewImg = document.getElementById(previewId);
					if (previewImg) {
						previewImg.src = e.target.result;
						previewImg.style.display = 'block';
					}
					const placeholder = document.getElementById(previewId + '-placeholder');
					if (placeholder) {
						placeholder.style.display = 'none';
					}
				};
				reader.readAsDataURL(file);
			}
		}

		// Inicialização no carregamento da página
		document.addEventListener('DOMContentLoaded', function() {
			const urlParams = new URLSearchParams(window.location.search);
			const activeTab = urlParams.get('tab') || 'general';
			switchTab(activeTab);

			// Renderiza o markdown inicial para todos os editores presentes
			document.querySelectorAll('.markdown-textarea').forEach(el => {
				const idMatch = el.id.match(/^info_desc_(.+)$/);
				if (idMatch && idMatch[1]) {
					renderMarkdownLive(idMatch[1]);
				}
			});
		});
	</script>
