{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default(AdminLang.text_orders ~ ' | ' ~ AdminLang.text_admin_panel) }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<div class="breadcrumb-list">
				<a href="{{ admin_path }}/pedidos" class="text-muted breadcrumb-item-link">{{ AdminLang.text_orders }}</a>
				<span class="text-muted">/</span>
				<span class="text-semibold text-dark">{{ AdminLang.text_order_id }} #{{ order.id }}</span>
			</div>
			<h2>{{ AdminLang.text_order_id }} #{{ order.id }}</h2>
			<p class="page-subtitle">{{ AdminLang.text_show_subtitle }}</p>
		</div>
		<div class="d-flex gap-2">
			<a href="{{ admin_path }}/pedidos" class="btn btn-secondary">
				<i class="fas fa-arrow-left"></i> {{ AdminLang.button_back }}
			</a>
			<a href="{{ admin_path }}/pedidos/{{ order.id }}/fatura" target="_blank" class="btn btn-primary">
				<i class="fas fa-print"></i> {{ AdminLang.button_invoice }}
			</a>
		</div>
	</div>

	{% if success %}
		<div class="alert alert-success">
			<i class="fas fa-check-circle mr-2"></i>
			{{ AdminLang.text_success_status }}
		</div>
	{% endif %}

	<!-- Grid de Informações Básicas e do Cliente -->
	<div class="grid-auto-fit-320">
		
		<!-- Resumo do Pedido -->
		<div class="card mb-0">
			<h3 class="card-title">
				<i class="fas fa-shopping-cart card-title-icon"></i> {{ AdminLang.title_sales_summary }}
			</h3>
			<table class="info-table">
				<tr>
					<td class="text-muted">{{ AdminLang.entry_order_id_label }}</td>
					<td class="text-semibold text-dark text-right">#{{ order.id }}</td>
				</tr>
				<tr>
					<td class="text-muted">{{ AdminLang.entry_date_added_label }}</td>
					<td class="text-semibold text-dark text-right">{{ order.date_added|date('d/m/Y H:i') }}</td>
				</tr>
				<tr>
					<td class="text-muted">{{ AdminLang.entry_store_name }}</td>
					<td class="text-semibold text-dark text-right">{{ order.store_name }}</td>
				</tr>
				<tr>
					<td class="text-muted">{{ AdminLang.entry_payment_method }}</td>
					<td class="text-semibold text-dark text-right">{{ order.payment_method }}</td>
				</tr>
				<tr>
					<td class="text-muted">{{ AdminLang.entry_shipping_method }}</td>
					<td class="text-semibold text-dark text-right">{{ order.shipping_method }}</td>
				</tr>
			</table>
		</div>

		<!-- Dados do Cliente -->
		<div class="card mb-0">
			<h3 class="card-title">
				<i class="fas fa-user card-title-icon"></i> {{ AdminLang.title_customer_info }}
			</h3>
			<table class="info-table">
				<tr>
					<td class="text-muted">{{ AdminLang.entry_firstname }}</td>
					<td class="text-semibold text-dark text-right">{{ order.firstname }} {{ order.lastname }}</td>
				</tr>
				<tr>
					<td class="text-muted">{{ AdminLang.entry_email }}</td>
					<td class="text-semibold text-dark text-right"><a href="mailto:{{ order.email }}" class="info-link">{{ order.email }}</a></td>
				</tr>
				<tr>
					<td class="text-muted">{{ AdminLang.entry_telephone }}</td>
					<td class="text-semibold text-dark text-right">{{ order.telephone }}</td>
				</tr>
				<tr>
					<td class="text-muted">{{ AdminLang.entry_ip }}</td>
					<td class="text-semibold text-dark text-right">{{ order.ip }}</td>
				</tr>
				<tr>
					<td class="text-muted">{{ AdminLang.entry_user_agent }}</td>
					<td class="text-semibold text-dark text-right text-ellipsis" title="{{ order.user_agent }}">{{ order.user_agent }}</td>
				</tr>
			</table>
		</div>

	</div>

	<!-- Endereços -->
	<div class="grid-auto-fit-320">
		
		<!-- Endereço de Cobrança -->
		<div class="card mb-0">
			<h3 class="card-title">
				<i class="fas fa-file-invoice-dollar card-title-icon"></i> {{ AdminLang.title_payment_address }}
			</h3>
			<div class="address-details">
				<strong>{{ order.payment_firstname }} {{ order.payment_lastname }}</strong><br>
				{% if order.payment_company %}{{ order.payment_company }}<br>{% endif %}
				{{ order.payment_street }}, {{ order.payment_number }}
				{% if order.payment_complement %} - {{ order.payment_complement }}{% endif %}<br>
				{{ order.payment_district }} - {{ order.payment_city }} / {{ order.payment_zone }}<br>
				CEP: {{ order.payment_postcode }}<br>
				{{ order.payment_country }}
			</div>
		</div>

		<!-- Endereço de Entrega -->
		<div class="card mb-0">
			<h3 class="card-title">
				<i class="fas fa-truck card-title-icon"></i> {{ AdminLang.title_shipping_address }}
			</h3>
			<div class="address-details">
				<strong>{{ order.shipping_firstname }} {{ order.shipping_lastname }}</strong><br>
				{% if order.shipping_company %}{{ order.shipping_company }}<br>{% endif %}
				{{ order.shipping_street }}, {{ order.shipping_number }}
				{% if order.shipping_complement %} - {{ order.shipping_complement }}{% endif %}<br>
				{{ order.shipping_district }} - {{ order.shipping_city }} / {{ order.shipping_zone }}<br>
				CEP: {{ order.shipping_postcode }}<br>
				{{ order.shipping_country }}
			</div>
		</div>

	</div>

	<!-- Itens do Pedido -->
	<div class="card pb-4">
		<h3 class="card-title">
			<i class="fas fa-box-open card-title-icon"></i> {{ AdminLang.title_products }}
		</h3>
		<div class="overflow-x-auto">
			<table class="table mt-0">
				<thead>
					<tr>
						<th>{{ AdminLang.column_product }}</th>
						<th>{{ AdminLang.column_model }}</th>
						<th>{{ AdminLang.column_quantity }}</th>
						<th class="text-right">{{ AdminLang.column_price }}</th>
						<th class="text-right">{{ AdminLang.column_total }}</th>
					</tr>
				</thead>
				<tbody>
					{% for product in products %}
						<tr>
							<td class="text-semibold text-dark">
								{{ product.name }}
								{% if product.options %}
									<div class="product-options-details">
										{% for opt in product.options %}
											<strong>- {{ opt.name }}:</strong> {{ opt.value }}<br>
										{% endfor %}
									</div>
								{% endif %}
							</td>
							<td>{{ product.model }}</td>
							<td>{{ product.quantity }}</td>
							<td class="text-right text-semibold">{{ product.price }}</td>
							<td class="text-right text-semibold text-dark">{{ product.total }}</td>
						</tr>
					{% endfor %}
					
					<!-- Totais -->
					{% for total in totals %}
						<tr class="totals-row">
							<td colspan="3" class="border-none"></td>
							<td class="text-right text-semibold text-muted totals-cell">{{ total.title }}:</td>
							<td class="text-right text-semibold {% if total.code == 'total' %}totals-cell-final{% else %}totals-cell{% endif %}">
								R$ {{ total.value|number_format(2, ',', '.') }}
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>

	<!-- Timeline de Histórico e Alteração de Status -->
	<div class="order-timeline-grid">
		
		<!-- Timeline do Histórico -->
		<div class="card mb-0">
			<h3 class="card-title">
				<i class="fas fa-history card-title-icon"></i> {{ AdminLang.title_history }}
			</h3>
			<div class="activity-list">
				{% if histories %}
					{% for history in histories %}
						<div class="activity-item">
							<div class="activity-header">
								<div>
									<span class="status-pill {% if 'Cancelado' in history.status or 'Reprovado' in history.status %}status-cancelled{% elseif 'Completo' in history.status or 'Entregue' in history.status or 'Pago' in history.status %}status-approved{% else %}status-pending{% endif %} status-pill-sm">
										{{ history.status }}
									</span>
									<span class="activity-time">{{ history.date_added|date('d/m/Y H:i') }}</span>
								</div>
								{% if history.notify %}
									<span class="status-pill status-pill-notify">
										<i class="fas fa-envelope"></i> {{ AdminLang.text_client_notified }}
									</span>
								{% endif %}
							</div>
							{% if history.comment %}
								<div class="activity-comment">
									"{{ history.comment }}"
								</div>
							{% endif %}
						</div>
					{% endfor %}
				{% else %}
					<p class="no-activity-message">
						{{ AdminLang.text_no_history }}
					</p>
				{% endif %}
			</div>
		</div>

		<!-- Formulário de Alteração de Status -->
		<div class="card mb-0">
			<h3 class="card-title">
				<i class="fas fa-edit card-title-icon"></i> {{ AdminLang.title_update }}
			</h3>
			<form action="{{ admin_path }}/pedidos/{{ order.id }}/status" method="POST">
				{% if csrf %}
					<input type="hidden" name="{{ csrf.keys.name }}" value="{{ csrf.name }}">
					<input type="hidden" name="{{ csrf.keys.value }}" value="{{ csrf.value }}">
				{% endif %}
				<div class="form-group">
					<label for="order_status_id" class="form-label">{{ AdminLang.entry_new_status }}</label>
					<select name="order_status_id" id="order_status_id" class="form-control" required>
						<option value="">{{ AdminLang.placeholder_status }}</option>
						{% for status in statuses %}
							<option value="{{ status.id }}" {% if order.order_status_id == status.id %}selected{% endif %}>{{ status.name }}</option>
						{% endfor %}
					</select>
				</div>

				<div class="form-group">
					<label for="comment" class="form-label">{{ AdminLang.entry_comment }}</label>
					<textarea name="comment" id="comment" class="form-control form-control-textarea" rows="4" placeholder="{{ AdminLang.placeholder_comment }}"></textarea>
				</div>

				<div class="form-group d-flex align-center gap-2 mb-6">
					<input type="checkbox" name="notify" id="notify" value="1" class="form-checkbox-custom">
					<label for="notify" class="form-checkbox-label">{{ AdminLang.entry_notify }}</label>
				</div>

				<button type="submit" class="btn btn-primary w-100">
					<i class="fas fa-save"></i> {{ AdminLang.button_update_status }}
				</button>
			</form>
		</div>

	</div>
{% endblock %}
