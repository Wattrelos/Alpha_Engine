{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default((AdminLang.text_add_title|default('Adicionar Fabricante')) ~ ' | ' ~ (AdminLang.sidebar.title|default('Painel Administrativo'))) }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>{{ AdminLang.text_add_title|default('Adicionar Fabricante') }}</h2>
			<p class="page-subtitle">{{ AdminLang.text_add_subtitle|default('Cadastre um novo fabricante ou marca no catálogo.') }}</p>
		</div>
		<a href="{{ admin_path }}/fabricantes" class="btn btn-secondary">
			<i class="fas fa-arrow-left"></i>
			<span>{{ AdminLang.button_back|default('Voltar para Lista') }}</span>
		</a>
	</div>

	<div class="card card-large">
		<form action="{{ admin_path }}/fabricantes/criar" method="POST" enctype="multipart/form-data">
			{% if csrf %}
				<input type="hidden" name="{{ csrf.keys.name }}" value="{{ csrf.name }}">
				<input type="hidden" name="{{ csrf.keys.value }}" value="{{ csrf.value }}">
			{% endif %}
			<div class="form-grid grid-2-cols">
				
				<!-- Nome do Fabricante -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="name" class="form-label-dark">{{ AdminLang.entry_name|default('Nome do Fabricante') }} *</label>
					<input type="text" id="name" name="name" class="form-control form-control-lg" required />
				</div>

				<!-- SEO URL (Keyword) -->
				<div class="form-group mb-6">
					<label for="seo_keyword" class="form-label-dark">{{ AdminLang.entry_seo_keyword|default('SEO URL (Amigável)') }}</label>
					<input type="text" id="seo_keyword" name="seo_keyword" class="form-control form-control-lg" placeholder="{{ AdminLang.placeholder_seo_keyword|default('ex: colchao-ortobom') }}" />
				</div>

				<!-- Ordem de Exibição -->
				<div class="form-group mb-6">
					<label for="sort_order" class="form-label-dark">{{ AdminLang.entry_sort_order|default('Ordem de Exibição') }}</label>
					<input type="number" id="sort_order" name="sort_order" class="form-control form-control-lg" value="0" />
				</div>

				<!-- Logotipo / Imagem -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="image" class="form-label-lg">{{ AdminLang.entry_logo|default('Logotipo (Imagem)') }}</label>
					<input type="file" id="image" name="image" accept="image/*" class="form-control form-control-lg" />
					<p class="form-text-muted">{{ AdminLang.text_accepted_formats|default('Formatos aceitos: JPG, PNG, WEBP, GIF.') }}</p>
				</div>

			</div>

			<!-- Botões de Ação -->
			<div class="form-actions">
				<a href="{{ admin_path }}/fabricantes" class="btn btn-secondary">{{ AdminLang.button_cancel|default('Cancelar') }}</a>
				<button type="submit" class="btn btn-primary">
					<i class="fas fa-save"></i>
					<span>{{ AdminLang.button_save|default('Salvar Fabricante') }}</span>
				</button>
			</div>
		</form>
	</div>
{% endblock %}
