{% extends 'admin/layouts/base_auth.html.twig' %}

{% block title %}
    {{ title|default((AdminLang.text_setup_title|default('Configuração Inicial')) ~ ' | ' ~ (AdminLang.sidebar.title|default('Painel Administrativo'))) }}
{% endblock %}

{% block container_class %}auth-container-large{% endblock %}

{% block content %}
    <div class="auth-card auth-card-large">
        <div class="auth-logo">
            <span class="auth-logo-emoji">🌌</span>
            <h2 class="auth-logo-title">{{ AdminLang.text_setup_heading|default('Instalação Concluída') }}</h2>
            <p class="auth-logo-subtitle">{{ AdminLang.text_setup_subtitle|default('Configure a credencial de Administrador Principal para começar a usar a loja.') }}</p>
        </div>

        <form action="{{ action }}" method="post" novalidate class="flex-column gap-1-25">
        
            <div class="grid-2-cols">
                <!-- Nome -->
                <div class="form-group-flex">
                    <label for="firstname" class="form-label">{{ AdminLang.entry_firstname|default('Nome') }}</label>
                    <input type="text" name="firstname" id="firstname" class="form-control {% if errors.firstname %}is-invalid{% endif %}" placeholder="{{ AdminLang.placeholder_firstname|default('Ex: João') }}" required value="{{ data.firstname }}">
                    {% if errors.firstname %}
                        <span class="invalid-feedback">{{ errors.firstname }}</span>
                    {% endif %}
                </div>

                <!-- Sobrenome -->
                <div class="form-group-flex">
                    <label for="lastname" class="form-label">{{ AdminLang.entry_lastname|default('Sobrenome') }}</label>
                    <input type="text" name="lastname" id="lastname" class="form-control {% if errors.lastname %}is-invalid{% endif %}" placeholder="{{ AdminLang.placeholder_lastname|default('Ex: Silva') }}" required value="{{ data.lastname }}">
                    {% if errors.lastname %}
                        <span class="invalid-feedback">{{ errors.lastname }}</span>
                    {% endif %}
                </div>
            </div>

            <!-- E-mail -->
            <div class="form-group-flex">
                <label for="email" class="form-label">{{ AdminLang.entry_email|default('E-mail') }}</label>
                <input type="email" name="email" id="email" class="form-control {% if errors.email %}is-invalid{% endif %}" placeholder="{{ AdminLang.placeholder_email|default('Ex: admin@meusite.com') }}" required value="{{ data.email }}">
                {% if errors.email %}
                    <span class="invalid-feedback">{{ errors.email }}</span>
                {% endif %}
            </div>

            <!-- Usuário -->
            <div class="form-group-flex">
                <label for="username" class="form-label">{{ AdminLang.entry_username|default('Usuário de Acesso') }}</label>
                <input type="text" name="username" id="username" class="form-control {% if errors.username %}is-invalid{% endif %}" placeholder="{{ AdminLang.placeholder_username|default('Ex: admin') }}" required value="{{ data.username }}">
                {% if errors.username %}
                    <span class="invalid-feedback">{{ errors.username }}</span>
                {% endif %}
            </div>

            <div class="grid-2-cols">
                <!-- Senha -->
                <div class="form-group-flex">
                    <label for="password" class="form-label">{{ AdminLang.entry_password|default('Senha') }}</label>
                    <input type="password" name="password" id="password" class="form-control {% if errors.password %}is-invalid{% endif %}" placeholder="{{ AdminLang.placeholder_password|default('Min. 6 caracteres') }}" required>
                    {% if errors.password %}
                        <span class="invalid-feedback">{{ errors.password }}</span>
                    {% endif %}
                </div>

                <!-- Confirmar Senha -->
                <div class="form-group-flex">
                    <label for="confirm_password" class="form-label">{{ AdminLang.entry_confirm_password|default('Confirmar Senha') }}</label>
                    <input type="password" name="confirm_password" id="confirm_password" class="form-control {% if errors.confirm_password %}is-invalid{% endif %}" placeholder="{{ AdminLang.placeholder_confirm_password|default('Repita a senha') }}" required>
                    {% if errors.confirm_password %}
                        <span class="invalid-feedback">{{ errors.confirm_password }}</span>
                    {% endif %}
                </div>
            </div>

            <button type="submit" class="btn btn-primary auth-btn mt-4">
                {{ AdminLang.button_setup_submit|default('Finalizar Configuração') }}
            </button>
        </form>
    </div>
{% endblock %}
