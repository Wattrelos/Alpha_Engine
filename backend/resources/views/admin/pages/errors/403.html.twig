{% extends 'admin/layouts/base.html.twig' %}

{% block title %}Acesso Negado | Painel Administrativo{% endblock %}

{% block content %}
	<div class="error-card">
		<div class="error-card-emoji">🚫</div>
		<h1 class="error-card-title">Acesso Negado</h1>
		<p class="error-card-text">
			{{ message|default('Você não tem privilégios suficientes para acessar ou modificar este recurso.') }}
		</p>
		<a href="{{ admin_path }}/dashboard" class="btn btn-primary error-card-btn">
			<i class="fas fa-arrow-left"></i>
			<span>Voltar ao Painel Inicial</span>
		</a>
	</div>
{% endblock %}
