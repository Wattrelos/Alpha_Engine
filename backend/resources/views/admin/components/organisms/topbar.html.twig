<header class="topbar">
    <div>
        <strong>Painel de Controle</strong>
    </div>
    <div class="topbar-user-box">
        <span>Olá, {{ logged_admin.name|default('Administrador') }}</span>
        <div class="topbar-avatar topbar-avatar-wrapper">
            {% if logged_admin.image %}
                {% if logged_admin.image starts with 'http' or logged_admin.image starts with '/' %}
                    <img src="{{ logged_admin.image }}" alt="{{ logged_admin.name|default('User') }}" class="topbar-avatar-img-fit">
                {% else %}
                    <img src="/image/{{ logged_admin.image }}" alt="{{ logged_admin.name|default('User') }}" class="topbar-avatar-img-fit">
                {% endif %}
            {% else %}
                <img src="/image/profile/default-user-profile.jpg" alt="{{ logged_admin.name|default('User') }}" class="topbar-avatar-img-fit">
            {% endif %}
        </div>
        <a href="{{ admin_path }}/logout" class="topbar-logout-btn">Sair</a>
    </div>
</header>
