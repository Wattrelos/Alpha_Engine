{% extends "pos/layout.twig" %}

{% block title %}{{ title }} | meusite PDV{% endblock %}

{% block extra_styles %}{% endblock %}

{% block content %}
    <div class="pos-workspace">
        <!-- Panel Esquerdo: Catálogo de Produtos e Busca de Clientes -->
        <div class="catalog-panel">
            <div class="search-box-row">
                <!-- Busca de Produtos -->
                <div class="search-input-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" id="product_search_input" class="search-input" placeholder="Buscar produtos por nome ou código..." autocomplete="off">
                </div>
            
                <!-- Busca e Identificação de Cliente -->
                <div class="search-input-wrapper customer-search-dropdown">
                    <i class="fas fa-user"></i>
                    <input type="text" id="customer_search_input" class="search-input" placeholder="Identificar cliente por nome/e-mail..." autocomplete="off">
                
                    <!-- Resultados da busca de clientes -->
                    <div id="customer_search_results" class="customer-results"></div>
                </div>
            </div>
        
            <!-- Grid de Produtos -->
            <div class="products-grid-container">
                <div id="products_grid" class="products-grid">
                    <!-- Injetado via Javascript -->
                    <div class="empty-cart-state pos-empty-grid-col pos-empty-state-padding">
                        <i class="fas fa-spinner fa-spin empty-cart-icon"></i>
                        <p>Carregando catálogo...</p>
                    </div>
                </div>
            </div>
        </div>
    
        <!-- Panel Central: Detalhes do Produto Selecionado -->
        <aside id="product_detail_panel" class="product-detail-panel">
            <div class="product-detail-header">
                <h3 class="product-detail-title-top">
                    <i class="fas fa-info-circle pos-accent-text"></i>
                    Ficha Técnica
                </h3>
                <span id="detail_header_badge" class="detail-badge detail-badge-stock-in" style="display: none;">Disponível</span>
            </div>
        
            <div id="product_detail_body" class="product-detail-body">
                <!-- Estado Vazio / Instrução -->
                <div class="product-detail-empty" id="detail_empty_state">
                    <i class="fas fa-search-plus detail-empty-icon"></i>
                    <h4 class="detail-empty-title">Nenhum item selecionado</h4>
                    <p class="detail-empty-desc">Selecione ou clique em um produto no catálogo para consultar medidas, peso, código EAN e estoque.</p>
                </div>
            
                <!-- Conteúdo Dinâmico do Produto -->
                <div id="detail_product_info" style="display: none; flex-direction: column; gap: 1rem;">
                    <div class="product-detail-img-box">
                        <img id="detail_img" src="/image/no-image.png" class="product-detail-img" alt="Produto">
                        <div class="product-detail-badges">
                            <span id="detail_stock_badge" class="detail-badge detail-badge-stock-in">Em Estoque</span>
                            <span id="detail_qty_badge" class="detail-badge" style="background-color: rgba(11, 15, 25, 0.85); color: #fff;">0 un</span>
                        </div>
                    </div>

                    <div class="product-detail-main">
                        <div class="product-detail-brand" id="detail_brand_row">
                            <i class="fas fa-tag"></i>
                            <span id="detail_brand">meusite</span>
                        </div>
                        <h3 class="product-detail-name" id="detail_name">Nome do Produto</h3>
                        <div class="product-detail-prices">
                            <span class="detail-price-current" id="detail_price">R$ 0,00</span>
                            <span class="detail-price-old" id="detail_old_price" style="display: none;">R$ 0,00</span>
                            <span class="detail-discount-tag" id="detail_discount_tag" style="display: none;">PROMOÇÃO</span>
                        </div>
                    </div>

                    <!-- Grade de Especificações Técnicas -->
                    <div class="product-detail-specs-grid">
                        <div class="spec-item">
                            <span class="spec-label"><i class="fas fa-barcode"></i> Cód. Barras (EAN)</span>
                            <span class="spec-value" id="detail_ean">-</span>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label"><i class="fas fa-fingerprint"></i> SKU / Ref</span>
                            <span class="spec-value" id="detail_sku">-</span>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label"><i class="fas fa-ruler-combined"></i> Medidas (CxLxA)</span>
                            <span class="spec-value" id="detail_dimensions">-</span>
                        </div>
                        <div class="spec-item">
                            <span class="spec-label"><i class="fas fa-weight-hanging"></i> Peso Líquido</span>
                            <span class="spec-value" id="detail_weight">-</span>
                        </div>
                    </div>

                    <!-- Descrição Curta -->
                    <div class="product-detail-desc-box" id="detail_desc_container">
                        <div class="product-detail-desc-title"><i class="fas fa-align-left"></i> Descrição Técnica</div>
                        <p class="product-detail-desc-text" id="detail_desc">Sem descrição informada.</p>
                    </div>
                </div>
            </div>

            <!-- Footer com Seletor de Quantidade e Ação de Adicionar -->
            <div class="product-detail-footer" id="detail_footer" style="display: none;">
                <div class="detail-action-row">
                    <div class="detail-qty-control">
                        <button class="detail-qty-btn" id="detail_qty_minus" type="button">-</button>
                        <span class="detail-qty-val" id="detail_qty_input">1</span>
                        <button class="detail-qty-btn" id="detail_qty_plus" type="button">+</button>
                    </div>
                    <button class="detail-add-btn" id="detail_add_btn" type="button">
                        <i class="fas fa-cart-plus"></i>
                        <span>Adicionar</span>
                    </button>
                </div>
            </div>
        </aside>
    
        <!-- Panel Direito: Carrinho de Compras -->
        <div class="cart-panel">
            <div class="cart-header">
                <h2 class="cart-title">
                    <i class="fas fa-shopping-cart pos-accent-text"></i>
                    Pré-Venda
                </h2>
                <div class="customer-selector">
                    <div class="customer-info-box">
                        <div>
                            <span class="pos-text-muted-sm">Cliente Identificado</span>
                            <span id="selected_customer_name" class="customer-name-selected unidentified">Consumidor Não Identificado</span>
                        </div>
                        <button id="clear_customer_btn" class="customer-search-btn pos-danger-alert">
                            <i class="fas fa-times-circle"></i>
                        </button>
                    </div>
                </div>
            </div>
        
            <!-- Itens do Carrinho -->
            <div id="cart_items_list" class="cart-items">
                <div class="empty-cart-state">
                    <i class="fas fa-shopping-basket empty-cart-icon"></i>
                    <p>Carrinho de pré-venda vazio</p>
                </div>
            </div>
        
            <!-- Totais e Envio -->
            <div class="cart-footer">
                <div class="total-row">
                    <span>Sub-Total</span>
                    <span id="cart_subtotal">R$ 0,00</span>
                </div>
                <div class="total-row grand-total">
                    <span>Total</span>
                    <span id="cart_total">R$ 0,00</span>
                </div>
            
                <button id="checkout_btn" class="checkout-btn" disabled>
                    <i class="fas fa-ticket-alt"></i>
                    Salvar Pré-Venda
                </button>
            </div>
        </div>
    </div>

    <!-- Modal de erro ou mensagens de idempotência -->
    <div id="alert_modal" class="pos-modal">
        <div class="modal-content">
            <i class="fas fa-exclamation-triangle modal-icon" id="modal_icon"></i>
            <h3 class="modal-title" id="modal_title">Aviso</h3>
            <p class="modal-msg" id="modal_message">Mensagem padrão</p>
            <button id="modal_close_btn" class="modal-close-btn">Entendido</button>
        </div>
    </div>

    <!-- Modal de Variações de Produto -->
    <div id="variants_modal" class="pos-modal">
        <div class="modal-content pos-max-w-600">
            <div class="variants-modal-header">
                <h3 class="variants-modal-title" id="variants_modal_title">Escolha a Variação</h3>
                <button id="variants_modal_close_btn" class="variants-modal-close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div id="variants_modal_list" class="variants-list">
                <!-- Injetado via Javascript -->
            </div>
        </div>
    </div>
{% endblock %}

{% block extra_scripts %}
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // Elementos da interface principal
            const productSearchInput = document.getElementById("product_search_input");
            const customerSearchInput = document.getElementById(
                "customer_search_input",
            );
            const customerSearchResults = document.getElementById(
                "customer_search_results",
            );
            const productsGrid = document.getElementById("products_grid");
            const cartItemsList = document.getElementById("cart_items_list");
            const selectedCustomerName = document.getElementById(
                "selected_customer_name",
            );
            const clearCustomerBtn = document.getElementById("clear_customer_btn");
            const cartSubtotal = document.getElementById("cart_subtotal");
            const cartTotal = document.getElementById("cart_total");
            const checkoutBtn = document.getElementById("checkout_btn");

            // Elementos do Painel de Detalhes do Produto
            const detailEmptyState = document.getElementById("detail_empty_state");
            const detailProductInfo = document.getElementById("detail_product_info");
            const detailFooter = document.getElementById("detail_footer");
            const detailHeaderBadge = document.getElementById("detail_header_badge");
            const detailImg = document.getElementById("detail_img");
            const detailStockBadge = document.getElementById("detail_stock_badge");
            const detailQtyBadge = document.getElementById("detail_qty_badge");
            const detailBrand = document.getElementById("detail_brand");
            const detailName = document.getElementById("detail_name");
            const detailPrice = document.getElementById("detail_price");
            const detailOldPrice = document.getElementById("detail_old_price");
            const detailDiscountTag = document.getElementById("detail_discount_tag");
            const detailEan = document.getElementById("detail_ean");
            const detailSku = document.getElementById("detail_sku");
            const detailDimensions = document.getElementById("detail_dimensions");
            const detailWeight = document.getElementById("detail_weight");
            const detailDesc = document.getElementById("detail_desc");
            const detailQtyInput = document.getElementById("detail_qty_input");
            const detailQtyMinus = document.getElementById("detail_qty_minus");
            const detailQtyPlus = document.getElementById("detail_qty_plus");
            const detailAddBtn = document.getElementById("detail_add_btn");

            // Modais
            const alertModal = document.getElementById("alert_modal");
            const modalIcon = document.getElementById("modal_icon");
            const modalTitle = document.getElementById("modal_title");
            const modalMessage = document.getElementById("modal_message");
            const modalCloseBtn = document.getElementById("modal_close_btn");
            const variantsModal = document.getElementById("variants_modal");
            const variantsModalTitle = document.getElementById("variants_modal_title");
            const variantsModalList = document.getElementById("variants_modal_list");
            const variantsModalCloseBtn = document.getElementById(
                "variants_modal_close_btn",
            );

            // Estados em memória
            let cart = [];
            let selectedCustomerId = 0;
            let productsDatabase = [];
            let focusedProduct = null;
            let focusedVariant = null;
            let detailQuantity = 1;

            // Utilitário de formatação de dinheiro
            const formatMoney = (val) => {
                return new Intl.NumberFormat("pt-BR", {
                    style: "currency",
                    currency: "BRL",
                }).format(val);
            };

            // Gerador de UUID para Idempotency-Key
            const generateUUID = () => {
                return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(
                    /[xy]/g,
                    function (c) {
                        var r = (Math.random() * 16) | 0,
                            v = c == "x" ? r : (r & 0x3) | 0x8;
                        return v.toString(16);
                    },
                );
            };

            let idempotencyKey = generateUUID();

            // 1. Carrega Produtos inicialmente ou por busca
            const loadProducts = (query = "") => {
                fetch(
                    `{{ admin_path }}/pos/produtos/buscar?q=${encodeURIComponent(query)}`,
                )
                    .then((res) => res.json())
                    .then((data) => {
                        productsDatabase = data;
                        renderProducts();
                    })
                    .catch((err) => {
                        console.error("Erro ao buscar produtos:", err);
                        productsGrid.innerHTML = `
                        <div class="empty-cart-state pos-empty-grid-col pos-text-danger">
                            <i class="fas fa-exclamation-circle empty-cart-icon"></i>
                            <p>Falha ao conectar com o catálogo de produtos.</p>
                        </div>
                    `;
                    });
            };

            // Renderiza Grid de Produtos
            const renderProducts = () => {
                if (productsDatabase.length === 0) {
                    productsGrid.innerHTML = `
                    <div class="empty-cart-state pos-empty-grid-col">
                        <i class="fas fa-box-open empty-cart-icon"></i>
                        <p>Nenhum produto encontrado no estoque.</p>
                    </div>
                `;
                    return;
                }

                productsGrid.innerHTML = productsDatabase
                    .map((p) => {
                        const hasVariants = p.variants && p.variants.length > 0;
                        const isOutOfStock = p.quantity <= 0;
                        const isSelected =
                            focusedProduct &&
                            focusedProduct.product_id === p.product_id;
                        const priceHtml = p.special_formatted
                            ? `<span class="product-price-old">${p.price_formatted}</span> <span class="product-price pos-text-success">${p.special_formatted}</span>`
                            : `<span class="product-price">${p.price_formatted}</span>`;

                        return `
                    <div class="product-card ${isSelected ? "is-active" : ""}" id="prod_card_${p.product_id}" onclick="selectProduct(${p.product_id})">
                        <div class="product-image-container">
                            <img src="${p.image}" class="product-image" alt="${p.name}" onerror="this.src='/image/no-image.png'">
                            <span class="product-badge">${p.quantity} unid</span>
                        </div>
                        <div class="product-info">
                            <h3 class="product-name" title="${p.name}">${p.name}</h3>
                            <p class="product-meta">Ref: ${p.sku || p.model || "N/A"}</p>
                            <div class="product-pricing">
                                <div>${priceHtml}</div>
                                <button class="add-btn" ${isOutOfStock && !hasVariants ? "disabled" : ""} onclick="event.stopPropagation(); triggerAdd(${p.product_id}, ${isOutOfStock})" title="Adicionar ao Carrinho">
                                    <i class="fas ${hasVariants ? "fa-list-ul" : isOutOfStock ? "fa-ban" : "fa-plus"}"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
                    })
                    .join("");
            };

            // Selecionar Produto para exibir no Painel de Detalhes
            window.selectProduct = (productId, variantId = null) => {
                const product = productsDatabase.find(
                    (p) => p.product_id === productId,
                );
                if (!product) return;

                focusedProduct = product;
                focusedVariant =
                    variantId && product.variants
                        ? product.variants.find((v) => v.product_id === variantId)
                        : null;
                detailQuantity = 1;

                // Atualiza classe ativa nos cards
                document
                    .querySelectorAll(".product-card")
                    .forEach((card) => card.classList.remove("is-active"));
                const activeCard = document.getElementById(`prod_card_${productId}`);
                if (activeCard) {
                    activeCard.classList.add("is-active");
                }

                renderProductDetail(product, focusedVariant);
            };

            // Renderizar Painel de Detalhes
            const renderProductDetail = (product, variant = null) => {
                const activeItem = variant || product;
                const hasVariants = product.variants && product.variants.length > 0;
                const isOutOfStock = (activeItem.quantity || 0) <= 0;
                const currentPrice =
                    activeItem.special !== null && activeItem.special !== undefined
                        ? activeItem.special
                        : activeItem.price;

                // Exibir blocos
                detailEmptyState.style.display = "none";
                detailProductInfo.style.display = "flex";
                detailFooter.style.display = "flex";
                detailHeaderBadge.style.display = "inline-block";

                // Badges
                if (isOutOfStock) {
                    detailStockBadge.className = "detail-badge detail-badge-stock-out";
                    detailStockBadge.textContent = "Esgotado";
                    detailHeaderBadge.className = "detail-badge detail-badge-stock-out";
                    detailHeaderBadge.textContent = "Indisponível";
                } else {
                    detailStockBadge.className = "detail-badge detail-badge-stock-in";
                    detailStockBadge.textContent = "Em Estoque";
                    detailHeaderBadge.className = "detail-badge detail-badge-stock-in";
                    detailHeaderBadge.textContent = "Disponível";
                }
                detailQtyBadge.textContent = `${activeItem.quantity || 0} un`;

                // Imagem e Nome
                detailImg.src = activeItem.image || "/image/no-image.png";
                detailImg.alt = variant
                    ? `${product.name} (${variant.name})`
                    : product.name;
                detailName.textContent = variant
                    ? `${product.name} - ${variant.name}`
                    : product.name;
                detailBrand.textContent = product.manufacturer || "meusite";

                // Preços
                if (product.special_formatted && !variant) {
                    detailPrice.textContent = product.special_formatted;
                    detailOldPrice.textContent = product.price_formatted;
                    detailOldPrice.style.display = "inline-block";
                    detailDiscountTag.style.display = "inline-block";
                } else {
                    detailPrice.textContent =
                        activeItem.price_formatted || formatMoney(currentPrice);
                    detailOldPrice.style.display = "none";
                    detailDiscountTag.style.display = "none";
                }

                // Códigos
                detailEan.textContent = activeItem.ean || "N/A";
                detailSku.textContent = activeItem.sku || activeItem.model || "N/A";

                // Dimensões (CxLxA)
                const length = parseFloat(activeItem.length) || 0;
                const width = parseFloat(activeItem.width) || 0;
                const height = parseFloat(activeItem.height) || 0;
                if (length > 0 || width > 0 || height > 0) {
                    detailDimensions.textContent = `${length} × ${width} × ${height} cm`;
                } else {
                    detailDimensions.textContent = "-";
                }

                // Peso
                const weight = parseFloat(activeItem.weight) || 0;
                detailWeight.textContent = weight > 0 ? `${weight.toFixed(2)} kg` : "-";

                // Descrição
                detailDesc.textContent =
                    product.description || "Sem descrição técnica cadastrada.";

                // Quantidade e Botão
                detailQtyInput.textContent = detailQuantity;
                if (isOutOfStock && !hasVariants) {
                    detailAddBtn.disabled = true;
                    detailAddBtn.innerHTML =
                        '<i class="fas fa-ban"></i> <span>Esgotado</span>';
                } else if (hasVariants && !variant) {
                    detailAddBtn.disabled = false;
                    detailAddBtn.innerHTML =
                        '<i class="fas fa-list-ul"></i> <span>Escolher Variação</span>';
                } else {
                    detailAddBtn.disabled = false;
                    detailAddBtn.innerHTML =
                        '<i class="fas fa-cart-plus"></i> <span>Adicionar</span>';
                }
            };

            // Controles de quantidade no Painel de Detalhes
            detailQtyMinus.addEventListener("click", () => {
                if (detailQuantity > 1) {
                    detailQuantity--;
                    detailQtyInput.textContent = detailQuantity;
                }
            });

            detailQtyPlus.addEventListener("click", () => {
                if (!focusedProduct) return;
                const maxQty = focusedVariant
                    ? focusedVariant.quantity || 0
                    : focusedProduct.quantity || 0;
                if (
                    detailQuantity < maxQty ||
                    (focusedProduct.variants &&
                        focusedProduct.variants.length > 0 &&
                        !focusedVariant)
                ) {
                    detailQuantity++;
                    detailQtyInput.textContent = detailQuantity;
                } else {
                    showModal(
                        "Limite de estoque",
                        `Quantidade máxima disponível em estoque: ${maxQty} unidades.`,
                        "fa-exclamation-circle",
                        "var(--warning)",
                    );
                }
            });

            // Adicionar ao Carrinho pelo Painel de Detalhes
            detailAddBtn.addEventListener("click", () => {
                if (!focusedProduct) return;

                if (
                    focusedProduct.variants &&
                    focusedProduct.variants.length > 0 &&
                    !focusedVariant
                ) {
                    openVariantsModal(focusedProduct);
                    return;
                }

                if (focusedVariant) {
                    addVariantToCart(
                        focusedProduct.product_id,
                        focusedVariant.product_id,
                        detailQuantity,
                    );
                } else {
                    addToCart(focusedProduct.product_id, detailQuantity);
                }
            });

            window.triggerAdd = (productId, isOutOfStock) => {
                const product = productsDatabase.find(
                    (p) => p.product_id === productId,
                );
                if (!product) return;

                // Atualiza seleção para feedback visual
                selectProduct(productId);

                if (product.variants && product.variants.length > 0) {
                    openVariantsModal(product);
                } else if (!isOutOfStock) {
                    addToCart(productId, 1);
                }
            };

            // 2. Busca e Seleção de Clientes
            let customerSearchTimeout;
            customerSearchInput.addEventListener("input", () => {
                clearTimeout(customerSearchTimeout);
                const query = customerSearchInput.value.trim();

                if (query.length < 2) {
                    customerSearchResults.style.display = "none";
                    return;
                }

                customerSearchTimeout = setTimeout(() => {
                    fetch(
                        `{{ admin_path }}/pos/clientes/buscar?q=${encodeURIComponent(query)}`,
                    )
                        .then((res) => res.json())
                        .then((data) => {
                            if (data.length === 0) {
                                customerSearchResults.innerHTML = `
                                <div class="customer-item pos-cursor-default">
                                    <span class="customer-item-name">Nenhum cliente encontrado</span>
                                </div>
                            `;
                            } else {
                                customerSearchResults.innerHTML = data
                                    .map(
                                        (c) => `
                                <div class="customer-item" onclick="selectCustomer(${c.customer_id}, '${c.name.replace(/'/g, "\\'")}')">
                                    <div class="customer-item-name">${c.name}</div>
                                    <div class="customer-item-meta"><i class="fas fa-envelope"></i> ${c.email} | <i class="fas fa-phone"></i> ${c.telephone || "Sem tel"}</div>
                                </div>
                            `,
                                    )
                                    .join("");
                            }
                            customerSearchResults.style.display = "block";
                        });
                }, 300);
            });

            // Selecionar Cliente
            window.selectCustomer = (id, name) => {
                selectedCustomerId = id;
                selectedCustomerName.textContent = name;
                selectedCustomerName.classList.remove("unidentified");
                clearCustomerBtn.style.display = "block";

                customerSearchResults.style.display = "none";
                customerSearchInput.value = "";
            };

            // Limpar Cliente Selecionado
            clearCustomerBtn.addEventListener("click", () => {
                selectedCustomerId = 0;
                selectedCustomerName.textContent = "Consumidor Não Identificado";
                selectedCustomerName.classList.add("unidentified");
                clearCustomerBtn.style.display = "none";
            });

            // Fechar dropdown de clientes ou modais se clicar fora
            document.addEventListener("click", (e) => {
                if (!e.target.closest(".customer-search-dropdown")) {
                    customerSearchResults.style.display = "none";
                }
                if (e.target === variantsModal) {
                    variantsModal.style.display = "none";
                }
            });

            variantsModalCloseBtn.addEventListener("click", () => {
                variantsModal.style.display = "none";
            });

            // 3. Gerenciamento de Variações de Produto
            const openVariantsModal = (product) => {
                variantsModalTitle.textContent = `Escolha a variação de: ${product.name}`;
                variantsModalList.innerHTML = product.variants
                    .map((v) => {
                        const isOutOfStock = v.quantity <= 0;
                        return `
                    <div class="variant-item-card" onclick="selectVariantAndDetail(${product.product_id}, ${v.product_id})">
                        <div class="variant-info-wrapper">
                            <img src="${v.image}" class="variant-image-thumb" onerror="this.src='/image/no-image.png'">
                            <div class="variant-meta-wrapper">
                                <span class="variant-name-text">${v.name}</span>
                                <span class="variant-sku-text">Ref/SKU: ${v.sku || "N/A"}</span>
                            </div>
                        </div>
                        <div class="variant-action-wrapper">
                            <div class="variant-price-info">
                                <span class="variant-price-text">${v.price_formatted}</span>
                                <span class="variant-stock-text ${isOutOfStock ? "variant-stock-out" : "variant-stock-in"}">
                                    ${v.quantity} unid
                                </span>
                            </div>
                            <button class="add-btn" ${isOutOfStock ? "disabled" : ""} onclick="event.stopPropagation(); addVariantToCart(${product.product_id}, ${v.product_id}, 1)">
                                <i class="fas ${isOutOfStock ? "fa-ban" : "fa-plus"}"></i>
                            </button>
                        </div>
                    </div>
                `;
                    })
                    .join("");
                variantsModal.style.display = "flex";
            };

            window.selectVariantAndDetail = (productId, variantId) => {
                selectProduct(productId, variantId);
            };

            window.addVariantToCart = (productId, variantId, qty = 1) => {
                const product = productsDatabase.find(
                    (p) => p.product_id === productId,
                );
                if (!product) return;

                const variant = product.variants.find(
                    (v) => v.product_id === variantId,
                );
                if (!variant) return;

                const existingItem = cart.find((item) => item.product_id === variantId);
                if (existingItem) {
                    if (existingItem.quantity + qty <= variant.quantity) {
                        existingItem.quantity += qty;
                    } else {
                        showModal(
                            "Limite de estoque",
                            `Você já adicionou a quantidade máxima disponível (${variant.quantity} unid) de ${product.name} - ${variant.name}.`,
                            "fa-exclamation-circle",
                            "var(--warning)",
                        );
                        return;
                    }
                } else {
                    if (qty > variant.quantity) {
                        showModal(
                            "Limite de estoque",
                            `Quantidade solicitada (${qty}) maior que a disponível (${variant.quantity}).`,
                            "fa-exclamation-circle",
                            "var(--warning)",
                        );
                        return;
                    }
                    cart.push({
                        product_id: variant.product_id,
                        name: `${product.name} - ${variant.name}`,
                        price: variant.price,
                        image: variant.image,
                        quantity: qty,
                        max_quantity: variant.quantity,
                    });
                }

                variantsModal.style.display = "none";
                renderCart();
            };

            // 4. Gerenciamento do Carrinho de Compras
            window.addToCart = (productId, qty = 1) => {
                const product = productsDatabase.find(
                    (p) => p.product_id === productId,
                );
                if (!product) return;

                // Se o produto tiver variações, abre o modal de variações
                if (product.variants && product.variants.length > 0) {
                    openVariantsModal(product);
                    return;
                }

                const existingItem = cart.find((item) => item.product_id === productId);
                if (existingItem) {
                    if (existingItem.quantity + qty <= product.quantity) {
                        existingItem.quantity += qty;
                    } else {
                        showModal(
                            "Limite de estoque",
                            `Você já adicionou a quantidade máxima disponível (${product.quantity} unid) de ${product.name}.`,
                            "fa-exclamation-circle",
                            "var(--warning)",
                        );
                        return;
                    }
                } else {
                    if (qty > product.quantity) {
                        showModal(
                            "Limite de estoque",
                            `Quantidade solicitada (${qty}) maior que a disponível (${product.quantity}).`,
                            "fa-exclamation-circle",
                            "var(--warning)",
                        );
                        return;
                    }
                    const finalPrice =
                        product.special !== null ? product.special : product.price;
                    cart.push({
                        product_id: product.product_id,
                        name: product.name,
                        price: finalPrice,
                        image: product.image,
                        quantity: qty,
                        max_quantity: product.quantity,
                    });
                }

                renderCart();
            };

            window.updateQty = (productId, change) => {
                const item = cart.find((i) => i.product_id === productId);
                if (!item) return;

                const newQty = item.quantity + change;
                if (newQty <= 0) {
                    removeFromCart(productId);
                } else if (newQty <= item.max_quantity) {
                    item.quantity = newQty;
                    renderCart();
                } else {
                    showModal(
                        "Limite de estoque",
                        `Estoque máximo atingido para ${item.name} (${item.max_quantity} unidades).`,
                        "fa-exclamation-circle",
                        "var(--warning)",
                    );
                }
            };

            window.removeFromCart = (productId) => {
                cart = cart.filter((item) => item.product_id !== productId);
                renderCart();
            };

            const renderCart = () => {
                if (cart.length === 0) {
                    cartItemsList.innerHTML = `
                    <div class="empty-cart-state">
                        <i class="fas fa-shopping-basket empty-cart-icon"></i>
                        <p>Carrinho de pré-venda vazio</p>
                    </div>
                `;
                    cartSubtotal.textContent = formatMoney(0);
                    cartTotal.textContent = formatMoney(0);
                    checkoutBtn.disabled = true;
                    return;
                }

                let totalVal = 0;

                cartItemsList.innerHTML = cart
                    .map((item) => {
                        const itemTotal = item.price * item.quantity;
                        totalVal += itemTotal;

                        return `
                    <div class="cart-item">
                        <img src="${item.image}" class="cart-item-image" alt="${item.name}" onerror="this.src='/image/no-image.png'">
                        <div class="cart-item-details">
                            <h4 class="cart-item-name" title="${item.name}">${item.name}</h4>
                            <div class="cart-item-price">${formatMoney(item.price)}</div>
                        </div>
                        <div class="qty-controls">
                            <button class="qty-btn" onclick="updateQty(${item.product_id}, -1)">-</button>
                            <span class="qty-val">${item.quantity}</span>
                            <button class="qty-btn" onclick="updateQty(${item.product_id}, 1)">+</button>
                        </div>
                        <button class="remove-item-btn" onclick="removeFromCart(${item.product_id})">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                `;
                    })
                    .join("");

                cartSubtotal.textContent = formatMoney(totalVal);
                cartTotal.textContent = formatMoney(totalVal);
                checkoutBtn.disabled = false;
            };

            // 5. Salvar Pré-Venda
            checkoutBtn.addEventListener("click", () => {
                if (cart.length === 0) return;

                checkoutBtn.disabled = true;
                checkoutBtn.innerHTML =
                    '<i class="fas fa-spinner fa-spin"></i> Salvando...';

                const payload = {
                    customer_id: selectedCustomerId,
                    cart: cart.map((item) => ({
                        product_id: item.product_id,
                        quantity: item.quantity,
                    })),
                    idempotency_key: idempotencyKey,
                };

                fetch("{{ admin_path }}/pos/pedidos/salvar", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Idempotency-Key": idempotencyKey,
                    },
                    body: JSON.stringify(payload),
                })
                    .then((res) => {
                        if (res.status === 422) {
                            return res.json().then((data) => {
                                throw new Error(
                                    data.message ||
                                        "Requisição duplicada já processada.",
                                );
                            });
                        }
                        if (!res.ok) {
                            return res.json().then((data) => {
                                throw new Error(
                                    data.error || "Erro ao processar pré-venda.",
                                );
                            });
                        }
                        return res.json();
                    })
                    .then((data) => {
                        if (data.success && data.order_id) {
                            window.location.href = `{{ admin_path }}/pos/vendedor/checkout?order_id=${data.order_id}`;
                        } else {
                            throw new Error(
                                data.error || "Falha ao processar pré-venda.",
                            );
                        }
                    })
                    .catch((err) => {
                        console.error("Erro na requisição:", err);
                        showModal(
                            "Falha na Operação",
                            err.message,
                            "fa-exclamation-triangle",
                            "var(--danger)",
                        );

                        checkoutBtn.disabled = false;
                        checkoutBtn.innerHTML =
                            '<i class="fas fa-ticket-alt"></i> Salvar Pré-Venda';

                        idempotencyKey = generateUUID();
                    });
            });

            // 6. Exibição de Alertas Modal
            const showModal = (title, message, iconClass, iconColor) => {
                modalTitle.textContent = title;
                modalMessage.textContent = message;
                modalIcon.className = `fas ${iconClass} modal-icon`;
                modalIcon.style.color = iconColor;
                alertModal.style.display = "flex";
            };

            modalCloseBtn.addEventListener("click", () => {
                alertModal.style.display = "none";
            });

            // 7. Busca dinâmica com debounce
            let productSearchTimeout;
            productSearchInput.addEventListener("input", () => {
                clearTimeout(productSearchTimeout);
                productSearchTimeout = setTimeout(() => {
                    loadProducts(productSearchInput.value.trim());
                }, 300);
            });

            // Carga inicial do catálogo
            loadProducts();
        });
    </script>
{% endblock %}
