@startuml "Diagrama_Casos_De_Uso_Cliente"

' --- Estilo CSS Moderno (Corrigido para PlantUML) ---
<style>
root {
    BackgroundColor #FAFAFA
    FontName "Helvetica Neue"
    FontSize 13
}
arrow {
    LineColor #263238
}
actor {
    BackgroundColor #FFF3E0
    BorderColor #E65100
    LineColor #E65100
}
usecase {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    LineColor #1565C0
}
rectangle {
    BackgroundColor #FFFFFF
    BorderColor #37474F
    LineColor #37474F
}
</style>

left to right direction

actor "Visitante" as Guest
actor "Cliente Logado" as Customer
actor "Sistema / Gateway" as System

Guest <|-- Customer : Herda permissões

rectangle "Alpha Engine - Loja Virtual" {
    usecase "Navegar no Catálogo" as UC_Nav
    usecase "Buscar Produtos" as UC_Search
    usecase "Adicionar ao Carrinho" as UC_Cart
    usecase "Selecionar Variantes/Assinaturas" as UC_Cart_Inc
    usecase "Fazer Login / Cadastro" as UC_Auth
    usecase "Mesclar Carrinho na Sessão" as UC_Auth_Inc
    usecase "Realizar Checkout" as UC_Checkout
    usecase "Aplicar Cupom de Desconto" as UC_Coupon
    usecase "Comprar como Visitante (Guest)" as UC_Checkout_Ext
    usecase "Acompanhar Pedidos" as UC_Orders
    usecase "Solicitar Devolução de Produto" as UC_Return
    usecase "Processar Pagamento" as UC_Payment
}

' Associações Diretas do Visitante
Guest --> UC_Nav
Guest --> UC_Search
Guest --> UC_Cart
Guest --> UC_Auth
Guest --> UC_Checkout

' Inclusões (Include) - Ações Obrigatórias do Fluxo
UC_Cart ..> UC_Cart_Inc : <<include>>
UC_Auth ..> UC_Auth_Inc : <<include>>
UC_Checkout ..> UC_Payment : <<include>>

' Extensões (Extend) - Ações Opcionais do Fluxo
UC_Coupon .up.> UC_Checkout : <<extend>>
UC_Checkout_Ext .up.> UC_Checkout : <<extend>>

' Ações Exclusivas do Cliente Logado
Customer --> UC_Orders
Customer --> UC_Return

' Associação do Sistema (Externa)
System --> UC_Payment

@enduml
