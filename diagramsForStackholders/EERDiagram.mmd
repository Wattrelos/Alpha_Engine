erDiagram
    %% =========================================================================
    %% Alpha Engine Domain Model - Enhanced Entity-Relationship (EER) Diagram
    %% Mapeamento de Tipos: SQL (Coluna Type) -> PHP 64-bit (Coluna Comment)
    %%  - BIGINT / INT          -> PHP: int
    %%  - TINYINT(1)            -> PHP: bool
    %%  - VARCHAR / TEXT / CHAR -> PHP: string
    %%  - DECIMAL / FLOAT       -> PHP: float
    %%  - DATETIME / DATE       -> PHP: DateTimeInterface
    %% =========================================================================

    %% --- CATALOG MODULE ---
    Product {
        BIGINT id PK "PHP: int"
        VARCHAR(64) model "PHP: string"
        VARCHAR(64) sku "PHP: string"
        VARCHAR(12) upc "PHP: string"
        VARCHAR(14) ean "PHP: string"
        VARCHAR(13) jan "PHP: string"
        VARCHAR(13) isbn "PHP: string"
        VARCHAR(64) mpn "PHP: string"
        VARCHAR(128) location "PHP: string"
        VARCHAR(255) variant "PHP: string"
        TEXT override "PHP: string"
        DECIMAL(15,4) price "PHP: float"
        INT quantity "PHP: int"
        BIGINT stock_status_id FK "PHP: int"
        VARCHAR(255) image "PHP: string"
        BIGINT manufacturer_id FK "PHP: int"
        TINYINT(1) shipping "PHP: bool"
        INT points "PHP: int"
        BIGINT tax_class_id FK "PHP: int"
        DATE date_available "PHP: DateTimeInterface"
        DECIMAL(15,8) weight "PHP: float"
        BIGINT weight_class_id FK "PHP: int"
        DECIMAL(15,8) length "PHP: float"
        DECIMAL(15,8) width "PHP: float"
        DECIMAL(15,8) height "PHP: float"
        BIGINT length_class_id FK "PHP: int"
        TINYINT(1) subtract "PHP: bool"
        INT minimum "PHP: int"
        INT rating "PHP: int"
        TINYINT(1) status "PHP: bool"
        INT sort_order "PHP: int"
        DATETIME date_added "PHP: DateTimeInterface"
        DATETIME date_modified "PHP: DateTimeInterface"
        BIGINT master_id FK "PHP: int"
    }

    ProductDescription {
        BIGINT product_id PK, FK "PHP: int"
        BIGINT language_id PK, FK "PHP: int"
        VARCHAR(255) name "PHP: string"
        TEXT description "PHP: string"
        TEXT tag "PHP: string"
        VARCHAR(255) meta_title "PHP: string"
        VARCHAR(255) meta_description "PHP: string"
        VARCHAR(255) meta_keyword "PHP: string"
    }

    Category {
        BIGINT id PK "PHP: int"
        VARCHAR(255) image "PHP: string"
        BIGINT parent_id FK "PHP: int"
        INT sort_order "PHP: int"
        TINYINT(1) status "PHP: bool"
    }

    CategoryDescription {
        BIGINT category_id PK, FK "PHP: int"
        BIGINT language_id PK, FK "PHP: int"
        VARCHAR(255) name "PHP: string"
        TEXT description "PHP: string"
        VARCHAR(255) meta_title "PHP: string"
        VARCHAR(255) meta_description "PHP: string"
        VARCHAR(255) meta_keyword "PHP: string"
    }

    Manufacturer {
        BIGINT id PK "PHP: int"
        VARCHAR(64) name "PHP: string"
        VARCHAR(255) image "PHP: string"
        INT sort_order "PHP: int"
    }

    ProductImage {
        BIGINT id PK "PHP: int"
        BIGINT product_id FK "PHP: int"
        VARCHAR(255) image "PHP: string"
        INT sort_order "PHP: int"
    }

    ProductToCategory {
        BIGINT product_id PK, FK "PHP: int"
        BIGINT category_id PK, FK "PHP: int"
    }

    Option {
        BIGINT id PK "PHP: int"
        VARCHAR(32) type "PHP: string"
        INT sort_order "PHP: int"
    }

    OptionValue {
        BIGINT id PK "PHP: int"
        BIGINT option_id FK "PHP: int"
        VARCHAR(255) image "PHP: string"
        INT sort_order "PHP: int"
    }

    ProductOption {
        BIGINT id PK "PHP: int"
        BIGINT product_id FK "PHP: int"
        BIGINT option_id FK "PHP: int"
        TEXT value "PHP: string"
        TINYINT(1) required "PHP: bool"
    }

    ProductOptionValue {
        BIGINT id PK "PHP: int"
        BIGINT product_option_id FK "PHP: int"
        BIGINT product_id FK "PHP: int"
        BIGINT option_id FK "PHP: int"
        BIGINT option_value_id FK "PHP: int"
        INT quantity "PHP: int"
        TINYINT(1) subtract "PHP: bool"
        DECIMAL(15,4) price "PHP: float"
        VARCHAR(1) price_prefix "PHP: string"
        INT points "PHP: int"
        VARCHAR(1) points_prefix "PHP: string"
        DECIMAL(15,8) weight "PHP: float"
        VARCHAR(1) weight_prefix "PHP: string"
    }

    Review {
        BIGINT id PK "PHP: int"
        BIGINT product_id FK "PHP: int"
        BIGINT customer_id FK "PHP: int"
        VARCHAR(64) author "PHP: string"
        TEXT text "PHP: string"
        INT rating "PHP: int"
        TINYINT(1) status "PHP: bool"
        DATETIME date_added "PHP: DateTimeInterface"
        DATETIME date_modified "PHP: DateTimeInterface"
    }

    ProductDiscount {
        BIGINT id PK "PHP: int"
        BIGINT product_id FK "PHP: int"
        BIGINT customer_group_id FK "PHP: int"
        INT quantity "PHP: int"
        INT priority "PHP: int"
        DECIMAL(15,4) price "PHP: float"
        DATE date_start "PHP: DateTimeInterface"
        DATE date_end "PHP: DateTimeInterface"
    }

    Attribute {
        BIGINT id PK "PHP: int"
        BIGINT attribute_group_id FK "PHP: int"
        INT sort_order "PHP: int"
    }

    AttributeGroup {
        BIGINT id PK "PHP: int"
        INT sort_order "PHP: int"
    }

    ProductAttribute {
        BIGINT product_id PK, FK "PHP: int"
        BIGINT attribute_id PK, FK "PHP: int"
        BIGINT language_id PK, FK "PHP: int"
        TEXT text "PHP: string"
    }

    %% --- CUSTOMER MODULE ---
    Customer {
        BIGINT id PK "PHP: int"
        BIGINT customer_group_id FK "PHP: int"
        BIGINT store_id FK "PHP: int"
        BIGINT language_id FK "PHP: int"
        VARCHAR(32) firstname "PHP: string"
        VARCHAR(32) lastname "PHP: string"
        VARCHAR(96) email "PHP: string"
        VARCHAR(32) telephone "PHP: string"
        VARCHAR(255) password "PHP: string"
        TINYINT(1) newsletter "PHP: bool"
        VARCHAR(40) ip "PHP: string"
        TINYINT(1) status "PHP: bool"
        TINYINT(1) safe "PHP: bool"
        TINYINT(1) commenter "PHP: bool"
        VARCHAR(255) token "PHP: string"
        VARCHAR(40) code "PHP: string"
        DATETIME date_added "PHP: DateTimeInterface"
        VARCHAR(20) cpf_cnpj "PHP: string"
        VARCHAR(20) persontype "PHP: string"
        BIGINT address_id FK "PHP: int"
    }

    CustomerGroup {
        BIGINT id PK "PHP: int"
        INT approval "PHP: int"
        INT sort_order "PHP: int"
    }

    Address {
        BIGINT id PK "PHP: int"
        BIGINT customer_id FK "PHP: int"
        VARCHAR(32) firstname "PHP: string"
        VARCHAR(32) lastname "PHP: string"
        VARCHAR(40) company "PHP: string"
        VARCHAR(128) street "PHP: string"
        INT number "PHP: int"
        VARCHAR(128) complement "PHP: string"
        VARCHAR(128) district "PHP: string"
        VARCHAR(128) city "PHP: string"
        VARCHAR(10) postcode "PHP: string"
        BIGINT country_id FK "PHP: int"
        BIGINT zone_id FK "PHP: int"
        TEXT custom_field "PHP: string"
    }

    CustomerWishlist {
        BIGINT customer_id PK, FK "PHP: int"
        BIGINT product_id PK, FK "PHP: int"
        DATETIME date_added "PHP: DateTimeInterface"
    }

    CustomerIp {
        BIGINT id PK "PHP: int"
        BIGINT customer_id FK "PHP: int"
        VARCHAR(40) ip "PHP: string"
        BIGINT store_id "PHP: int"
        VARCHAR(64) country "PHP: string"
        DATETIME date_added "PHP: DateTimeInterface"
    }

    %% --- CHECKOUT & SALES MODULE ---
    Cart {
        BIGINT id PK "PHP: int"
        BIGINT store_id FK "PHP: int"
        BIGINT customer_id FK "PHP: int"
        VARCHAR(255) token_session "PHP: string"
        BIGINT product_id FK "PHP: int"
        BIGINT subscription_plan_id FK "PHP: int"
        TEXT option "PHP: string"
        INT quantity "PHP: int"
        TEXT override "PHP: string"
        DECIMAL(15,4) price "PHP: float"
        DATETIME date_added "PHP: DateTimeInterface"
    }

    Order {
        BIGINT id PK "PHP: int"
        BIGINT store_id FK "PHP: int"
        BIGINT customer_id FK "PHP: int"
        BIGINT customer_group_id "PHP: int"
        VARCHAR(32) firstname "PHP: string"
        VARCHAR(32) lastname "PHP: string"
        VARCHAR(96) email "PHP: string"
        VARCHAR(32) telephone "PHP: string"
        VARCHAR(32) payment_firstname "PHP: string"
        VARCHAR(32) payment_lastname "PHP: string"
        VARCHAR(40) payment_company "PHP: string"
        VARCHAR(128) payment_street "PHP: string"
        INT payment_number "PHP: int"
        VARCHAR(128) payment_complement "PHP: string"
        VARCHAR(128) payment_district "PHP: string"
        VARCHAR(128) payment_city "PHP: string"
        VARCHAR(10) payment_postcode "PHP: string"
        VARCHAR(128) payment_country "PHP: string"
        BIGINT payment_country_id "PHP: int"
        VARCHAR(128) payment_zone "PHP: string"
        BIGINT payment_zone_id "PHP: int"
        VARCHAR(128) payment_method "PHP: string"
        VARCHAR(32) shipping_firstname "PHP: string"
        VARCHAR(32) shipping_lastname "PHP: string"
        VARCHAR(40) shipping_company "PHP: string"
        VARCHAR(128) shipping_street "PHP: string"
        INT shipping_number "PHP: int"
        VARCHAR(128) shipping_complement "PHP: string"
        VARCHAR(128) shipping_district "PHP: string"
        VARCHAR(128) shipping_city "PHP: string"
        VARCHAR(10) shipping_postcode "PHP: string"
        VARCHAR(128) shipping_country "PHP: string"
        BIGINT shipping_country_id "PHP: int"
        VARCHAR(128) shipping_zone "PHP: string"
        BIGINT shipping_zone_id "PHP: int"
        VARCHAR(128) shipping_method "PHP: string"
        DECIMAL(15,4) total "PHP: float"
        BIGINT order_status_id FK "PHP: int"
        BIGINT affiliate_id "PHP: int"
        DECIMAL(15,4) commission "PHP: float"
        BIGINT marketing_id "PHP: int"
        VARCHAR(64) tracking "PHP: string"
        BIGINT language_id FK "PHP: int"
        BIGINT currency_id FK "PHP: int"
        VARCHAR(3) currency_code "PHP: string"
        DECIMAL(15,8) currency_value "PHP: float"
        VARCHAR(40) ip "PHP: string"
        VARCHAR(40) forwarded_ip "PHP: string"
        VARCHAR(255) user_agent "PHP: string"
        VARCHAR(255) accept_language "PHP: string"
        DATETIME date_added "PHP: DateTimeInterface"
        DATETIME date_modified "PHP: DateTimeInterface"
    }

    OrderProduct {
        BIGINT id PK "PHP: int"
        BIGINT order_id FK "PHP: int"
        BIGINT product_id FK "PHP: int"
        VARCHAR(255) name "PHP: string"
        VARCHAR(64) model "PHP: string"
        INT quantity "PHP: int"
        DECIMAL(15,4) price "PHP: float"
        DECIMAL(15,4) total "PHP: float"
        DECIMAL(15,4) tax "PHP: float"
        INT reward "PHP: int"
    }

    OrderOption {
        BIGINT id PK "PHP: int"
        BIGINT order_id FK "PHP: int"
        BIGINT order_product_id FK "PHP: int"
        BIGINT product_option_id "PHP: int"
        BIGINT product_option_value_id "PHP: int"
        VARCHAR(255) name "PHP: string"
        TEXT value "PHP: string"
        VARCHAR(32) type "PHP: string"
    }

    OrderHistory {
        BIGINT id PK "PHP: int"
        BIGINT order_id FK "PHP: int"
        BIGINT order_status_id FK "PHP: int"
        TINYINT(1) notify "PHP: bool"
        TEXT comment "PHP: string"
        DATETIME date_added "PHP: DateTimeInterface"
    }

    OrderTotal {
        BIGINT id PK "PHP: int"
        BIGINT order_id FK "PHP: int"
        VARCHAR(32) code "PHP: string"
        VARCHAR(255) title "PHP: string"
        DECIMAL(15,4) value "PHP: float"
        INT sort_order "PHP: int"
    }

    OrderStatus {
        BIGINT id PK "PHP: int"
        VARCHAR(32) name "PHP: string"
    }

    %% --- SUBSCRIPTION MODULE ---
    SubscriptionPlan {
        BIGINT id PK "PHP: int"
        VARCHAR(10) trial_frequency "PHP: string"
        INT trial_cycle "PHP: int"
        INT trial_duration "PHP: int"
        TINYINT(1) trial_status "PHP: bool"
        VARCHAR(10) frequency "PHP: string"
        INT cycle "PHP: int"
        INT duration "PHP: int"
        INT sort_order "PHP: int"
        TINYINT(1) status "PHP: bool"
    }

    SubscriptionPlanDescription {
        BIGINT subscription_plan_id PK, FK "PHP: int"
        BIGINT language_id PK, FK "PHP: int"
        VARCHAR(255) name "PHP: string"
    }

    Subscription {
        BIGINT id PK "PHP: int"
        BIGINT order_id FK "PHP: int"
        BIGINT customer_id FK "PHP: int"
        BIGINT subscription_plan_id FK "PHP: int"
        BIGINT store_id FK "PHP: int"
        BIGINT payment_address_id "PHP: int"
        VARCHAR(128) payment_method "PHP: string"
        BIGINT shipping_address_id "PHP: int"
        VARCHAR(128) shipping_method "PHP: string"
        DECIMAL(15,4) trial_price "PHP: float"
        DECIMAL(15,4) trial_tax "PHP: float"
        VARCHAR(10) trial_frequency "PHP: string"
        INT trial_cycle "PHP: int"
        INT trial_duration "PHP: int"
        INT trial_remaining "PHP: int"
        TINYINT(1) trial_status "PHP: bool"
        DECIMAL(15,4) price "PHP: float"
        DECIMAL(15,4) tax "PHP: float"
        VARCHAR(10) frequency "PHP: string"
        INT cycle "PHP: int"
        INT duration "PHP: int"
        INT remaining "PHP: int"
        DATETIME date_next "PHP: DateTimeInterface"
        VARCHAR(64) language "PHP: string"
        VARCHAR(64) currency "PHP: string"
        BIGINT subscription_status_id FK "PHP: int"
        TEXT comment "PHP: string"
        DATETIME date_added "PHP: DateTimeInterface"
        DATETIME date_modified "PHP: DateTimeInterface"
    }

    SubscriptionStatus {
        BIGINT id PK "PHP: int"
        VARCHAR(32) name "PHP: string"
    }

    %% --- LOCALIZATION MODULE ---
    Language {
        BIGINT id PK "PHP: int"
        VARCHAR(32) name "PHP: string"
        VARCHAR(5) code "PHP: string"
        VARCHAR(255) locale "PHP: string"
        VARCHAR(64) image "PHP: string"
        VARCHAR(32) directory "PHP: string"
        TINYINT(1) status "PHP: bool"
        INT sort_order "PHP: int"
    }

    Currency {
        BIGINT id PK "PHP: int"
        VARCHAR(32) title "PHP: string"
        VARCHAR(3) code "PHP: string"
        VARCHAR(12) symbol_left "PHP: string"
        VARCHAR(12) symbol_right "PHP: string"
        CHAR(1) decimal_place "PHP: string"
        FLOAT(15,8) value "PHP: float"
        TINYINT(1) status "PHP: bool"
        DATETIME date_modified "PHP: DateTimeInterface"
    }

    Country {
        BIGINT id PK "PHP: int"
        VARCHAR(128) name "PHP: string"
        VARCHAR(2) iso_code_2 "PHP: string"
        VARCHAR(3) iso_code_3 "PHP: string"
        TEXT address_format "PHP: string"
        TINYINT(1) postcode_required "PHP: bool"
        TINYINT(1) status "PHP: bool"
    }

    Zone {
        BIGINT id PK "PHP: int"
        BIGINT country_id FK "PHP: int"
        VARCHAR(128) name "PHP: string"
        VARCHAR(32) code "PHP: string"
        TINYINT(1) status "PHP: bool"
    }

    City {
        BIGINT id PK "PHP: int"
        BIGINT zone_id FK "PHP: int"
        VARCHAR(128) name "PHP: string"
        TINYINT(1) is_served "PHP: bool"
    }

    TaxClass {
        BIGINT id PK "PHP: int"
        VARCHAR(32) title "PHP: string"
        VARCHAR(255) description "PHP: string"
        DATETIME date_added "PHP: DateTimeInterface"
        DATETIME date_modified "PHP: DateTimeInterface"
    }

    TaxRate {
        BIGINT id PK "PHP: int"
        VARCHAR(32) name "PHP: string"
        DECIMAL(15,4) rate "PHP: float"
        CHAR(1) type "PHP: string"
        DATETIME date_added "PHP: DateTimeInterface"
        DATETIME date_modified "PHP: DateTimeInterface"
    }

    TaxRule {
        BIGINT id PK "PHP: int"
        BIGINT tax_class_id FK "PHP: int"
        BIGINT tax_rate_id FK "PHP: int"
        VARCHAR(10) based "PHP: string"
        INT priority "PHP: int"
    }

    %% --- SYSTEM & STORE ---
    Store {
        BIGINT id PK "PHP: int"
        VARCHAR(64) name "PHP: string"
        VARCHAR(255) url "PHP: string"
    }

    %% --- PROCUREMENT MODULE ---
    Supplier {
        BIGINT id PK "PHP: int"
        VARCHAR(255) company_name "PHP: string"
        VARCHAR(255) trade_name "PHP: string"
        VARCHAR(14) tax_id "PHP: string"
        VARCHAR(32) state_registration "PHP: string"
        VARCHAR(32) municipal_registration "PHP: string"
        VARCHAR(96) email "PHP: string"
        VARCHAR(32) phone "PHP: string"
        VARCHAR(255) website "PHP: string"
        TINYINT(1) is_active "PHP: bool"
        DATETIME created_at "PHP: DateTimeInterface"
        DATETIME updated_at "PHP: DateTimeInterface"
    }

    Contact {
        BIGINT id PK "PHP: int"
        VARCHAR(120) name "PHP: string"
        VARCHAR(120) email "PHP: string"
        VARCHAR(50) phone "PHP: string"
        VARCHAR(100) position "PHP: string"
        TINYINT(1) is_active "PHP: bool"
        DATETIME created_at "PHP: DateTimeInterface"
        DATETIME updated_at "PHP: DateTimeInterface"
    }

    SupplierAddress {
        BIGINT id PK "PHP: int"
        BIGINT supplier_id FK "PHP: int"
        BIGINT country_id FK "PHP: int"
        BIGINT zone_id FK "PHP: int"
        BIGINT city_id FK "PHP: int"
        VARCHAR(10) postal_code "PHP: string"
        VARCHAR(255) street "PHP: string"
        VARCHAR(32) number "PHP: string"
        VARCHAR(255) complement "PHP: string"
        VARCHAR(128) district "PHP: string"
    }

    SupplierContactManufacturer {
        BIGINT supplier_id PK, FK "PHP: int"
        BIGINT contact_id PK, FK "PHP: int"
        BIGINT manufacturer_id PK, FK "PHP: int"
        DATETIME created_at "PHP: DateTimeInterface"
    }

    %% =========================================================================
    %% RELATIONSHIPS
    %% =========================================================================

    %% Catalog Module
    Product ||--|{ ProductDescription : "described by"
    Product ||--|{ ProductImage : "has"
    Product ||--|{ ProductToCategory : "categorized in"
    Category ||--|{ ProductToCategory : "holds"
    Category ||--|{ CategoryDescription : "described by"
    Category |o--|{ Category : "parent of"
    Manufacturer |o--|{ Product : "manufactures"

    Option ||--|{ OptionValue : "defines values"
    Option ||--|{ ProductOption : "offered by"
    ProductOption ||--|{ ProductOptionValue : "variants"
    OptionValue ||--|{ ProductOptionValue : "instantiates"
    Product ||--|{ ProductOption : "has options"
    Product ||--|{ ProductOptionValue : "has variant details"

    Product ||--|{ ProductDiscount : "offered with discount"
    Product ||--|{ ProductAttribute : "specified by"
    Attribute ||--|{ ProductAttribute : "defines type"
    AttributeGroup ||--|{ Attribute : "groups"

    %% Customer Module
    CustomerGroup ||--|{ Customer : "classifies"
    CustomerGroup ||--|{ ProductDiscount : "targets"
    Customer ||--|{ Address : "has"
    Customer |o--|| Address : "default address"
    Customer ||--|{ CustomerWishlist : "saves to"
    Product ||--|{ CustomerWishlist : "saved on"
    Customer ||--|{ CustomerIp : "logs IP"
    Customer ||--|{ Review : "writes"
    Product ||--|{ Review : "rated by"

    %% Checkout & Sales Module
    Customer ||--|{ Cart : "has active items"
    Product ||--|{ Cart : "item in cart"
    SubscriptionPlan |o--|{ Cart : "item subscription billing plan"
    Store ||--|{ Cart : "contains cart context"

    Customer ||--|{ Order : "places"
    Store ||--|{ Order : "records order in context"
    OrderStatus ||--|{ Order : "indicates status"
    Language ||--|{ Order : "placed using"
    Currency ||--|{ Order : "billed in"

    Order ||--|{ OrderProduct : "contains"
    Product ||--|{ OrderProduct : "sold in"
    OrderProduct ||--|{ OrderOption : "configured by"
    Order ||--|{ OrderTotal : "tallies cost"
    Order ||--|{ OrderHistory : "audited by"
    OrderStatus ||--|{ OrderHistory : "stage reached"

    %% Subscription Module
    SubscriptionPlan ||--|{ SubscriptionPlanDescription : "described by"
    SubscriptionPlan ||--|{ Subscription : "bills under"
    Customer ||--|{ Subscription : "holds subscription"
    Order ||--|{ Subscription : "billed in order"
    SubscriptionStatus ||--|{ Subscription : "indicates current state"

    %% Localization Module
    Language ||--|{ ProductDescription : "translation"
    Language ||--|{ CategoryDescription : "translation"
    Language ||--|{ ProductAttribute : "translation"
    Language ||--|{ SubscriptionPlanDescription : "translation"

    Country ||--|{ Zone : "contains zones"
    Zone ||--|{ City : "contains cities"
    Country ||--|{ Address : "address country"
    Zone ||--|{ Address : "address state/zone"

    TaxClass ||--|{ TaxRule : "contains rules"
    TaxRate ||--|{ TaxRule : "applied rate"
    TaxClass ||--|{ Product : "tax configuration"

    %% Procurement Module
    Supplier ||--|| SupplierAddress : "located at"
    Supplier ||--|{ SupplierContactManufacturer : "associated through"
    Contact ||--|{ SupplierContactManufacturer : "linked to"
    Manufacturer ||--|{ SupplierContactManufacturer : "represented by"
    Country ||--|{ SupplierAddress : "address country"
    Zone ||--|{ SupplierAddress : "address state/zone"
    City ||--|{ SupplierAddress : "address city"
