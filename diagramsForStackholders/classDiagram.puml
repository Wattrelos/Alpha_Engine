header "Material Didático: Engenharia de Software no E-commerce Alpha Engine"
title "Diagrama de Classes de Domínio, Persistência e Padrões GoF / DDD"

' ═════════════════════════════════════════════════════════════════════════════
' CAMADA 0 — CONTAINER E INJEÇÃO DE DEPENDÊNCIA (PSR-11)
' ═════════════════════════════════════════════════════════════════════════════
package "0. Framework & Injeção de Dependências (PSR-11)" as PkIoC #dce8f5 {
    interface ContainerInterface <<PSR-11>> {
        + get(id: string): mixed
        + has(id: string): bool
    }

    class AppContainer <<Service Locator / DI>> {
        - instances: array
        - bindings: array
        + bind(key: string, resolver: mixed): void
        + get(id: string): mixed
        + has(id: string): bool
    }
}

' ═════════════════════════════════════════════════════════════════════════════
' CAMADA 1 — ACTIONS E CONTROLLERS (SINGLE ACTION & TEMPLATE METHOD)
' ═════════════════════════════════════════════════════════════════════════════
package "1. Camada de Controladores (Actions & Controllers)" as PkControllers #e1f5fe {
    interface ActionInterface <<Interface>> {
        + __invoke(request: Request, response: Response, args: array): Response
    }

    abstract class BaseController <<Template Method>> {
        # storeId: int
        # languageId: int
        # container: ContainerInterface
        # viewRenderer: ViewRenderer
        + __construct(container: ContainerInterface)
        # getRepository(class: string): mixed
        # getMapper(class: string): mixed
        # remember(cacheKey: string, generator: callable, ttl: int): mixed
        # getTemplate(route: string, data: array): string
    }

    class ProcessPaymentAction <<Front-end Single Action>> {
        - uow: UnitOfWork
        - orderRepository: OrderRepository
        - twig: TwigEnvironment
        + __construct(uow: UnitOfWork, orderRepo: OrderRepository, twig: TwigEnvironment)
        + __invoke(request: Request, response: Response, args: array): Response
    }

    class PayOrderAction <<Admin Action (Template Method)>> {
        + __invoke(request: Request, response: Response, args: array): Response
    }
}

' ═════════════════════════════════════════════════════════════════════════════
' CAMADA 2 — DOMÍNIO E REPOSITÓRIOS (DDD & REPOSITORY PATTERN)
' ═════════════════════════════════════════════════════════════════════════════
package "4. Camada de Domínio (DDD & Aggregates)" as PkDomain #e8f5e9 {
    abstract class BaseEntity <<Aggregate Root>> {
        # id: ?int
        + getId(): ?int
        + setId(id: int): void
        + toArray(): array
    }

    class Order <<Entity>> {
        - customerId: int
        - total: float
        - orderStatusId: int
        - dateAdded: DateTimeImmutable
        + getCustomerId(): int
        + getTotal(): float
        + getOrderStatusId(): int
        + setOrderStatusId(statusId: int): void
        + getDateAdded(): DateTimeImmutable
    }

    class Customer <<Entity>> {
        - firstname: string
        - lastname: string
        - email: string
        - status: bool
        + getFirstname(): string
        + getEmail(): string
    }

    abstract class AbstractRepository <<Repository Pattern>> {
        # identityMap: array
        + {abstract} find(id: int): ?BaseEntity
        + {abstract} save(entity: BaseEntity): void
        + {abstract} delete(id: int): void
    }

    class OrderRepository <<Domain Repository>> {
        - mapper: OrderMapper
        - unitOfWork: UnitOfWork
        + find(id: int): ?Order
        + save(order: BaseEntity): void
        + updateStatus(orderId: int, statusId: int): void
    }

    class RepositoryFactory <<Singleton / Factory>> {
        - {static} instance: ?RepositoryFactory
        - instances: array
        + {static} getInstance(): RepositoryFactory
        + get(class: string): mixed
    }
}

' ═════════════════════════════════════════════════════════════════════════════
' CAMADA 3 — INFRAESTRUTURA DE PERSISTÊNCIA (DATA MAPPER, UOW & DAO)
' ═════════════════════════════════════════════════════════════════════════════
package "5. Infraestrutura de Persistência (Data Mapper & Transações)" as PkPersistence #fff3e0 {
    abstract class BaseMapper <<Data Mapper Pattern>> {
        # dao: DataAccessObject
        + {abstract} mapToEntity(data: object): BaseEntity
        + {abstract} mapToRow(entity: BaseEntity): array
    }

    class OrderMapper <<Data Mapper>> {
        + findById(id: int): ?Order
        + insert(order: Order): int
        + update(order: Order): bool
    }

    class MapperFactory <<Singleton / Factory>> {
        - {static} instance: ?MapperFactory
        - instances: array
        + {static} getInstance(): MapperFactory
        + get(class: string): mixed
    }

    class UnitOfWork <<Transaction Manager (ACID)>> {
        - db: PDO
        + __construct()
        + transaction(callback: callable): mixed
        + start(): void
        + commit(): void
        + rollback(): void
    }

    class DataAccessObject <<DAO & Identity Map>> {
        - pdo: PDO
        - identityMap: array
        + fetchObject(sql: string, params: array): ?object
        + fetchAll(sql: string, params: array): array
        + execute(sql: string, params: array): bool
    }

    class QueryBuilder <<Fluent SQL Builder>> {
        - sql: string
        - params: array
        + select(columns: string): QueryBuilder
        + from(table: string): QueryBuilder
        + where(condition: string, value: mixed): QueryBuilder
        + execute(): mixed
    }
}

' ═════════════════════════════════════════════════════════════════════════════
' CAMADA 4 — RECURSOS TRANSVERSAIS, EVENTS E CACHE (STRATEGY & OBSERVER)
' ═════════════════════════════════════════════════════════════════════════════
package "6. Infraestrutura de Suporte & Eventos" as PkSupport #f3e5f5 {
    class EventDispatcher <<Domain Observer>> {
        - listeners: array
        + dispatch(event: object): void
        + addListener(eventName: string, listener: callable): void
    }

    class OrderCreatedEvent <<Domain Event>> {
        + orderId: int
        + total: float
        + __construct(orderId: int, total: float)
    }

    interface CacheStrategyInterface <<Strategy Pattern>> {
        + get(key: string): mixed
        + set(key: string, value: mixed, ttl: int): bool
    }

    class RedisCache <<Strategy Concrete>> {
        - redis: Redis
        + get(key: string): mixed
        + set(key: string, value: mixed, ttl: int): bool
    }
}

' ─────────────────────────────────────────────────────────────────────────────
' HERANÇAS E REALIZAÇÕES (INTERFACES & HERANÇA)
' ─────────────────────────────────────────────────────────────────────────────

AppContainer .up.|> ContainerInterface : implements
ProcessPaymentAction .up.|> ActionInterface : implements
PayOrderAction .up.|> ActionInterface : implements
PayOrderAction --|> BaseController : extends

Order --|> BaseEntity : extends
Customer --|> BaseEntity : extends

OrderRepository --|> AbstractRepository : extends
OrderMapper --|> BaseMapper : extends

RedisCache .up.|> CacheStrategyInterface : implements

' ─────────────────────────────────────────────────────────────────────────────
' ASSOCIAÇÕES, COMPOSIÇÕES E DEPENDÊNCIAS
' ─────────────────────────────────────────────────────────────────────────────

BaseController o-- ContainerInterface : holds
BaseController ..> RepositoryFactory : uses
BaseController ..> MapperFactory : uses

ProcessPaymentAction --> UnitOfWork : DI
ProcessPaymentAction --> OrderRepository : DI

OrderRepository --> OrderMapper : delegates persistence
OrderRepository --> UnitOfWork : transactional scope

OrderMapper --> DataAccessObject : uses SQL execution
DataAccessObject --> QueryBuilder : builds parameterized queries
DataAccessObject --> Order : hydrates entities

UnitOfWork ..> DataAccessObject : manages PDO transaction
RepositoryFactory ..> AbstractRepository : instantiates
MapperFactory ..> BaseMapper : instantiates

ProcessPaymentAction ..> EventDispatcher : dispatches event
EventDispatcher --> OrderCreatedEvent : notifies listeners
BaseController ..> CacheStrategyInterface : remembers via strategy

@enduml
