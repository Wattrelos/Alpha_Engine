@startuml EER_Diagram
' Fundo branco em toda a folha
skinparam backgroundColor #FFFFFF
skinparam shadowing false

' --- CONFIGURAÇÃO VISUAL DA LEGENDA ---
skinparam legend {
    BackgroundColor #e5f2ffff
    BorderColor #A0AAB5
    FontSize 11
}

' --- ETIQUETA DE IDENTIFICAÇÃO DO BLUEPRINT & MAPEAMENTO DE TIPOS ---
legend top left
  |= <size:14>**Blueprint: Modelo de Dados do Sistema**</size> |= <size:14>**Mapeamento de Tipos (Arquitetura)**</size> |
  | **Tipo:** Arquitetura de Dados / Modelo Físico | **Banco de Dados (DB)** -> **PHP (64-bit)** |
  | **Versão:** v1.0.8  | BIGINT (8 bytes, PK/FK) -> int (8-byte integer) |
  | **Data:** 05/08/2026 | INT (4 bytes) -> int |
  | **Autor:** Josias da Conceição Sobrinho © 2026 | TINYINT(1) -> bool |
  | **Licença:** MIT License (Open Source) | VARCHAR / TEXT -> string |
  | **Status:** <color:green>**Em desenvolvimento (80%). Sujeito a alterações**</color> | DATETIME / DATE -> DateTimeInterface |
  | <size:9><color:gray>Disponibilizado nos termos da licença MIT. Permissão livre concedida.</color></size> |
endlegend


!theme plain
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadow shading false
skinparam class {
    BorderColor #444444
    ArrowColor #555555
}

header Alpha Engine Domain Model
title Enhanced Entity-Relationship (EER) Diagram for AI Agents

package "Catalog Module" #FFF2CC {
    entity Product #FFF9E6 {
        * id : int <<PK>>
        --
        * model : varchar(64)
        * sku : varchar(64)
        * upc : varchar(12)
        * ean : varchar(14)
        * jan : varchar(13)
        * isbn : varchar(13)
        * mpn : varchar(64)
        * location : varchar(128)
        * variant : varchar(255)
        * override : text
        * price : decimal(15,4)
        * quantity : int
        * stock_status_id : int <<FK>>
        * image : varchar(255)
        * manufacturer_id : int <<FK>>
        * shipping : tinyint(1)
        * points : int
        * tax_class_id : int <<FK>>
        * date_available : date
        * weight : decimal(15,8)
        * weight_class_id : int <<FK>>
        * length : decimal(15,8)
        * width : decimal(15,8)
        * height : decimal(15,8)
        * length_class_id : int <<FK>>
        * subtract : tinyint(1)
        * minimum : int
        * rating : int
        * status : tinyint(1)
        * sort_order : int
        * date_added : datetime
        * date_modified : datetime
        * master_id : int <<FK>>
    }

    entity ProductDescription #FFF9E6 {
        * product_id : int <<PK, FK>>
        * language_id : int <<PK, FK>>
        --
        * name : varchar(255)
        * description : text
        * tag : text
        * meta_title : varchar(255)
        * meta_description : varchar(255)
        * meta_keyword : varchar(255)
    }

    entity Category #FFF9E6 {
        * id : int <<PK>>
        --
        * image : varchar(255)
        * parent_id : int <<FK>>
        * sort_order : int
        * status : tinyint(1)
    }

    entity CategoryDescription #FFF9E6 {
        * category_id : int <<PK, FK>>
        * language_id : int <<PK, FK>>
        --
        * name : varchar(255)
        * description : text
        * meta_title : varchar(255)
        * meta_description : varchar(255)
        * meta_keyword : varchar(255)
    }

    entity Manufacturer #FFF9E6 {
        * id : int <<PK>>
        --
        * name : varchar(64)
        * image : varchar(255)
        * sort_order : int
    }

    entity ProductImage #FFF9E6 {
        * id : int <<PK>>
        --
        * product_id : int <<FK>>
        * image : varchar(255)
        * sort_order : int
    }

    entity ProductToCategory #FFF9E6 {
        * product_id : int <<PK, FK>>
        * category_id : int <<PK, FK>>
    }

    entity Option #FFF9E6 {
        * id : int <<PK>>
        --
        * type : varchar(32)
        * sort_order : int
    }

    entity OptionValue #FFF9E6 {
        * id : int <<PK>>
        --
        * option_id : int <<FK>>
        * image : varchar(255)
        * sort_order : int
    }

    entity ProductOption #FFF9E6 {
        * id : int <<PK>>
        --
        * product_id : int <<FK>>
        * option_id : int <<FK>>
        * value : text
        * required : tinyint(1)
    }

    entity ProductOptionValue #FFF9E6 {
        * id : int <<PK>>
        --
        * product_option_id : int <<FK>>
        * product_id : int <<FK>>
        * option_id : int <<FK>>
        * option_value_id : int <<FK>>
        * quantity : int
        * subtract : tinyint(1)
        * price : decimal(15,4)
        * price_prefix : varchar(1)
        * points : int
        * points_prefix : varchar(1)
        * weight : decimal(15,8)
        * weight_prefix : varchar(1)
    }

    entity Review #FFF9E6 {
        * id : int <<PK>>
        --
        * product_id : int <<FK>>
        * customer_id : int <<FK>>
        * author : varchar(64)
        * text : text
        * rating : int
        * status : tinyint(1)
        * date_added : datetime
        * date_modified : datetime
    }

    entity ProductDiscount #FFF9E6 {
        * id : int <<PK>>
        --
        * product_id : int <<FK>>
        * customer_group_id : int <<FK>>
        * quantity : int
        * priority : int
        * price : decimal(15,4)
        * date_start : date
        * date_end : date
    }

    entity Attribute #FFF9E6 {
        * id : int <<PK>>
        --
        * attribute_group_id : int <<FK>>
        * sort_order : int
    }

    entity AttributeGroup #FFF9E6 {
        * id : int <<PK>>
        --
        * sort_order : int
    }

    entity ProductAttribute #FFF9E6 {
        * product_id : int <<PK, FK>>
        * attribute_id : int <<PK, FK>>
        * language_id : int <<PK, FK>>
        --
        * text : text
    }
}

