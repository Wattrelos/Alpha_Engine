        "psr-4": {
            "Alpha\\": "core/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "sort-packages": true
    },
    "require": {
        "predis/predis": "^3.4",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "twig/twig": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "scripts": {
        "alpha:evo": "php -r \"require 'vendor/autoload.php'; (new Alpha\\Support\\EvolutionGenerator())->run();\""
    }
