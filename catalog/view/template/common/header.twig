<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{ title }}</title>
  <base href="{{ base }}"/>
  {% if description %}
    <meta name="description" content="{{ description }}"/>
  {% endif %}
  {% if keywords %}
    <meta name="keywords" content="{{ keywords }}"/>
  {% endif %}
  {% if icon %}
    <link rel="icon" href="{{ icon }}" type="image/png">
  {% endif %}

  <!-- Bibliotecas Core do OpenCart (Obrigatórias para o Carrinho e Bootstrap) -->
  <script src="catalog/view/javascript/jquery/jquery-3.7.1.min.js" type="text/javascript"></script>
  <link href="catalog/view/stylesheet/bootstrap.css" rel="stylesheet" media="screen" />
  <script src="catalog/view/javascript/bootstrap/js/bootstrap.bundle.min.js" type="text/javascript"></script>
  <link href="catalog/view/stylesheet/fonts/fontawesome/css/all.min.css" rel="stylesheet" type="text/css" />
  <script src="catalog/view/javascript/common.js" type="text/javascript"></script>
  <link href="catalog/view/stylesheet/custom/personalizada.css" rel="stylesheet" type="text/css" />

  {% for style in styles %}
    <link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}"/>
  {% endfor %}
  {% for script in scripts %}
    {# Alpha Engine: Previne bugs caso o script venha como String em vez de Array #}
    <script src="{{ script.href ? script.href : script }}" type="text/javascript"></script>
  {% endfor %}
  {% for link in links %}
    <link href="{{ link.href }}" rel="{{ link.rel }}"/>
  {% endfor %}
  {% for analytic in analytics %}
    {{ analytic }}
  {% endfor %}
</head>
<body>
<div id="container">
  <div class="telhado">
    <header>
      <div class="container">
          {# Adicionamos align-items-center para que o menu da direita e o logo fiquem alinhados verticalmente ao centro #}
          <div class="row align-items-center">
            
            {# Logo ajustado à esquerda: 'col-auto' faz a coluna ter exatamente a largura da sua imagem #}
            <div class="col-auto">
              <div id="logo">
            {% if logo %}
              <a href="{{ home }}"><img src="{{ logo }}" title="{{ name }}" alt="{{ name }}" class="img-fluid"/></a>
            {% else %}
              <h1><a href="{{ home }}">{{ name }}</a></h1>
            {% endif %}
          </div>
            </div>
            
            {# 'col' (sem número) automaticamente preenche 100% de todo o espaço horizontal restante #}
            <div class="col">          
            <div class="row">             
              <div class="col text-end">
                <nav class="navbar navbar-expand-lg border-bottom border-body bg-primary bg-dark" data-bs-theme="dark">
                  <div class="container-fluid">                                        
                    <ul class="nav nav-pills nav-fill me-auto mb-2 mb-lg-0" >
                      <li class="nav-item"><a href="{{ home }}"    class="nav-link"><i class="fa-solid fa-house"></i><span class="d-none d-lg-inline"> {{ text_home }}</span></a></li>
                      <li class="nav-item"><a href="{{ contact }}" class="nav-link"><i class="fa-solid fa-phone"></i><span class="d-none d-lg-inline"> {{ telephone }}</span></a></li>
                      <li class="nav-item dropdown">
                          <a href="#" class="dropdown-toggle nav-link" data-bs-toggle="dropdown"><i class="fa-solid fa-user"></i> <span class="d-none d-lg-inline">{{ text_account }}</span> <i class="fa-solid fa-caret-down"></i></a>
                          <ul class="dropdown-menu dropdown-menu-dark">
                            {% if not logged %}
                              <li><a href="{{ register }}"    class="dropdown-item">{{ text_register }}</a></li>
                              <li><a href="{{ login }}"       class="dropdown-item">{{ text_login }}</a></li>
                            {% else %}
                              <li><a href="{{ account }}"     class="dropdown-item">{{ text_account }}</a></li>
                              <li><a href="{{ order }}"       class="dropdown-item">{{ text_order }}</a></li>
                              <li><a href="{{ transaction }}" class="dropdown-item">{{ text_transaction }}</a></li>
                              <li><a href="{{ logout }}"      class="dropdown-item">{{ text_logout }}</a></li>
                            {% endif %}
                          </ul>
                      </li>
                      <li class="nav-item"><a class="nav-link" href="{{ wishlist }}" id="wishlist-total" title="{{ text_wishlist }}">     <i class="fa-solid fa-heart"></i>         <span class="d-none d-lg-inline">{{ text_wishlist }}</span></a></li>
                      <li class="nav-item"><a class="nav-link" href="{{ shopping_cart }}"                title="{{ text_shopping_cart }}"><i class="fa-solid fa-cart-shopping"></i> <span class="d-none d-lg-inline">{{ text_shopping_cart }}</span></a></li>
                      <li class="nav-item"><a class="nav-link" href="{{ checkout }}"                     title="{{ text_checkout }}">     <i class="fa-solid fa-share"></i>         <span class="d-none d-lg-inline">{{ text_checkout }}</span></a></li>
                    </ul>
                  </div>
                </nav>
              </div>
            </div>            
            <!-- Tudo Ok. Barra de utilidades (Menu, Busca, Carrinho) utilizando Grid nativo do Bootstrap -->
            <div id="top" class="row align-items-center mt-3 mb-3">
              <div class="col-12 col-md-auto mb-2 mb-md-0">{{ menu }}</div>
              <div class="col-12 col-md mb-2 mb-md-0">{{ search }}</div>
              <div class="col-12 col-md-auto">{{ cart }}</div>
            </div>
          </div>  
        </div>
      </div> 
    </header>
  </div>

{# Reposicionado: O OpenCart injeta dinamicamente as mensagens flutuantes (ex: Produto adicionado) aqui, sem quebrar o header #}
<div id="alert" class="container mt-2"></div>

<main>

    