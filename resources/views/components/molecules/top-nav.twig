<nav class="egen-top-nav" aria-label="Barra de navegação utilitária">
	<ul class="egen-top-nav__list">
		<li class="egen-top-nav__item">
			<a href="{{ home|default(url('home', {}, lang)) }}" class="egen-top-nav__link">
				<i class="fa-solid fa-house" aria-hidden="true"></i>
				<span class="egen-top-nav__label">{{ Common.header.home|default('Início') }}</span>
			</a>
		</li>
		<li class="egen-top-nav__item">
			<a href="{{ contact|default(url('information/contact', {}, lang)) }}" class="egen-top-nav__link">
				<i class="fa-solid fa-phone" aria-hidden="true"></i>
				<span class="egen-top-nav__label">{{ store.telephone|default(telephone)|default(Common.header.contact)|default('Contato') }}</span>
			</a>
		</li>
		<li class="egen-top-nav__item egen-top-nav__item--dropdown">
			<a href="#" class="egen-top-nav__link" aria-haspopup="true" aria-expanded="false">
				<i class="fa-solid fa-user" aria-hidden="true"></i>
				<span class="egen-top-nav__label">{{ Common.header.account|default('Minha Conta') }}</span>
				<i class="fa-solid fa-caret-down egen-top-nav__caret" aria-hidden="true"></i>
			</a>
			<ul class="egen-top-nav__dropdown" role="menu">
				{% if not logged %}
					<li role="none">
						<a href="{{ register|default(url('cadastro', {}, lang)) }}" class="egen-top-nav__dropdown-item" role="menuitem">{{ Common.header.register|default('Registrar') }}</a>
					</li>
					<li role="none">
						<a href="{{ login|default(url('login', {}, lang)) }}" class="egen-top-nav__dropdown-item" role="menuitem">{{ Common.header.login|default('Login') }}</a>
					</li>
				{% else %}
					<li role="none">
						<a href="{{ account|default(url('account', {}, lang)) }}" class="egen-top-nav__dropdown-item" role="menuitem">{{ Common.header.account|default('Minha Conta') }}</a>
					</li>
					<li role="none">
						<a href="{{ order|default(url('account/orders', {}, lang)) }}" class="egen-top-nav__dropdown-item" role="menuitem">{{ Common.header.order|default('Pedidos') }}</a>
					</li>
					<li role="none">
						<a href="{{ transaction|default(url('account/transaction', {}, lang)) }}" class="egen-top-nav__dropdown-item" role="menuitem">{{ Common.header.transaction|default('Transações') }}</a>
					</li>
					<li role="none">
						<a href="{{ logout|default(url('logout', {}, lang)) }}" class="egen-top-nav__dropdown-item" role="menuitem">{{ Common.header.logout|default('Sair') }}</a>
					</li>
				{% endif %}
			</ul>
		</li>
		<li class="egen-top-nav__item">
			<a class="egen-top-nav__link" href="{{ wishlist|default(url('account/wishlist', {}, lang)) }}" id="wishlist-total" title="{{ Common.header.wishlist|default('Favoritos') }}">
				<i class="fa-solid fa-heart" aria-hidden="true"></i>
				<span class="egen-top-nav__label">{{ Common.header.wishlist|default('Favoritos') }}</span>
			</a>
		</li>
		<li class="egen-top-nav__item">
			<a class="egen-top-nav__link" href="{{ shopping_cart|default(url('carrinho', {}, lang)) }}" title="{{ Common.header.shoppingCart|default('Carrinho') }}">
				<i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
				<span class="egen-top-nav__label">{{ Common.header.shoppingCart|default('Carrinho') }}</span>
				<span class="egen-cart-badge {{ cart_count > 0 ? '' : 'd-none' }}" id="egen-cart-count-top">{{ cart_count|default(0) }}</span>
			</a>
		</li>
		<li class="egen-top-nav__item">
			<a class="egen-top-nav__link" href="{{ checkout|default(url('checkout', {}, lang)) }}" title="{{ Common.header.checkout|default('Finalizar Compra') }}">
				<i class="fa-solid fa-share" aria-hidden="true"></i>
				<span class="egen-top-nav__label">{{ Common.header.checkout|default('Finalizar Compra') }}</span>
			</a>
		</li>
	</ul>
</nav>
