<div class="egen-footer__col">
  <h5 class="footer-column__title">{{ title }}</h5>
  <ul class="footer-column__list">
    {% for link in links %}
      {% if link.href %}
        <li class="footer-column__item">
          <a href="{{ link.href }}" class="footer-column__link">
            {{ link.label }}
          </a>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</div>
