{% extends 'layouts/base.html.twig' %}

{% block title %}{{ Returns.heading_title }} | AgSonhos{% endblock %}

{% block content %}
<div id="account-return-form-page">

    {# ── Hero ── #}
    <div class="return-hero">
        <div class="return-hero-inner">
            <nav class="return-breadcrumb" aria-label="Navegação">
                {% for breadcrumb in breadcrumbs %}
                    {% if not loop.last %}
                        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
                        <span class="sep">›</span>
                    {% else %}
                        <span class="current">{{ breadcrumb.text }}</span>
                    {% endif %}
                {% endfor %}
            </nav>
            <h1 class="return-title">
                <span class="return-title-icon">🔄</span>
                {{ Returns.heading_title }}
            </h1>
            <p class="return-subtitle">{{ Returns.text_description }}</p>
        </div>
    </div>

    {# ── Main content ── #}
    <div class="return-wrapper">
        <form action="{{ action }}" method="post" class="return-form">
            
            {# ── Section 1: Customer Details ── #}
            <div class="form-card">
                <div class="form-card-header">
                    <h3 class="form-card-header-title">👤 {{ Returns.text_customer }}</h3>
                </div>
                <div class="form-card-body grid-2">
                    <div class="form-group {% if errors.firstname %}has-error{% endif %}">
                        <label for="input-firstname" class="form-label required">{{ Returns.entry_firstname }}</label>
                        <input type="text" name="firstname" value="{{ data.firstname }}" placeholder="{{ Returns.entry_firstname }}" id="input-firstname" class="form-input" required />
                        {% if errors.firstname %}
                            <div class="error-msg">{{ errors.firstname }}</div>
                        {% endif %}
                    </div>
                    <div class="form-group {% if errors.lastname %}has-error{% endif %}">
                        <label for="input-lastname" class="form-label required">{{ Returns.entry_lastname }}</label>
                        <input type="text" name="lastname" value="{{ data.lastname }}" placeholder="{{ Returns.entry_lastname }}" id="input-lastname" class="form-input" required />
                        {% if errors.lastname %}
                            <div class="error-msg">{{ errors.lastname }}</div>
                        {% endif %}
                    </div>
                    <div class="form-group {% if errors.email %}has-error{% endif %}">
                        <label for="input-email" class="form-label required">{{ Returns.entry_email }}</label>
                        <input type="email" name="email" value="{{ data.email }}" placeholder="{{ Returns.entry_email }}" id="input-email" class="form-input" required />
                        {% if errors.email %}
                            <div class="error-msg">{{ errors.email }}</div>
                        {% endif %}
                    </div>
                    <div class="form-group {% if errors.telephone %}has-error{% endif %}">
                        <label for="input-telephone" class="form-label required">{{ Returns.entry_telephone }}</label>
                        <input type="tel" name="telephone" value="{{ data.telephone }}" placeholder="{{ Returns.entry_telephone }}" id="input-telephone" class="form-input" required />
                        {% if errors.telephone %}
                            <div class="error-msg">{{ errors.telephone }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# ── Section 2: Order Details ── #}
            <div class="form-card">
                <div class="form-card-header">
                    <h3 class="form-card-header-title">📦 {{ Returns.text_order }}</h3>
                </div>
                <div class="form-card-body grid-2">
                    <div class="form-group {% if errors.order_id %}has-error{% endif %}">
                        <label for="input-order-id" class="form-label required">{{ Returns.entry_order_id }}</label>
                        <input type="text" name="order_id" value="{{ data.order_id }}" placeholder="{{ Returns.entry_order_id }}" id="input-order-id" class="form-input" required />
                        {% if errors.order_id %}
                            <div class="error-msg">{{ errors.order_id }}</div>
                        {% endif %}
                    </div>
                    <div class="form-group">
                        <label for="input-date-ordered" class="form-label">{{ Returns.entry_date_ordered }}</label>
                        <input type="date" name="date_ordered" value="{{ data.date_ordered }}" id="input-date-ordered" class="form-input" />
                    </div>
                </div>
            </div>

            {# ── Section 3: Product Info & Reason ── #}
            <div class="form-card">
                <div class="form-card-header">
                    <h3 class="form-card-header-title">🛍️ {{ Returns.text_product }}</h3>
                </div>
                <div class="form-card-body">
                    <div class="grid-3">
                        <div class="form-group {% if errors.product %}has-error{% endif %}">
                            <label for="input-product" class="form-label required">{{ Returns.entry_product }}</label>
                            <input type="text" name="product" value="{{ data.product }}" placeholder="{{ Returns.entry_product }}" id="input-product" class="form-input" required />
                            {% if errors.product %}
                                <div class="error-msg">{{ errors.product }}</div>
                            {% endif %}
                        </div>
                        <div class="form-group {% if errors.model %}has-error{% endif %}">
                            <label for="input-model" class="form-label required">{{ Returns.entry_model }}</label>
                            <input type="text" name="model" value="{{ data.model }}" placeholder="{{ Returns.entry_model }}" id="input-model" class="form-input" required />
                            {% if errors.model %}
                                <div class="error-msg">{{ errors.model }}</div>
                            {% endif %}
                        </div>
                        <div class="form-group">
                            <label for="input-quantity" class="form-label">{{ Returns.entry_quantity }}</label>
                            <input type="number" name="quantity" value="{{ data.quantity }}" min="1" id="input-quantity" class="form-input" />
                        </div>
                    </div>

                    <div class="grid-2 mt-4">
                        {# ── Packaging status ── #}
                        <div class="form-group">
                            <span class="form-label d-block mb-3">{{ Returns.entry_opened }}</span>
                            <div class="radio-group">
                                <label class="radio-item">
                                    <input type="radio" name="opened" value="1" {% if data.opened == '1' %}checked{% endif %} />
                                    <span class="radio-label">Sim</span>
                                </label>
                                <label class="radio-item">
                                    <input type="radio" name="opened" value="0" {% if data.opened == '0' or not data.opened %}checked{% endif %} />
                                    <span class="radio-label">Não</span>
                                </label>
                            </div>
                        </div>

                        {# ── Return Reason ── #}
                        <div class="form-group {% if errors.return_reason_id %}has-error{% endif %}">
                            <span class="form-label d-block mb-3 required">{{ Returns.entry_reason }}</span>
                            <div class="radio-column">
                                {% for reason in reasons %}
                                    <label class="radio-item-block">
                                        <input type="radio" name="return_reason_id" value="{{ reason.id }}" {% if data.return_reason_id == reason.id %}checked{% endif %} />
                                        <span class="radio-label-text">{{ reason.name }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                            {% if errors.return_reason_id %}
                                <div class="error-msg">{{ errors.return_reason_id }}</div>
                            {% endif %}
                        </div>
                    </div>

                    {# ── Fault Detail / Comment ── #}
                    <div class="form-group mt-4">
                        <label for="input-comment" class="form-label">{{ Returns.entry_fault_detail }}</label>
                        <textarea name="comment" rows="5" placeholder="{{ Returns.entry_fault_detail }}" id="input-comment" class="form-textarea">{{ data.comment }}</textarea>
                    </div>
                </div>
            </div>

            {# ── Submit Actions ── #}
            <div class="return-actions">
                <a href="{{ back }}" class="btn-cancel">{{ Returns.button_continue ?: 'Cancelar' }}</a>
                <button type="submit" class="btn-submit">{{ Returns.button_submit ?: 'Enviar Solicitação' }}</button>
            </div>

        </form>
    </div>
</div>

<style>
/* ══════════════════════════════════════════════════
   RETURN FORM — Alpha Engine Premium UI
   ══════════════════════════════════════════════════ */

#account-return-form-page {
    min-height: 100vh;
    background: #0d0f14;
    color: #e2e8f0;
    font-family: 'Inter', 'Outfit', system-ui, sans-serif;
}

/* ── Hero ── */
.return-hero {
    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #0f172a 100%);
    border-bottom: 1px solid rgba(99, 102, 241, 0.2);
    padding: 3rem 2rem 2.5rem;
}
.return-hero-inner {
    max-width: 900px;
    margin: 0 auto;
}
.return-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #94a3b8;
    margin-bottom: 1.5rem;
}
.return-breadcrumb a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s;
}
.return-breadcrumb a:hover { color: #a5b4fc; }
.return-breadcrumb .sep { color: #475569; }
.return-breadcrumb .current { color: #a5b4fc; font-weight: 500; }

.return-title {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 700;
    color: #f1f5f9;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}
.return-title-icon { font-size: 1.6rem; }
.return-subtitle {
    color: #94a3b8;
    font-size: 0.95rem;
    margin: 0;
}

/* ── Wrapper & Cards ── */
.return-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
}
.return-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}
.form-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    overflow: hidden;
    backdrop-filter: blur(8px);
}
.form-card-header {
    padding: 1.25rem 1.5rem;
    background: rgba(99, 102, 241, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}
.form-card-header-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #f1f5f9;
    margin: 0;
}
.form-card-body {
    padding: 1.5rem;
}

/* ── Grid Layouts ── */
.grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
}
@media (min-width: 640px) {
    .grid-2 { grid-template-columns: 1fr 1fr; }
}
.grid-3 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
}
@media (min-width: 768px) {
    .grid-3 { grid-template-columns: 2fr 1fr 1fr; }
}
.mt-4 { margin-top: 1.5rem; }
.mb-3 { margin-bottom: 0.75rem; }
.d-block { display: block; }

/* ── Form Controls ── */
.form-group {
    display: flex;
    flex-direction: column;
}
.form-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #cbd5e1;
    margin-bottom: 0.5rem;
}
.form-label.required::after {
    content: " *";
    color: #ef4444;
}
.form-input {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 0.65rem 0.9rem;
    font-size: 0.9rem;
    color: #f1f5f9;
    transition: all 0.2s;
    font-family: inherit;
}
.form-input:focus {
    border-color: #6366f1;
    outline: none;
    box-shadow: 0 0 8px rgba(99, 102, 241, 0.25);
    background: rgba(0, 0, 0, 0.3);
}
.form-textarea {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 0.65rem 0.9rem;
    font-size: 0.9rem;
    color: #f1f5f9;
    transition: all 0.2s;
    font-family: inherit;
    resize: vertical;
}
.form-textarea:focus {
    border-color: #6366f1;
    outline: none;
    box-shadow: 0 0 8px rgba(99, 102, 241, 0.25);
    background: rgba(0, 0, 0, 0.3);
}

/* ── Custom radios ── */
.radio-group {
    display: flex;
    gap: 1.5rem;
}
.radio-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
}
.radio-item input[type="radio"] {
    accent-color: #6366f1;
    width: 1rem;
    height: 1rem;
}
.radio-label {
    font-size: 0.9rem;
    color: #e2e8f0;
}

.radio-column {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}
.radio-item-block {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
}
.radio-item-block:hover {
    background: rgba(99, 102, 241, 0.05);
    border-color: rgba(99, 102, 241, 0.2);
}
.radio-item-block input[type="radio"] {
    accent-color: #6366f1;
    width: 1.1rem;
    height: 1.1rem;
}
.radio-label-text {
    font-size: 0.88rem;
    color: #cbd5e1;
}

/* ── Error States ── */
.form-group.has-error .form-input {
    border-color: #ef4444;
}
.error-msg {
    color: #f87171;
    font-size: 0.78rem;
    margin-top: 0.35rem;
    font-weight: 500;
}

/* ── Actions ── */
.return-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
}
.btn-submit {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: #ffffff;
    border: none;
    padding: 0.75rem 2rem;
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);
    font-family: inherit;
    font-size: 0.95rem;
}
.btn-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
}
.btn-cancel {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    transition: all 0.2s;
}
.btn-cancel:hover {
    color: #e2e8f0;
    background: rgba(255, 255, 255, 0.05);
}
</style>
{% endblock %}
