{% extends 'layouts/base.html.twig' %}

{% block title %}
	{{ title|default('Recuperar Senha | AgSonhos') }}
{% endblock %}

{% block content %}
<div class="egen-register-page">
	<div class="egen-register-container" style="max-width: 500px;">
		<nav class="egen-breadcrumb" aria-label="Navegação">
			{% for breadcrumb in breadcrumbs %}
				{% if not loop.last %}
					<li class="egen-breadcrumb__item">
						<a class="egen-breadcrumb__link" href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
					</li>
				{% else %}
					<li class="egen-breadcrumb__item">
						<span class="egen-breadcrumb__text">{{ breadcrumb.text }}</span>
					</li>
				{% endif %}
			{% endfor %}
		</nav>

		<h1 class="egen-register-title">Recuperar Senha</h1>
		<p class="egen-register-subtitle">Informe o seu e-mail cadastrado para receber as instruções de recuperação.</p>

		{# ── Alertas ── #}
		{% if success %}
			<div class="login-alert login-alert--success" style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; border-radius: 10px; font-size: 0.9rem; background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.25); color: #86efac;">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
				<span style="flex: 1;">{{ success }}</span>
			</div>
		{% endif %}

		{% if error %}
			<div class="login-alert login-alert--danger" style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; border-radius: 10px; font-size: 0.9rem; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.25); color: #fca5a5;">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
				<span style="flex: 1;">{{ error }}</span>
			</div>
		{% endif %}

		<form action="{{ action }}" method="post">
			<div class="egen-form-group">
				<label for="input-email" class="egen-form-label">Endereço de E-mail</label>
				<input type="email" name="email" value="{{ email }}" placeholder="seuemail@exemplo.com" id="input-email" class="egen-form-input" required />
			</div>

			<div class="egen-form-footer" style="margin-top: 1.5rem;">
				<a href="{{ back }}" class="egen-link-forgotten" style="margin: 0; align-self: center;">Voltar para o Login</a>
				<button type="submit" class="egen-btn-primary">
					<span>Enviar Código</span>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="5" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</button>
			</div>
		</form>
	</div>
</div>
{% endblock %}
