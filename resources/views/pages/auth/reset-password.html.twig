{% extends 'layouts/base.html.twig' %}

{% block title %}
	{{ title|default('Redefinir Senha | AgSonhos') }}
{% endblock %}

{% block content %}
<div class="egen-register-page">
	<div class="egen-register-container" style="max-width: 500px;">
		<nav class="egen-breadcrumb" aria-label="Navegação">
			{% for breadcrumb in breadcrumbs %}
				{% if not loop.last %}
					<li class="egen-breadcrumb__item">
						<a class="egen-breadcrumb__link" href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
					</li>
				{% else %}
					<li class="egen-breadcrumb__item">
						<span class="egen-breadcrumb__text">{{ breadcrumb.text }}</span>
					</li>
				{% endif %}
			{% endfor %}
		</nav>

		<h1 class="egen-register-title">Redefinir Senha</h1>
		<p class="egen-register-subtitle">Escolha uma nova senha forte para acessar sua conta.</p>

		{# ── Alertas ── #}
		{% if error %}
			<div class="login-alert login-alert--danger" style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; border-radius: 10px; font-size: 0.9rem; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.25); color: #fca5a5;">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
				<span style="flex: 1;">{{ error }}</span>
			</div>
		{% endif %}

		<form action="{{ action }}" method="post">
			<input type="hidden" name="code" value="{{ code }}" />

			<div class="egen-form-group" style="margin-bottom: 1.25rem;">
				<label for="input-password" class="egen-form-label">Nova Senha</label>
				<input type="password" name="password" placeholder="Digite sua nova senha" id="input-password" class="egen-form-input" required />
			</div>

			<div class="egen-form-group" style="margin-bottom: 1.25rem;">
				<label for="input-confirm" class="egen-form-label">Confirmar Senha</label>
				<input type="password" name="confirm" placeholder="Confirme sua nova senha" id="input-confirm" class="egen-form-input" required />
			</div>

			<div class="egen-form-footer" style="margin-top: 1.5rem;">
				<button type="submit" class="egen-btn-primary" style="margin-left: auto;">
					<span>Alterar Senha</span>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<polyline points="20 6 9 17 4 12"></polyline>
					</svg>
				</button>
			</div>
		</form>
	</div>
</div>
{% endblock %}
