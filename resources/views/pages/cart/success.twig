{% extends "layouts/base.html.twig" %}

{% block title %}
	{{ Order.headingTitle|default('Pedido Realizado com Sucesso!') }}
	| AgSonhos
{% endblock %}

{% block content %}
	<div class="egen-cart-page">
		<div class="egen-cart-container cart-success-box">
			<div class="egen-cart-empty__icon cart-success-icon">
				<i class="fa-solid fa-circle-check"></i>
			</div>
			<h1 class="egen-cart-title cart-success-title">{{ Order.headingTitle|default('Pedido Realizado com Sucesso!') }}</h1>
			<p class="cart-success-desc">{{ Order.textMessage|format(order_id)|raw }}</p>
			<a href="{{ continue_url|default('/') }}" class="egen-btn-primary">{{ Order.buttonContinue|default('Voltar para a Página Inicial') }}</a>
		</div>
	</div>
{% endblock %}
