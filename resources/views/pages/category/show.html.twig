{% extends 'layouts/base.html.twig' %}

{% block title %}{{ seo.title }}{% endblock %}

{% block content %}
<div class="egen-category-page">
    <!-- Breadcrumbs -->
    <div class="egen-category-page__breadcrumbs">
        {% include 'components/molecules/breadcrumbs.twig' with { items: category.breadcrumbs } %}
    </div>

    <!-- Banner/Cabeçalho da Categoria -->
    <div class="egen-category-header">
        {% if category.thumb %}
            <div class="egen-category-header__image-wrapper">
                <img src="{{ category.thumb }}" alt="{{ category.name }}" class="egen-category-header__image">
            </div>
        {% endif %}
        <div class="egen-category-header__content">
            <h1 class="egen-category-header__title">{{ category.name }}</h1>
            {% if category.description %}
                <div class="egen-category-header__description">{{ category.description|raw }}</div>
            {% endif %}
        </div>
    </div>

    <!-- Subcategorias (Se existirem) -->
    {% if category.categories %}
        <div class="egen-category-subcategories">
            <span class="egen-category-subcategories__title">Subcategorias</span>
            <div class="egen-category-subcategories__list">
                {% for sub in category.categories %}
                    <a href="{{ sub.href }}" class="egen-category-subcategories__item">
                        <i class="fas fa-folder"></i> {{ sub.name }}
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <!-- Filtros, Ordenação e Limites -->
    <div class="egen-category-filters">
        <div class="egen-category-filters__info">
            Exibindo <strong>{{ category.products|length }}</strong> de <strong>{{ category.product_total }}</strong> produtos
        </div>
        
        <div class="egen-category-filters__controls">
            <!-- Ordenação -->
            <div class="egen-category-filters__group">
                <label for="select-sort" class="egen-category-filters__label">Ordenar:</label>
                <select id="select-sort" class="egen-form-select egen-category-filters__select" onchange="location = this.value;">
                    {% for option in category.sorts %}
                        <option value="{{ option.href }}" {% if option.value == category.sort ~ '-' ~ category.order %}selected{% endif %}>{{ option.text }}</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Exibir por página -->
            <div class="egen-category-filters__group">
                <label for="select-limit" class="egen-category-filters__label">Exibir:</label>
                <select id="select-limit" class="egen-form-select egen-category-filters__select" onchange="location = this.value;">
                    {% for option in category.limits %}
                        <option value="{{ option.href }}" {% if option.value == category.limit %}selected{% endif %}>{{ option.text }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
    </div>

    <!-- Grade de Produtos -->
    <div class="egen-category-grid">
        {% for prod in category.products %}
            <div class="egen-product-card">
                <a href="{{ prod.href }}" class="egen-product-card__image-link">
                    {% if prod.thumb %}
                        <img src="{{ prod.thumb }}" alt="{{ prod.name }}" class="egen-product-card__image">
                    {% else %}
                        <img src="/img/no-image.png" alt="{{ prod.name }}" class="egen-product-card__image">
                    {% endif %}
                </a>
                
                <div class="egen-product-card__body">
                    <div class="egen-product-card__info">
                        <h3 class="egen-product-card__title">
                            <a href="{{ prod.href }}" class="egen-product-card__link">{{ prod.name }}</a>
                        </h3>
                        
                        <p class="egen-product-card__description">
                            {{ prod.description|striptags }}
                        </p>
                    </div>
                    
                    <div class="egen-product-card__footer">
                        <div class="egen-product-card__price-block">
                            {% if prod.special %}
                                <span class="egen-product-card__price-old">{{ prod.price }}</span>
                                <span class="egen-product-card__price-special">{{ prod.special }}</span>
                            {% else %}
                                <span class="egen-product-card__price-normal">{{ prod.price }}</span>
                            {% endif %}
                            {% if prod.tax %}
                                <div class="egen-product-card__tax">Sem imposto: {{ prod.tax }}</div>
                            {% endif %}
                        </div>

                        <form action="{{ prod.cart_add }}" method="POST" data-oc-toggle="ajax">
                            <input type="hidden" name="product_id" value="{{ prod.product_id }}">
                            <input type="hidden" name="quantity" value="{{ prod.minimum }}">
                            <button type="submit" class="egen-btn-primary egen-product-card__btn">
                                <i class="fas fa-shopping-cart"></i> Comprar
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="egen-category-empty">
                <i class="fas fa-info-circle"></i>
                <p class="egen-category-empty__text">Nenhum produto foi encontrado nesta categoria.</p>
            </div>
        {% endfor %}
    </div>

    <!-- Paginação -->
    {% if category.product_total > category.limit %}
        <div class="egen-pagination-wrapper">
            <nav aria-label="Navegação de página">
                <ul class="egen-pagination">
                    {% set total_pages = (category.product_total / category.limit)|round(0, 'ceil') %}
                    {% set current_page = category.pagination.page %}
                    {% set range = 2 %}

                    {# Primeira & Anterior #}
                    {% if current_page > 1 %}
                        <li class="egen-pagination__item">
                            <a class="egen-pagination__link" href="{{ category.pagination.url|replace({'{page}': 1}) }}" title="Primeira página">
                                <i class="fa-solid fa-angles-left"></i>
                            </a>
                        </li>
                        <li class="egen-pagination__item">
                            <a class="egen-pagination__link" href="{{ category.pagination.url|replace({'{page}': current_page - 1}) }}" title="Anterior">
                                <i class="fa-solid fa-angle-left"></i>
                            </a>
                        </li>
                    {% endif %}

                    {# Reticências Iniciais #}
                    {% if current_page - range > 1 %}
                        <li class="egen-pagination__item egen-pagination__item--separator">
                            <span class="egen-pagination__link">...</span>
                        </li>
                    {% endif %}

                    {# Números do Intervalo #}
                    {% for page in 1..total_pages %}
                        {% if page >= current_page - range and page <= current_page + range %}
                            <li class="egen-pagination__item {% if page == current_page %}egen-pagination__item--active{% endif %}">
                                <a class="egen-pagination__link" href="{{ category.pagination.url|replace({'{page}': page}) }}">{{ page }}</a>
                            </li>
                        {% endif %}
                    {% endfor %}

                    {# Reticências Finais #}
                    {% if current_page + range < total_pages %}
                        <li class="egen-pagination__item egen-pagination__item--separator">
                            <span class="egen-pagination__link">...</span>
                        </li>
                    {% endif %}

                    {# Próxima & Última #}
                    {% if current_page < total_pages %}
                        <li class="egen-pagination__item">
                            <a class="egen-pagination__link" href="{{ category.pagination.url|replace({'{page}': current_page + 1}) }}" title="Próxima">
                                <i class="fa-solid fa-angle-right"></i>
                            </a>
                        </li>
                        <li class="egen-pagination__item">
                            <a class="egen-pagination__link" href="{{ category.pagination.url|replace({'{page}': total_pages}) }}" title="Última página">
                                <i class="fa-solid fa-angles-right"></i>
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        </div>
    {% endif %}
</div>
{% endblock %}
