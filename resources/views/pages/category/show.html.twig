{% extends 'layouts/base.html.twig' %}

{% block title %}
	{{ seo.title }}
{% endblock %}

{% block content %}
	<div
		id="egen-category-page">

		{# ── Hero / Cabeçalho da Categoria ── #}
		<div class="egen-cat-hero {% if category.thumb %}egen-cat-hero--with-image{% endif %}">
			{% if category.thumb %}
				<div class="egen-cat-hero-bg">
					<img src="{{ category.thumb }}" alt="{{ category.name }}" class="egen-cat-hero-bg-img">
					<div class="egen-cat-hero-bg-overlay"></div>
				</div>
			{% endif %}
			<div
				class="egen-cat-hero-inner">
				{# Breadcrumb #}
				<nav class="egen-cat-breadcrumb" aria-label="Navegação">
					{% for item in category.breadcrumbs %}
						{% if not loop.last %}
							<a href="{{ item.href }}">{{ item.name ?? item.text }}</a>
							<span class="sep">›</span>
						{% else %}
							<span class="current">{{ item.name ?? item.text }}</span>
						{% endif %}
					{% endfor %}
				</nav>

				<h1 class="egen-cat-hero-title">{{ category.name }}</h1>

				{% if category.description %}
					<div class="egen-cat-hero-desc">{{ category.description|striptags|slice(0, 180) }}
						{% if category.description|striptags|length > 180 %}…
						{% endif %}
					</div>
				{% endif %}

				{# Contagem de produtos #}
				<div class="egen-cat-hero-count">
					<span class="egen-count-badge">{{ category.product_total }}
						produto{{ category.product_total != 1 ? 's' : '' }}</span>
				</div>
			</div>
		</div>

		<div
			class="egen-cat-wrapper">

			{# ── Subcategorias ── #}
			{% if category.categories %}
				<div class="egen-cat-subcategories">
					<span class="egen-cat-subcategories-label">Subcategorias</span>
					<div class="egen-cat-subcategories-chips">
						{% for sub in category.categories %}
							<a href="{{ sub.href }}" class="egen-cat-subchip">
								<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
								</svg>
								{{ sub.name }}
							</a>
						{% endfor %}
					</div>
				</div>
			{% endif %}

			{# ── Barra de Filtros / Ordenação ── #}
			<div class="egen-cat-toolbar">
				<div class="egen-cat-toolbar-info">
					Exibindo
					<strong>{{ category.products|length }}</strong>
					de
					<strong>{{ category.product_total }}</strong>
					produtos
				</div>
				<div class="egen-cat-toolbar-controls">
					<div class="egen-cat-select-wrap">
						<label for="select-sort">Ordenar</label>
						<select id="select-sort" class="egen-cat-select" onchange="location = this.value;">
							{% for option in category.sorts %}
								<option value="{{ option.href }}" {% if option.value == category.sort ~ '-' ~ category.order %} selected {% endif %}>{{ option.text }}</option>
							{% endfor %}
						</select>
						<svg class="egen-cat-select-arrow" width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
					</div>
					<div class="egen-cat-select-wrap">
						<label for="select-limit">Exibir</label>
						<select id="select-limit" class="egen-cat-select" onchange="location = this.value;">
							{% for option in category.limits %}
								<option value="{{ option.href }}" {% if option.value == category.limit %} selected {% endif %}>{{ option.text }}</option>
							{% endfor %}
						</select>
						<svg class="egen-cat-select-arrow" width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
					</div>
				</div>
			</div>


			<div class="egen-category-layout">
				<!-- Filtros para faixa de preços, fabricantes, categorias... -->
				{% include 'components/organisms/aside_filters.html.twig' %}

				<div class="egen-category-main">
					{# ── Grade de Produtos ── #}
					{% if category.products %}
						<div class="egen-cat-grid" id="products-grid">
							{% for prod in category.products %}
								<article
									class="egen-prod-card" id="product-{{ prod.product_id }}">
									{# Badge de promoção #}
									{% if prod.special %}
										<div class="egen-prod-badge egen-prod-badge--sale">Oferta</div>
									{% endif %}

									{# Imagem #}
									<a href="{{ prod.href }}" class="egen-prod-card-img-wrap" tabindex="-1" aria-hidden="true">
										<img src="{{ prod.thumb ?: '/img/no-image.png' }}" alt="{{ prod.name }}" class="egen-prod-card-img" loading="lazy">
										<div class="egen-prod-card-img-overlay">
											<span class="egen-prod-overlay-btn">Ver produto</span>
										</div>
									</a>

									{# Corpo #}
									<div class="egen-prod-card-body">
										<h3 class="egen-prod-card-title">
											<a href="{{ prod.href }}" class="egen-prod-card-title-link">{{ prod.name }}</a>
										</h3>

										{% if prod.description %}
											<p class="egen-prod-card-desc">{{ prod.description|striptags|slice(0, 80) }}
												{% if prod.description|striptags|length > 80 %}…
												{% endif %}
											</p>
										{% endif %}

										{# Preços #}
										<div class="egen-prod-card-price-block">
											{% if prod.special %}
												<span class="egen-prod-price-old">{{ prod.price }}</span>
												<span class="egen-prod-price-special">{{ prod.special }}</span>
											{% else %}
												<span class="egen-prod-price">{{ prod.price }}</span>
											{% endif %}
										</div>

										{# Ação #}
										<form action="{{ prod.cart_add }}" method="POST" class="egen-prod-card-form">
											<input type="hidden" name="product_id" value="{{ prod.product_id }}">
											<input type="hidden" name="quantity" value="{{ prod.minimum }}">
											<a href="{{ prod.href }}" class="egen-prod-btn-details">Ver detalhes</a>
											<button type="submit" class="egen-prod-btn-cart" title="Adicionar ao carrinho">
												<svg width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
													<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
													<path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
												</svg>
											</button>
										</form>
									</div>
								</article>
							{% endfor %}
						</div>

						{# ── Paginação ── #}
						{% if category.product_total > category.limit %}
							<div class="egen-cat-pagination-wrap">
								<nav class="egen-cat-pagination" aria-label="Navegação de páginas">
									{% set total_pages = (category.product_total / category.limit)|round(0, 'ceil') %}
									{% set current_page = category.pagination.page %}
									{% set range = 2 %}

									{% if current_page > 1 %}
										<a class="egen-cat-page-btn" href="{{ category.pagination.url|replace({'{page}': 1}) }}" title="Primeira">
											<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="11 17 6 12 11 7"/><polyline points="18 17 13 12 18 7"/></svg>
										</a>
										<a class="egen-cat-page-btn" href="{{ category.pagination.url|replace({'{page}': current_page - 1}) }}" title="Anterior">
											<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
										</a>
									{% endif %}

									{% if current_page - range > 1 %}
										<span class="egen-cat-page-sep">…</span>
									{% endif %}

									{% for page in 1..total_pages %}
										{% if page >= current_page - range and page <= current_page + range %}
											<a class="egen-cat-page-btn {% if page == current_page %}egen-cat-page-btn--active{% endif %}" href="{{ category.pagination.url|replace({'{page}': page}) }}">{{ page }}</a>
										{% endif %}
									{% endfor %}

									{% if current_page + range < total_pages %}
										<span class="egen-cat-page-sep">…</span>
									{% endif %}

									{% if current_page < total_pages %}
										<a class="egen-cat-page-btn" href="{{ category.pagination.url|replace({'{page}': current_page + 1}) }}" title="Próxima">
											<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
										</a>
										<a class="egen-cat-page-btn" href="{{ category.pagination.url|replace({'{page}': total_pages}) }}" title="Última">
											<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="13 17 18 12 13 7"/><polyline points="6 17 11 12 6 7"/></svg>
										</a>
									{% endif %}
								</nav>
							</div>
						{% endif %}

					{% else %}
						{# ── Estado vazio ── #}
						<div class="egen-cat-empty">
							<div class="egen-cat-empty-icon">🔍</div>
							<h2 class="egen-cat-empty-title">Nenhum produto encontrado</h2>
							<p class="egen-cat-empty-desc">Esta categoria ainda não possui produtos disponíveis.</p>
						</div>
					{% endif %}
				</div>
			</div>

		</div>
		{# /.egen-cat-wrapper #}
	</div>
	{# /#egen-category-page #}
{% endblock %}
