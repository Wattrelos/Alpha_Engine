{% extends 'layouts/base.html.twig' %}

{% block title %}
	{{ seo.title }}
{% endblock %}

{% block content %}
	<div
		id="category-page">

		{# ── Hero / Cabeçalho da Categoria ── #}
		<div class="cat-hero {% if category.thumb %}cat-hero--with-image{% endif %}">
			{% if category.thumb %}
				<div class="cat-hero-bg">
					<img src="{{ category.thumb }}" alt="{{ category.name }}" class="cat-hero-bg-img">
					<div class="cat-hero-bg-overlay"></div>
				</div>
			{% endif %}
			<div
				class="cat-hero-inner">
				{# Breadcrumb #}
				<nav class="cat-breadcrumb" aria-label="Navegação">
					{% for item in category.breadcrumbs %}
						{% if not loop.last %}
							<a href="{{ item.href }}">{{ item.name ?? item.text }}</a>
							<span class="sep">›</span>
						{% else %}
							<span class="current">{{ item.name ?? item.text }}</span>
						{% endif %}
					{% endfor %}
				</nav>

				<h1 class="cat-hero-title">{{ category.name }}</h1>

				{% if category.description %}
					<div class="cat-hero-desc">{{ category.description|striptags|slice(0, 180) }}
						{% if category.description|striptags|length > 180 %}…
						{% endif %}
					</div>
				{% endif %}

				{# Contagem de produtos #}
				<div class="cat-hero-count">
					<span class="count-badge">{{ category.product_total }}
						produto{{ category.product_total != 1 ? 's' : '' }}</span>
				</div>
			</div>
		</div>

		<div
			class="cat-wrapper">

			{# ── Subcategorias ── #}
			{% if category.categories %}
				<div class="cat-subcategories">
					<span class="cat-subcategories-label">Subcategorias</span>
					<div class="cat-subcategories-chips">
						{% for sub in category.categories %}
							<a href="{{ sub.href }}" class="cat-subchip">
								<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
								</svg>
								{{ sub.name }}
							</a>
						{% endfor %}
					</div>
				</div>
			{% endif %}

			{# ── Barra de Filtros / Ordenação ── #}
			<div class="cat-toolbar">
				<div class="cat-toolbar-info">
					Exibindo
					<strong>{{ category.products|length }}</strong>
					de
					<strong>{{ category.product_total }}</strong>
					produtos
				</div>
				<div class="cat-toolbar-controls">
					<div class="cat-select-wrap">
						<label for="select-sort">Ordenar</label>
						<select id="select-sort" class="cat-select" onchange="location = this.value;">
							{% for option in category.sorts %}
								<option value="{{ option.href }}" {% if option.value == category.sort ~ '-' ~ category.order %} selected {% endif %}>{{ option.text }}</option>
							{% endfor %}
						</select>
						<svg class="cat-select-arrow" width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
					</div>
					<div class="cat-select-wrap">
						<label for="select-limit">Exibir</label>
						<select id="select-limit" class="cat-select" onchange="location = this.value;">
							{% for option in category.limits %}
								<option value="{{ option.href }}" {% if option.value == category.limit %} selected {% endif %}>{{ option.text }}</option>
							{% endfor %}
						</select>
						<svg class="cat-select-arrow" width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
					</div>
				</div>
			</div>


			<div class="egen-category-layout">
				<!-- Filtros para faixa de preços, fabricantes, categorias... -->
				{% include 'components/organisms/aside_filters.html.twig' %}

				<div class="egen-category-main">
					{# ── Grade de Produtos ── #}
					{% if category.products %}
						<div class="cat-grid" id="products-grid">
							{% for prod in category.products %}
								<article
									class="prod-card" id="product-{{ prod.product_id }}">
									{# Badge de promoção #}
									{% if prod.special %}
										<div class="prod-badge prod-badge--sale">Oferta</div>
									{% endif %}

									{# Imagem #}
									<a href="{{ prod.href }}" class="prod-card-img-wrap" tabindex="-1" aria-hidden="true">
										<img src="{{ prod.thumb ?: '/img/no-image.png' }}" alt="{{ prod.name }}" class="prod-card-img" loading="lazy">
										<div class="prod-card-img-overlay">
											<span class="prod-overlay-btn">Ver produto</span>
										</div>
									</a>

									{# Corpo #}
									<div class="prod-card-body">
										<h3 class="prod-card-title">
											<a href="{{ prod.href }}" class="prod-card-title-link">{{ prod.name }}</a>
										</h3>

										{% if prod.description %}
											<p class="prod-card-desc">{{ prod.description|striptags|slice(0, 80) }}
												{% if prod.description|striptags|length > 80 %}…
												{% endif %}
											</p>
										{% endif %}

										{# Preços #}
										<div class="prod-card-price-block">
											{% if prod.special %}
												<span class="prod-price-old">{{ prod.price }}</span>
												<span class="prod-price-special">{{ prod.special }}</span>
											{% else %}
												<span class="prod-price">{{ prod.price }}</span>
											{% endif %}
										</div>

										{# Ação #}
										<form action="{{ prod.cart_add }}" method="POST" class="prod-card-form">
											<input type="hidden" name="product_id" value="{{ prod.product_id }}">
											<input type="hidden" name="quantity" value="{{ prod.minimum }}">
											<a href="{{ prod.href }}" class="prod-btn-details">Ver detalhes</a>
											<button type="submit" class="prod-btn-cart" title="Adicionar ao carrinho">
												<svg width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
													<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
													<path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
												</svg>
											</button>
										</form>
									</div>
								</article>
							{% endfor %}
						</div>

						{# ── Paginação ── #}
						{% if category.product_total > category.limit %}
							<div class="cat-pagination-wrap">
								<nav class="cat-pagination" aria-label="Navegação de páginas">
									{% set total_pages = (category.product_total / category.limit)|round(0, 'ceil') %}
									{% set current_page = category.pagination.page %}
									{% set range = 2 %}

									{% if current_page > 1 %}
										<a class="cat-page-btn" href="{{ category.pagination.url|replace({'{page}': 1}) }}" title="Primeira">
											<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="11 17 6 12 11 7"/><polyline points="18 17 13 12 18 7"/></svg>
										</a>
										<a class="cat-page-btn" href="{{ category.pagination.url|replace({'{page}': current_page - 1}) }}" title="Anterior">
											<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
										</a>
									{% endif %}

									{% if current_page - range > 1 %}
										<span class="cat-page-sep">…</span>
									{% endif %}

									{% for page in 1..total_pages %}
										{% if page >= current_page - range and page <= current_page + range %}
											<a class="cat-page-btn {% if page == current_page %}cat-page-btn--active{% endif %}" href="{{ category.pagination.url|replace({'{page}': page}) }}">{{ page }}</a>
										{% endif %}
									{% endfor %}

									{% if current_page + range < total_pages %}
										<span class="cat-page-sep">…</span>
									{% endif %}

									{% if current_page < total_pages %}
										<a class="cat-page-btn" href="{{ category.pagination.url|replace({'{page}': current_page + 1}) }}" title="Próxima">
											<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
										</a>
										<a class="cat-page-btn" href="{{ category.pagination.url|replace({'{page}': total_pages}) }}" title="Última">
											<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="13 17 18 12 13 7"/><polyline points="6 17 11 12 6 7"/></svg>
										</a>
									{% endif %}
								</nav>
							</div>
						{% endif %}

					{% else %}
						{# ── Estado vazio ── #}
						<div class="cat-empty">
							<div class="cat-empty-icon">🔍</div>
							<h2 class="cat-empty-title">Nenhum produto encontrado</h2>
							<p class="cat-empty-desc">Esta categoria ainda não possui produtos disponíveis.</p>
						</div>
					{% endif %}
				</div>
			</div>

		</div>
		{# /.cat-wrapper #}
	</div>
	{# /#category-page #}

	<style>
		/* ══════════════════════════════════════════════════
   CATEGORY PAGE — Alpha Engine Premium UI
   ══════════════════════════════════════════════════ */

		#category-page {
			min-height: 100vh;
			background: #0d0f14;
			color: #e2e8f0;
			font-family: 'Inter', 'Outfit', system-ui, sans-serif;
		}

		/* ── Hero ── */
		.cat-hero {
			position: relative;
			background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 60%, #0f172a 100%);
			border-bottom: 1px solid rgba(99, 102, 241, 0.2);
			padding: 3.5rem 2rem 2.5rem;
			overflow: hidden;
		}
		.cat-hero--with-image {
			padding: 4rem 2rem 3rem;
		}

		.cat-hero-bg {
			position: absolute;
			inset: 0;
			z-index: 0;
		}
		.cat-hero-bg-img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			opacity: 0.18;
		}
		.cat-hero-bg-overlay {
			position: absolute;
			inset: 0;
			background: linear-gradient(to bottom, rgba(13,15,20,0.4) 0%, rgba(13,15,20,0.85) 100%);
		}

		.cat-hero-inner {
			position: relative;
			z-index: 1;
			max-width: 1200px;
			margin: 0 auto;
		}

		/* Breadcrumb */
		.cat-breadcrumb {
			display: flex;
			align-items: center;
			flex-wrap: wrap;
			gap: 0.4rem;
			font-size: 0.78rem;
			color: #94a3b8;
			margin-bottom: 1.5rem;
		}
		.cat-breadcrumb a {
			color: #94a3b8;
			text-decoration: none;
			transition: color 0.2s;
		}
		.cat-breadcrumb a:hover {
			color: #a5b4fc;
		}
		.cat-breadcrumb .sep {
			color: #475569;
		}
		.cat-breadcrumb .current {
			color: #a5b4fc;
			font-weight: 500;
		}

		.cat-hero-title {
			font-size: clamp(1.8rem, 4vw, 2.8rem);
			font-weight: 800;
			color: #f1f5f9;
			margin: 0 0 0.75rem;
			letter-spacing: -0.03em;
			line-height: 1.15;
		}
		.cat-hero-desc {
			color: #94a3b8;
			font-size: 0.95rem;
			max-width: 600px;
			line-height: 1.6;
			margin-bottom: 1.25rem;
		}
		.count-badge {
			display: inline-block;
			background: rgba(99, 102, 241, 0.15);
			border: 1px solid rgba(99, 102, 241, 0.3);
			color: #a5b4fc;
			font-size: 0.8rem;
			font-weight: 600;
			padding: 0.3rem 0.9rem;
			border-radius: 100px;
		}

		/* ── Wrapper ── */
		.cat-wrapper {
			max-width: 1200px;
			margin: 0 auto;
			padding: 2rem 1.5rem 5rem;
		}

		/* ── Subcategorias ── */
		.cat-subcategories {
			display: flex;
			align-items: center;
			flex-wrap: wrap;
			gap: 0.75rem;
			margin-bottom: 2rem;
			padding-bottom: 1.5rem;
			border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		}
		.cat-subcategories-label {
			font-size: 0.7rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			color: #64748b;
			white-space: nowrap;
		}
		.cat-subcategories-chips {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
		}
		.cat-subchip {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			background: rgba(255, 255, 255, 0.04);
			border: 1px solid rgba(255, 255, 255, 0.1);
			color: #cbd5e1;
			text-decoration: none;
			font-size: 0.82rem;
			font-weight: 500;
			padding: 0.3rem 0.85rem;
			border-radius: 100px;
			transition: all 0.2s;
		}
		.cat-subchip:hover {
			background: rgba(99, 102, 241, 0.15);
			border-color: rgba(99, 102, 241, 0.4);
			color: #a5b4fc;
		}

		/* ── Toolbar ── */
		.cat-toolbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			flex-wrap: wrap;
			gap: 1rem;
			margin-bottom: 1.75rem;
		}
		.cat-toolbar-info {
			font-size: 0.85rem;
			color: #64748b;
		}
		.cat-toolbar-info strong {
			color: #94a3b8;
		}
		.cat-toolbar-controls {
			display: flex;
			gap: 0.75rem;
			flex-wrap: wrap;
		}

		.cat-select-wrap {
			position: relative;
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}
		.cat-select-wrap label {
			font-size: 0.75rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.07em;
			color: #64748b;
			white-space: nowrap;
		}
		.cat-select {
			appearance: none;
			background: rgba(255, 255, 255, 0.05);
			border: 1px solid rgba(255, 255, 255, 0.1);
			color: #e2e8f0;
			font-size: 0.83rem;
			padding: 0.45rem 2.2rem 0.45rem 0.85rem;
			border-radius: 8px;
			cursor: pointer;
			transition: border-color 0.2s, background 0.2s;
			outline: none;
		}
		.cat-select:hover,
		.cat-select:focus {
			border-color: rgba(99, 102, 241, 0.4);
			background: rgba(99, 102, 241, 0.08);
		}
		.cat-select option {
			background: #1e2030;
			color: #e2e8f0;
		}
		.cat-select-arrow {
			position: absolute;
			right: 0.6rem;
			pointer-events: none;
			color: #64748b;
		}

		/* ── Grid de Produtos ── */
		.cat-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
			gap: 1.25rem;
			margin-bottom: 3rem;
		}

		/* ── Card de Produto ── */
		.prod-card {
			position: relative;
			background: rgba(255, 255, 255, 0.03);
			border: 1px solid rgba(255, 255, 255, 0.07);
			border-radius: 16px;
			overflow: hidden;
			display: flex;
			flex-direction: column;
			transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
		}
		.prod-card:hover {
			border-color: rgba(99, 102, 241, 0.35);
			transform: translateY(-4px);
			box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
		}

		/* Badge */
		.prod-badge {
			position: absolute;
			top: 0.75rem;
			left: 0.75rem;
			z-index: 2;
			font-size: 0.68rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			padding: 0.25rem 0.65rem;
			border-radius: 100px;
		}
		.prod-badge--sale {
			background: linear-gradient(135deg, #ef4444, #f97316);
			color: #fff;
			box-shadow: 0 2px 8px rgba(239, 68, 68, 0.4);
		}

		/* Imagem */
		.prod-card-img-wrap {
			display: block;
			position: relative;
			overflow: hidden;
			aspect-ratio: 4 / 3;
			background: rgba(255, 255, 255, 0.02);
		}
		.prod-card-img {
			width: 100%;
			height: 100%;
			object-fit: contain;
			padding: 1rem;
			transition: transform 0.4s ease;
		}
		.prod-card:hover .prod-card-img {
			transform: scale(1.04);
		}

		.prod-card-img-overlay {
			position: absolute;
			inset: 0;
			background: rgba(99, 102, 241, 0.75);
			display: flex;
			align-items: center;
			justify-content: center;
			opacity: 0;
			transition: opacity 0.25s;
		}
		.prod-card:hover .prod-card-img-overlay {
			opacity: 1;
		}
		.prod-overlay-btn {
			color: #fff;
			font-weight: 600;
			font-size: 0.85rem;
			background: rgba(255, 255, 255, 0.15);
			border: 1px solid rgba(255, 255, 255, 0.3);
			padding: 0.5rem 1.25rem;
			border-radius: 100px;
			backdrop-filter: blur(4px);
		}

		/* Corpo do card */
		.prod-card-body {
			padding: 1.1rem;
			display: flex;
			flex-direction: column;
			flex: 1;
			gap: 0.6rem;
			border-top: 1px solid rgba(255, 255, 255, 0.05);
		}
		.prod-card-title {
			margin: 0;
			font-size: 0.9rem;
			font-weight: 600;
			line-height: 1.3;
		}
		.prod-card-title-link {
			color: #e2e8f0;
			text-decoration: none;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
			transition: color 0.2s;
		}
		.prod-card-title-link:hover {
			color: #a5b4fc;
		}

		.prod-card-desc {
			font-size: 0.78rem;
			color: #64748b;
			margin: 0;
			line-height: 1.5;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}

		/* Preços */
		.prod-card-price-block {
			display: flex;
			align-items: baseline;
			gap: 0.5rem;
			flex-wrap: wrap;
			margin-top: auto;
		}
		.prod-price {
			font-size: 1.05rem;
			font-weight: 700;
			color: #e2e8f0;
			font-variant-numeric: tabular-nums;
		}
		.prod-price-special {
			font-size: 1.05rem;
			font-weight: 700;
			color: #4ade80;
			font-variant-numeric: tabular-nums;
		}
		.prod-price-old {
			font-size: 0.82rem;
			color: #475569;
			text-decoration: line-through;
			font-variant-numeric: tabular-nums;
		}

		/* Ações do card */
		.prod-card-form {
			display: flex;
			gap: 0.5rem;
			align-items: center;
			margin-top: 0.25rem;
		}
		.prod-btn-details {
			flex: 1;
			display: block;
			text-align: center;
			background: rgba(99, 102, 241, 0.12);
			border: 1px solid rgba(99, 102, 241, 0.25);
			color: #a5b4fc;
			text-decoration: none;
			font-size: 0.8rem;
			font-weight: 600;
			padding: 0.5rem;
			border-radius: 8px;
			transition: all 0.2s;
		}
		.prod-btn-details:hover {
			background: rgba(99, 102, 241, 0.25);
			border-color: rgba(99, 102, 241, 0.5);
			color: #c7d2fe;
		}
		.prod-btn-cart {
			width: 38px;
			height: 38px;
			background: linear-gradient(135deg, #6366f1, #8b5cf6);
			border: none;
			border-radius: 8px;
			color: #fff;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
			transition: all 0.2s;
			box-shadow: 0 2px 8px rgba(99, 102, 241, 0.3);
		}
		.prod-btn-cart:hover {
			transform: scale(1.08);
			box-shadow: 0 4px 14px rgba(99, 102, 241, 0.5);
		}
		.prod-btn-cart:active {
			transform: scale(0.96);
		}

		/* ── Empty state ── */
		.cat-empty {
			text-align: center;
			padding: 6rem 2rem;
			border: 1px dashed rgba(255, 255, 255, 0.1);
			border-radius: 16px;
		}
		.cat-empty-icon {
			font-size: 4rem;
			margin-bottom: 1.5rem;
		}
		.cat-empty-title {
			font-size: 1.3rem;
			font-weight: 700;
			color: #e2e8f0;
			margin: 0 0 0.5rem;
		}
		.cat-empty-desc {
			color: #64748b;
			font-size: 0.9rem;
			margin: 0;
		}

		/* ── Paginação ── */
