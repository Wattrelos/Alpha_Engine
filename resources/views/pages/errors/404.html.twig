{% extends 'layouts/base.html.twig' %}

{% block title %}Página Não Encontrada | AgSonhos{% endblock %}

{% block content %}
    <div style="max-width: 600px; margin: 4rem auto; padding: 2rem; text-align: center; font-family: sans-serif; background: #fff; border-radius: 1.5rem; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
        <div style="font-size: 5rem; margin-bottom: 1rem;">🚧</div>
        <h1 style="color: #9c4902; font-size: 2.2rem; margin-top: 0;">Página Não Encontrada</h1>
        <p style="color: #666; font-size: 1.1rem; line-height: 1.6; margin-bottom: 2rem;">
            A página que você está procurando não existe ou foi movida.
        </p>
        <a href="/" class="btn-3d" style="display: inline-block; padding: 0.8rem 2rem; color: #fff; text-decoration: none; font-weight: bold; border-radius: 50px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); transition: all 0.2s;">
            Voltar para a Página Inicial
        </a>
    </div>
{% endblock %}
