{% extends 'layouts/base.html.twig' %}

{% block title %}
	{{ seo.title }}
{% endblock %}

{% block content %}
	<div id="egen-category-page" class="egen-search-page">

		{# ── Hero / Cabeçalho da Busca ── #}
		<div class="egen-cat-hero">
			<div class="egen-cat-hero-inner">
				{# Breadcrumb #}
				<nav class="egen-cat-breadcrumb" aria-label="Navegação">
					<a href="{{ url_for('home', {'lang': lang}) }}">Início</a>
					<span class="sep">›</span>
					<span class="current">Busca</span>
				</nav>

				<h1 class="egen-cat-hero-title">Pesquisa de Produtos</h1>

				{# Formulário de busca interno na página #}
				<div class="egen-search-form-container" style="margin-top: 1.5rem; max-width: 600px; width: 100%;">
					<form action="{{ url_for('search', {'lang': lang}) }}" method="GET" class="egen-search-page-form" style="display: flex; gap: 0.5rem; width: 100%;">
						<input 
							type="text" 
							name="busca" 
							value="{{ term }}" 
							placeholder="Digite o que procura..." 
							class="egen-form-input" 
							style="flex: 1; background: var(--egen-bg-input); border: 1px solid var(--egen-border-color); color: var(--egen-text-color); border-radius: var(--egen-radius-sm); padding: 0.75rem 1rem; outline: none; transition: var(--egen-transition);"
							required
						>
						<button 
							type="submit" 
							class="egen-btn-primary" 
							style="border-radius: var(--egen-radius-sm); padding: 0.75rem 1.5rem; font-weight: 600; cursor: pointer; border: none; background: var(--egen-primary-color); color: #fff; transition: var(--egen-transition);"
						>
							Buscar
						</button>
					</form>
				</div>

				{# Contagem de produtos #}
				{% if search_data.products %}
					<div class="egen-cat-hero-count" style="margin-top: 1rem;">
						<span class="egen-count-badge">
							{{ search_data.product_total }} produto{{ search_data.product_total != 1 ? 's' : '' }} encontrado{{ search_data.product_total != 1 ? 's' : '' }}
						</span>
					</div>
				{% endif %}
			</div>
		</div>

		<div class="egen-cat-wrapper">

			{% if search_data.products %}
				{# ── Barra de Filtros / Ordenação ── #}
				<div class="egen-cat-toolbar">
					<div class="egen-cat-toolbar-info">
						Resultado para "<strong>{{ term }}</strong>": Exibindo <strong>{{ search_data.products|length }}</strong> de <strong>{{ search_data.product_total }}</strong> produtos
					</div>
					<div class="egen-cat-toolbar-controls">
						<div class="egen-cat-select-wrap">
							<label for="select-sort">Ordenar</label>
							<select id="select-sort" class="egen-cat-select" onchange="location = this.value;">
								{% for option in search_data.sorts %}
									<option value="{{ option.href }}" {% if option.value == search_data.sort ~ '-' ~ search_data.order %} selected {% endif %}>{{ option.text }}</option>
								{% endfor %}
							</select>
							<svg class="egen-cat-select-arrow" width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
						</div>
						<div class="egen-cat-select-wrap">
							<label for="select-limit">Exibir</label>
							<select id="select-limit" class="egen-cat-select" onchange="location = this.value;">
								{% for option in search_data.limits %}
									<option value="{{ option.href }}" {% if option.value == search_data.limit %} selected {% endif %}>{{ option.text }}</option>
								{% endfor %}
							</select>
							<svg class="egen-cat-select-arrow" width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
						</div>
					</div>
				</div>

				<div class="egen-category-layout" style="display: block;">
					<div class="egen-category-main">
						{# ── Grade de Produtos ── #}
						<div class="egen-cat-grid" id="products-grid">
							{% for prod in search_data.products %}
								{% include 'pages/product/product-card.html.twig' with {'prod': prod} %}
							{% endfor %}
						</div>

						{# ── Paginação ── #}
						{% include 'components/molecules/pagination.html.twig' with {
							'total': search_data.product_total,
							'limit': search_data.limit,
							'current_page': search_data.pagination.page,
							'url': search_data.pagination.url
						} %}
					</div>
				</div>

			{% else %}
				{# ── Estado vazio ── #}
				<div class="egen-cat-empty" style="text-align: center; padding: 5rem 2rem;">
					<div class="egen-cat-empty-icon" style="font-size: 3rem; margin-bottom: 1.5rem;">🔍</div>
					<h2 class="egen-cat-empty-title" style="color: var(--egen-text-color); margin-bottom: 0.5rem;">Nenhum produto encontrado</h2>
					<p class="egen-cat-empty-desc" style="color: var(--egen-text-muted);">Não encontramos resultados para "{{ term }}". Tente utilizar termos diferentes ou categorias.</p>
				</div>
			{% endif %}

		</div>
	</div>
{% endblock %}
