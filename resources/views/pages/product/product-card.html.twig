{# Resolve a URL do produto (prioriza href montado no Controller > slug > keyword > fallback numérico) #}
{% set product_url = prod.href|default(url_for('product.detail', {'lang': lang, 'slug': prod.slug|default(prod.keyword|default(prod.product_id))})) %}
<article class="egen-prod-card" id="product-{{ prod.product_id }}">
	{# Badge de promoção #}
	{% if prod.special %}
		<div class="egen-prod-badge egen-prod-badge--sale">Oferta</div>
	{% endif %}

	{# Imagem #}
	<a href="{{ product_url }}" class="egen-prod-card-img-wrap" tabindex="-1" aria-hidden="true">
		<img src="{{ prod.thumb ?: '/image/no-image.png' }}" alt="{{ prod.name }}" class="egen-prod-card-img" loading="lazy">
		<div class="egen-prod-card-img-overlay">
			<span class="egen-prod-overlay-btn">Ver produto</span>
		</div>
	</a>

	{# Corpo #}
	<div class="egen-prod-card-body">
		<h3 class="egen-prod-card-title">
			<a href="{{ product_url }}" class="egen-prod-card-title-link">{{ prod.name }}</a>
		</h3>

		{% if prod.description %}
			<p class="egen-prod-card-desc">{{ prod.description|striptags|slice(0, 80) }}
				{% if prod.description|striptags|length > 80 %}…{% endif %}
			</p>
		{% endif %}

		{# Preços #}
		<div class="egen-prod-card-price-block">
			{% if prod.special %}
				<span class="egen-prod-price-old">{{ prod.price }}</span>
				<span class="egen-prod-price-special">{{ prod.special }}</span>
			{% else %}
				<span class="egen-prod-price">{{ prod.price }}</span>
			{% endif %}
		</div>

		{# Ação #}
		<form action="{{ prod.cart_add|default('/' ~ lang ~ '/carrinho/adicionar') }}" method="POST" class="egen-prod-card-form prod-card-form">
			<input type="hidden" name="product_id" value="{{ prod.product_id }}">
			<input type="hidden" name="quantity" value="{{ prod.minimum|default(1) }}">
			<a href="{{ product_url }}" class="egen-prod-btn-details">Ver detalhes</a>
			<button type="submit" class="egen-prod-btn-cart" title="Adicionar ao carrinho">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
					<path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
				</svg>
			</button>
			<button type="button" class="egen-prod-btn-wishlist add-to-wishlist-btn" data-product-id="{{ prod.product_id }}" title="Adicionar à lista de desejos">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
				</svg>
			</button>
		</form>
	</div>
</article>
