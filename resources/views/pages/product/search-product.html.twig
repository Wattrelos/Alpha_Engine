{% extends 'layouts/base.html.twig' %}

{% block title %}
	{{ seo.title }}
{% endblock %}

{% block content %}
	<div id="egen-category-page" class="egen-search-page">

		{# ── Hero / Cabeçalho da Busca ── #}
		<div class="egen-cat-hero">
			<div class="egen-cat-hero-inner">
				{# Breadcrumb #}
				<nav class="egen-cat-breadcrumb" aria-label="Navegação">
					<a href="/{{ lang }}">{{ Search.breadcrumbHome }}</a>
					<span class="sep">›</span>
					<span class="current">{{ Search.breadcrumbSearch }}</span>
				</nav>

				<h1 class="egen-cat-hero-title">{{ Search.headingTitle }}</h1>

				{# Formulário de busca interno na página #}
				<div class="egen-search-form-container" style="margin-top: 1.5rem; max-width: 600px; width: 100%;">
					<form action="/{{ lang }}/busca" method="GET" class="egen-search-page-form" style="display: flex; gap: 0.5rem; width: 100%;">
						<input 
							type="text" 
							name="busca" 
							value="{{ term }}" 
							placeholder="{{ Search.searchPlaceholder }}" 
							class="egen-form-input" 
							style="flex: 1; background: var(--egen-bg-input); border: 1px solid var(--egen-border-color); color: var(--egen-text-color); border-radius: var(--egen-radius-sm); padding: 0.75rem 1rem; outline: none; transition: var(--egen-transition);"
							required
						>
						<button 
							type="submit" 
							class="egen-btn-primary" 
							style="border-radius: var(--egen-radius-sm); padding: 0.75rem 1.5rem; font-weight: 600; cursor: pointer; border: none; background: var(--egen-primary-color); color: #fff; transition: var(--egen-transition);"
						>
							{{ Search.buttonSearch }}
						</button>
					</form>
				</div>

				{# Contagem de produtos #}
				{% if search_data.products %}
					<div class="egen-cat-hero-count" style="margin-top: 1rem;">
						<span class="egen-count-badge">
							{{ search_data.product_total }} {{ search_data.product_total != 1 ? Search.textProductPlural : Search.textProductSingular }} {{ search_data.product_total != 1 ? Search.textFoundPlural : Search.textFoundSingular }}
						</span>
					</div>
				{% endif %}
			</div>
		</div>

		<div class="egen-cat-wrapper">

			{% if search_data.products %}
				{# ── Barra de Filtros / Ordenação ── #}
				<div class="egen-cat-toolbar">
					<div class="egen-cat-toolbar-info">
						{{ Search.textResultFor }} "<strong>{{ term }}</strong>": {{ Search.textShowing }} <strong>{{ search_data.products|length }}</strong> {{ Search.textOf }} <strong>{{ search_data.product_total }}</strong> {{ search_data.product_total != 1 ? Search.textProductPlural : Search.textProductSingular }}
					</div>
					<div class="egen-cat-toolbar-controls">
						<div class="egen-cat-select-wrap">
							<label for="select-sort">{{ Search.textSort }}</label>
							<select id="select-sort" class="egen-cat-select" onchange="location = this.value;">
								{% for option in search_data.sorts %}
									<option value="{{ option.href }}" {% if option.value == search_data.sort ~ '-' ~ search_data.order %} selected {% endif %}>{{ option.text }}</option>
								{% endfor %}
							</select>
							<svg class="egen-cat-select-arrow" width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
						</div>
						<div class="egen-cat-select-wrap">
							<label for="select-limit">{{ Search.textLimit }}</label>
							<select id="select-limit" class="egen-cat-select" onchange="location = this.value;">
								{% for option in search_data.limits %}
									<option value="{{ option.href }}" {% if option.value == search_data.limit %} selected {% endif %}>{{ option.text }}</option>
								{% endfor %}
							</select>
							<svg class="egen-cat-select-arrow" width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
						</div>
					</div>
				</div>

				<div class="egen-category-layout" style="display: block;">
					<div class="egen-category-main">
						{# ── Grade de Produtos ── #}
						<div class="egen-cat-grid" id="products-grid">
							{% for prod in search_data.products %}
								<article class="egen-prod-card" id="product-{{ prod.product_id }}">
									{# Badge de promoção #}
									{% if prod.special %}
										<div class="egen-prod-badge egen-prod-badge--sale">{{ Search.textSale }}</div>
									{% endif %}

									{# Imagem #}
									<a href="{{ prod.href }}" class="egen-prod-card-img-wrap" tabindex="-1" aria-hidden="true">
										<img src="{{ prod.thumb ?: '/img/no-image.png' }}" alt="{{ prod.name }}" class="egen-prod-card-img" loading="lazy">
										<div class="egen-prod-card-img-overlay">
											<span class="egen-prod-overlay-btn">{{ Search.textViewProduct }}</span>
										</div>
									</a>

									{# Corpo #}
									<div class="egen-prod-card-body">
										<h3 class="egen-prod-card-title">
											<a href="{{ prod.href }}" class="egen-prod-card-title-link">{{ prod.name }}</a>
										</h3>

										{% if prod.description %}
											<p class="egen-prod-card-desc">{{ prod.description|striptags|slice(0, 80) }}
												{% if prod.description|striptags|length > 80 %}…
												{% endif %}
											</p>
										{% endif %}

										{# Preços #}
										<div class="egen-prod-card-price-block">
											{% if prod.special %}
												<span class="egen-prod-price-old">{{ prod.price }}</span>
												<span class="egen-prod-price-special">{{ prod.special }}</span>
											{% else %}
												<span class="egen-prod-price">{{ prod.price }}</span>
											{% endif %}
										</div>

										{# Ação #}
										<form action="{{ prod.cart_add|default('/' ~ lang ~ '/carrinho/adicionar') }}" method="POST" class="egen-prod-card-form prod-card-form">
											<input type="hidden" name="product_id" value="{{ prod.product_id }}">
											<input type="hidden" name="quantity" value="{{ prod.minimum|default(1) }}">
											<a href="{{ prod.href }}" class="egen-prod-btn-details">{{ Search.textViewDetails }}</a>
											<button type="submit" class="egen-prod-btn-cart" title="{{ Common.button.cart }}">
												<svg width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
													<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
													<path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
												</svg>
											</button>
										</form>
									</div>
								</article>
							{% endfor %}
						</div>

						{# ── Paginação ── #}
						{% if search_data.product_total > search_data.limit %}
							<div class="egen-cat-pagination-wrap">
								<nav class="egen-cat-pagination" aria-label="Navegação de páginas">
									{% set total_pages = (search_data.product_total / search_data.limit)|round(0, 'ceil') %}
									{% set current_page = search_data.pagination.page %}
									{% set range = 2 %}

									{% if current_page > 1 %}
										<a class="egen-cat-page-btn" href="{{ search_data.pagination.url|replace({'{page}': 1}) }}" title="Primeira">
											<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="11 17 6 12 11 7"/><polyline points="18 17 13 12 18 7"/></svg>
										</a>
										<a class="egen-cat-page-btn" href="{{ search_data.pagination.url|replace({'{page}': current_page - 1}) }}" title="Anterior">
											<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
										</a>
									{% endif %}

									{% if current_page - range > 1 %}
										<span class="egen-cat-page-sep">…</span>
									{% endif %}

									{% for page in 1..total_pages %}
										{% if page >= current_page - range and page <= current_page + range %}
											<a class="egen-cat-page-btn {% if page == current_page %}egen-cat-page-btn--active{% endif %}" href="{{ search_data.pagination.url|replace({'{page}': page}) }}">{{ page }}</a>
										{% endif %}
									{% endfor %}

									{% if current_page + range < total_pages %}
										<span class="egen-cat-page-sep">…</span>
									{% endif %}

									{% if current_page < total_pages %}
										<a class="egen-cat-page-btn" href="{{ search_data.pagination.url|replace({'{page}': current_page + 1}) }}" title="Próxima">
											<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
										</a>
										<a class="egen-cat-page-btn" href="{{ search_data.pagination.url|replace({'{page}': total_pages}) }}" title="Última">
											<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="13 17 18 12 13 7"/><polyline points="6 17 11 12 6 7"/></svg>
										</a>
									{% endif %}
								</nav>
							</div>
						{% endif %}
					</div>
				</div>

			{% else %}
				{# ── Estado vazio ── #}
				<div class="egen-cat-empty" style="text-align: center; padding: 5rem 2rem;">
					<div class="egen-cat-empty-icon" style="font-size: 3rem; margin-bottom: 1.5rem;">🔍</div>
					<h2 class="egen-cat-empty-title" style="color: var(--egen-text-color); margin-bottom: 0.5rem;">{{ Search.textNoResults }}</h2>
					<p class="egen-cat-empty-desc" style="color: var(--egen-text-muted);">{{ Search.textEmptyDesc|format(term) }}</p>
				</div>
			{% endif %}

		</div>
	</div>
{% endblock %}
