{% extends 'layouts/base.html.twig' %}

{% block title %}{{ seo.title }}{% endblock %}

{% block content %}
<div id="info-page">

    {# ── Hero ── #}
    <div class="info-hero">
        <div class="info-hero-inner">
            <nav class="info-breadcrumb" aria-label="Navegação">
                <a href="/{{ lang }}">Início</a>
                <span class="sep">›</span>
                {% if information.breadcrumbs %}
                    {% for crumb in information.breadcrumbs|slice(1) %}
                        {% if not loop.last %}
                            <a href="{{ crumb.href }}">{{ crumb.text }}</a>
                            <span class="sep">›</span>
                        {% else %}
                            <span class="current">{{ crumb.text }}</span>
                        {% endif %}
                    {% endfor %}
                {% else %}
                    <span class="current">{{ information.title }}</span>
                {% endif %}
            </nav>
            <div class="info-hero-content">
                <div class="info-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                </div>
                <div>
                    <h1 class="info-hero-title">{{ information.title }}</h1>
                    <p class="info-hero-sub">Página institucional de informações</p>
                </div>
            </div>
        </div>
    </div>

    {# ── Article Content ── #}
    <div class="info-wrapper">
        <article class="info-card">
            <div class="info-body-content">
                {{ information.description|raw }}
            </div>
        </article>
    </div>
</div>

<style>
/* ══════════════════════════════════════════════════
   INFORMATION PAGE — Alpha Engine Premium UI
   ══════════════════════════════════════════════════ */

#info-page {
    min-height: 100vh;
    background: #0d0f14;
    color: #e2e8f0;
    font-family: 'Inter', 'Outfit', system-ui, sans-serif;
}

/* ── Hero ── */
.info-hero {
    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #0f172a 100%);
    border-bottom: 1px solid rgba(99, 102, 241, 0.2);
    padding: 3rem 2rem 2.5rem;
}
.info-hero-inner { max-width: 900px; margin: 0 auto; }

.info-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #94a3b8;
    margin-bottom: 1.75rem;
}
.info-breadcrumb a { color: #94a3b8; text-decoration: none; transition: color 0.2s; }
.info-breadcrumb a:hover { color: #a5b4fc; }
.info-breadcrumb .sep { color: #475569; }
.info-breadcrumb .current { color: #a5b4fc; font-weight: 500; }

.info-hero-content {
    display: flex;
    align-items: center;
    gap: 1.25rem;
}
.info-icon {
    width: 64px; height: 64px;
    background: linear-gradient(135deg, rgba(99,102,241,0.25), rgba(139,92,246,0.25));
    border: 1px solid rgba(99, 102, 241, 0.4);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #a5b4fc;
    flex-shrink: 0;
}
.info-hero-title {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
    color: #f1f5f9;
    margin: 0 0 0.25rem;
    letter-spacing: -0.02em;
}
.info-hero-sub { color: #94a3b8; font-size: 0.9rem; margin: 0; }

/* ── Wrapper ── */
.info-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
}

.info-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 16px;
    padding: 2.5rem 3rem;
    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
}

.info-body-content {
    line-height: 1.8;
    font-size: 1.05rem;
    color: #cbd5e1;
}

/* Rich text formatting rules within the page content */
.info-body-content p {
    margin-bottom: 1.5rem;
}
.info-body-content h2, .info-body-content h3, .info-body-content h4 {
    color: #f1f5f9;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
}
.info-body-content h2 { font-size: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 0.5rem; }
.info-body-content h3 { font-size: 1.25rem; }

.info-body-content ul, .info-body-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
}
.info-body-content li {
    margin-bottom: 0.5rem;
}
.info-body-content strong {
    color: #f8fafc;
}
.info-body-content a {
    color: #8b5cf6;
    text-decoration: none;
    transition: color 0.2s;
    border-bottom: 1px dotted rgba(139, 92, 246, 0.4);
}
.info-body-content a:hover {
    color: #a5b4fc;
    border-bottom-style: solid;
}

/* ── Responsive ── */
@media (max-width: 640px) {
    .info-hero { padding: 2.5rem 1rem 2rem; }
    .info-wrapper { padding: 2rem 1rem 4rem; }
    .info-card { padding: 1.5rem; }
    .info-hero-title { font-size: 1.5rem; }
    .info-icon { width: 52px; height: 52px; }
}
</style>
{% endblock %}
