{% extends "pos/layout.twig" %}

{% block title %}{{ title }} | AgSonhos PDV{% endblock %}

{% block extra_styles %}{% endblock %}

{% block content %}
<div class="pos-workspace">
    <!-- Panel Esquerdo: Catálogo de Produtos e Busca de Clientes -->
    <div class="catalog-panel">
        <div class="search-box-row">
            <!-- Busca de Produtos -->
            <div class="search-input-wrapper">
                <i class="fas fa-search"></i>
                <input type="text" id="product_search_input" class="search-input" placeholder="Buscar produtos por nome ou código..." autocomplete="off">
            </div>
            
            <!-- Busca e Identificação de Cliente -->
            <div class="search-input-wrapper customer-search-dropdown">
                <i class="fas fa-user"></i>
                <input type="text" id="customer_search_input" class="search-input" placeholder="Identificar cliente por nome/e-mail..." autocomplete="off">
                
                <!-- Resultados da busca de clientes -->
                <div id="customer_search_results" class="customer-results"></div>
            </div>
        </div>
        
        <!-- Grid de Produtos -->
        <div class="products-grid-container">
            <div id="products_grid" class="products-grid">
                <!-- Injetado via Javascript -->
                <div class="empty-cart-state" style="grid-column: 1/-1; padding: 4rem;">
                    <i class="fas fa-spinner fa-spin empty-cart-icon"></i>
                    <p>Carregando catálogo...</p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Panel Direito: Carrinho de Compras -->
    <div class="cart-panel">
        <div class="cart-header">
            <h2 class="cart-title">
                <i class="fas fa-shopping-cart" style="color: var(--accent);"></i>
                Pré-Venda
            </h2>
            <div class="customer-selector">
                <div class="customer-info-box">
                    <div>
                        <span style="font-size: 0.75rem; color: var(--text-muted); display: block;">Cliente Identificado</span>
                        <span id="selected_customer_name" class="customer-name-selected unidentified">Consumidor Não Identificado</span>
                    </div>
                    <button id="clear_customer_btn" class="customer-search-btn" style="display: none; color: var(--danger);">
                        <i class="fas fa-times-circle"></i>
                    </button>
                </div>
            </div>
        </div>
        
        <!-- Itens do Carrinho -->
        <div id="cart_items_list" class="cart-items">
            <div class="empty-cart-state">
                <i class="fas fa-shopping-basket empty-cart-icon"></i>
                <p>Carrinho de pré-venda vazio</p>
            </div>
        </div>
        
        <!-- Totais e Envio -->
        <div class="cart-footer">
            <div class="total-row">
                <span>Sub-Total</span>
                <span id="cart_subtotal">R$ 0,00</span>
            </div>
            <div class="total-row grand-total">
                <span>Total</span>
                <span id="cart_total">R$ 0,00</span>
            </div>
            
            <button id="checkout_btn" class="checkout-btn" disabled>
                <i class="fas fa-ticket-alt"></i>
                Salvar Pré-Venda
            </button>
        </div>
    </div>
</div>

<!-- Modal de erro ou mensagens de idempotência -->
<div id="alert_modal" class="pos-modal">
    <div class="modal-content">
        <i class="fas fa-exclamation-triangle modal-icon" id="modal_icon"></i>
        <h3 class="modal-title" id="modal_title">Aviso</h3>
        <p class="modal-msg" id="modal_message">Mensagem padrão</p>
        <button id="modal_close_btn" class="modal-close-btn">Entendido</button>
    </div>
</div>

<!-- Modal de Variações de Produto -->
<div id="variants_modal" class="pos-modal">
    <div class="modal-content" style="max-width: 600px; text-align: left;">
        <div class="variants-modal-header">
            <h3 class="variants-modal-title" id="variants_modal_title">Escolha a Variação</h3>
            <button id="variants_modal_close_btn" class="variants-modal-close">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div id="variants_modal_list" class="variants-list">
            <!-- Injetado via Javascript -->
        </div>
    </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Elementos da interface
        const productSearchInput = document.getElementById('product_search_input');
        const customerSearchInput = document.getElementById('customer_search_input');
        const customerSearchResults = document.getElementById('customer_search_results');
        const productsGrid = document.getElementById('products_grid');
        const cartItemsList = document.getElementById('cart_items_list');
        const selectedCustomerName = document.getElementById('selected_customer_name');
        const clearCustomerBtn = document.getElementById('clear_customer_btn');
        const cartSubtotal = document.getElementById('cart_subtotal');
        const cartTotal = document.getElementById('cart_total');
        const checkoutBtn = document.getElementById('checkout_btn');
        
        // Modal
        const alertModal = document.getElementById('alert_modal');
        const modalIcon = document.getElementById('modal_icon');
        const modalTitle = document.getElementById('modal_title');
        const modalMessage = document.getElementById('modal_message');
        const modalCloseBtn = document.getElementById('modal_close_btn');
        
        // Estado do Carrinho em memória
        let cart = [];
        let selectedCustomerId = 0;
        let productsDatabase = [];
        
        // Utilitário de formatação de dinheiro
        const formatMoney = (val) => {
            return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(val);
        };
        
        // Gerador de UUID para Idempotency-Key
        const generateUUID = () => {
            return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
                var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
                return v.toString(16);
            });
        };
        
        let idempotencyKey = generateUUID();

        // 1. Carrega Produtos inicialmente
        const loadProducts = (query = '') => {
            fetch(`{{ admin_path }}/pos/produtos/buscar?q=${encodeURIComponent(query)}`)
                .then(res => res.json())
                .then(data => {
                    productsDatabase = data;
                    renderProducts();
                })
                .catch(err => {
                    console.error("Erro ao buscar produtos:", err);
                    productsGrid.innerHTML = `
                        <div class="empty-cart-state" style="grid-column: 1/-1; color: var(--danger);">
                            <i class="fas fa-exclamation-circle empty-cart-icon"></i>
                            <p>Falha ao conectar com o catálogo de produtos.</p>
                        </div>
                    `;
                });
        };
        
        // Renderiza Grid de Produtos
        const renderProducts = () => {
            if (productsDatabase.length === 0) {
                productsGrid.innerHTML = `
                    <div class="empty-cart-state" style="grid-column: 1/-1;">
                        <i class="fas fa-box-open empty-cart-icon"></i>
                        <p>Nenhum produto encontrado no estoque.</p>
                    </div>
                `;
                return;
            }
            
            productsGrid.innerHTML = productsDatabase.map(p => {
                const hasVariants = p.variants && p.variants.length > 0;
                const isOutOfStock = p.quantity <= 0;
                const priceHtml = p.special_formatted 
                    ? `<span class="product-price-old">${p.price_formatted}</span> <span class="product-price" style="color: var(--success);">${p.special_formatted}</span>`
                    : `<span class="product-price">${p.price_formatted}</span>`;
                
                return `
                    <div class="product-card" onclick="triggerAdd(${p.product_id}, ${isOutOfStock})">
                        <div class="product-image-container">
                            <img src="${p.image}" class="product-image" alt="${p.name}" onerror="this.src='/image/no_image.png'">
                            <span class="product-badge">${p.quantity} unid</span>
                        </div>
                        <div class="product-info">
                            <h3 class="product-name" title="${p.name}">${p.name}</h3>
                            <p class="product-meta">Ref: ${p.model || 'N/A'}</p>
                            <div class="product-pricing">
                                <div>${priceHtml}</div>
                                <button class="add-btn" ${isOutOfStock && !hasVariants ? 'disabled' : ''} onclick="event.stopPropagation(); addToCart(${p.product_id})">
                                    <i class="fas ${hasVariants ? 'fa-list-ul' : (isOutOfStock ? 'fa-ban' : 'fa-plus')}"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        };
        
        window.triggerAdd = (productId, isOutOfStock) => {
            const product = productsDatabase.find(p => p.product_id === productId);
            if (!product) return;
            
            if (product.variants && product.variants.length > 0) {
                addToCart(productId);
            } else if (!isOutOfStock) {
                addToCart(productId);
            }
        };

        // 2. Busca e Seleção de Clientes
        let customerSearchTimeout;
        customerSearchInput.addEventListener('input', () => {
            clearTimeout(customerSearchTimeout);
            const query = customerSearchInput.value.trim();
            
            if (query.length < 2) {
                customerSearchResults.style.display = 'none';
                return;
            }
            
            customerSearchTimeout = setTimeout(() => {
                fetch(`{{ admin_path }}/pos/clientes/buscar?q=${encodeURIComponent(query)}`)
                    .then(res => res.json())
                    .then(data => {
                        if (data.length === 0) {
                            customerSearchResults.innerHTML = `
                                <div class="customer-item" style="cursor: default;">
                                    <span class="customer-item-name">Nenhum cliente encontrado</span>
                                </div>
                            `;
                        } else {
                            customerSearchResults.innerHTML = data.map(c => `
                                <div class="customer-item" onclick="selectCustomer(${c.customer_id}, '${c.name.replace(/'/g, "\\'")}')">
                                    <div class="customer-item-name">${c.name}</div>
                                    <div class="customer-item-meta"><i class="fas fa-envelope"></i> ${c.email} | <i class="fas fa-phone"></i> ${c.telephone || 'Sem tel'}</div>
                                </div>
                            `).join('');
                        }
                        customerSearchResults.style.display = 'block';
                    });
            }, 300);
        });
        
        // Selecionar Cliente
        window.selectCustomer = (id, name) => {
            selectedCustomerId = id;
            selectedCustomerName.textContent = name;
            selectedCustomerName.classList.remove('unidentified');
            clearCustomerBtn.style.display = 'block';
            
            customerSearchResults.style.display = 'none';
            customerSearchInput.value = '';
        };
        
        // Limpar Cliente Selecionado
        clearCustomerBtn.addEventListener('click', () => {
            selectedCustomerId = 0;
            selectedCustomerName.textContent = 'Consumidor Não Identificado';
            selectedCustomerName.classList.add('unidentified');
            clearCustomerBtn.style.display = 'none';
        });
        
        const variantsModal = document.getElementById('variants_modal');
        const variantsModalTitle = document.getElementById('variants_modal_title');
        const variantsModalList = document.getElementById('variants_modal_list');
        const variantsModalCloseBtn = document.getElementById('variants_modal_close_btn');

        variantsModalCloseBtn.addEventListener('click', () => {
            variantsModal.style.display = 'none';
        });

        // Fechar dropdown de clientes se clicar fora
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.customer-search-dropdown')) {
                customerSearchResults.style.display = 'none';
            }
            if (e.target === variantsModal) {
                variantsModal.style.display = 'none';
            }
        });

        // 3. Gerenciamento do Carrinho de Compras
        window.addToCart = (productId) => {
            const product = productsDatabase.find(p => p.product_id === productId);
            if (!product) return;
            
            // Se o produto tiver variações, abre o modal de variações
            if (product.variants && product.variants.length > 0) {
                openVariantsModal(product);
                return;
            }
            
            const existingItem = cart.find(item => item.product_id === productId);
            if (existingItem) {
                if (existingItem.quantity < product.quantity) {
                    existingItem.quantity += 1;
                } else {
                    showModal('Limite de estoque', `Você já adicionou a quantidade máxima disponível (${product.quantity} unid) de ${product.name}.`, 'fa-exclamation-circle', 'var(--warning)');
                }
            } else {
                const finalPrice = product.special !== null ? product.special : product.price;
                cart.push({
                    product_id: product.product_id,
                    name: product.name,
                    price: finalPrice,
                    image: product.image,
                    quantity: 1,
                    max_quantity: product.quantity
                });
            }
            
            renderCart();
        };

        const openVariantsModal = (product) => {
            variantsModalTitle.textContent = `Escolha a variação de: ${product.name}`;
            variantsModalList.innerHTML = product.variants.map(v => {
                const isOutOfStock = v.quantity <= 0;
                return `
                    <div class="variant-item-card">
                        <div class="variant-info-wrapper">
                            <img src="${v.image}" class="variant-image-thumb" onerror="this.src='/image/no_image.png'">
                            <div class="variant-meta-wrapper">
                                <span class="variant-name-text">${v.name}</span>
                                <span class="variant-sku-text">Ref/SKU: ${v.sku || 'N/A'}</span>
                            </div>
                        </div>
                        <div class="variant-action-wrapper">
                            <div class="variant-price-info">
                                <span class="variant-price-text">${v.price_formatted}</span>
                                <span class="variant-stock-text ${isOutOfStock ? 'variant-stock-out' : 'variant-stock-in'}">
                                    ${v.quantity} unid
                                </span>
                            </div>
                            <button class="add-btn" ${isOutOfStock ? 'disabled' : ''} onclick="addVariantToCart(${product.product_id}, ${v.product_id})">
                                <i class="fas ${isOutOfStock ? 'fa-ban' : 'fa-plus'}"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
            variantsModal.style.display = 'flex';
        };

        window.addVariantToCart = (productId, variantId) => {
            const product = productsDatabase.find(p => p.product_id === productId);
            if (!product) return;
            
            const variant = product.variants.find(v => v.product_id === variantId);
            if (!variant) return;
            
            const existingItem = cart.find(item => item.product_id === variantId);
            if (existingItem) {
                if (existingItem.quantity < variant.quantity) {
                    existingItem.quantity += 1;
                } else {
                    showModal('Limite de estoque', `Você já adicionou a quantidade máxima disponível (${variant.quantity} unid) de ${product.name} - ${variant.name}.`, 'fa-exclamation-circle', 'var(--warning)');
                }
            } else {
                cart.push({
                    product_id: variant.product_id,
                    name: `${product.name} - ${variant.name}`,
                    price: variant.price,
                    image: variant.image,
                    quantity: 1,
                    max_quantity: variant.quantity
                });
            }
            
            variantsModal.style.display = 'none';
            renderCart();
        };
        
        window.updateQty = (productId, change) => {
            const item = cart.find(i => i.product_id === productId);
            if (!item) return;
            
            const newQty = item.quantity + change;
            if (newQty <= 0) {
                removeFromCart(productId);
            } else if (newQty <= item.max_quantity) {
                item.quantity = newQty;
                renderCart();
            } else {
                showModal('Limite de estoque', `Estoque máximo atingido para ${item.name} (${item.max_quantity} unidades).`, 'fa-exclamation-circle', 'var(--warning)');
            }
        };
        
        window.removeFromCart = (productId) => {
            cart = cart.filter(item => item.product_id !== productId);
            renderCart();
        };
        
        const renderCart = () => {
            if (cart.length === 0) {
                cartItemsList.innerHTML = `
                    <div class="empty-cart-state">
                        <i class="fas fa-shopping-basket empty-cart-icon"></i>
                        <p>Carrinho de pré-venda vazio</p>
                    </div>
                `;
                cartSubtotal.textContent = formatMoney(0);
                cartTotal.textContent = formatMoney(0);
                checkoutBtn.disabled = true;
                return;
            }
            
            let totalVal = 0;
            
            cartItemsList.innerHTML = cart.map(item => {
                const itemTotal = item.price * item.quantity;
                totalVal += itemTotal;
                
                return `
                    <div class="cart-item">
                        <img src="${item.image}" class="cart-item-image" alt="${item.name}" onerror="this.src='/image/no_image.png'">
                        <div class="cart-item-details">
                            <h4 class="cart-item-name" title="${item.name}">${item.name}</h4>
                            <div class="cart-item-price">${formatMoney(item.price)}</div>
                        </div>
                        <div class="qty-controls">
                            <button class="qty-btn" onclick="updateQty(${item.product_id}, -1)">-</button>
                            <span class="qty-val">${item.quantity}</span>
                            <button class="qty-btn" onclick="updateQty(${item.product_id}, 1)">+</button>
                        </div>
                        <button class="remove-item-btn" onclick="removeFromCart(${item.product_id})">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                `;
            }).join('');
            
            cartSubtotal.textContent = formatMoney(totalVal);
            cartTotal.textContent = formatMoney(totalVal);
            checkoutBtn.disabled = false;
        };

        // 4. Salvar Pré-Venda
        checkoutBtn.addEventListener('click', () => {
            if (cart.length === 0) return;
            
            checkoutBtn.disabled = true;
            checkoutBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Salvando...';
            
            const payload = {
                customer_id: selectedCustomerId,
                cart: cart.map(item => ({
                    product_id: item.product_id,
                    quantity: item.quantity
                })),
                idempotency_key: idempotencyKey
            };
            
            fetch('{{ admin_path }}/pos/pedidos/salvar', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Idempotency-Key': idempotencyKey
                },
                body: JSON.stringify(payload)
            })
            .then(res => {
                if (res.status === 422) {
                    // Trata duplicidade
                    return res.json().then(data => {
                        throw new Error(data.message || 'Requisição duplicada já processada.');
                    });
                }
                if (!res.ok) {
                    return res.json().then(data => {
                        throw new Error(data.error || 'Erro ao processar pré-venda.');
                    });
                }
                return res.json();
            })
            .then(data => {
                if (data.success && data.order_id) {
                    // Sucesso: Redireciona para tela de checkout sucesso
                    window.location.href = `{{ admin_path }}/pos/vendedor/checkout?order_id=${data.order_id}`;
                } else {
                    throw new Error(data.error || 'Falha ao processar pré-venda.');
                }
            })
            .catch(err => {
                console.error("Erro na requisição:", err);
                showModal('Falha na Operação', err.message, 'fa-exclamation-triangle', 'var(--danger)');
                
                // Restaura o botão
                checkoutBtn.disabled = false;
                checkoutBtn.innerHTML = '<i class="fas fa-ticket-alt"></i> Salvar Pré-Venda';
                
                // Gera uma nova chave idempotente em caso de falha real para permitir retentativas
                idempotencyKey = generateUUID();
            });
        });

        // 5. Exibição de Alertas Modal
        const showModal = (title, message, iconClass, iconColor) => {
            modalTitle.textContent = title;
            modalMessage.textContent = message;
            modalIcon.className = `fas ${iconClass} modal-icon`;
            modalIcon.style.color = iconColor;
            alertModal.style.display = 'flex';
        };
        
        modalCloseBtn.addEventListener('click', () => {
            alertModal.style.display = 'none';
        });

        // 6. Busca de produtos dinâmica
        let productSearchTimeout;
        productSearchInput.addEventListener('input', () => {
            clearTimeout(productSearchTimeout);
            productSearchTimeout = setTimeout(() => {
                loadProducts(productSearchInput.value.trim());
            }, 300);
        });

        // Carga inicial
        loadProducts();
    });
</script>
{% endblock %}
