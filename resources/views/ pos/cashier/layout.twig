{% extends " pos/layout.twig" %}

{% block title %}{{ title }} | AgSonhos PDV{% endblock %}

{% block extra_styles %}
.cashier-workspace {
    display: flex;
    width: 100%;
    height: 100%;
    gap: 1.5rem;
    padding: 1rem 0;
}

/* Esquerda: Painel de busca e pagamento */
.payment-section {
    flex: 1.2;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

/* Direita: Detalhes do ticket */
.ticket-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: var(--bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.05);
    overflow: hidden;
}

/* Ticket Search Panel */
.ticket-search-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.ticket-search-row {
    display: flex;
    gap: 0.75rem;
}

.ticket-search-input {
    flex: 1;
    background-color: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 700;
    text-align: center;
    letter-spacing: 2px;
    outline: none;
    transition: var(--transition);
}

.ticket-search-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
}

.search-btn {
    padding: 0 1.5rem;
    background-color: var(--accent);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.search-btn:hover {
    background-color: var(--accent-hover);
}

/* Payment Methods Grid */
.payment-methods-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
}

.pay-method-card {
    background-color: rgba(30, 41, 75, 0.3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem 0.75rem;
    text-align: center;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
}

.pay-method-card:hover {
    border-color: var(--accent);
    background-color: rgba(99, 102, 241, 0.05);
}

.pay-method-card.active {
    border-color: var(--success);
    background-color: var(--success-glow);
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
}

.pay-method-icon {
    font-size: 1.75rem;
    color: var(--text-secondary);
}

.pay-method-card.active .pay-method-icon {
    color: var(--success);
}

.pay-method-title {
    font-size: 0.85rem;
    font-weight: 600;
}

/* Payment Configuration Panels */
.pay-config-panel {
    display: none;
    flex: 1;
    min-height: 180px;
}

/* Calculator for Cash change */
.cash-calculator {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
}

.calculator-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
}

.calc-input-wrapper {
    position: relative;
    flex: 1;
}

.calc-currency-symbol {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    font-weight: 700;
    color: var(--text-muted);
}

.calc-input {
    width: 100%;
    padding: 0.75rem 0.75rem 0.75rem 2rem;
    background-color: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 1.1rem;
    font-weight: 700;
    outline: none;
}

.calc-value-large {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--warning);
}

/* Pix QR Code Mock */
.pix-panel {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background-color: rgba(255, 255, 255, 0.02);
    border-radius: var(--radius-md);
    padding: 1rem;
}

.pix-qr-container {
    width: 120px;
    height: 120px;
    background-color: white;
    border-radius: 8px;
    padding: 6px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.pix-qr-img {
    max-width: 100%;
    max-height: 100%;
}

.pix-scanner-line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: var(--success);
    box-shadow: 0 0 8px var(--success);
    animation: scanAnimation 2s linear infinite;
}

@keyframes scanAnimation {
    0% { top: 0%; }
    50% { top: 100%; }
    100% { top: 0%; }
}

.pix-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

/* Pre-order Details receipt preview (Right panel) */
.ticket-header {
    padding: 1.25rem;
    border-bottom: 1px solid var(--border);
    background-color: rgba(11, 15, 25, 0.3);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.ticket-items-container {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
}

.ticket-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
}

.ticket-item-qty {
    background-color: var(--bg-tertiary);
    color: var(--text-secondary);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    margin-right: 0.5rem;
}

.ticket-footer {
    padding: 1.25rem;
    border-top: 1px solid var(--border);
    background-color: rgba(11, 15, 25, 0.4);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.confirm-pay-btn {
    width: 100%;
    padding: 1rem;
    background: linear-gradient(135deg, var(--success), #059669);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px var(--success-glow);
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
}

.confirm-pay-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(16, 185, 129, 0.3);
}

.confirm-pay-btn:disabled {
    background: var(--border);
    color: var(--text-muted);
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
}
{% endblock %}

{% block content %}
<div class="cashier-workspace">
    <!-- Panel Esquerdo: Busca de ticket e Configuração de Pagamento -->
    <div class="payment-section">
        <!-- Card 1: Localizar Ticket -->
        <div class="glass-card ticket-search-card">
            <h3 style="font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-search" style="color: var(--accent);"></i>
                Localizar Pré-Venda
            </h3>
            <div class="ticket-search-row">
                <input type="text" id="ticket_id_input" class="ticket-search-input" placeholder="0000" maxlength="8" autocomplete="off">
                <button id="search_ticket_btn" class="search-btn">
                    <i class="fas fa-arrow-right"></i>
                    Buscar
                </button>
            </div>
        </div>

        <!-- Card 2: Seletor de Pagamento -->
        <div class="glass-card" style="flex: 1; display: flex; flex-direction: column; gap: 1.25rem;">
            <h3 style="font-family: var(--font-display); font-size: 1.05rem; font-weight: 700;">
                Método de Pagamento
            </h3>
            
            <div class="payment-methods-grid">
                <div class="pay-method-card active" data-method="Pix">
                    <i class="fas fa-qrcode pay-method-icon"></i>
                    <span class="pay-method-title">Pix Instantâneo</span>
                </div>
                <div class="pay-method-card" data-method="Cartão">
                    <i class="fas fa-credit-card pay-method-icon"></i>
                    <span class="pay-method-title">Débito / Crédito</span>
                </div>
                <div class="pay-method-card" data-method="Dinheiro">
                    <i class="fas fa-money-bill-wave pay-method-icon"></i>
                    <span class="pay-method-title">Dinheiro Físico</span>
                </div>
            </div>

            <!-- Detalhes do Pagamento Selecionado -->
            <!-- Painel Pix -->
            <div id="panel_Pix" class="pay-config-panel" style="display: flex;">
                <div class="pix-panel" style="width: 100%;">
                    <div class="pix-qr-container">
                        <!-- Simulated QR code pattern in CSS/SVG -->
                        <svg class="pix-qr-img" viewBox="0 0 100 100" fill="currentColor">
                            <path d="M0,0 h30 v30 h-30 z M10,10 h10 v10 h-10 z M70,0 h30 v30 h-30 z M80,10 h10 v10 h-10 z M0,70 h30 v30 h-30 z M10,80 h10 v10 h-10 z M40,40 h20 v20 h-20 z M45,45 h10 v10 h-10 z M40,0 h10 v10 h-10 z M60,20 h10 v10 h-10 z M40,80 h20 v10 h-20 z M80,40 h20 v10 h-20 z M70,60 h10 v20 h-10 z M90,80 h10 v20 h-10 z" />
                        </svg>
                        <div class="pix-scanner-line"></div>
                    </div>
                    <div class="pix-info">
                        <span style="font-size: 0.8rem; color: var(--success); font-weight: 600;"><i class="fas fa-spinner fa-spin"></i> Aguardando Pix do cliente...</span>
                        <p style="font-size: 0.75rem; color: var(--text-secondary);">Aponte a câmera do celular para o QR Code acima. O sistema identificará o pagamento automaticamente.</p>
                        <button class="pos-exit-btn" style="padding: 0.3rem 0.6rem; font-size: 0.75rem; width: fit-content;" onclick="simulatePixReceived()">Simular Recebimento</button>
                    </div>
                </div>
            </div>

            <!-- Painel Cartão -->
            <div id="panel_Cartão" class="pay-config-panel">
                <div style="background-color: rgba(255, 255, 255, 0.02); padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--border); display: flex; flex-direction: column; gap: 0.75rem; justify-content: center; width: 100%;">
                    <span style="font-weight: 600; font-size: 0.85rem;"><i class="fas fa-terminal"></i> Terminal de Cartões TEF</span>
                    <p style="font-size: 0.75rem; color: var(--text-secondary);">Insira ou aproxime o cartão do cliente na maquininha de pagamento. Aguarde a confirmação de aprovação do terminal.</p>
                    <div style="background-color: var(--bg-primary); padding: 0.65rem; border-radius: 4px; border: 1px solid var(--border); text-align: center; font-size: 0.85rem; font-weight: 600; color: var(--warning);">
                        <i class="fas fa-circle-notch fa-spin"></i> Aguardando transação na maquininha...
                    </div>
                </div>
            </div>

            <!-- Painel Dinheiro -->
            <div id="panel_Dinheiro" class="pay-config-panel">
                <div class="cash-calculator">
                    <div class="calculator-row">
                        <span style="font-size: 0.85rem; color: var(--text-secondary);">Valor Recebido</span>
                        <div class="calc-input-wrapper">
                            <span class="calc-currency-symbol">R$</span>
                            <input type="number" id="cash_received_input" class="calc-input" placeholder="0,00" step="0.01">
                        </div>
                    </div>
                    <div class="calculator-row" style="border-top: 1px solid rgba(255, 255, 255, 0.05); padding-top: 1rem;">
                        <span style="font-size: 0.85rem; color: var(--text-secondary);">Troco Devido</span>
                        <span id="cash_change_due" class="calc-value-large">R$ 0,00</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel Direito: Detalhes do Ticket -->
    <div class="ticket-section">
        <div class="ticket-header">
            <div>
                <h2 style="font-family: var(--font-display); font-size: 1.1rem; font-weight: 700;">Detalhes do Pedido</h2>
                <span id="ticket_id_badge" style="font-size: 0.75rem; color: var(--text-muted);">Nenhum ticket carregado</span>
            </div>
            <span id="ticket_status_badge" class="brand-badge" style="display: none;">Pendente</span>
        </div>

        <!-- Lista de Itens do Pedido -->
        <div id="ticket_items_list" class="ticket-items-container">
            <div class="empty-cart-state">
                <i class="fas fa-file-invoice empty-cart-icon"></i>
                <p>Aguardando digitação do ticket...</p>
            </div>
        </div>

        <!-- Totais e Efetivação -->
        <div class="ticket-footer">
            <div class="total-row">
                <span>Cliente</span>
                <span id="ticket_customer_name" class="receipt-row-value" style="color: var(--text-primary);">N/A</span>
            </div>
            <div class="total-row grand-total">
                <span>Total a Pagar</span>
                <span id="ticket_total_price">R$ 0,00</span>
            </div>
            
            <button id="confirm_pay_btn" class="confirm-pay-btn" disabled>
                <i class="fas fa-check-circle"></i>
                Finalizar Recebimento
            </button>
        </div>
    </div>
</div>

<!-- Modal de Alerta / Sucesso -->
<div id="alert_modal" class="pos-modal">
    <div class="modal-content">
        <i class="fas fa-check-circle modal-icon" id="modal_icon" style="color: var(--success);"></i>
        <h3 class="modal-title" id="modal_title">Sucesso</h3>
        <p class="modal-msg" id="modal_message">Pagamento processado e venda concluída!</p>
        <button id="modal_close_btn" class="modal-close-btn">Confirmar</button>
    </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Elementos de busca e pagamento
        const ticketIdInput = document.getElementById('ticket_id_input');
        const searchTicketBtn = document.getElementById('search_ticket_btn');
        const payMethodCards = document.querySelectorAll('.pay-method-card');
        const payConfigPanels = document.querySelectorAll('.pay-config-panel');
        const cashReceivedInput = document.getElementById('cash_received_input');
        const cashChangeDue = document.getElementById('cash_change_due');
        
        // Elementos do painel do ticket
        const ticketIdBadge = document.getElementById('ticket_id_badge');
        const ticketStatusBadge = document.getElementById('ticket_status_badge');
        const ticketItemsList = document.getElementById('ticket_items_list');
        const ticketCustomerName = document.getElementById('ticket_customer_name');
        const ticketTotalPrice = document.getElementById('ticket_total_price');
        const confirmPayBtn = document.getElementById('confirm_pay_btn');
        
        // Modal
        const alertModal = document.getElementById('alert_modal');
        const modalIcon = document.getElementById('modal_icon');
        const modalTitle = document.getElementById('modal_title');
        const modalMessage = document.getElementById('modal_message');
        const modalCloseBtn = document.getElementById('modal_close_btn');
        
        // Estado do ticket carregado
        let currentTicket = null;
        let selectedMethod = 'Pix';
        
        const formatMoney = (val) => {
            return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(val);
        };
        
        // 1. Busca do ticket
        const searchTicket = () => {
            const ticketId = ticketIdInput.value.trim();
            if (!ticketId) return;
            
            searchTicketBtn.disabled = true;
            searchTicketBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            
            fetch(`/LPDHED2dC7Gjrg2b/pos/pedidos/${ticketId}`)
                .then(res => {
                    if (!res.ok) {
                        throw new Error('Ticket não encontrado.');
                    }
                    return res.json();
                })
                .then(data => {
                    currentTicket = data;
                    renderTicket();
                })
                .catch(err => {
                    console.error(err);
                    showModal('Erro de Consulta', err.message, 'fa-exclamation-triangle', 'var(--danger)');
                    resetTicketState();
                })
                .finally(() => {
                    searchTicketBtn.disabled = false;
                    searchTicketBtn.innerHTML = '<i class="fas fa-arrow-right"></i> Buscar';
                });
        };
        
        searchTicketBtn.addEventListener('click', searchTicket);
        ticketIdInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                searchTicket();
            }
        });
        
        // Renderiza ticket carregado
        const renderTicket = () => {
            if (!currentTicket) return;
            
            ticketIdBadge.textContent = `Ticket #${currentTicket.order_id}`;
            ticketCustomerName.textContent = currentTicket.customer_name;
            ticketTotalPrice.textContent = currentTicket.total_formatted;
            
            ticketStatusBadge.style.display = 'inline-block';
            
            if (currentTicket.order_status_id === 1) {
                ticketStatusBadge.textContent = 'Pendente';
                ticketStatusBadge.style.backgroundColor = 'rgba(245, 158, 11, 0.15)';
                ticketStatusBadge.style.color = 'var(--warning)';
                ticketStatusBadge.style.borderColor = 'rgba(245, 158, 11, 0.3)';
                
                confirmPayBtn.disabled = false;
            } else {
                ticketStatusBadge.textContent = currentTicket.order_status_id === 5 ? 'Completo / Pago' : 'Outro status';
                ticketStatusBadge.style.backgroundColor = 'rgba(16, 185, 129, 0.15)';
                ticketStatusBadge.style.color = 'var(--success)';
                ticketStatusBadge.style.borderColor = 'rgba(16, 185, 129, 0.3)';
                
                confirmPayBtn.disabled = true;
                showModal('Pedido Finalizado', 'Este ticket já foi pago e concluído anteriormente.', 'fa-info-circle', 'var(--success)');
            }
            
            ticketItemsList.innerHTML = currentTicket.products.map(p => `
                <div class="ticket-item">
                    <div>
                        <span class="ticket-item-qty">${p.quantity}x</span>
                        <span style="font-weight: 500;">${p.name}</span>
                    </div>
                    <span style="font-weight: 600;">${formatMoney(p.total)}</span>
                </div>
            `).join('');
            
            // Recalcula troco se dinheiro estiver ativo
            calculateChange();
        };
        
        // Reset do ticket
        const resetTicketState = () => {
            currentTicket = null;
            ticketIdBadge.textContent = 'Nenhum ticket carregado';
            ticketStatusBadge.style.display = 'none';
            ticketCustomerName.textContent = 'N/A';
            ticketTotalPrice.textContent = formatMoney(0);
            confirmPayBtn.disabled = true;
            ticketItemsList.innerHTML = `
                <div class="empty-cart-state">
                    <i class="fas fa-file-invoice empty-cart-icon"></i>
                    <p>Aguardando digitação do ticket...</p>
                </div>
            `;
            cashReceivedInput.value = '';
            cashChangeDue.textContent = formatMoney(0);
        };
        
        // 2. Comportamento do Seletor de Pagamento
        payMethodCards.forEach(card => {
            card.addEventListener('click', () => {
                payMethodCards.forEach(c => c.classList.remove('active'));
                card.classList.add('active');
                
                selectedMethod = card.getAttribute('data-method');
                
                // Exibe o painel de configuração correspondente
                payConfigPanels.forEach(p => p.style.display = 'none');
                document.getElementById(`panel_${selectedMethod}`).style.display = 'flex';
                
                calculateChange();
            });
        });
        
        // Calculadora de Troco
        const calculateChange = () => {
            if (selectedMethod !== 'Dinheiro' || !currentTicket) {
                return;
            }
            
            const total = currentTicket.total;
            const received = parseFloat(cashReceivedInput.value) || 0;
            
            if (received >= total) {
                const change = received - total;
                cashChangeDue.textContent = formatMoney(change);
                cashChangeDue.style.color = 'var(--success)';
                confirmPayBtn.disabled = false;
            } else {
                cashChangeDue.textContent = 'A pagar...';
                cashChangeDue.style.color = 'var(--warning)';
                confirmPayBtn.disabled = true;
            }
        };
        
        cashReceivedInput.addEventListener('input', calculateChange);
        
        // Simular Recebimento de Pix
        window.simulatePixReceived = () => {
            if (!currentTicket) return;
            showModal('Pix Confirmado', 'O pagamento via Pix de ' + currentTicket.total_formatted + ' foi recebido na conta bancária com sucesso!', 'fa-check-circle', 'var(--success)');
        };

        // 3. Confirmar pagamento final
        confirmPayBtn.addEventListener('click', () => {
            if (!currentTicket) return;
            
            confirmPayBtn.disabled = true;
            confirmPayBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processando...';
            
            const payload = {
                payment_method: selectedMethod
            };
            
            fetch(`/LPDHED2dC7Gjrg2b/pos/pedidos/${currentTicket.order_id}/pagar`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            })
            .then(res => {
                if (!res.ok) {
                    return res.json().then(data => {
                        throw new Error(data.error || 'Erro ao registrar pagamento.');
                    });
                }
                return res.json();
            })
            .then(data => {
                if (data.success) {
                    showModal('Venda Concluída', 'O pagamento foi registrado e o pedido #' + currentTicket.order_id + ' foi concluído. Imprima o cupom do cliente.', 'fa-check-circle', 'var(--success)');
                    // Abre modal de sucesso e ao fechar limpa a tela
                    modalCloseBtn.onclick = () => {
                        alertModal.style.display = 'none';
                        // Limpa a tela
                        ticketIdInput.value = '';
                        resetTicketState();
                        window.print(); // Abre diálogo de impressão do recibo
                    };
                } else {
                    throw new Error(data.error || 'Erro na gravação do pagamento.');
                }
            })
            .catch(err => {
                console.error(err);
                showModal('Falha na Operação', err.message, 'fa-exclamation-triangle', 'var(--danger)');
                confirmPayBtn.disabled = false;
                confirmPayBtn.innerHTML = '<i class="fas fa-check-circle"></i> Finalizar Recebimento';
            });
        });

        // 4. Modal
        const showModal = (title, message, iconClass, iconColor) => {
            modalTitle.textContent = title;
            modalMessage.textContent = message;
            modalIcon.className = `fas ${iconClass} modal-icon`;
            modalIcon.style.color = iconColor;
            alertModal.style.display = 'flex';
            
            modalCloseBtn.onclick = () => {
                alertModal.style.display = 'none';
            };
        };
    });
</script>
{% endblock %}
