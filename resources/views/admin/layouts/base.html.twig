<!DOCTYPE html>
<html lang="{{ admin_lang_code|default('pt-br') }}">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}Painel Administrativo | AgSonhos
			{% endblock %}
		</title>

		<link rel="stylesheet" href="/css/admin/admin.css">
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="/fonts/fontawesome/css/all.min.css">
		{% if csrf %}
			<meta name="csrf-name" content="{{ csrf.name }}">
			<meta name="csrf-value" content="{{ csrf.value }}">
			<meta name="csrf-key-name" content="{{ csrf.keys.name }}">
			<meta name="csrf-key-value" content="{{ csrf.keys.value }}">
		{% endif %}
	</head>
	<body class="admin-body">
		<div
			class="admin-wrapper">
			<!-- Sidebar -->
			<aside class="sidebar">
				<div class="sidebar-brand">
					<h1 class="sidebar-title">
						<span class="sidebar-logo-icon">🌌</span>
						{{ AdminLang.sidebar.title|default('AgSonhos Admin') }}
					</h1>
				</div>
				<ul>
					<li>
						<a href="{{ admin_path }}/dashboard" class="active">
							<i class="fas fa-chart-line sidebar-link-icon"></i>
							{{ AdminLang.sidebar.dashboard|default('Painel Inicial') }}
						</a>
					</li>
					<li>
						<a href="{{ admin_path }}/pedidos">
							<i class="fas fa-shopping-basket sidebar-link-icon"></i>
							{{ AdminLang.sidebar.orders|default('Vendas / Pedidos') }}
						</a>
					</li>
					<li>
						<a href="{{ admin_path }}/pos/vendedor">
							<i class="fas fa-user sidebar-link-icon"></i>
							{{ AdminLang.sidebar.pdv_seller|default('PDV Vendedor') }}
						</a>
					</li>
					<li>
						<a href="{{ admin_path }}/pos/caixa">
							<i class="fas fa-cash-register sidebar-link-icon"></i>
							{{ AdminLang.sidebar.pos|default('Caixa') }}
						</a>
					</li>
					<li>
						<a href="{{ admin_path }}/devolucoes">
							<i class="fas fa-undo sidebar-link-icon"></i>
							{{ AdminLang.sidebar.returns|default('Devoluções') }}
						</a>
					</li>
					<li>
						<a href="{{ admin_path }}/clientes">
							<i class="fas fa-users sidebar-link-icon"></i>
							{{ AdminLang.sidebar.customers|default('Clientes') }}
						</a>
					</li>
					<li>
						<a href="{{ admin_path }}/produtos">
							<i class="fas fa-box-open sidebar-link-icon"></i>
							{{ AdminLang.sidebar.products|default('Produtos') }}
						</a>
					</li>
					<li>
						<a href="{{ admin_path }}/categorias">
							<i class="fas fa-tags sidebar-link-icon"></i>
							{{ AdminLang.sidebar.categories|default('Categorias') }}
						</a>
					</li>
					<li>
						<a href="{{ admin_path }}/fabricantes">
							<i class="fas fa-tags sidebar-link-icon"></i>
							{{ AdminLang.sidebar.manufacturers|default('Fabricantes') }}
						</a>
					</li>
					<li>
						<a href="{{ admin_path }}/fornecedores">
							<i class="fas fa-tags sidebar-link-icon"></i>
							{{ AdminLang.sidebar.suppliers|default('Fornecedores') }}
						</a>
					</li>
					<li>
						<a href="{{ admin_path }}/configuracoes">
							<i class="fas fa-cog sidebar-link-icon"></i>
							{{ AdminLang.sidebar.settings|default('Configurações') }}
						</a>
					</li>
					<li class="sidebar-logout-item">
						<a href="{{ admin_path }}/logout">
							<i class="fas fa-sign-out-alt sidebar-link-icon"></i>
							{{ AdminLang.sidebar.logout|default('Sair do Painel') }}
						</a>
					</li>
				</ul>
			</aside>

			<!-- Main Content Wrapper -->
			<div
				class="main-content">
				<!-- Topbar -->
				<header class="topbar">
					<div class="topbar-left">
						<span class="topbar-role">{{ AdminLang.topbar.role|default('Modo Administrador') }}</span>
					</div>
					<div
						class="topbar-right" style="display: flex; align-items: center;">
						<!-- Language Switcher Dropdown -->
						<div class="topbar-language-select" style="margin-right: 25px; display: flex; align-items: center;">
							<form action="{{ admin_path }}/idioma" method="POST" id="form_lang_switch" style="margin: 0; display: flex; align-items: center;">
								{% if csrf %}
									<input type="hidden" name="{{ csrf.keys.name }}" value="{{ csrf.name }}">
									<input type="hidden" name="{{ csrf.keys.value }}" value="{{ csrf.value }}">
								{% endif %}
								<i class="fas fa-globe" style="color: #64748b; font-size: 1rem; margin-right: 6px;"></i>
								<select name="language_code" onchange="document.getElementById('form_lang_switch').submit();" style="padding: 0.35rem 0.5rem; font-size: 0.85rem; border-radius: 4px; border: 1px solid #cbd5e1; cursor: pointer; color: #334155; background-color: #fff; outline: none; transition: border-color 0.2s; font-family: inherit; font-weight: 500;">
									{% for l in languages %}
										<option value="{{ l.code }}" {% if admin_lang_code == l.code %} selected {% endif %}>
											{{ l.name }}
										</option>
									{% endfor %}
								</select>
							</form>
						</div>
						<div class="topbar-user-info">
							<p class="topbar-username">{{ logged_admin.name|default(AdminLang.topbar.default_name|default('Administrador')) }}</p>
							<p class="topbar-email">{{ logged_admin.email|default(AdminLang.topbar.default_email|default('admin@agsonhos.com')) }}</p>
						</div>
						<div class="topbar-avatar">
							{% if logged_admin.image %}
								{% if logged_admin.image starts with 'http' or logged_admin.image starts with '/' %}
									<img src="{{ logged_admin.image }}" alt="{{ logged_admin.name|default('User') }}" class="topbar-avatar-img">
								{% else %}
									<img src="/image/{{ logged_admin.image }}" alt="{{ logged_admin.name|default('User') }}" class="topbar-avatar-img">
								{% endif %}
							{% else %}
								<img src="/image/profile/default-user-profile.jpg" alt="{{ logged_admin.name|default('User') }}" class="topbar-avatar-img">
							{% endif %}
						</div>
					</div>
				</header>

				<!-- Main Page Content -->
				<main class="page-body"> {% block content %}{% endblock %}
					</main>
				</div>
			</div>
			<script>
				document.addEventListener('DOMContentLoaded', () => {
const currentPath = window.location.pathname;
const links = document.querySelectorAll('.sidebar a');
const adminDashboardUrl = "{{ admin_path }}/dashboard";
links.forEach(link => {
link.classList.remove('active');
const href = link.getAttribute('href');
if (currentPath === href || (href !== adminDashboardUrl && currentPath.startsWith(href))) {
link.classList.add('active');
}
});
});
			</script>
		</body>
	</html>
