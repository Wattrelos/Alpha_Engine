{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default((AdminLang.heading_title|default('Fornecedores')) ~ ' | ' ~ (AdminLang.sidebar.title|default('Painel Administrativo'))) }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>{{ AdminLang.heading_title|default('Gerenciamento de Fornecedores') }}</h2>
			<p class="page-subtitle">{{ AdminLang.text_subtitle|default('Visualize, adicione ou edite os fornecedores cadastrados na Alpha Engine.') }}</p>
		</div>
		<a href="/LPDHED2dC7Gjrg2b/fornecedores/criar" class="btn btn-primary btn-with-icon">
			<i class="fas fa-plus"></i>
			<span>{{ AdminLang.button_add|default('Adicionar Fornecedor') }}</span>
		</a>
	</div>

	<!-- Painel de Filtros de Busca -->
	<div class="card">
		<form method="GET" action="/LPDHED2dC7Gjrg2b/fornecedores">
			<div class="grid-filters">
				
				<!-- Nome -->
				<div class="form-group mb-0">
					<label for="filter_name" class="form-label-sm">{{ AdminLang.entry_company_name|default('Razão Social') }}</label>
					<input type="text" id="filter_name" name="filter_name" class="form-control" value="{{ filters.filter_name }}" placeholder="{{ AdminLang.placeholder_search_company|default('Buscar por razão social...') }}" />
				</div>

				<!-- CNPJ -->
				<div class="form-group mb-0">
					<label for="filter_tax_id" class="form-label-sm">{{ AdminLang.entry_tax_id|default('CNPJ') }}</label>
					<input type="text" id="filter_tax_id" name="filter_tax_id" class="form-control" value="{{ filters.filter_tax_id }}" placeholder="{{ AdminLang.placeholder_search_tax_id|default('Buscar por CNPJ...') }}" />
				</div>
 
				<!-- Ações -->
				<div class="d-flex gap-2">
					<a href="/LPDHED2dC7Gjrg2b/fornecedores" class="btn flex-1 btn-secondary">{{ AdminLang.button_clear|default('Limpar') }}</a>
					<button type="submit" class="btn btn-primary flex-1">
						<i class="fas fa-filter"></i>
						<span>{{ AdminLang.button_filter|default('Filtrar') }}</span>
					</button>
				</div>
 
			</div>
		</form>
	</div>

	<div class="card card-table">
		<div class="overflow-x-auto">
			<table class="table table-clean">
				<thead>
					<tr>
						<th>{{ AdminLang.entry_company_name|default('Razão Social') }}</th>
						<th>{{ AdminLang.entry_trade_name|default('Nome Fantasia') }}</th>
						<th>{{ AdminLang.entry_tax_id|default('CNPJ') }}</th>
						<th>{{ AdminLang.entry_email|default('E-mail') }} / {{ AdminLang.entry_phone|default('Telefone') }}</th>
						<th>{{ AdminLang.column_status|default('Status') }}</th>
						<th class="text-right col-actions">{{ AdminLang.column_actions|default('Ações') }}</th>
					</tr>
				</thead>
				<tbody>
					{% if suppliers %}
						{% for supplier in suppliers %}
							<tr>
								<td class="text-semibold text-dark">{{ supplier.company_name }}</td>
								<td class="text-muted">{{ supplier.trade_name|default('-') }}</td>
								<td class="text-muted">{{ supplier.tax_id }}</td>
								<td class="text-muted">
									<div class="supplier-contact-info">{{ supplier.email }}</div>
									<div class="supplier-contact-subinfo">{{ supplier.phone|default('-') }}</div>
								</td>
								<td class="text-center">
									{% if supplier.is_active %}
										<span class="status-pill status-pill-active">{{ AdminLang.text_active|default('Ativo') }}</span>
									{% else %}
										<span class="status-pill status-pill-inactive">{{ AdminLang.text_inactive|default('Inativo') }}</span>
									{% endif %}
								</td>
								<td class="text-right">
									<div class="actions-wrapper">
										<a href="/LPDHED2dC7Gjrg2b/fornecedores/{{ supplier.id }}/editar" class="btn btn-primary btn-sm" title="Editar">
											<i class="fas fa-edit"></i>
										</a>
										<a href="/LPDHED2dC7Gjrg2b/fornecedores/{{ supplier.id }}/excluir" class="btn btn-danger btn-sm" title="Excluir" onclick="return confirm('{{ AdminLang.text_confirm_delete|default('Deseja realmente excluir este fornecedor? Seu endereço associado também será excluído.')|escape('js') }}');">
											<i class="fas fa-trash-alt"></i>
										</a>
									</div>
								</td>
							</tr>
						{% endfor %}
					{% else %}
						<tr>
							<td colspan="6" class="table-empty-cell">
								<i class="fas fa-truck table-empty-icon"></i>
								{{ AdminLang.text_empty|default('Nenhum fornecedor cadastrado até o momento.') }}
							</td>
						</tr>
					{% endif %}
				</tbody>
			</table>
		</div>
		{% if total > limit %}
			<div class="table-pagination-bar">
				{% include 'components/molecules/pagination.html.twig' %}
			</div>
		{% endif %}
	</div>
{% endblock %}
