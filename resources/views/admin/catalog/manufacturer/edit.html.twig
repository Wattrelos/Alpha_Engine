{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default('Editar Fabricante | Painel Administrativo') }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>Editar Fabricante</h2>
			<p class="page-subtitle">Modifique os detalhes do fabricante do catálogo.</p>
		</div>
		<a href="/LPDHED2dC7Gjrg2b/fabricantes" class="btn btn-secondary">
			<i class="fas fa-arrow-left"></i>
			<span>Voltar para Lista</span>
		</a>
	</div>

	<div class="card card-large">
		<form action="/LPDHED2dC7Gjrg2b/fabricantes/{{ manufacturer.id }}/editar" method="POST" enctype="multipart/form-data">
			<div class="form-grid grid-2-cols">
				
				<!-- Nome do Fabricante -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="name" class="form-label-dark">Nome do Fabricante *</label>
					<input type="text" id="name" name="name" class="form-control form-control-lg" value="{{ manufacturer.name }}" required />
				</div>

				<!-- SEO URL (Keyword) -->
				<div class="form-group mb-6">
					<label for="seo_keyword" class="form-label-dark">SEO URL (Amigável)</label>
					<input type="text" id="seo_keyword" name="seo_keyword" class="form-control form-control-lg" value="{{ manufacturer.seo_keyword }}" placeholder="ex: colchao-ortobom" />
				</div>

				<!-- Ordem de Exibição -->
				<div class="form-group mb-6">
					<label for="sort_order" class="form-label-dark">Ordem de Exibição</label>
					<input type="number" id="sort_order" name="sort_order" class="form-control form-control-lg" value="{{ manufacturer.sort_order }}" />
				</div>

				<!-- Logotipo / Imagem -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="image" style="display: block; font-weight: 700; margin-bottom: 0.5rem; color: #0f172a; font-size: 1.1rem;">Logotipo (Imagem)</label>
					
					{% if manufacturer.image %}
						<div style="display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1rem; padding: 0.75rem; background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; width: fit-content;">
							<img src="/{{ manufacturer.image }}" alt="{{ manufacturer.name }}" style="max-height: 60px; max-width: 120px; object-fit: contain; border-radius: 4px;" />
							<label style="display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: #ef4444; cursor: pointer; margin: 0;">
								<input type="checkbox" name="remove_image" value="1" style="width: 16px; height: 16px; accent-color: #ef4444;" />
								Remover imagem atual
							</label>
						</div>
					{% endif %}

					<input type="file" id="image" name="image" accept="image/*" class="form-control form-control-lg" />
					<p style="margin: 0.5rem 0 0 0; font-size: 0.8rem; color: #64748b;">Formatos aceitos: JPG, PNG, WEBP, GIF. Deixe em branco para manter a imagem atual.</p>
				</div>

			</div>

			<!-- Botões de Ação -->
			<div class="form-actions">
				<a href="/LPDHED2dC7Gjrg2b/fabricantes" class="btn btn-secondary">Cancelar</a>
				<button type="submit" class="btn btn-primary">
					<i class="fas fa-save"></i>
					<span>Salvar Alterações</span>
				</button>
			</div>
		</form>
	</div>
{% endblock %}
