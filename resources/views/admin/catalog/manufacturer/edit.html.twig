{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default('Editar Fabricante | Painel Administrativo') }}
{% endblock %}

{% block content %}
	<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
		<div>
			<h2>Editar Fabricante</h2>
			<p style="color: #64748b; margin: 0;">Modifique os detalhes do fabricante do catálogo.</p>
		</div>
		<a href="/LPDHED2dC7Gjrg2b/fabricantes" class="btn" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px; background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1;">
			<i class="fas fa-arrow-left"></i>
			<span>Voltar para Lista</span>
		</a>
	</div>

	<div class="card" style="box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06); border-radius: var(--border-radius); background: #fff; padding: 2rem;">
		<form action="/LPDHED2dC7Gjrg2b/fabricantes/{{ manufacturer.id }}/editar" method="POST" enctype="multipart/form-data">
			<div class="form-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;">
				
				<!-- Nome do Fabricante -->
				<div class="form-group" style="grid-column: span 2; margin-bottom: 1.5rem;">
					<label for="name" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Nome do Fabricante *</label>
					<input type="text" id="name" name="name" class="form-control" value="{{ manufacturer.name }}" required style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b;" />
				</div>

				<!-- SEO URL (Keyword) -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<label for="seo_keyword" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">SEO URL (Amigável)</label>
					<input type="text" id="seo_keyword" name="seo_keyword" class="form-control" value="{{ manufacturer.seo_keyword }}" placeholder="ex: colchao-ortobom" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b;" />
				</div>

				<!-- Ordem de Exibição -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<label for="sort_order" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Ordem de Exibição</label>
					<input type="number" id="sort_order" name="sort_order" class="form-control" value="{{ manufacturer.sort_order }}" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b;" />
				</div>

				<!-- Logotipo / Imagem -->
				<div class="form-group" style="grid-column: span 2; margin-bottom: 1.5rem; padding: 1.5rem; border: 1px dashed #cbd5e1; border-radius: 12px; background: #f8fafc;">
					<label for="image" style="display: block; font-weight: 700; margin-bottom: 0.5rem; color: #0f172a; font-size: 1.1rem;">Logotipo (Imagem)</label>
					
					{% if manufacturer.image %}
						<div style="display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1rem; padding: 0.75rem; background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; width: fit-content;">
							<img src="/{{ manufacturer.image }}" alt="{{ manufacturer.name }}" style="max-height: 60px; max-width: 120px; object-fit: contain; border-radius: 4px;" />
							<label style="display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: #ef4444; cursor: pointer; margin: 0;">
								<input type="checkbox" name="remove_image" value="1" style="width: 16px; height: 16px; accent-color: #ef4444;" />
								Remover imagem atual
							</label>
						</div>
					{% endif %}

					<input type="file" id="image" name="image" accept="image/*" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; color: #1e293b; background: #fff;" />
					<p style="margin: 0.5rem 0 0 0; font-size: 0.8rem; color: #64748b;">Formatos aceitos: JPG, PNG, WEBP, GIF. Deixe em branco para manter a imagem atual.</p>
				</div>

			</div>

			<!-- Botões de Ação -->
			<div class="form-actions" style="display: flex; gap: 1rem; justify-content: flex-end; border-top: 1px solid #e2e8f0; padding-top: 1.5rem; margin-top: 1.5rem;">
				<a href="/LPDHED2dC7Gjrg2b/fabricantes" class="btn" style="background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; text-decoration: none; padding: 10px 20px; border-radius: 6px; font-weight: 600;">Cancelar</a>
				<button type="submit" class="btn btn-primary" style="padding: 10px 25px; border-radius: 6px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
					<i class="fas fa-save"></i>
					<span>Salvar Alterações</span>
				</button>
			</div>
		</form>
	</div>
{% endblock %}
