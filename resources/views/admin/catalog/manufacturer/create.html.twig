{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default('Adicionar Fabricante | Painel Administrativo') }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>Adicionar Fabricante</h2>
			<p class="page-subtitle">Cadastre um novo fabricante ou marca no catálogo.</p>
		</div>
		<a href="/LPDHED2dC7Gjrg2b/fabricantes" class="btn btn-secondary">
			<i class="fas fa-arrow-left"></i>
			<span>Voltar para Lista</span>
		</a>
	</div>

	<div class="card card-large">
		<form action="/LPDHED2dC7Gjrg2b/fabricantes/criar" method="POST" enctype="multipart/form-data">
			<div class="form-grid grid-2-cols">
				
				<!-- Nome do Fabricante -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="name" class="form-label-dark">Nome do Fabricante *</label>
					<input type="text" id="name" name="name" class="form-control form-control-lg" required />
				</div>

				<!-- SEO URL (Keyword) -->
				<div class="form-group mb-6">
					<label for="seo_keyword" class="form-label-dark">SEO URL (Amigável)</label>
					<input type="text" id="seo_keyword" name="seo_keyword" class="form-control form-control-lg" placeholder="ex: colchao-ortobom" />
				</div>

				<!-- Ordem de Exibição -->
				<div class="form-group mb-6">
					<label for="sort_order" class="form-label-dark">Ordem de Exibição</label>
					<input type="number" id="sort_order" name="sort_order" class="form-control form-control-lg" value="0" />
				</div>

				<!-- Logotipo / Imagem -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="image" style="display: block; font-weight: 700; margin-bottom: 0.5rem; color: #0f172a; font-size: 1.1rem;">Logotipo (Imagem)</label>
					<input type="file" id="image" name="image" accept="image/*" class="form-control form-control-lg" />
					<p style="margin: 0.5rem 0 0 0; font-size: 0.8rem; color: #64748b;">Formatos aceitos: JPG, PNG, WEBP, GIF.</p>
				</div>

			</div>

			<!-- Botões de Ação -->
			<div class="form-actions">
				<a href="/LPDHED2dC7Gjrg2b/fabricantes" class="btn btn-secondary">Cancelar</a>
				<button type="submit" class="btn btn-primary">
					<i class="fas fa-save"></i>
					<span>Salvar Fabricante</span>
				</button>
			</div>
		</form>
	</div>
{% endblock %}
