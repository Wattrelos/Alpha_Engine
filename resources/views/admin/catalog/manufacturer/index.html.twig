{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default((AdminLang.heading_title|default('Fabricantes')) ~ ' | ' ~ (AdminLang.sidebar.title|default('Painel Administrativo'))) }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>{{ AdminLang.heading_title|default('Gerenciamento de Fabricantes') }}</h2>
			<p class="page-subtitle">{{ AdminLang.text_subtitle|default('Visualize, adicione ou edite os fabricantes e marcas cadastrados.') }}</p>
		</div>
		<a href="{{ admin_path }}/fabricantes/criar" class="btn btn-primary btn-with-icon">
			<i class="fas fa-plus"></i>
			<span>{{ AdminLang.button_add|default('Adicionar Fabricante') }}</span>
		</a>
	</div>

	<!-- Painel de Filtros de Busca -->
	<div class="card">
		<form method="GET" action="{{ admin_path }}/fabricantes">
			<div class="grid-filters">
				
				<!-- Nome -->
				<div class="form-group mb-0">
					<label for="filter_name" class="form-label-sm">{{ AdminLang.entry_name|default('Nome do Fabricante') }}</label>
					<input type="text" id="filter_name" name="filter_name" class="form-control" value="{{ filters.filter_name }}" placeholder="{{ AdminLang.placeholder_search_name|default('Buscar por nome...') }}" />
				</div>
 
				<!-- Ações -->
				<div class="d-flex gap-2">
					<a href="{{ admin_path }}/fabricantes" class="btn flex-1 btn-secondary">{{ AdminLang.button_clear|default('Limpar') }}</a>
					<button type="submit" class="btn btn-primary flex-1">
						<i class="fas fa-filter"></i>
						<span>{{ AdminLang.button_filter|default('Filtrar') }}</span>
					</button>
				</div>
 
			</div>
		</form>
	</div>

	<div class="card card-table">
		<div class="overflow-x-auto">
			<table class="table table-clean">
				<thead>
					<tr>
						<th>{{ AdminLang.column_logo|default('Logo') }}</th>
						<th>{{ AdminLang.column_name|default('Nome do Fabricante') }}</th>
						<th>{{ AdminLang.column_sort_order|default('Ordem de Exibição') }}</th>
						<th class="text-right col-actions">{{ AdminLang.column_actions|default('Ações') }}</th>
					</tr>
				</thead>
				<tbody>
					{% if manufacturers %}
						{% for manufacturer in manufacturers %}
							<tr>
								<td>
									{% if manufacturer.image %}
										<img src="/{{ manufacturer.image }}" alt="{{ manufacturer.name }}" class="table-image" />
									{% else %}
										<div class="table-image-placeholder">
											<i class="fas fa-image"></i>
										</div>
									{% endif %}
								</td>
								<td class="text-semibold text-dark">{{ manufacturer.name }}</td>
								<td class="text-muted">{{ manufacturer.sort_order }}</td>
								<td class="text-right">
									<div class="actions-wrapper">
										<a href="{{ admin_path }}/fabricantes/{{ manufacturer.manufacturer_id }}/editar" class="btn btn-primary btn-sm" title="Editar">
											<i class="fas fa-edit"></i>
										</a>
										<a href="{{ admin_path }}/fabricantes/{{ manufacturer.manufacturer_id }}/excluir" class="btn btn-danger btn-sm" title="Excluir" onclick="return confirm('{{ AdminLang.text_confirm_delete|default('Deseja realmente excluir este fabricante? Todos os produtos vinculados serão desassociados.')|escape('js') }}');">
											<i class="fas fa-trash-alt"></i>
										</a>
									</div>
								</td>
							</tr>
						{% endfor %}
					{% else %}
						<tr>
							<td colspan="4" class="table-empty-cell">
								<i class="fas fa-industry table-empty-icon"></i>
								{{ AdminLang.text_empty|default('Nenhum fabricante cadastrado até o momento.') }}
							</td>
						</tr>
					{% endif %}
				</tbody>
			</table>
		</div>
		{% if total > limit %}
			<div class="table-pagination-bar">
				{% include 'components/molecules/pagination.html.twig' %}
			</div>
		{% endif %}
	</div>
{% endblock %}
