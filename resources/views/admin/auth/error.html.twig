{% extends 'admin/layouts/base_auth.html.twig' %}

{% block title %}
	{{ title|default((AdminLang.text_error_title|default('Aviso de Segurança')) ~ ' | ' ~ (AdminLang.sidebar.title|default('Painel Administrativo'))) }}
{% endblock %}

{% block content %}
<div class="auth-card text-center">
    <div class="auth-logo">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#e02424" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="auth-error-icon">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
            <line x1="12" y1="9" x2="12" y2="13"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <h2 class="auth-logo-title">{{ AdminLang.text_error_heading|default('Falha na Autenticação') }}</h2>
        <p class="auth-logo-subtitle">{{ AdminLang.text_error_subtitle|default('Aviso de Segurança do Painel') }}</p>
    </div>

    <div class="alert alert-danger font-medium text-center">
        {{ error_message }}
    </div>

    {% if is_locked %}
        <p class="text-danger text-semibold mb-6">
            {{ AdminLang.text_error_locked|default('Acesso bloqueado temporariamente por segurança devido a excesso de tentativas. Por favor, tente novamente mais tarde.') }}
        </p>
    {% else %}
        <p class="mb-6 text-sm text-dark">
            {{ AdminLang.text_error_remaining|default('Tentativas restantes para o usuário %s: %s')|format('<strong>' ~ username ~ '</strong>', '<strong class="text-danger text-sm">' ~ remaining_attempts ~ ' de 5</strong>')|raw }}
        </p>
    {% endif %}

    <div class="mt-4 text-muted text-sm">
        {{ AdminLang.text_error_countdown|default('Você será redirecionado para a tela de login em %s segundos...')|format('<span id="countdown" class="text-semibold text-dark">5</span>')|raw }}
    </div>

    <a href="{{ login_url }}" class="btn btn-secondary btn-block mt-4">
        {{ AdminLang.button_back_to_login|default('Voltar para Login') }}
    </a>
</div>

<script>
    let seconds = 5;
    const countdownEl = document.getElementById('countdown');
    const interval = setInterval(() => {
        seconds--;
        countdownEl.textContent = seconds;
        if (seconds <= 0) {
            clearInterval(interval);
            window.location.href = "{{ login_url }}";
        }
    }, 1000);
</script>
{% endblock %}
