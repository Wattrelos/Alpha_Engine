{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default(AdminLang.text_title_edit) }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>{{ AdminLang.heading_title_edit }}</h2>
			<p class="page-subtitle">{{ AdminLang.text_subtitle_edit }}</p>
		</div>
		<a href="{{ admin_path }}/categorias" class="btn btn-secondary">
			<i class="fas fa-arrow-left"></i>
			<span>{{ AdminLang.button_back }}</span>
		</a>
	</div>

	<div class="card card-large">
		<form action="{{ admin_path }}/categorias/{{ category.id }}/editar" method="POST" enctype="multipart/form-data">
			{% if csrf %}
				<input type="hidden" name="{{ csrf.keys.name }}" value="{{ csrf.name }}">
				<input type="hidden" name="{{ csrf.keys.value }}" value="{{ csrf.value }}">
			{% endif %}
			<div class="form-grid grid-2-cols">
				
				<!-- Nome da Categoria -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="name" class="form-label-dark">{{ AdminLang.entry_name }} *</label>
					<input type="text" id="name" name="name" class="form-control form-control-lg" value="{{ category.name }}" required />
				</div>

				<!-- Categoria Pai -->
				<div class="form-group mb-6">
					<label for="parent_id" class="form-label-dark">{{ AdminLang.entry_parent }}</label>
					<select id="parent_id" name="parent_id" class="form-control form-control-lg">
						<option value="0" {% if category.parent_id == 0 %}selected{% endif %}>{{ AdminLang.text_none }}</option>
						{% for c in categories %}
							<option value="{{ c.id }}" {% if category.parent_id == c.id %}selected{% endif %}>{{ c.name }}</option>
						{% endfor %}
					</select>
				</div>

				<!-- SEO URL (Keyword) -->
				<div class="form-group mb-6">
					<label for="seo_keyword" class="form-label-dark">{{ AdminLang.entry_seo_keyword }}</label>
					<input type="text" id="seo_keyword" name="seo_keyword" class="form-control form-control-lg" value="{{ category.seo_keyword }}" placeholder="{{ AdminLang.placeholder_seo_keyword }}" />
				</div>

				<!-- Ordem de Exibição -->
				<div class="form-group mb-6">
					<label for="sort_order" class="form-label-dark">{{ AdminLang.entry_sort_order }}</label>
					<input type="number" id="sort_order" name="sort_order" class="form-control form-control-lg" value="{{ category.sort_order }}" />
				</div>

				<!-- Status -->
				<div class="form-group mb-6">
					<label for="status" class="form-label-dark">{{ AdminLang.entry_status }}</label>
					<select id="status" name="status" class="form-control form-control-lg">
						<option value="1" {% if category.status == 1 %}selected{% endif %}>{{ AdminLang.text_active }}</option>
						<option value="0" {% if category.status == 0 %}selected{% endif %}>{{ AdminLang.text_inactive }}</option>
					</select>
				</div>

				<!-- Imagem de Capa -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="image" style="display: block; font-weight: 700; margin-bottom: 0.5rem; color: #0f172a; font-size: 1.1rem;">{{ AdminLang.entry_image }}</label>
					
					{% if category.image %}
						<div class="current-image-container" style="display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.5rem; background: #fff; padding: 1rem; border-radius: 8px; border: 1px solid #e2e8f0;">
							<div style="width: 120px; height: 120px; display: flex; align-items: center; justify-content: center; background: #f1f5f9; border-radius: 6px; overflow: hidden; border: 1px solid #e2e8f0;">
								<img src="/{{ category.image }}" alt="Preview" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
							</div>
							<div>
								<div style="font-weight: 600; color: #334155; margin-bottom: 0.25rem;">{{ AdminLang.text_current_image }}</div>
								<div style="font-family: monospace; font-size: 0.85rem; color: #64748b; margin-bottom: 0.75rem; word-break: break-all;">{{ category.image }}</div>
								<label style="display: inline-flex; align-items: center; gap: 8px; color: #ef4444; font-weight: 600; cursor: pointer; font-size: 0.9rem; user-select: none;">
									<input type="checkbox" name="remove_image" value="1" style="width: 16px; height: 16px; accent-color: #ef4444;" />
									<span>{{ AdminLang.text_remove_image }}</span>
								</label>
							</div>
						</div>
					{% else %}
						<div class="no-image-placeholder" style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; color: #64748b; font-size: 0.9rem;">
							<i class="fas fa-image" style="font-size: 2rem; color: #cbd5e1;"></i>
							<span>{{ AdminLang.text_no_image }}</span>
						</div>
					{% endif %}

					<div class="upload-input-wrap">
						<input type="file" id="image" name="image" accept="image/*" class="form-control form-control-lg" />
						<p style="margin: 0.5rem 0 0 0; font-size: 0.8rem; color: #64748b;">{{ AdminLang.text_image_help_edit }}</p>
					</div>
				</div>

				<!-- Meta Título -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="meta_title" class="form-label-dark">{{ AdminLang.entry_meta_title }}</label>
					<input type="text" id="meta_title" name="meta_title" class="form-control form-control-lg" value="{{ category.meta_title }}" />
				</div>

				<!-- Meta Descrição -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="meta_description" class="form-label-dark">{{ AdminLang.entry_meta_description }}</label>
					<input type="text" id="meta_description" name="meta_description" class="form-control form-control-lg" value="{{ category.meta_description }}" />
				</div>

				<!-- Meta Palavras-chave -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="meta_keyword" class="form-label-dark">{{ AdminLang.entry_meta_keyword }}</label>
					<input type="text" id="meta_keyword" name="meta_keyword" class="form-control form-control-lg" value="{{ category.meta_keyword }}" placeholder="{{ AdminLang.placeholder_meta_keyword }}" />
				</div>

				<!-- Descrição Detalhada -->
				<div class="form-group" style="grid-column: span 2; margin-bottom: 2rem;">
					<label for="description" class="form-label-dark">{{ AdminLang.entry_description }}</label>
					<textarea id="description" name="description" class="form-control form-control-lg" rows="6">{{ category.description }}</textarea>
				</div>

			</div>

			<!-- Botões de Ação -->
			<div class="form-actions">
				<a href="{{ admin_path }}/categorias" class="btn btn-secondary">{{ AdminLang.button_cancel }}</a>
				<button type="submit" class="btn btn-primary">
					<i class="fas fa-save"></i>
					<span>{{ AdminLang.button_save_changes }}</span>
				</button>
			</div>
		</form>
	</div>
{% endblock %}
