{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default('Editar Categoria | Painel Administrativo') }}
{% endblock %}

{% block content %}
	<div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
		<div>
			<h2>Editar Categoria</h2>
			<p style="color: #64748b; margin: 0;">Atualize as informações da categoria de produtos.</p>
		</div>
		<a href="/LPDHED2dC7Gjrg2b/categorias" class="btn" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px; background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1;">
			<i class="fas fa-arrow-left"></i>
			<span>Voltar para Lista</span>
		</a>
	</div>

	<div class="card" style="box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06); border-radius: var(--border-radius); background: #fff; padding: 2rem;">
		<form action="/LPDHED2dC7Gjrg2b/categorias/{{ category.id }}/editar" method="POST" enctype="multipart/form-data">
			<div class="form-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;">
				
				<!-- Nome da Categoria -->
				<div class="form-group" style="grid-column: span 2; margin-bottom: 1.5rem;">
					<label for="name" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Nome da Categoria *</label>
					<input type="text" id="name" name="name" class="form-control" value="{{ category.name }}" required style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b;" />
				</div>

				<!-- Categoria Pai -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<label for="parent_id" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Categoria Pai</label>
					<select id="parent_id" name="parent_id" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b; background: #fff;">
						<option value="0" {% if category.parent_id == 0 %}selected{% endif %}>--- Nenhuma (Raiz) ---</option>
						{% for c in categories %}
							<option value="{{ c.id }}" {% if category.parent_id == c.id %}selected{% endif %}>{{ c.name }}</option>
						{% endfor %}
					</select>
				</div>

				<!-- SEO URL (Keyword) -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<label for="seo_keyword" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">SEO URL (Amigável)</label>
					<input type="text" id="seo_keyword" name="seo_keyword" class="form-control" value="{{ category.seo_keyword }}" placeholder="ex: tubos-de-pvc" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b;" />
				</div>

				<!-- Ordem de Exibição -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<label for="sort_order" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Ordem de Exibição</label>
					<input type="number" id="sort_order" name="sort_order" class="form-control" value="{{ category.sort_order }}" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b;" />
				</div>

				<!-- Status -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<label for="status" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Status</label>
					<select id="status" name="status" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b; background: #fff;">
						<option value="1" {% if category.status == 1 %}selected{% endif %}>Ativo</option>
						<option value="0" {% if category.status == 0 %}selected{% endif %}>Inativo</option>
					</select>
				</div>

				<!-- Imagem de Capa -->
				<div class="form-group" style="grid-column: span 2; margin-bottom: 1.5rem; padding: 1.5rem; border: 1px dashed #cbd5e1; border-radius: 12px; background: #f8fafc;">
					<label for="image" style="display: block; font-weight: 700; margin-bottom: 0.5rem; color: #0f172a; font-size: 1.1rem;">Imagem de Capa (Banner/Ícone)</label>
					
					{% if category.image %}
						<div class="current-image-container" style="display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.5rem; background: #fff; padding: 1rem; border-radius: 8px; border: 1px solid #e2e8f0;">
							<div style="width: 120px; height: 120px; display: flex; align-items: center; justify-content: center; background: #f1f5f9; border-radius: 6px; overflow: hidden; border: 1px solid #e2e8f0;">
								<img src="/{{ category.image }}" alt="Preview" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
							</div>
							<div>
								<div style="font-weight: 600; color: #334155; margin-bottom: 0.25rem;">Caminho da imagem atual:</div>
								<div style="font-family: monospace; font-size: 0.85rem; color: #64748b; margin-bottom: 0.75rem; word-break: break-all;">{{ category.image }}</div>
								<label style="display: inline-flex; align-items: center; gap: 8px; color: #ef4444; font-weight: 600; cursor: pointer; font-size: 0.9rem; user-select: none;">
									<input type="checkbox" name="remove_image" value="1" style="width: 16px; height: 16px; accent-color: #ef4444;" />
									<span>Remover esta imagem</span>
								</label>
							</div>
						</div>
					{% else %}
						<div class="no-image-placeholder" style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; color: #64748b; font-size: 0.9rem;">
							<i class="fas fa-image" style="font-size: 2rem; color: #cbd5e1;"></i>
							<span>Nenhuma imagem cadastrada para esta categoria.</span>
						</div>
					{% endif %}

					<div class="upload-input-wrap">
						<input type="file" id="image" name="image" accept="image/*" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; color: #1e293b; background: #fff;" />
						<p style="margin: 0.5rem 0 0 0; font-size: 0.8rem; color: #64748b;">Formatos aceitos: JPG, PNG, WEBP, GIF. O envio de uma nova imagem substituirá a atual.</p>
					</div>
				</div>

				<!-- Meta Título -->
				<div class="form-group" style="grid-column: span 2; margin-bottom: 1.5rem;">
					<label for="meta_title" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Meta Título (SEO Title)</label>
					<input type="text" id="meta_title" name="meta_title" class="form-control" value="{{ category.meta_title }}" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b;" />
				</div>

				<!-- Meta Descrição -->
				<div class="form-group" style="grid-column: span 2; margin-bottom: 1.5rem;">
					<label for="meta_description" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Meta Descrição (SEO Description)</label>
					<input type="text" id="meta_description" name="meta_description" class="form-control" value="{{ category.meta_description }}" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b;" />
				</div>

				<!-- Meta Palavras-chave -->
				<div class="form-group" style="grid-column: span 2; margin-bottom: 1.5rem;">
					<label for="meta_keyword" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Meta Keywords (Palavras-chave)</label>
					<input type="text" id="meta_keyword" name="meta_keyword" class="form-control" value="{{ category.meta_keyword }}" placeholder="ex: tubos, conexoes, pvc" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b;" />
				</div>

				<!-- Descrição Detalhada -->
				<div class="form-group" style="grid-column: span 2; margin-bottom: 2rem;">
					<label for="description" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Descrição da Categoria</label>
					<textarea id="description" name="description" class="form-control" rows="6" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b; font-family: inherit; resize: vertical;">{{ category.description }}</textarea>
				</div>

			</div>

			<!-- Botões de Ação -->
			<div class="form-actions" style="display: flex; gap: 1rem; justify-content: flex-end; border-top: 1px solid #e2e8f0; padding-top: 1.5rem; margin-top: 1.5rem;">
				<a href="/LPDHED2dC7Gjrg2b/categorias" class="btn" style="background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; text-decoration: none; padding: 10px 20px; border-radius: 6px; font-weight: 600;">Cancelar</a>
				<button type="submit" class="btn btn-primary" style="padding: 10px 25px; border-radius: 6px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
					<i class="fas fa-save"></i>
					<span>Salvar Alterações</span>
				</button>
			</div>
		</form>
	</div>
{% endblock %}
