{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default('Adicionar Categoria | Painel Administrativo') }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>Adicionar Categoria</h2>
			<p class="page-subtitle">Cadastre uma nova categoria de produtos em sua loja.</p>
		</div>
		<a href="/LPDHED2dC7Gjrg2b/categorias" class="btn btn-secondary">
			<i class="fas fa-arrow-left"></i>
			<span>Voltar para Lista</span>
		</a>
	</div>

	<div class="card card-large">
		<form action="/LPDHED2dC7Gjrg2b/categorias/criar" method="POST" enctype="multipart/form-data">
			<div class="form-grid grid-2-cols">
				
				<!-- Nome da Categoria -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="name" class="form-label-dark">Nome da Categoria *</label>
					<input type="text" id="name" name="name" class="form-control form-control-lg" required />
				</div>

				<!-- Categoria Pai -->
				<div class="form-group mb-6">
					<label for="parent_id" class="form-label-dark">Categoria Pai</label>
					<select id="parent_id" name="parent_id" class="form-control form-control-lg">
						<option value="0">--- Nenhuma (Raiz) ---</option>
						{% for c in categories %}
							<option value="{{ c.id }}">{{ c.name }}</option>
						{% endfor %}
					</select>
				</div>

				<!-- SEO URL (Keyword) -->
				<div class="form-group mb-6">
					<label for="seo_keyword" class="form-label-dark">SEO URL (Amigável)</label>
					<input type="text" id="seo_keyword" name="seo_keyword" class="form-control form-control-lg" placeholder="ex: tubos-de-pvc" />
				</div>

				<!-- Ordem de Exibição -->
				<div class="form-group mb-6">
					<label for="sort_order" class="form-label-dark">Ordem de Exibição</label>
					<input type="number" id="sort_order" name="sort_order" class="form-control form-control-lg" value="0" />
				</div>

				<!-- Status -->
				<div class="form-group mb-6">
					<label for="status" class="form-label-dark">Status</label>
					<select id="status" name="status" class="form-control form-control-lg">
						<option value="1">Ativo</option>
						<option value="0">Inativo</option>
					</select>
				</div>

				<!-- Imagem de Capa -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="image" style="display: block; font-weight: 700; margin-bottom: 0.5rem; color: #0f172a; font-size: 1.1rem;">Imagem de Capa (Banner/Ícone)</label>
					<input type="file" id="image" name="image" accept="image/*" class="form-control form-control-lg" />
					<p style="margin: 0.5rem 0 0 0; font-size: 0.8rem; color: #64748b;">Formatos aceitos: JPG, PNG, WEBP, GIF.</p>
				</div>

				<!-- Meta Título -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="meta_title" class="form-label-dark">Meta Título (SEO Title)</label>
					<input type="text" id="meta_title" name="meta_title" class="form-control form-control-lg" />
				</div>

				<!-- Meta Descrição -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="meta_description" class="form-label-dark">Meta Descrição (SEO Description)</label>
					<input type="text" id="meta_description" name="meta_description" class="form-control form-control-lg" />
				</div>

				<!-- Meta Palavras-chave -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="meta_keyword" class="form-label-dark">Meta Keywords (Palavras-chave)</label>
					<input type="text" id="meta_keyword" name="meta_keyword" class="form-control form-control-lg" placeholder="ex: tubos, conexoes, pvc" />
				</div>

				<!-- Descrição Detalhada -->
				<div class="form-group" style="grid-column: span 2; margin-bottom: 2rem;">
					<label for="description" class="form-label-dark">Descrição da Categoria</label>
					<textarea id="description" name="description" class="form-control form-control-lg" rows="6"></textarea>
				</div>

			</div>

			<!-- Botões de Ação -->
			<div class="form-actions">
				<a href="/LPDHED2dC7Gjrg2b/categorias" class="btn btn-secondary">Cancelar</a>
				<button type="submit" class="btn btn-primary">
					<i class="fas fa-save"></i>
					<span>Salvar Categoria</span>
				</button>
			</div>
		</form>
	</div>
{% endblock %}
