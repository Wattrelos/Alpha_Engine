{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default(AdminLang.text_title_create) }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>{{ AdminLang.heading_title_create }}</h2>
			<p class="page-subtitle">{{ AdminLang.text_subtitle_create }}</p>
		</div>
		<a href="{{ admin_path }}/categorias" class="btn btn-secondary">
			<i class="fas fa-arrow-left"></i>
			<span>{{ AdminLang.button_back }}</span>
		</a>
	</div>

	<div class="card card-large">
		<form action="{{ admin_path }}/categorias/criar" method="POST" enctype="multipart/form-data">
			{% if csrf %}
				<input type="hidden" name="{{ csrf.keys.name }}" value="{{ csrf.name }}">
				<input type="hidden" name="{{ csrf.keys.value }}" value="{{ csrf.value }}">
			{% endif %}
			<div class="form-grid grid-2-cols">
				
				<!-- Nome da Categoria -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="name" class="form-label-dark">{{ AdminLang.entry_name }} *</label>
					<input type="text" id="name" name="name" class="form-control form-control-lg" required />
				</div>

				<!-- Categoria Pai -->
				<div class="form-group mb-6">
					<label for="parent_id" class="form-label-dark">{{ AdminLang.entry_parent }}</label>
					<select id="parent_id" name="parent_id" class="form-control form-control-lg">
						<option value="0">{{ AdminLang.text_none }}</option>
						{% for c in categories %}
							<option value="{{ c.id }}">{{ c.name }}</option>
						{% endfor %}
					</select>
				</div>

				<!-- SEO URL (Keyword) -->
				<div class="form-group mb-6">
					<label for="seo_keyword" class="form-label-dark">{{ AdminLang.entry_seo_keyword }}</label>
					<input type="text" id="seo_keyword" name="seo_keyword" class="form-control form-control-lg" placeholder="{{ AdminLang.placeholder_seo_keyword }}" />
				</div>

				<!-- Ordem de Exibição -->
				<div class="form-group mb-6">
					<label for="sort_order" class="form-label-dark">{{ AdminLang.entry_sort_order }}</label>
					<input type="number" id="sort_order" name="sort_order" class="form-control form-control-lg" value="0" />
				</div>

				<!-- Status -->
				<div class="form-group mb-6">
					<label for="status" class="form-label-dark">{{ AdminLang.entry_status }}</label>
					<select id="status" name="status" class="form-control form-control-lg">
						<option value="1">{{ AdminLang.text_active }}</option>
						<option value="0">{{ AdminLang.text_inactive }}</option>
					</select>
				</div>

				<!-- Imagem de Capa -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="image" class="form-label-lg">{{ AdminLang.entry_image }}</label>
					<input type="file" id="image" name="image" accept="image/*" class="form-control form-control-lg" />
					<p class="form-text-muted">{{ AdminLang.text_image_help }}</p>
				</div>

				<!-- Meta Título -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="meta_title" class="form-label-dark">{{ AdminLang.entry_meta_title }}</label>
					<input type="text" id="meta_title" name="meta_title" class="form-control form-control-lg" />
				</div>

				<!-- Meta Descrição -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="meta_description" class="form-label-dark">{{ AdminLang.entry_meta_description }}</label>
					<input type="text" id="meta_description" name="meta_description" class="form-control form-control-lg" />
				</div>

				<!-- Meta Palavras-chave -->
				<div class="form-group col-span-2 grid-form-row">
					<label for="meta_keyword" class="form-label-dark">{{ AdminLang.entry_meta_keyword }}</label>
					<input type="text" id="meta_keyword" name="meta_keyword" class="form-control form-control-lg" placeholder="{{ AdminLang.placeholder_meta_keyword }}" />
				</div>

				<!-- Descrição Detalhada -->
				<div class="form-group grid-col-span-2">
					<label for="description" class="form-label-dark">{{ AdminLang.entry_description }}</label>
					<textarea id="description" name="description" class="form-control form-control-lg" rows="6"></textarea>
				</div>

			</div>

			<!-- Botões de Ação -->
			<div class="form-actions">
				<a href="{{ admin_path }}/categorias" class="btn btn-secondary">{{ AdminLang.button_cancel }}</a>
				<button type="submit" class="btn btn-primary">
					<i class="fas fa-save"></i>
					<span>{{ AdminLang.button_save }}</span>
				</button>
			</div>
		</form>
	</div>
{% endblock %}
