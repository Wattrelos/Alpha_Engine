{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default('Editar Produto | Painel Administrativo') }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>Editar Produto</h2>
			<p class="page-subtitle">Atualize as informações do produto em sua loja.</p>
		</div>
		<a href="/LPDHED2dC7Gjrg2b/produtos" class="btn btn-secondary">
			<i class="fas fa-arrow-left"></i>
			<span>Voltar para Lista</span>
		</a>
	</div>

	<div class="card card-large">
		<form action="/LPDHED2dC7Gjrg2b/produtos/{{ product.id }}/editar" method="POST" enctype="multipart/form-data">
			
			<div class="tabs-container" style="margin-bottom: 2rem;">
				<div class="tabs" style="display: flex; gap: 1rem; border-bottom: 2px solid #e2e8f0; padding-bottom: 0.5rem;">
					<button type="button" class="tab-btn active-tab" data-tab="tab-general" style="background: none; border: none; font-size: 1.1rem; font-weight: 700; color: #0f172a; padding: 0.5rem 1rem; cursor: pointer; border-bottom: 3px solid #3b82f6; margin-bottom: -0.7rem; transition: all 0.2s;">Geral</button>
					<button type="button" class="tab-btn" data-tab="tab-variants" style="background: none; border: none; font-size: 1.1rem; font-weight: 600; color: #64748b; padding: 0.5rem 1rem; cursor: pointer; margin-bottom: -0.7rem; transition: all 0.2s;">Variações (Padrão SaaS)</button>
				</div>
			</div>

			<!-- ABA GERAL -->
			<div id="tab-general" class="tab-content-panel">
				<div class="form-grid grid-2-cols">
					
					<!-- Nome do Produto -->
					<div class="form-group col-span-2 grid-form-row">
						<label for="name" class="form-label-dark">Nome do Produto *</label>
						<input type="text" id="name" name="name" class="form-control form-control-lg" value="{{ product.name }}" required />
					</div>

					<!-- Modelo -->
					<div class="form-group mb-6">
						<label for="model" class="form-label-dark">Modelo</label>
						<input type="text" id="model" name="model" class="form-control form-control-lg" value="{{ product.model }}" />
					</div>

					<!-- EAN / Código de Barras -->
					<div class="form-group mb-6">
						<label for="ean" class="form-label-dark">EAN (Código de Barras)</label>
						<input type="text" id="ean" name="ean" class="form-control form-control-lg" value="{{ product.ean }}" />
					</div>

					<!-- Preço -->
					<div class="form-group mb-6">
						<label for="price" class="form-label-dark">Preço (R$)</label>
						<input type="number" id="price" name="price" class="form-control form-control-lg" step="0.01" value="{{ product.price }}" />
					</div>

					<!-- Quantidade -->
					<div class="form-group mb-6">
						<label for="quantity" class="form-label-dark">Quantidade em Estoque</label>
						<input type="number" id="quantity" name="quantity" class="form-control form-control-lg" value="{{ product.quantity }}" />
					</div>

					<!-- Fabricante (Manufacturer) -->
					<div class="form-group mb-6">
						<label for="manufacturer_id" class="form-label-dark">Fabricante</label>
						<select id="manufacturer_id" name="manufacturer_id" class="form-control form-control-lg">
							<option value="0">--- Nenhum ---</option>
							{% for m in manufacturers %}
								<option value="{{ m.id }}" {% if product.manufacturer_id == m.id %}selected{% endif %}>{{ m.name }}</option>
							{% endfor %}
						</select>
					</div>

					<!-- Status de Estoque (Stock Status) -->
					<div class="form-group mb-6">
						<label for="stock_status_id" class="form-label-dark">Status se Esgotado</label>
						<select id="stock_status_id" name="stock_status_id" class="form-control form-control-lg">
							{% for s in stock_statuses %}
								<option value="{{ s.id }}" {% if product.stock_status_id == s.id %}selected{% endif %}>{{ s.name }}</option>
							{% endfor %}
						</select>
					</div>

					<!-- Data Disponível -->
					<div class="form-group mb-6">
						<label for="date_available" class="form-label-dark">Data Disponível</label>
						<input type="date" id="date_available" name="date_available" class="form-control form-control-lg" value="{{ product.date_available }}" />
					</div>

					<!-- Status -->
					<div class="form-group mb-6">
						<label for="status" class="form-label-dark">Status Geral</label>
						<select id="status" name="status" class="form-control form-control-lg">
							<option value="1" {% if product.status == 1 %}selected{% endif %}>Ativo</option>
							<option value="0" {% if product.status == 0 %}selected{% endif %}>Inativo</option>
						</select>
					</div>

					<!-- Última Modificação -->
					<div class="form-group col-span-2 grid-form-row">
						<label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #64748b;">Última Modificação</label>
						<input type="text" class="form-control" value="{{ product.date_modified|default('Nenhuma alteração registrada') }}" readonly style="width: 100%; padding: 0.75rem; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 1rem; color: #64748b; background: #f8f9fa; cursor: not-allowed;" />
					</div>
					<!-- Imagem do Produto -->
					<div class="form-group" style="grid-column: span 2; margin-bottom: 2rem; padding: 1.5rem; border: 1px dashed #cbd5e1; border-radius: 12px; background: #f8fafc;">
						<label for="image" style="display: block; font-weight: 700; margin-bottom: 0.75rem; color: #0f172a; font-size: 1.1rem;">Foto do Produto</label>
						
						{% if product.image %}
							<div class="current-image-container" style="display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.5rem; background: #fff; padding: 1rem; border-radius: 8px; border: 1px solid #e2e8f0;">
								<div style="width: 120px; height: 120px; display: flex; align-items: center; justify-content: center; background: #f1f5f9; border-radius: 6px; overflow: hidden; border: 1px solid #e2e8f0;">
									<img src="/{{ product.image }}" alt="Preview" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
								</div>
								<div>
									<div style="font-weight: 600; color: #334155; margin-bottom: 0.25rem;">Caminho da imagem atual:</div>
									<div style="font-family: monospace; font-size: 0.85rem; color: #64748b; margin-bottom: 0.75rem; word-break: break-all;">{{ product.image }}</div>
									<label style="display: inline-flex; align-items: center; gap: 8px; color: #ef4444; font-weight: 600; cursor: pointer; font-size: 0.9rem; user-select: none;">
										<input type="checkbox" name="remove_image" value="1" style="width: 16px; height: 16px; accent-color: #ef4444;" />
										<span>Remover esta imagem</span>
									</label>
								</div>
							</div>
						{% else %}
							<div class="no-image-placeholder" style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; color: #64748b; font-size: 0.9rem;">
								<i class="fas fa-image" style="font-size: 2rem; color: #cbd5e1;"></i>
								<span>Nenhuma imagem cadastrada para este produto.</span>
							</div>
						{% endif %}

						<div class="upload-input-wrap">
							<input type="file" id="image" name="image" accept="image/*" class="form-control form-control-lg" />
							<p style="margin: 0.5rem 0 0 0; font-size: 0.8rem; color: #64748b;">Formatos aceitos: JPG, PNG, WEBP, GIF. O envio de uma nova foto substituirá a atual.</p>
						</div>
					</div>

					<div class="form-group" style="grid-column: span 2; margin-bottom: 2rem;">
						<label for="description" class="form-label-dark">Descrição Detalhada</label>
						<textarea id="description" name="description" class="form-control form-control-lg" rows="8">{{ product.description }}</textarea>
					</div>
				</div>
			</div>

			<!-- ABA DE VARIAÇÕES -->
			<div id="tab-variants" class="tab-content-panel" style="display: none;">
				<h3 style="font-size: 1.25rem; font-weight: 700; color: #0f172a; margin-bottom: 0.5rem;">Variações do Produto (Filhos)</h3>
				<p style="color: #64748b; font-size: 0.9rem; margin-bottom: 1.5rem;">Cadastre as variações disponíveis (ex: Voltagem, Cor, Tamanho). Cada variação cadastrada funciona como um SKU filho, permitindo o controle de estoque individual, SKU próprio e preços diferenciados (ou herdados do produto pai se deixado em 0.00).</p>
				
				<div style="margin-bottom: 1.5rem; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; background: #fff;">
					<table id="variants-table" style="width: 100%; border-collapse: collapse; margin: 0; font-size: 0.95rem;">
						<thead>
							<tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
								<th style="padding: 1rem; font-weight: 600; color: #334155;">Nome da Variação *</th>
								<th style="padding: 1rem; font-weight: 600; color: #334155;">SKU</th>
								<th style="padding: 1rem; font-weight: 600; color: #334155;">Preço Venda (R$)</th>
								<th style="padding: 1rem; font-weight: 600; color: #334155;">Estoque</th>
								<th style="padding: 1rem; font-weight: 600; color: #334155;">Status</th>
								<th style="padding: 1rem; font-weight: 600; color: #334155; text-align: right;">Ação</th>
							</tr>
						</thead>
						<tbody>
							{% for variant in variants %}
								<tr style="border-bottom: 1px solid #f1f5f9;" class="variant-row" data-id="{{ variant.id }}">
									<td style="padding: 1rem;">
										<input type="hidden" name="variants[{{ loop.index0 }}][id]" value="{{ variant.id }}" />
										<input type="hidden" name="variants[{{ loop.index0 }}][delete]" value="0" class="delete-flag" />
										<input type="text" name="variants[{{ loop.index0 }}][name]" class="form-control" value="{{ variant.variant }}" required style="width: 100%; padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
									</td>
									<td style="padding: 1rem;">
										<input type="text" name="variants[{{ loop.index0 }}][sku]" class="form-control" value="{{ variant.sku }}" style="width: 100%; padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
									</td>
									<td style="padding: 1rem;">
										<input type="number" name="variants[{{ loop.index0 }}][price]" class="form-control" value="{{ variant.price }}" step="0.01" style="width: 100%; padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
									</td>
									<td style="padding: 1rem;">
										<input type="number" name="variants[{{ loop.index0 }}][quantity]" class="form-control" value="{{ variant.quantity }}" style="width: 100%; padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
									</td>
									<td style="padding: 1rem;">
										<select name="variants[{{ loop.index0 }}][status]" class="form-control" style="width: 100%; padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 6px;">
											<option value="1" {% if variant.status == 1 %}selected{% endif %}>Ativo</option>
											<option value="0" {% if variant.status == 0 %}selected{% endif %}>Inativo</option>
										</select>
									</td>
									<td style="padding: 1rem; text-align: right;">
										<button type="button" class="btn btn-danger btn-sm remove-variant-btn" style="padding: 0.4rem 0.75rem; border-radius: 6px;"><i class="fas fa-trash-alt"></i></button>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
				
				<button type="button" id="add-variant-btn" class="btn btn-secondary btn-with-icon" style="margin-bottom: 2rem;">
					<i class="fas fa-plus"></i>
					<span>Adicionar Variação</span>
				</button>
			</div>

			<!-- Botões de Ação -->
			<div class="form-actions" style="margin-top: 2rem; border-top: 1px solid #e2e8f0; padding-top: 1.5rem;">
				<a href="/LPDHED2dC7Gjrg2b/produtos" class="btn btn-secondary">Cancelar</a>
				<button type="submit" class="btn btn-primary">
					<i class="fas fa-save"></i>
					<span>Salvar Alterações</span>
				</button>
			</div>
		</form>
	</div>

	<script>
	document.addEventListener('DOMContentLoaded', function() {
		// 1. Alternador de Abas
		const tabBtns = document.querySelectorAll('.tab-btn');
		const tabPanels = document.querySelectorAll('.tab-content-panel');
		
		tabBtns.forEach(btn => {
			btn.addEventListener('click', function() {
				const targetTab = this.getAttribute('data-tab');
				
				tabBtns.forEach(b => {
					b.classList.remove('active-tab');
					b.style.color = '#64748b';
					b.style.borderBottom = 'none';
					b.style.fontWeight = '600';
				});
				
				tabPanels.forEach(p => p.style.display = 'none');
				
				this.classList.add('active-tab');
				this.style.color = '#0f172a';
				this.style.borderBottom = '3px solid #3b82f6';
				this.style.fontWeight = '700';
				
				document.getElementById(targetTab).style.display = 'block';
			});
		});
		
		// 2. Adicionar Variação Dinamicamente
		const addBtn = document.getElementById('add-variant-btn');
		const tableBody = document.querySelector('#variants-table tbody');
		let rowIndex = tableBody.querySelectorAll('tr').length;
		
		addBtn.addEventListener('click', function() {
			const tr = document.createElement('tr');
			tr.style.borderBottom = '1px solid #f1f5f9';
			tr.innerHTML = `
				<td style="padding: 1rem;">
					<input type="hidden" name="variants[${rowIndex}][id]" value="0" />
					<input type="hidden" name="variants[${rowIndex}][delete]" value="0" class="delete-flag" />
					<input type="text" name="variants[${rowIndex}][name]" class="form-control" placeholder="ex: Cor: Preto, Tamanho: P" required style="width: 100%; padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
				</td>
				<td style="padding: 1rem;">
					<input type="text" name="variants[${rowIndex}][sku]" class="form-control" placeholder="ex: SKU-VAR" style="width: 100%; padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
				</td>
				<td style="padding: 1rem;">
					<input type="number" name="variants[${rowIndex}][price]" class="form-control" value="0.00" step="0.01" style="width: 100%; padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
				</td>
				<td style="padding: 1rem;">
					<input type="number" name="variants[${rowIndex}][quantity]" class="form-control" value="1" style="width: 100%; padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
				</td>
				<td style="padding: 1rem;">
					<select name="variants[${rowIndex}][status]" class="form-control" style="width: 100%; padding: 0.5rem; border: 1px solid #cbd5e1; border-radius: 6px;">
						<option value="1" selected>Ativo</option>
						<option value="0">Inativo</option>
					</select>
				</td>
				<td style="padding: 1rem; text-align: right;">
					<button type="button" class="btn btn-danger btn-sm remove-variant-btn" style="padding: 0.4rem 0.75rem; border-radius: 6px;"><i class="fas fa-trash-alt"></i></button>
				</td>
			`;
			tableBody.appendChild(tr);
			
			// Bind remove event on new row
			bindRowRemove(tr);
			
			rowIndex++;
		});
		
		// 3. Remover/Marcar Exclusão de Variações
		function bindRowRemove(row) {
			row.querySelector('.remove-variant-btn').addEventListener('click', function() {
				const idInput = row.querySelector('input[name*="[id]"]');
				if (idInput && parseInt(idInput.value) > 0) {
					// É uma variação antiga salva no BD, marcamos para deletar no backend
					row.querySelector('.delete-flag').value = '1';
					row.style.display = 'none';
				} else {
					// É uma variação nova, removemos direto do DOM
					row.remove();
				}
			});
		}
		
		// Bind nas linhas iniciais
		tableBody.querySelectorAll('tr').forEach(tr => bindRowRemove(tr));
	});
	</script>
		</form>
	</div>
{% endblock %}
