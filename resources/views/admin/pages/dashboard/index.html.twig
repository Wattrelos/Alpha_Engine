{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default('Painel Inicial | AgSonhos Admin') }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<h2>{{ title|default('Painel Inicial') }}</h2>
		<p class="page-subtitle">Bem-vindo de volta! Aqui está o resumo das atividades da AgSonhos e Construções de hoje.</p>
	</div>

	<!-- Stats Grid -->
	<div class="stats-grid">
		<!-- Stat Item 1 -->
		<div class="card stat-card">
			<div>
				<p class="stat-title">Total em Vendas</p>
				<h3 class="stat-value">R$ 48.825,90</h3>
				<span class="stat-trend trend-up"><i class="fas fa-arrow-up"></i> +12% esta semana</span>
			</div>
			<div class="stat-icon-box icon-blue">
				<i class="fas fa-dollar-sign"></i>
			</div>
		</div>

		<!-- Stat Item 2 -->
		<div class="card stat-card">
			<div>
				<p class="stat-title">Pedidos Recebidos</p>
				<h3 class="stat-value">784</h3>
				<span class="stat-trend trend-up"><i class="fas fa-arrow-up"></i> +5% esta semana</span>
			</div>
			<div class="stat-icon-box icon-green">
				<i class="fas fa-shopping-bag"></i>
			</div>
		</div>

		<!-- Stat Item 3 -->
		<div class="card stat-card">
			<div>
				<p class="stat-title">Clientes Registrados</p>
				<h3 class="stat-value">240</h3>
				<span class="stat-trend trend-down"><i class="fas fa-arrow-down"></i> -2.4% esta semana</span>
			</div>
			<div class="stat-icon-box icon-yellow">
				<i class="fas fa-users"></i>
			</div>
		</div>

		<!-- Stat Item 4 -->
		<div class="card stat-card">
			<div>
				<p class="stat-title">Taxa de Conversão</p>
				<h3 class="stat-value">3.42%</h3>
				<span class="stat-trend trend-up"><i class="fas fa-arrow-up"></i> +1.1% hoje</span>
			</div>
			<div class="stat-icon-box icon-purple">
				<i class="fas fa-percentage"></i>
			</div>
		</div>
	</div>

	<!-- Quick Actions Grid (Atalhos Rápidos por Permissão) -->
	<div class="card mb-4" style="margin-bottom: 2rem;">
		<h3 style="margin: 0 0 0.5rem 0; font-size: 1.1rem; font-weight: 700; color: #1e293b;">
			<i class="fas fa-bolt text-primary mr-2"></i> Atalhos Rápidos do Sistema
		</h3>
		<p class="text-sm text-muted mb-4">Ferramentas de acesso rápido autorizadas para o seu perfil ({% if logged_admin.user_group_id == 1 %}Super Administrator{% else %}Colaborador{% endif %}):</p>
		
		<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 1rem;">
			
			{% if logged_admin.user_group_id == 1 or 'user/user' in logged_admin_permissions.access %}
				<a href="{{ admin_path }}/usuarios" class="card" style="margin: 0; padding: 1rem; text-decoration: none; border: 1px solid #e2e8f0; transition: all 0.2s ease; display: flex; align-items: center; gap: 0.8rem; background: #ffffff;">
					<div class="stat-icon-box icon-blue" style="width: 42px; height: 42px; font-size: 1.1rem;">
						<i class="fas fa-users-cog"></i>
					</div>
					<div>
						<h4 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: #0f172a;">Funcionários</h4>
						<span style="font-size: 0.75rem; color: #64748b;">Gerenciar Colaboradores</span>
					</div>
				</a>
			{% endif %}

			{% if logged_admin.user_group_id == 1 or 'user/user_group' in logged_admin_permissions.access %}
				<a href="{{ admin_path }}/papeis" class="card" style="margin: 0; padding: 1rem; text-decoration: none; border: 1px solid #e2e8f0; transition: all 0.2s ease; display: flex; align-items: center; gap: 0.8rem; background: #ffffff;">
					<div class="stat-icon-box icon-purple" style="width: 42px; height: 42px; font-size: 1.1rem;">
						<i class="fas fa-user-shield"></i>
					</div>
					<div>
						<h4 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: #0f172a;">Papéis & Permissões</h4>
						<span style="font-size: 0.75rem; color: #64748b;">Perfis de Acesso</span>
					</div>
				</a>
			{% endif %}

			{% if logged_admin.user_group_id == 1 or 'pos/sales_rep' in logged_admin_permissions.access %}
				<a href="{{ admin_path }}/pos/vendedor" class="card" style="margin: 0; padding: 1rem; text-decoration: none; border: 1px solid #e2e8f0; transition: all 0.2s ease; display: flex; align-items: center; gap: 0.8rem; background: #ffffff;">
					<div class="stat-icon-box icon-green" style="width: 42px; height: 42px; font-size: 1.1rem;">
						<i class="fas fa-cash-register"></i>
					</div>
					<div>
						<h4 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: #0f172a;">PDV Vendedor</h4>
						<span style="font-size: 0.75rem; color: #64748b;">Vendas Balcão / Loja</span>
					</div>
				</a>
			{% endif %}

			{% if logged_admin.user_group_id == 1 or 'pos/cashier' in logged_admin_permissions.access %}
				<a href="{{ admin_path }}/pos/caixa" class="card" style="margin: 0; padding: 1rem; text-decoration: none; border: 1px solid #e2e8f0; transition: all 0.2s ease; display: flex; align-items: center; gap: 0.8rem; background: #ffffff;">
					<div class="stat-icon-box icon-yellow" style="width: 42px; height: 42px; font-size: 1.1rem;">
						<i class="fas fa-receipt"></i>
					</div>
					<div>
						<h4 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: #0f172a;">PDV Caixa</h4>
						<span style="font-size: 0.75rem; color: #64748b;">Recebimentos / Fatura</span>
					</div>
				</a>
			{% endif %}

			{% if logged_admin.user_group_id == 1 or 'catalog/product' in logged_admin_permissions.access %}
				<a href="{{ admin_path }}/produtos" class="card" style="margin: 0; padding: 1rem; text-decoration: none; border: 1px solid #e2e8f0; transition: all 0.2s ease; display: flex; align-items: center; gap: 0.8rem; background: #ffffff;">
					<div class="stat-icon-box icon-blue" style="width: 42px; height: 42px; font-size: 1.1rem;">
						<i class="fas fa-box"></i>
					</div>
					<div>
						<h4 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: #0f172a;">Produtos</h4>
						<span style="font-size: 0.75rem; color: #64748b;">Catálogo de Itens</span>
					</div>
				</a>
			{% endif %}

			{% if logged_admin.user_group_id == 1 or 'procurement/supplier' in logged_admin_permissions.access %}
				<a href="{{ admin_path }}/fornecedores" class="card" style="margin: 0; padding: 1rem; text-decoration: none; border: 1px solid #e2e8f0; transition: all 0.2s ease; display: flex; align-items: center; gap: 0.8rem; background: #ffffff;">
					<div class="stat-icon-box icon-purple" style="width: 42px; height: 42px; font-size: 1.1rem;">
						<i class="fas fa-truck-loading"></i>
					</div>
					<div>
						<h4 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: #0f172a;">Fornecedores</h4>
						<span style="font-size: 0.75rem; color: #64748b;">Gestão de Suprimentos</span>
					</div>
				</a>
			{% endif %}

			{% if logged_admin.user_group_id == 1 or 'setting/store_setting' in logged_admin_permissions.access or 'setting/setting' in logged_admin_permissions.access %}
				<a href="{{ admin_path }}/configuracoes" class="card" style="margin: 0; padding: 1rem; text-decoration: none; border: 1px solid #e2e8f0; transition: all 0.2s ease; display: flex; align-items: center; gap: 0.8rem; background: #ffffff;">
					<div class="stat-icon-box icon-yellow" style="width: 42px; height: 42px; font-size: 1.1rem;">
						<i class="fas fa-cogs"></i>
					</div>
					<div>
						<h4 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: #0f172a;">Configurações</h4>
						<span style="font-size: 0.75rem; color: #64748b;">Ajustes da Loja</span>
					</div>
				</a>
			{% endif %}

		</div>
	</div>

	<!-- Two-column grid -->
	<div class="dashboard-grid">
		<!-- Recent Sales Card -->
		<div class="card mb-0">
			<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
				<h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: #1e293b;">Vendas Recentes</h3>
				<button class="btn btn-primary" style="font-size: 0.8rem; padding: 6px 12px;">Ver Todas</button>
			</div>
			<div class="overflow-x-auto">
				<table class="table" style="margin: 0;">
					<thead>
						<tr>
							<th class="pl-0">Pedido ID</th>
							<th>Cliente</th>
							<th>Status</th>
							<th>Data</th>
							<th class="text-right pr-0">Total</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="pl-0" style="font-weight: 600; color: var(--color-primary);">#4829</td>
							<td>Carlos Silva</td>
							<td><span class="status-pill status-approved">Aprovado</span></td>
							<td>Hoje, 14:32</td>
							<td class="text-right pr-0 text-semibold text-dark">R$ 299,90</td>
						</tr>
						<tr>
							<td class="pl-0" style="font-weight: 600; color: var(--color-primary);">#4828</td>
							<td>Maria Fernanda</td>
							<td><span class="status-pill status-cancelled">Cancelado</span></td>
							<td>Hoje, 11:15</td>
							<td class="text-right pr-0 text-semibold text-dark">R$ 89,90</td>
						</tr>
						<tr>
							<td class="pl-0" style="font-weight: 600; color: var(--color-primary);">#4827</td>
							<td>Roberto Costa</td>
							<td><span class="status-pill status-pending">Pendente</span></td>
							<td>Ontem, 19:44</td>
							<td class="text-right pr-0 text-semibold text-dark">R$ 1.240,00</td>
						</tr>
						<tr>
							<td class="pl-0" style="font-weight: 600; color: var(--color-primary);">#4826</td>
							<td>Juliana Paes</td>
							<td><span class="status-pill status-approved">Aprovado</span></td>
							<td>Ontem, 16:21</td>
							<td class="text-right pr-0 text-semibold text-dark">R$ 459,00</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Recent Activity Card -->
		<div class="card mb-0">
			<h3 style="margin: 0 0 1.5rem 0; font-size: 1.1rem; font-weight: 700; color: #1e293b;">Atividades do Sistema</h3>
			<div class="activity-list">
				<!-- Activity 1 -->
				<div class="activity-item">
					<div class="activity-dot dot-primary"></div>
					<div>
						<p class="activity-title">Novo produto cadastrado</p>
						<p class="activity-desc">"Cimento CP-II Itaú 50kg"</p>
						<span class="activity-time">Há 5 minutos</span>
					</div>
				</div>
				<!-- Activity 2 -->
				<div class="activity-item">
					<div class="activity-dot dot-success"></div>
					<div>
						<p class="activity-title">Pedido #4829 faturado</p>
						<p class="activity-desc">Envio preparado via transportadora</p>
						<span class="activity-time">Há 20 minutos</span>
					</div>
				</div>
				<!-- Activity 3 -->
				<div class="activity-item">
					<div class="activity-dot dot-warning"></div>
					<div>
						<p class="activity-title">Nova mensagem de contato</p>
						<p class="activity-desc">Dúvida sobre frete de tijolos</p>
						<span class="activity-time">Há 1 hora</span>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
