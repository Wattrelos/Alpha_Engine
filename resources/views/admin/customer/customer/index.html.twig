{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default((AdminLang.heading_title|default('Clientes')) ~ ' | ' ~ (AdminLang.sidebar.title|default('Painel Administrativo'))) }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>{{ AdminLang.heading_title|default('Gerenciamento de Clientes') }}</h2>
			<p class="page-subtitle">{{ AdminLang.text_subtitle|default('Visualize, adicione ou edite as contas de clientes da sua loja.') }}</p>
		</div>
		<a href="{{ admin_path }}/clientes/criar" class="btn btn-primary btn-with-icon">
			<i class="fas fa-plus"></i>
			<span>{{ AdminLang.button_add|default('Adicionar Cliente') }}</span>
		</a>
	</div>

	<!-- Painel de Filtros de Busca -->
	<div class="card">
		<form method="GET" action="{{ admin_path }}/clientes">
			<div class="grid-filters">
				
				<!-- Nome -->
				<div class="form-group mb-0">
					<label for="filter_name" class="form-label-sm">{{ AdminLang.entry_name|default('Nome do Cliente') }}</label>
					<input type="text" id="filter_name" name="filter_name" class="form-control" value="{{ filters.filter_name }}" placeholder="{{ AdminLang.placeholder_search_name|default('Buscar por nome...') }}" />
				</div>

				<!-- E-mail -->
				<div class="form-group mb-0">
					<label for="filter_email" class="form-label-sm">{{ AdminLang.entry_email|default('E-mail') }}</label>
					<input type="text" id="filter_email" name="filter_email" class="form-control" value="{{ filters.filter_email }}" placeholder="{{ AdminLang.placeholder_search_email|default('Buscar por e-mail...') }}" />
				</div>

				<!-- Grupo de Clientes -->
				<div class="form-group mb-0">
					<label for="filter_customer_group_id" class="form-label-sm">{{ AdminLang.entry_customer_group|default('Grupo de Clientes') }}</label>
					<select id="filter_customer_group_id" name="filter_customer_group_id" class="form-control">
						<option value="">-- {{ AdminLang.text_all|default('Todos') }} --</option>
						{% for group in customer_groups %}
							<option value="{{ group.id }}" {% if filters.filter_customer_group_id == group.id %}selected{% endif %}>{{ group.name }}</option>
						{% endfor %}
					</select>
				</div>

				<!-- Status -->
				<div class="form-group mb-0">
					<label for="filter_status" class="form-label-sm">{{ AdminLang.entry_status|default('Status') }}</label>
					<select id="filter_status" name="filter_status" class="form-control">
						<option value="">-- {{ AdminLang.text_all|default('Todos') }} --</option>
						<option value="1" {% if filters.filter_status == '1' %}selected{% endif %}>{{ AdminLang.text_active|default('Ativo') }}</option>
						<option value="0" {% if filters.filter_status == '0' %}selected{% endif %}>{{ AdminLang.text_inactive|default('Inativo') }}</option>
					</select>
				</div>
 
				<!-- Ações -->
				<div class="d-flex gap-2">
					<a href="{{ admin_path }}/clientes" class="btn flex-1 btn-secondary">{{ AdminLang.button_clear|default('Limpar') }}</a>
					<button type="submit" class="btn btn-primary flex-1">
						<i class="fas fa-filter"></i>
						<span>{{ AdminLang.button_filter|default('Filtrar') }}</span>
					</button>
				</div>
 
			</div>
		</form>
	</div>

	<div class="card card-table">
		<div class="overflow-x-auto">
			<table class="table table-clean">
				<thead>
					<tr>
						<th>{{ AdminLang.column_id|default('ID') }}</th>
						<th>{{ AdminLang.column_name|default('Nome do Cliente') }}</th>
						<th>{{ AdminLang.column_email|default('E-mail') }}</th>
						<th>{{ AdminLang.column_group|default('Grupo') }}</th>
						<th>{{ AdminLang.column_status|default('Status') }}</th>
						<th>{{ AdminLang.column_date_added|default('Data Cadastro') }}</th>
						<th class="text-right">{{ AdminLang.column_actions|default('Ações') }}</th>
					</tr>
				</thead>
				<tbody>
					{% if customers %}
						{% for customer in customers %}
							<tr>
								<td class="text-muted">#{{ customer.customer_id }}</td>
								<td class="text-semibold text-dark">{{ customer.name }}</td>
								<td class="text-muted">{{ customer.email }}</td>
								<td class="text-muted">{{ customer.customer_group }}</td>
								<td>
									{% if customer.status == 'Ativo' %}
										<span class="status-pill status-approved">{{ AdminLang.text_active|default('Ativo') }}</span>
									{% else %}
										<span class="status-pill status-cancelled">{{ AdminLang.text_inactive|default('Inativo') }}</span>
									{% endif %}
								</td>
								<td class="text-muted">{{ customer.date_added }}</td>
								<td class="text-right">
									<div class="actions-wrapper">
										<a href="{{ admin_path }}/clientes/{{ customer.customer_id }}" class="btn btn-sm" title="{{ AdminLang.text_show_title|default('Visualizar Detalhes') }}">
											<i class="fas fa-eye"></i>
										</a>
										<a href="{{ admin_path }}/clientes/{{ customer.customer_id }}/editar" class="btn btn-primary btn-sm" title="{{ AdminLang.text_edit_title|default('Editar') }}">
											<i class="fas fa-edit"></i>
										</a>
									</div>
								</td>
							</tr>
						{% endfor %}
					{% else %}
						<tr>
							<td colspan="7" class="table-empty-cell">
								<i class="fas fa-users table-empty-icon"></i>
								{{ AdminLang.text_empty|default('Nenhum cliente encontrado.') }}
							</td>
						</tr>
					{% endif %}
				</tbody>
			</table>
		</div>
		{% if total > limit %}
			<div class="table-pagination-bar">
				{% include 'components/molecules/pagination.html.twig' %}
			</div>
		{% endif %}
	</div>
{% endblock %}
