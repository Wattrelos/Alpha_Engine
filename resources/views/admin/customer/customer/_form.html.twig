<div class="form-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;">
	
	<!-- Nome -->
	<div class="form-group" style="margin-bottom: 1rem;">
		<label for="firstname" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Nome *</label>
		<input type="text" id="firstname" name="firstname" class="form-control" value="{{ customer.firstname }}" required style="width: 100%; padding: 0.75rem; border: 1px solid {% if errors.firstname %}#ef4444{% else %}#cbd5e1{% endif %}; border-radius: 8px; font-size: 1rem; color: #1e293b;" />
		{% if errors.firstname %}<p style="color: #ef4444; font-size: 0.8rem; margin: 4px 0 0 0;">{{ errors.firstname }}</p>{% endif %}
	</div>

	<!-- Sobrenome -->
	<div class="form-group" style="margin-bottom: 1rem;">
		<label for="lastname" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Sobrenome *</label>
		<input type="text" id="lastname" name="lastname" class="form-control" value="{{ customer.lastname }}" required style="width: 100%; padding: 0.75rem; border: 1px solid {% if errors.lastname %}#ef4444{% else %}#cbd5e1{% endif %}; border-radius: 8px; font-size: 1rem; color: #1e293b;" />
		{% if errors.lastname %}<p style="color: #ef4444; font-size: 0.8rem; margin: 4px 0 0 0;">{{ errors.lastname }}</p>{% endif %}
	</div>

	<!-- E-mail -->
	<div class="form-group" style="margin-bottom: 1rem;">
		<label for="email" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">E-mail *</label>
		<input type="email" id="email" name="email" class="form-control" value="{{ customer.email }}" required style="width: 100%; padding: 0.75rem; border: 1px solid {% if errors.email %}#ef4444{% else %}#cbd5e1{% endif %}; border-radius: 8px; font-size: 1rem; color: #1e293b;" />
		{% if errors.email %}<p style="color: #ef4444; font-size: 0.8rem; margin: 4px 0 0 0;">{{ errors.email }}</p>{% endif %}
	</div>

	<!-- Telefone -->
	<div class="form-group" style="margin-bottom: 1rem;">
		<label for="telephone" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Telefone *</label>
		<input type="text" id="telephone" name="telephone" class="form-control" value="{{ customer.telephone }}" required style="width: 100%; padding: 0.75rem; border: 1px solid {% if errors.telephone %}#ef4444{% else %}#cbd5e1{% endif %}; border-radius: 8px; font-size: 1rem; color: #1e293b;" />
		{% if errors.telephone %}<p style="color: #ef4444; font-size: 0.8rem; margin: 4px 0 0 0;">{{ errors.telephone }}</p>{% endif %}
	</div>

	<!-- Tipo de Pessoa -->
	<div class="form-group" style="margin-bottom: 1rem;">
		<label for="persontype" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Tipo de Pessoa</label>
		<select id="persontype" name="persontype" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b; background: #fff;">
			<option value="F" {% if customer.persontype == 'F' %}selected{% endif %}>Física</option>
			<option value="J" {% if customer.persontype == 'J' %}selected{% endif %}>Jurídica</option>
		</select>
	</div>

	<!-- CPF / CNPJ -->
	<div class="form-group" style="margin-bottom: 1rem;">
		<label for="cpf_cnpj" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">CPF / CNPJ</label>
		<input type="text" id="cpf_cnpj" name="cpf_cnpj" class="form-control" value="{{ customer.cpf_cnpj }}" style="width: 100%; padding: 0.75rem; border: 1px solid {% if errors.cpf_cnpj %}#ef4444{% else %}#cbd5e1{% endif %}; border-radius: 8px; font-size: 1rem; color: #1e293b;" />
		{% if errors.cpf_cnpj %}<p style="color: #ef4444; font-size: 0.8rem; margin: 4px 0 0 0;">{{ errors.cpf_cnpj }}</p>{% endif %}
	</div>

	<!-- Grupo de Clientes -->
	<div class="form-group" style="margin-bottom: 1rem;">
		<label for="customer_group_id" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Grupo de Clientes</label>
		<select id="customer_group_id" name="customer_group_id" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b; background: #fff;">
			{% for group in customer_groups %}
				<option value="{{ group.id }}" {% if customer.customer_group_id == group.id or (not customer.customer_group_id and group.id == 1) %}selected{% endif %}>{{ group.name }}</option>
			{% endfor %}
		</select>
	</div>

	<!-- Status -->
	<div class="form-group" style="margin-bottom: 1rem;">
		<label for="status" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Status</label>
		<select id="status" name="status" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b; background: #fff;">
			<option value="1" {% if customer.status == '1' or customer.status is not defined or customer.status is null %}selected{% endif %}>Ativo</option>
			<option value="0" {% if customer.status == '0' %}selected{% endif %}>Inativo</option>
		</select>
	</div>

	<!-- Seguro (Safe) -->
	<div class="form-group" style="margin-bottom: 1rem;">
		<label for="safe" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Aprovado (Safe)</label>
		<select id="safe" name="safe" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b; background: #fff;">
			<option value="1" {% if customer.safe == '1' %}selected{% endif %}>Sim</option>
			<option value="0" {% if customer.safe == '0' or customer.safe is not defined or customer.safe is null %}selected{% endif %}>Não</option>
		</select>
	</div>

	<!-- Comentador (Commenter) -->
	<div class="form-group" style="margin-bottom: 1rem;">
		<label for="commenter" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Pode Comentar</label>
		<select id="commenter" name="commenter" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 1rem; color: #1e293b; background: #fff;">
			<option value="1" {% if customer.commenter == '1' %}selected{% endif %}>Sim</option>
			<option value="0" {% if customer.commenter == '0' or customer.commenter is not defined or customer.commenter is null %}selected{% endif %}>Não</option>
		</select>
	</div>

	<!-- Senha -->
	<div class="form-group" style="margin-bottom: 1rem;">
		<label for="password" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Senha {% if not customer.id %}*{% endif %}</label>
		<input type="password" id="password" name="password" class="form-control" {% if not customer.id %}required{% endif %} style="width: 100%; padding: 0.75rem; border: 1px solid {% if errors.password %}#ef4444{% else %}#cbd5e1{% endif %}; border-radius: 8px; font-size: 1rem; color: #1e293b;" />
		{% if errors.password %}<p style="color: #ef4444; font-size: 0.8rem; margin: 4px 0 0 0;">{{ errors.password }}</p>{% endif %}
		{% if customer.id %}<p style="margin: 4px 0 0 0; font-size: 0.8rem; color: #64748b;">Deixe em branco para manter a senha atual.</p>{% endif %}
	</div>

	<!-- Confirmar Senha -->
	<div class="form-group" style="margin-bottom: 1rem;">
		<label for="confirm" style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #1e293b;">Confirmar Senha {% if not customer.id %}*{% endif %}</label>
		<input type="password" id="confirm" name="confirm" class="form-control" {% if not customer.id %}required{% endif %} style="width: 100%; padding: 0.75rem; border: 1px solid {% if errors.confirm %}#ef4444{% else %}#cbd5e1{% endif %}; border-radius: 8px; font-size: 1rem; color: #1e293b;" />
		{% if errors.confirm %}<p style="color: #ef4444; font-size: 0.8rem; margin: 4px 0 0 0;">{{ errors.confirm }}</p>{% endif %}
	</div>

</div>
