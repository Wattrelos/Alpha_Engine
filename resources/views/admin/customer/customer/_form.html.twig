<div class="form-grid grid-2-cols">
	
	<!-- Nome -->
	<div class="form-group mb-4">
		<label for="firstname" class="form-label-dark">{{ AdminLang.entry_firstname|default('Nome') }} *</label>
		<input type="text" id="firstname" name="firstname" class="form-control {% if errors.firstname %}is-invalid{% endif %}" value="{{ customer.firstname }}" required />
		{% if errors.firstname %}<p class="invalid-feedback">{{ errors.firstname }}</p>{% endif %}
	</div>

	<!-- Sobrenome -->
	<div class="form-group mb-4">
		<label for="lastname" class="form-label-dark">{{ AdminLang.entry_lastname|default('Sobrenome') }} *</label>
		<input type="text" id="lastname" name="lastname" class="form-control {% if errors.lastname %}is-invalid{% endif %}" value="{{ customer.lastname }}" required />
		{% if errors.lastname %}<p class="invalid-feedback">{{ errors.lastname }}</p>{% endif %}
	</div>

	<!-- E-mail -->
	<div class="form-group mb-4">
		<label for="email" class="form-label-dark">{{ AdminLang.entry_email|default('E-mail') }} *</label>
		<input type="email" id="email" name="email" class="form-control {% if errors.email %}is-invalid{% endif %}" value="{{ customer.email }}" required />
		{% if errors.email %}<p class="invalid-feedback">{{ errors.email }}</p>{% endif %}
	</div>

	<!-- Telefone -->
	<div class="form-group mb-4">
		<label for="telephone" class="form-label-dark">{{ AdminLang.entry_telephone|default('Telefone') }} *</label>
		<input type="text" id="telephone" name="telephone" class="form-control {% if errors.telephone %}is-invalid{% endif %}" value="{{ customer.telephone }}" required />
		{% if errors.telephone %}<p class="invalid-feedback">{{ errors.telephone }}</p>{% endif %}
	</div>

	<!-- Tipo de Pessoa -->
	<div class="form-group mb-4">
		<label for="persontype" class="form-label-dark">{{ AdminLang.entry_persontype|default('Tipo de Pessoa') }}</label>
		<select id="persontype" name="persontype" class="form-control form-control-lg">
			<option value="F" {% if customer.persontype == 'F' %}selected{% endif %}>{{ AdminLang.entry_persontype_f|default('Física') }}</option>
			<option value="J" {% if customer.persontype == 'J' %}selected{% endif %}>{{ AdminLang.entry_persontype_j|default('Jurídica') }}</option>
		</select>
	</div>

	<!-- CPF / CNPJ -->
	<div class="form-group mb-4">
		<label for="cpf_cnpj" class="form-label-dark">{{ AdminLang.entry_cpf_cnpj|default('CPF / CNPJ') }}</label>
		<input type="text" id="cpf_cnpj" name="cpf_cnpj" class="form-control {% if errors.cpf_cnpj %}is-invalid{% endif %}" value="{{ customer.cpf_cnpj }}" />
		{% if errors.cpf_cnpj %}<p class="invalid-feedback">{{ errors.cpf_cnpj }}</p>{% endif %}
	</div>

	<!-- Grupo de Clientes -->
	<div class="form-group mb-4">
		<label for="customer_group_id" class="form-label-dark">{{ AdminLang.entry_customer_group|default('Grupo de Clientes') }}</label>
		<select id="customer_group_id" name="customer_group_id" class="form-control form-control-lg">
			{% for group in customer_groups %}
				<option value="{{ group.id }}" {% if customer.customer_group_id == group.id or (not customer.customer_group_id and group.id == 1) %}selected{% endif %}>{{ group.name }}</option>
			{% endfor %}
		</select>
	</div>

	<!-- Status -->
	<div class="form-group mb-4">
		<label for="status" class="form-label-dark">{{ AdminLang.entry_status|default('Status') }}</label>
		<select id="status" name="status" class="form-control form-control-lg">
			<option value="1" {% if customer.status == '1' or customer.status is not defined or customer.status is null %}selected{% endif %}>{{ AdminLang.text_active|default('Ativo') }}</option>
			<option value="0" {% if customer.status == '0' %}selected{% endif %}>{{ AdminLang.text_inactive|default('Inativo') }}</option>
		</select>
	</div>

	<!-- Seguro (Safe) -->
	<div class="form-group mb-4">
		<label for="safe" class="form-label-dark">{{ AdminLang.entry_safe|default('Aprovado (Safe)') }}</label>
		<select id="safe" name="safe" class="form-control form-control-lg">
			<option value="1" {% if customer.safe == '1' %}selected{% endif %}>{{ AdminLang.entry_safe_yes|default('Sim') }}</option>
			<option value="0" {% if customer.safe == '0' or customer.safe is not defined or customer.safe is null %}selected{% endif %}>{{ AdminLang.entry_safe_no|default('Não') }}</option>
		</select>
	</div>

	<!-- Comentador (Commenter) -->
	<div class="form-group mb-4">
		<label for="commenter" class="form-label-dark">{{ AdminLang.entry_commenter|default('Pode Comentar') }}</label>
		<select id="commenter" name="commenter" class="form-control form-control-lg">
			<option value="1" {% if customer.commenter == '1' %}selected{% endif %}>{{ AdminLang.entry_commenter_yes|default('Sim') }}</option>
			<option value="0" {% if customer.commenter == '0' or customer.commenter is not defined or customer.commenter is null %}selected{% endif %}>{{ AdminLang.entry_commenter_no|default('Não') }}</option>
		</select>
	</div>

	<!-- Senha -->
	<div class="form-group mb-4">
		<label for="password" class="form-label-dark">{{ AdminLang.entry_password|default('Senha') }} {% if not customer.id %}*{% endif %}</label>
		<input type="password" id="password" name="password" class="form-control {% if errors.password %}is-invalid{% endif %}" {% if not customer.id %}required{% endif %} />
		{% if errors.password %}<p class="invalid-feedback">{{ errors.password }}</p>{% endif %}
		{% if customer.id %}<p class="form-text-muted">{{ AdminLang.text_password_help|default('Deixe em branco para manter a senha atual.') }}</p>{% endif %}
	</div>

	<!-- Confirmar Senha -->
	<div class="form-group mb-4">
		<label for="confirm" class="form-label-dark">{{ AdminLang.entry_confirm|default('Confirmar Senha') }} {% if not customer.id %}*{% endif %}</label>
		<input type="password" id="confirm" name="confirm" class="form-control {% if errors.confirm %}is-invalid{% endif %}" {% if not customer.id %}required{% endif %} />
		{% if errors.confirm %}<p class="invalid-feedback">{{ errors.confirm }}</p>{% endif %}
	</div>

</div>
