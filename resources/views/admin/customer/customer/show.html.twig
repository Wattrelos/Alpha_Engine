{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default((AdminLang.text_show_title|default('Ficha do Cliente')) ~ ' | ' ~ (AdminLang.sidebar.title|default('Painel Administrativo'))) }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>{{ AdminLang.text_show_title|default('Ficha do Cliente') }}: {{ customer.firstname }} {{ customer.lastname }}</h2>
			<p class="page-subtitle">{{ AdminLang.text_show_subtitle|default('Visualize o perfil completo, endereços e histórico de compras.') }}</p>
		</div>
		<div class="d-flex gap-2">
			<a href="{{ admin_path }}/clientes" class="btn btn-secondary">
				<i class="fas fa-arrow-left"></i>
				<span>{{ AdminLang.button_back|default('Voltar') }}</span>
			</a>
			<a href="{{ admin_path }}/clientes/{{ customer.id }}/editar" class="btn btn-primary btn-with-icon">
				<i class="fas fa-user-edit"></i>
				<span>{{ AdminLang.button_edit_profile|default('Editar Cadastro') }}</span>
			</a>
		</div>
	</div>

	<!-- Layout de Grade: 2 Colunas -->
	<div class="grid-2-cols align-start mb-8">
		
		<!-- Coluna Esquerda: Dados do Perfil -->
		<div class="card">
			<h3 class="section-title">
				<i class="fas fa-user-circle icon-primary icon-mr-2"></i>{{ AdminLang.title_general|default('Informações Gerais') }}
			</h3>
			
			<div class="flex-column gap-3">
				<div class="d-flex border-bottom pb-2">
					<span class="text-semibold text-muted w-140">{{ AdminLang.entry_firstname_label|default('Nome Completo') }}:</span>
					<span class="font-medium text-dark">{{ customer.firstname }} {{ customer.lastname }}</span>
				</div>
				
				<div class="d-flex border-bottom pb-2">
					<span class="text-semibold text-muted w-140">{{ AdminLang.entry_email|default('E-mail') }}:</span>
					<span class="text-dark">{{ customer.email }}</span>
				</div>
				
				<div class="d-flex border-bottom pb-2">
					<span class="text-semibold text-muted w-140">{{ AdminLang.entry_telephone|default('Telefone') }}:</span>
					<span class="text-dark">{{ customer.telephone }}</span>
				</div>

				<div class="d-flex border-bottom pb-2">
					<span class="text-semibold text-muted w-140">{{ AdminLang.entry_persontype|default('Tipo de Pessoa') }}:</span>
					<span class="text-dark">
						{% if customer.persontype == 'J' %}{{ AdminLang.entry_persontype_j|default('Jurídica') }}{% else %}{{ AdminLang.entry_persontype_f|default('Física') }}{% endif %}
					</span>
				</div>

				<div class="d-flex border-bottom pb-2">
					<span class="text-semibold text-muted w-140">{{ AdminLang.entry_cpf_cnpj|default('CPF / CNPJ') }}:</span>
					<span class="text-dark">{{ customer.cpf_cnpj|default('-') }}</span>
				</div>
				
				<div class="d-flex border-bottom pb-2">
					<span class="text-semibold text-muted w-140">{{ AdminLang.entry_customer_group|default('Grupo de Clientes') }}:</span>
					<span class="text-dark">{{ customer.customer_group }}</span>
				</div>
				
				<div class="d-flex border-bottom pb-2">
					<span class="text-semibold text-muted w-140">{{ AdminLang.entry_status|default('Status') }}:</span>
					<span>
						{% if customer.status %}
							<span class="status-pill status-approved">{{ AdminLang.text_active|default('Ativo') }}</span>
						{% else %}
							<span class="status-pill status-cancelled">{{ AdminLang.text_inactive|default('Inativo') }}</span>
						{% endif %}
					</span>
				</div>

				<div class="d-flex border-bottom pb-2">
					<span class="text-semibold text-muted w-140">{{ AdminLang.entry_safe|default('Aprovado (Safe)') }}:</span>
					<span>
						{% if customer.safe %}
							<span class="text-success text-semibold"><i class="fas fa-check-circle"></i> {{ AdminLang.entry_safe_yes|default('Sim') }}</span>
						{% else %}
							<span class="text-muted"><i class="fas fa-times-circle"></i> {{ AdminLang.entry_safe_no|default('Não') }}</span>
						{% endif %}
					</span>
				</div>

				<div class="d-flex border-bottom pb-2">
					<span class="text-semibold text-muted w-140">{{ AdminLang.entry_date_added_label|default('Cadastrado em') }}:</span>
					<span class="text-dark">{{ customer.date_added|date('d/m/Y H:i') }}</span>
				</div>

				<div class="d-flex pb-2">
					<span class="text-semibold text-muted w-140">{{ AdminLang.entry_ip_label|default('IP de Registro') }}:</span>
					<span class="text-muted">{{ customer.ip }}</span>
				</div>
			</div>
		</div>

		<!-- Coluna Direita: Endereços -->
		<div class="card">
			<h3 class="section-title">
				<i class="fas fa-map-marker-alt icon-success icon-mr-2"></i>{{ AdminLang.title_addresses|default('Livro de Endereços') }}
			</h3>
			
			{% if addresses %}
				<div class="flex-column gap-3">
					{% for addr in addresses %}
						<div class="address-box {% if addr.default %}address-default{% endif %}">
							{% if addr.default %}
								<span class="badge-success">{{ AdminLang.text_default|default('Padrão') }}</span>
							{% endif %}
							<p class="mb-2 font-medium text-dark">{{ addr.firstname }} {{ addr.lastname }}</p>
							<p class="mb-1 text-muted text-sm">
								{{ addr.street }}, Nº {{ addr.number }} {% if addr.complement %}({{ addr.complement }}){% endif %}
							</p>
							<p class="mb-1 text-muted text-sm">
								{{ addr.neighborhood }} - {{ addr.city }}/{{ addr.zone_code }}
							</p>
							<p class="mb-0 text-muted text-xs">
								CEP: {{ addr.postcode }} | {{ addr.country }}
							</p>
						</div>
					{% endfor %}
				</div>
			{% else %}
				<div class="empty-box">
					<i class="fas fa-map-marker-alt table-empty-icon"></i>
					{{ AdminLang.text_no_addresses|default('Nenhum endereço cadastrado para este cliente.') }}
				</div>
			{% endif %}
		</div>

	</div>

	<!-- Linha Inferior: Histórico de Pedidos -->
	<div class="card card-table mb-8">
		<div class="p-4 border-bottom">
			<h3 class="mb-0 text-dark">
				<i class="fas fa-history icon-indigo icon-mr-2"></i>{{ AdminLang.title_orders|default('Histórico de Pedidos Recentes (Últimos 5)') }}
			</h3>
		</div>
		
		<div class="overflow-x-auto">
			<table class="table table-clean">
				<thead>
					<tr>
						<th>{{ AdminLang.column_order_id|default('ID do Pedido') }}</th>
						<th>{{ AdminLang.column_order_total|default('Valor Total') }}</th>
						<th>{{ AdminLang.column_order_date|default('Data') }}</th>
						<th>{{ AdminLang.column_order_status|default('Status') }}</th>
					</tr>
				</thead>
				<tbody>
					{% if orders %}
						{% for order in orders %}
							<tr>
								<td class="text-semibold text-dark">#{{ order.order_id }}</td>
								<td class="font-medium text-dark">{{ order.total }}</td>
								<td class="text-muted">{{ order.date_added }}</td>
								<td>
									<span class="status-pill status-info">{{ order.status }}</span>
								</td>
							</tr>
						{% endfor %}
					{% else %}
						<tr>
							<td colspan="4" class="table-empty-cell">
								<i class="fas fa-history table-empty-icon"></i>
								{{ AdminLang.text_no_orders|default('Nenhum pedido realizado por este cliente até o momento.') }}
							</td>
						</tr>
					{% endif %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
