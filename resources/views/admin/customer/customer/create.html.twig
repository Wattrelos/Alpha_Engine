{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default((AdminLang.text_add_title|default('Adicionar Cliente')) ~ ' | ' ~ (AdminLang.sidebar.title|default('Painel Administrativo'))) }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>{{ AdminLang.text_add_title|default('Adicionar Cliente') }}</h2>
			<p class="page-subtitle">{{ AdminLang.text_add_subtitle|default('Cadastre um novo cliente no banco de dados.') }}</p>
		</div>
		<a href="{{ admin_path }}/clientes" class="btn btn-secondary">
			<i class="fas fa-arrow-left"></i>
			<span>{{ AdminLang.button_back|default('Voltar para Lista') }}</span>
		</a>
	</div>

	{% if errors.warning %}
		<div class="alert alert-danger">
			{{ errors.warning }}
		</div>
	{% endif %}

	<div class="card card-large">
		<form action="{{ admin_path }}/clientes/criar" method="POST">
			{% if csrf %}
				<input type="hidden" name="{{ csrf.keys.name }}" value="{{ csrf.name }}">
				<input type="hidden" name="{{ csrf.keys.value }}" value="{{ csrf.value }}">
			{% endif %}
			
			{% include 'admin/customer/customer/_form.html.twig' %}

			<!-- Botões de Ação -->
			<div class="form-actions">
				<a href="{{ admin_path }}/clientes" class="btn btn-secondary">{{ AdminLang.button_cancel|default('Cancelar') }}</a>
				<button type="submit" class="btn btn-primary">
					<i class="fas fa-save"></i>
					<span>{{ AdminLang.button_save|default('Salvar Cliente') }}</span>
				</button>
			</div>
		</form>
	</div>
{% endblock %}
