{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default('Adicionar Cliente | Painel Administrativo') }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>Adicionar Cliente</h2>
			<p class="page-subtitle">Cadastre um novo cliente no banco de dados.</p>
		</div>
		<a href="/LPDHED2dC7Gjrg2b/clientes" class="btn btn-secondary">
			<i class="fas fa-arrow-left"></i>
			<span>Voltar para Lista</span>
		</a>
	</div>

	{% if errors.warning %}
		<div class="alert alert-danger">
			{{ errors.warning }}
		</div>
	{% endif %}

	<div class="card card-large">
		<form action="/LPDHED2dC7Gjrg2b/clientes/criar" method="POST">
			
			{% include 'admin/customer/customer/_form.html.twig' %}

			<!-- Botões de Ação -->
			<div class="form-actions">
				<a href="/LPDHED2dC7Gjrg2b/clientes" class="btn btn-secondary">Cancelar</a>
				<button type="submit" class="btn btn-primary">
					<i class="fas fa-save"></i>
					<span>Salvar Cliente</span>
				</button>
			</div>
		</form>
	</div>
{% endblock %}
