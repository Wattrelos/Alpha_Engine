{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default('Adicionar Endereço | Painel Administrativo') }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>Adicionar Endereço</h2>
			<p class="page-subtitle">Cadastre um novo endereço para o cliente: <strong>{{ customer.firstname }} {{ customer.lastname }}</strong></p>
		</div>
		<a href="/LPDHED2dC7Gjrg2b/clientes/{{ customer.id }}/editar?tab=addresses" class="btn btn-secondary">
			<i class="fas fa-arrow-left"></i>
			<span>Voltar</span>
		</a>
	</div>

	{% if errors.warning %}
		<div class="alert alert-danger">
			{{ errors.warning }}
		</div>
	{% endif %}

	<div class="card card-large">
		<form action="/LPDHED2dC7Gjrg2b/clientes/{{ customer.id }}/enderecos/criar" method="POST">
			
			<div class="grid-2-cols grid-form-row">
				<div>
					<label for="firstname" class="form-label">Nome *</label>
					<input type="text" id="firstname" name="firstname" class="form-control" value="{{ data.firstname|default(customer.firstname) }}" required />
					{% if errors.firstname %}<div class="invalid-feedback">{{ errors.firstname }}</div>{% endif %}
				</div>
				<div>
					<label for="lastname" class="form-label">Sobrenome *</label>
					<input type="text" id="lastname" name="lastname" class="form-control" value="{{ data.lastname|default(customer.lastname) }}" required />
					{% if errors.lastname %}<div class="invalid-feedback">{{ errors.lastname }}</div>{% endif %}
				</div>
			</div>

			<div class="grid-2-cols grid-form-row">
				<div>
					<label for="company" class="form-label">Empresa</label>
					<input type="text" id="company" name="company" class="form-control" value="{{ data.company|default('') }}" />
					{% if errors.company %}<div class="invalid-feedback">{{ errors.company }}</div>{% endif %}
				</div>
				<div>
					<label for="postcode" class="form-label">CEP *</label>
					<input type="text" id="postcode" name="postcode" class="form-control" value="{{ data.postcode|default('') }}" placeholder="00000000" required />
					{% if errors.postcode %}<div class="invalid-feedback">{{ errors.postcode }}</div>{% endif %}
				</div>
			</div>

			<div class="grid-2to1-cols grid-form-row">
				<div>
					<label for="address_1" class="form-label">Rua / Logradouro *</label>
					<input type="text" id="address_1" name="address_1" class="form-control" value="{{ data.address_1|default('') }}" required />
					{% if errors.address_1 %}<div class="invalid-feedback">{{ errors.address_1 }}</div>{% endif %}
				</div>
				<div>
					<label for="number" class="form-label">Número *</label>
					<input type="number" id="number" name="number" class="form-control" value="{{ data.number|default('') }}" required />
					{% if errors.number %}<div class="invalid-feedback">{{ errors.number }}</div>{% endif %}
				</div>
			</div>

			<div class="grid-2-cols grid-form-row">
				<div>
					<label for="address_2" class="form-label">Complemento</label>
					<input type="text" id="address_2" name="address_2" class="form-control" value="{{ data.address_2|default('') }}" />
					{% if errors.address_2 %}<div class="invalid-feedback">{{ errors.address_2 }}</div>{% endif %}
				</div>
				<div>
					<label for="neighborhood" class="form-label">Bairro *</label>
					<input type="text" id="neighborhood" name="neighborhood" class="form-control" value="{{ data.neighborhood|default('') }}" required />
					{% if errors.neighborhood %}<div class="invalid-feedback">{{ errors.neighborhood }}</div>{% endif %}
				</div>
			</div>

			<div class="grid-3-cols grid-form-row">
				<div>
					<label for="city" class="form-label">Cidade *</label>
					<input type="text" id="city" name="city" class="form-control" value="{{ data.city|default('') }}" required />
					{% if errors.city %}<div class="invalid-feedback">{{ errors.city }}</div>{% endif %}
				</div>
				<div>
					<label for="country_id" class="form-label">País *</label>
					<select id="country_id" name="country_id" class="form-control">
						{% for country in countries %}
							<option value="{{ country.id }}" {% if data.country_id|default(30) == country.id %}selected{% endif %}>{{ country.name }}</option>
						{% endfor %}
					</select>
					{% if errors.country_id %}<div class="invalid-feedback">{{ errors.country_id }}</div>{% endif %}
				</div>
				<div>
					<label for="zone_id" class="form-label">Estado (UF) *</label>
					<select id="zone_id" name="zone_id" class="form-control">
						<option value="">Selecione...</option>
						{% for zone in zones %}
							<option value="{{ zone.id }}" {% if data.zone_id|default(0) == zone.id %}selected{% endif %}>{{ zone.name }} ({{ zone.code }})</option>
						{% endfor %}
					</select>
					{% if errors.zone_id %}<div class="invalid-feedback">{{ errors.zone_id }}</div>{% endif %}
				</div>
			</div>

			<div style="margin-bottom: 2rem; display: flex; align-items: center; gap: 8px;">
				<input type="checkbox" id="default" name="default" value="1" {% if data.default %}checked{% endif %} style="width: 18px; height: 18px; accent-color: #3b82f6;" />
				<label for="default" style="font-weight: 600; color: #475569; font-size: 0.95rem; cursor: pointer; user-select: none;">Definir como Endereço Padrão</label>
			</div>

			<!-- Botões de Ação -->
			<div class="form-actions">
				<a href="/LPDHED2dC7Gjrg2b/clientes/{{ customer.id }}/editar?tab=addresses" class="btn btn-secondary">Cancelar</a>
				<button type="submit" class="btn btn-primary">
					<i class="fas fa-save"></i>
					<span>Salvar Endereço</span>
				</button>
			</div>
		</form>
	</div>
{% endblock %}
