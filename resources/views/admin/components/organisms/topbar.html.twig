<header class="topbar">
    <div>
        <strong>Painel de Controle</strong>
    </div>
    <div style="display: flex; align-items: center; gap: 12px;">
        <span>Olá, {{ logged_admin.name|default('Administrador') }}</span>
        <div class="topbar-avatar" style="width: 32px; height: 32px; border-radius: 50%; overflow: hidden; background: #e2e8f0; display: flex; align-items: center; justify-content: center;">
            {% if logged_admin.image %}
                {% if logged_admin.image starts with 'http' or logged_admin.image starts with '/' %}
                    <img src="{{ logged_admin.image }}" alt="{{ logged_admin.name|default('User') }}" style="width: 100%; height: 100%; object-fit: cover;">
                {% else %}
                    <img src="/image/{{ logged_admin.image }}" alt="{{ logged_admin.name|default('User') }}" style="width: 100%; height: 100%; object-fit: cover;">
                {% endif %}
            {% else %}
                <img src="/image/profile/default-user-profile.jpg" alt="{{ logged_admin.name|default('User') }}" style="width: 100%; height: 100%; object-fit: cover;">
            {% endif %}
        </div>
        <a href="{{ admin_path }}/logout" style="margin-left: 5px; color: #ef4444; text-decoration: none;">Sair</a>
    </div>
</header>
