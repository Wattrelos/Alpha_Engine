{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default((AdminLang.heading_title|default('Devoluções')) ~ ' | ' ~ (AdminLang.sidebar.title|default('Painel Administrativo'))) }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>{{ AdminLang.heading_title|default('Gerenciamento de Devoluções') }}</h2>
			<p class="page-subtitle">{{ AdminLang.text_subtitle|default('Acompanhe as solicitações de RMA (Retorno de Mercadoria Autorizada), mude status e defina resoluções.') }}</p>
		</div>
	</div>

	<!-- Stats Bar -->
	<div class="stats-bar-flex">
		<div class="card stat-card-clean">
			<div class="stat-icon-wrapper">
				<i class="fas fa-undo"></i>
			</div>
			<div>
				<h4 class="stat-title-sm">{{ AdminLang.text_total_cases|default('Total de Casos') }}</h4>
				<p class="stat-value-sm">{{ total }}</p>
			</div>
		</div>
	</div>

	<!-- Filtros de Busca -->
	<div class="card">
		<form method="GET" action="/LPDHED2dC7Gjrg2b/devolucoes">
			<div class="grid-filters-returns">
				
				<!-- ID da Devolução -->
				<div class="form-group mb-0">
					<label for="filter_return_id" class="form-label-sm">{{ AdminLang.entry_return_id|default('ID Devolução') }}</label>
					<input type="text" id="filter_return_id" name="filter_return_id" class="form-control" value="{{ filters.filter_return_id }}" placeholder="{{ AdminLang.placeholder_return_id|default('Ex: 12') }}" />
				</div>

				<!-- ID do Pedido -->
				<div class="form-group mb-0">
					<label for="filter_order_id" class="form-label-sm">{{ AdminLang.entry_order_id|default('ID do Pedido') }}</label>
					<input type="text" id="filter_order_id" name="filter_order_id" class="form-control" value="{{ filters.filter_order_id }}" placeholder="{{ AdminLang.placeholder_order_id|default('Ex: 123') }}" />
				</div>
 
				<!-- Cliente -->
				<div class="form-group mb-0">
					<label for="filter_customer" class="form-label-sm">{{ AdminLang.entry_customer|default('Cliente') }}</label>
					<input type="text" id="filter_customer" name="filter_customer" class="form-control" value="{{ filters.filter_customer }}" placeholder="{{ AdminLang.placeholder_customer|default('Nome do cliente...') }}" />
				</div>
 
				<!-- Status -->
				<div class="form-group mb-0">
					<label for="filter_return_status_id" class="form-label-sm">{{ AdminLang.entry_status|default('Status') }}</label>
					<select id="filter_return_status_id" name="filter_return_status_id" class="form-control">
						<option value="">-- {{ AdminLang.text_all|default('Todos') }} --</option>
						{% for s in statuses %}
							<option value="{{ s.id }}" {% if filters.filter_return_status_id == s.id %}selected{% endif %}>{{ s.name }}</option>
						{% endfor %}
					</select>
				</div>
 
				<!-- Data de Criação -->
				<div class="form-group mb-0">
					<label for="filter_date_added" class="form-label-sm">{{ AdminLang.entry_date_added|default('Data de Inclusão') }}</label>
					<input type="date" id="filter_date_added" name="filter_date_added" class="form-control" value="{{ filters.filter_date_added }}" />
				</div>

				<!-- Ações de Filtro -->
				<div class="d-flex gap-2">
					<a href="/LPDHED2dC7Gjrg2b/devolucoes" class="btn flex-1 btn-secondary">{{ AdminLang.button_clear|default('Limpar') }}</a>
					<button type="submit" class="btn btn-primary flex-1">
						<i class="fas fa-filter"></i>
						<span>{{ AdminLang.button_filter|default('Filtrar') }}</span>
					</button>
				</div>
 
			</div>
		</form>
	</div>

	<!-- Tabela de Solicitações -->
	<div class="card card-table mb-8">
		<div class="overflow-x-auto">
			<table class="table table-clean">
				<thead>
					<tr>
						<th class="col-id-80">{{ AdminLang.column_id|default('ID') }}</th>
						<th class="col-order-100">{{ AdminLang.column_order_id|default('Pedido nº') }}</th>
						<th>{{ AdminLang.column_customer|default('Cliente') }}</th>
						<th>{{ AdminLang.column_product|default('Produto') }}</th>
						<th>{{ AdminLang.column_model|default('Modelo') }}</th>
						<th>{{ AdminLang.column_status|default('Status') }}</th>
						<th>{{ AdminLang.column_date_added|default('Data de Inclusão') }}</th>
						<th class="text-right col-actions-100">{{ AdminLang.column_actions|default('Ações') }}</th>
					</tr>
				</thead>
				<tbody>
					{% if returns %}
						{% for ret in returns %}
							<tr>
								<td class="text-semibold text-dark">#{{ ret.return_id }}</td>
								<td class="text-semibold text-dark">
									<a href="/LPDHED2dC7Gjrg2b/pedidos/{{ ret.order_id }}" class="text-decoration-none icon-primary text-semibold">
										#{{ ret.order_id }}
									</a>
								</td>
								<td class="text-semibold text-dark">{{ ret.customer }}</td>
								<td>{{ ret.product }}</td>
								<td class="text-muted">{{ ret.model }}</td>
								<td>
									{% if 'Cancelado' in ret.status or 'Recusado' in ret.status or 'Rejeitado' in ret.status %}
										<span class="status-pill status-cancelled">{{ ret.status }}</span>
									{% elseif 'Completo' in ret.status or 'Finalizado' in ret.status or 'Concluído' in ret.status or 'Reembolsado' in ret.status %}
										<span class="status-pill status-approved">{{ ret.status }}</span>
									{% else %}
										<span class="status-pill status-pending">{{ ret.status }}</span>
									{% endif %}
								</td>
								<td>{{ ret.date_added }}</td>
								<td class="text-right">
									<div class="actions-wrapper">
										<a href="/LPDHED2dC7Gjrg2b/devolucoes/{{ ret.return_id }}" class="btn btn-primary btn-sm" title="{{ AdminLang.text_show_title|default('Visualizar Detalhes') }}">
											<i class="fas fa-eye"></i>
										</a>
									</div>
								</td>
							</tr>
						{% endfor %}
					{% else %}
						<tr>
							<td colspan="8" class="table-empty-cell">
								<i class="fas fa-undo table-empty-icon"></i>
								{{ AdminLang.text_empty|default('Nenhuma solicitação de devolução encontrada.') }}
							</td>
						</tr>
					{% endif %}
				</tbody>
			</table>
		</div>
		{% if total > limit %}
			<div class="table-pagination-bar">
				{% include 'components/molecules/pagination.html.twig' %}
			</div>
		{% endif %}
	</div>
{% endblock %}
