{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default((AdminLang.text_show_title|default('Detalhes da Devolução')) ~ ' | ' ~ (AdminLang.sidebar.title|default('Painel Administrativo'))) }}
{% endblock %}

{% block content %}
	<div class="page-header mb-8">
		<div>
			<div class="d-flex align-center gap-2 mb-2">
				<a href="/LPDHED2dC7Gjrg2b/devolucoes" class="text-muted text-decoration-none">{{ AdminLang.heading_title|default('Devoluções') }}</a>
				<span class="text-muted">/</span>
				<span class="text-semibold text-dark">{{ AdminLang.text_show_heading|default('Devolução') }} #{{ return.id }}</span>
			</div>
			<h2>{{ AdminLang.text_show_heading|default('Devolução') }} #{{ return.id }}</h2>
			<p class="page-subtitle">{{ AdminLang.text_show_subtitle|default('Visualização completa dos dados da solicitação de devolução, produto e histórico de status.') }}</p>
		</div>
		<div>
			<a href="/LPDHED2dC7Gjrg2b/devolucoes" class="btn btn-secondary">
				<i class="fas fa-arrow-left"></i> {{ AdminLang.button_back|default('Voltar') }}
			</a>
		</div>
	</div>

	<div id="alert-container">
		{% if success %}
			<div class="alert alert-success mb-4">
				<i class="fas fa-check-circle icon-mr-2"></i>
				{{ AdminLang.text_success_update|default('Solicitação de devolução atualizada com sucesso!') }}
			</div>
		{% endif %}
		{% if error == 'concurrency_conflict' %}
			<div class="alert alert-error mb-4">
				<i class="fas fa-exclamation-triangle icon-mr-2"></i>
				{{ AdminLang.text_error_concurrency|default('Não foi possível salvar! Outro administrador alterou esta devolução enquanto você lia a página. Por favor, tente novamente com os dados atualizados.') }}
			</div>
		{% endif %}
	</div>

	<!-- Grid de Informações Básicas e do Cliente -->
	<div class="grid-cards mb-4">
		
		<!-- Resumo da Devolução -->
		<div class="card mb-0">
			<h3 class="card-section-title">
				<i class="fas fa-undo icon-primary icon-mr-2"></i> {{ AdminLang.title_rma_summary|default('Resumo do RMA') }}
			</h3>
			<table class="table-info">
				<tr class="tr-info">
					<td class="text-muted">{{ AdminLang.column_id|default('ID') }} da Devolução:</td>
					<td class="text-semibold text-dark text-right">#{{ return.id }}</td>
				</tr>
				<tr class="tr-info">
					<td class="text-muted">{{ AdminLang.entry_order_id|default('ID do Pedido') }}:</td>
					<td class="text-semibold text-dark text-right">
						<a href="/LPDHED2dC7Gjrg2b/pedidos/{{ return.order_id }}" class="text-decoration-none icon-primary text-semibold">
							#{{ return.order_id }}
						</a>
					</td>
				</tr>
				<tr class="tr-info">
					<td class="text-muted">{{ AdminLang.entry_date_ordered|default('Data do Pedido') }}:</td>
					<td class="text-semibold text-dark text-right">{{ return.date_ordered|date('d/m/Y') }}</td>
				</tr>
				<tr class="tr-info">
					<td class="text-muted">{{ AdminLang.entry_opened|default('Abertura de Embalagem') }}:</td>
					<td class="text-semibold text-dark text-right">
						{% if return.opened %}
							{{ AdminLang.text_yes|default('Sim') }}
						{% else %}
							{{ AdminLang.text_no|default('Não') }}
						{% endif %}
					</td>
				</tr>
				<tr class="tr-info">
					<td class="text-muted">{{ AdminLang.entry_date_added_label|default('Data da Solicitação') }}:</td>
					<td class="text-semibold text-dark text-right">{{ return.date_added|date('d/m/Y H:i') }}</td>
				</tr>
				<tr class="tr-info">
					<td class="text-muted">{{ AdminLang.entry_date_modified|default('Última Modificação') }}:</td>
					<td id="info_date_modified" class="text-semibold text-dark text-right">{{ return.date_modified|date('d/m/Y H:i') }}</td>
				</tr>
				<tr class="tr-info-last">
					<td class="text-muted">{{ AdminLang.entry_version|default('Versão do Registro') }}:</td>
					<td id="info_version" class="text-semibold text-dark text-right">#{{ return.version }}</td>
				</tr>
			</table>
		</div>

		<!-- Dados do Cliente -->
		<div class="card mb-0">
			<h3 class="card-section-title">
				<i class="fas fa-user icon-primary icon-mr-2"></i> {{ AdminLang.title_customer_info|default('Informações do Cliente') }}
			</h3>
			<table class="table-info">
				<tr class="tr-info">
					<td class="text-muted">{{ AdminLang.entry_firstname_label|default('Nome Completo') }}:</td>
					<td class="text-semibold text-dark text-right">{{ return.firstname }} {{ return.lastname }}</td>
				</tr>
				<tr class="tr-info">
					<td class="text-muted">{{ AdminLang.entry_email|default('E-mail') }}:</td>
					<td class="text-semibold text-dark text-right">
						<a href="mailto:{{ return.email }}" class="text-decoration-none icon-primary">{{ return.email }}</a>
					</td>
				</tr>
				<tr class="tr-info">
					<td class="text-muted">{{ AdminLang.entry_telephone|default('Telefone') }}:</td>
					<td class="text-semibold text-dark text-right">{{ return.telephone }}</td>
				</tr>
				{% if return.cpf_cnpj %}
				<tr class="tr-info">
					<td class="text-muted">{{ AdminLang.entry_cpf_cnpj|default('CPF / CNPJ') }}:</td>
					<td class="text-semibold text-dark text-right">{{ return.cpf_cnpj }}</td>
				</tr>
				{% endif %}
				{% if return.persontype %}
				<tr class="tr-info-last">
					<td class="text-muted">{{ AdminLang.entry_persontype|default('Tipo de Pessoa') }}:</td>
					<td class="text-semibold text-dark text-right">
						{% if return.persontype == 'F' %}
							{{ AdminLang.entry_persontype_f|default('Física') }}
						{% else %}
							{{ AdminLang.entry_persontype_j|default('Jurídica') }}
						{% endif %}
					</td>
				</tr>
				{% endif %}
			</table>
		</div>

	</div>

	<!-- Informações do Produto Devolvido -->
	<div class="card mb-4">
		<h3 class="card-section-title">
			<i class="fas fa-box-open icon-primary icon-mr-2"></i> {{ AdminLang.title_product_details|default('Detalhes do Produto & Motivo') }}
		</h3>
		<div class="grid-details mb-4">
			<div>
				<span class="detail-label">{{ AdminLang.entry_product|default('Produto') }}</span>
				<strong class="text-dark text-sm">{{ return.product }}</strong>
			</div>
			<div>
				<span class="detail-label">{{ AdminLang.entry_model_label|default('Modelo') }}</span>
				<span class="detail-value-pill">{{ return.model }}</span>
			</div>
			<div>
				<span class="detail-label">{{ AdminLang.entry_quantity|default('Quantidade') }}</span>
				<strong class="text-dark text-sm">{{ return.quantity }}</strong>
			</div>
			<div>
				<span class="detail-label">{{ AdminLang.entry_reason|default('Motivo do Retorno') }}</span>
				<span class="text-warning text-semibold text-sm">{{ return.reason_name }}</span>
			</div>
			<div>
				<span class="detail-label">{{ AdminLang.entry_action|default('Ação Resolutiva') }}</span>
				<span id="current_action_name" class="text-success text-semibold text-sm">{{ return.action_name|default(AdminLang.text_to_define|default('A definir')) }}</span>
			</div>
			<div>
				<span class="detail-label">{{ AdminLang.entry_status|default('Status Atual') }}</span>
				<span id="current_status_pill" class="status-pill {% if 'Cancelado' in return.status_name or 'Recusado' in return.status_name or 'Rejeitado' in return.status_name %}status-cancelled{% elseif 'Completo' in return.status_name or 'Reembolsado' in return.status_name %}status-approved{% else %}status-pending{% endif %} text-xs">
					{{ return.status_name }}
				</span>
			</div>
		</div>

		{% if return.comment %}
			<div class="border-top-dashed">
				<span class="detail-label">{{ AdminLang.entry_customer_comment|default('Comentários do Cliente') }}</span>
				<div class="comment-quote-box">
					"{{ return.comment }}"
				</div>
			</div>
		{% endif %}
	</div>

	<!-- Timeline e Atualização de Status -->
	<div class="grid-timeline-layout mb-8">
		
		<!-- Timeline do Histórico -->
		<div class="card mb-0">
			<h3 class="card-section-title">
				<i class="fas fa-history icon-primary icon-mr-2"></i> {{ AdminLang.title_timeline|default('Linha do Tempo da Devolução') }}
			</h3>
			<div class="activity-list activity-list-timeline">
				{% if histories %}
					{% for history in histories %}
						<div class="activity-item activity-item-border">
							<div class="d-flex justify-between align-center w-100">
								<div>
									<span class="status-pill {% if 'Cancelado' in history.status or 'Recusado' in history.status or 'Rejeitado' in history.status %}status-cancelled{% elseif 'Completo' in history.status or 'Reembolsado' in history.status %}status-approved{% else %}status-pending{% endif %} text-xs">
										{{ history.status }}
									</span>
									<span class="activity-time-info">{{ history.date_added|date('d/m/Y H:i') }}</span>
								</div>
								{% if history.notify %}
									<span class="status-pill status-notify">
										<i class="fas fa-envelope"></i> {{ AdminLang.text_client_notified|default('Cliente Notificado') }}
									</span>
								{% endif %}
							</div>
							{% if history.comment %}
								<div class="activity-comment-box">
									"{{ history.comment }}"
								</div>
							{% endif %}
						</div>
					{% endfor %}
				{% else %}
					<p class="text-muted text-sm text-center p-4">
						{{ AdminLang.text_no_history|default('Nenhuma alteração registrada ainda no histórico.') }}
					</p>
				{% endif %}
			</div>
		</div>

		<!-- Formulário de Alteração de Status / Ação -->
		<div class="card mb-0">
			<h3 class="card-section-title">
				<i class="fas fa-edit icon-primary icon-mr-2"></i> {{ AdminLang.title_update_request|default('Atualizar Solicitação') }}
			</h3>
			<form id="update-status-form" action="/LPDHED2dC7Gjrg2b/devolucoes/{{ return.id }}/status" method="POST">
				{% if csrf %}
					<input type="hidden" name="{{ csrf.keys.name }}" value="{{ csrf.name }}">
					<input type="hidden" name="{{ csrf.keys.value }}" value="{{ csrf.value }}">
				{% endif %}
				<input type="hidden" name="version" id="return_version" value="{{ return.version }}">
				
				<!-- Novo Status -->
				<div class="form-group">
					<label for="return_status_id" class="form-label">{{ AdminLang.entry_change_status|default('Alterar Status') }}</label>
					<select name="return_status_id" id="return_status_id" class="form-control" required>
						<option value="">{{ AdminLang.placeholder_status|default('-- Selecione o Status --') }}</option>
						{% for status in statuses %}
							<option value="{{ status.id }}" {% if return.return_status_id == status.id %}selected{% endif %}>{{ status.name }}</option>
						{% endfor %}
					</select>
				</div>

				<!-- Ação Resolutiva -->
				<div class="form-group">
					<label for="return_action_id" class="form-label">{{ AdminLang.entry_action_resolution|default('Ação / Resolução') }}</label>
					<select name="return_action_id" id="return_action_id" class="form-control" required>
						<option value="">{{ AdminLang.placeholder_action|default('-- Selecione a Ação --') }}</option>
						{% for action in actions %}
							<option value="{{ action.id }}" {% if return.return_action_id == action.id %}selected{% endif %}>{{ action.name }}</option>
						{% endfor %}
					</select>
				</div>

				<!-- Comentário -->
				<div class="form-group">
					<label for="comment" class="form-label">{{ AdminLang.entry_observation|default('Comentário / Observação') }}</label>
					<textarea name="comment" id="comment" class="form-control resize-vertical" rows="4" placeholder="{{ AdminLang.placeholder_observation|default('Insira observações internas ou detalhes para o cliente...') }}"></textarea>
				</div>

				<!-- Notificar -->
				<div class="form-group d-flex align-center gap-2 mb-6">
					<input type="checkbox" name="notify" id="notify" value="1" class="form-checkbox">
					<label for="notify" class="form-checkbox-label-sm">{{ AdminLang.entry_notify_client|default('Notificar Cliente por E-mail') }}</label>
				</div>

				<button type="submit" class="btn btn-primary w-100">
					<i class="fas fa-save"></i> {{ AdminLang.button_save_changes|default('Gravar Alterações') }}
				</button>
			</form>
		</div>

	</div>

	<script src="/js/updateReturnStatus.js"></script>
	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const form = document.getElementById('update-status-form');
			if (form) {
				form.addEventListener('submit', async (e) => {
					e.preventDefault();
					const id = "{{ return.id }}";
					const statusSelect = document.getElementById('return_status_id');
					const actionSelect = document.getElementById('return_action_id');
					const commentTextarea = document.getElementById('comment');
					const notifyCheckbox = document.getElementById('notify');
					const versionInput = document.getElementById('return_version');

					const novoStatus = statusSelect.value;
					const acaoResolutiva = actionSelect.value;
					const comment = commentTextarea.value;
					const notify = notifyCheckbox.checked;
					const versaoAtual = versionInput.value;

					await updateReturnStatus(id, {
						return_status_id: novoStatus,
						return_action_id: acaoResolutiva,
						comment: comment,
						notify: notify,
						version: versaoAtual
					});
				});
			}
		});
	</script>
{% endblock %}
