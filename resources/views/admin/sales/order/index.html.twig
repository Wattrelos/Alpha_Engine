{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default(AdminLang.heading_title ~ ' | ' ~ AdminLang.text_admin_panel) }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>{{ AdminLang.heading_title }}</h2>
			<p class="page-subtitle">{{ AdminLang.text_subtitle }}</p>
		</div>
	</div>

	<!-- Painel de Filtros de Busca -->
	<div class="card">
		<form method="GET" action="/LPDHED2dC7Gjrg2b/pedidos">
			<div class="grid-filters-order">
				
				<!-- ID do Pedido -->
				<div class="form-group mb-0">
					<label for="filter_order_id" class="form-label-sm">{{ AdminLang.entry_order_id }}</label>
					<input type="text" id="filter_order_id" name="filter_order_id" class="form-control" value="{{ filters.filter_order_id }}" placeholder="{{ AdminLang.placeholder_order_id }}" />
				</div>
 
				<!-- Cliente -->
				<div class="form-group mb-0">
					<label for="filter_customer" class="form-label-sm">{{ AdminLang.entry_customer }}</label>
					<input type="text" id="filter_customer" name="filter_customer" class="form-control" value="{{ filters.filter_customer }}" placeholder="{{ AdminLang.placeholder_customer }}" />
				</div>
 
				<!-- Status -->
				<div class="form-group mb-0">
					<label for="filter_order_status_id" class="form-label-sm">{{ AdminLang.entry_status }}</label>
					<select id="filter_order_status_id" name="filter_order_status_id" class="form-control">
						<option value="">{{ AdminLang.text_all }}</option>
						{% for s in statuses %}
							<option value="{{ s.id }}" {% if filters.filter_order_status_id == s.id %}selected{% endif %}>{{ s.name }}</option>
						{% endfor %}
					</select>
				</div>
 
				<!-- Total -->
				<div class="form-group mb-0">
					<label for="filter_total" class="form-label-sm">{{ AdminLang.entry_total }}</label>
					<input type="text" id="filter_total" name="filter_total" class="form-control" value="{{ filters.filter_total }}" placeholder="{{ AdminLang.placeholder_total }}" />
				</div>

				<!-- Data de Criação -->
				<div class="form-group mb-0">
					<label for="filter_date_added" class="form-label-sm">{{ AdminLang.entry_date_added }}</label>
					<input type="date" id="filter_date_added" name="filter_date_added" class="form-control" value="{{ filters.filter_date_added }}" />
				</div>

				<!-- Ações -->
				<div class="d-flex gap-2">
					<a href="/LPDHED2dC7Gjrg2b/pedidos" class="btn flex-1 btn-secondary">{{ AdminLang.button_clear }}</a>
					<button type="submit" class="btn btn-primary flex-1">
						<i class="fas fa-filter"></i>
						<span>{{ AdminLang.button_filter }}</span>
					</button>
				</div>
 
			</div>
		</form>
	</div>

	<div class="card card-table">
		<div class="overflow-x-auto">
			<table class="table table-clean">
				<thead>
					<tr>
						<th class="w-80">{{ AdminLang.column_id }}</th>
						<th>{{ AdminLang.column_customer }}</th>
						<th>{{ AdminLang.column_status }}</th>
						<th>{{ AdminLang.column_total }}</th>
						<th>{{ AdminLang.column_date_added }}</th>
						<th>{{ AdminLang.column_date_modified }}</th>
						<th class="text-right w-150">{{ AdminLang.column_actions }}</th>
					</tr>
				</thead>
				<tbody>
					{% if orders %}
						{% for order in orders %}
							<tr>
								<td class="text-semibold text-dark">#{{ order.order_id }}</td>
								<td class="text-semibold text-dark">{{ order.customer }}</td>
								<td>
									{% if 'Cancelado' in order.status or 'Nulled' in order.status or 'Reprovado' in order.status %}
										<span class="status-pill status-cancelled">{{ order.status }}</span>
									{% elseif 'Completo' in order.status or 'Entregue' in order.status or 'Enviado' in order.status or 'Pago' in order.status or 'Processamento' in order.status %}
										<span class="status-pill status-approved">{{ order.status }}</span>
									{% else %}
										<span class="status-pill status-pending">{{ order.status }}</span>
									{% endif %}
								</td>
								<td class="text-semibold text-dark">{{ order.total }}</td>
								<td>{{ order.date_added }}</td>
								<td>{{ order.date_modified }}</td>
								<td class="text-right">
									<div class="actions-wrapper">
										<a href="/LPDHED2dC7Gjrg2b/pedidos/{{ order.order_id }}" class="btn btn-primary btn-sm" title="{{ AdminLang.button_view }}">
											<i class="fas fa-eye"></i>
										</a>
										<a href="/LPDHED2dC7Gjrg2b/pedidos/{{ order.order_id }}/fatura" target="_blank" class="btn btn-secondary btn-sm" title="{{ AdminLang.button_invoice }}">
											<i class="fas fa-print"></i>
										</a>
									</div>
								</td>
							</tr>
						{% endfor %}
					{% else %}
						<tr>
							<td colspan="7" class="table-empty-cell">
								<i class="fas fa-shopping-basket table-empty-icon"></i>
								{{ AdminLang.text_empty }}
							</td>
						</tr>
					{% endif %}
				</tbody>
			</table>
		</div>
		{% if total > limit %}
			<div class="pagination-footer">
				{% include 'components/molecules/pagination.html.twig' %}
			</div>
		{% endif %}
	</div>
{% endblock %}
