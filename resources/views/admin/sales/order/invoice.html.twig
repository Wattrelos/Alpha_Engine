<!DOCTYPE html>
<html lang="pt-BR">
<head>
	<meta charset="UTF-8">
	<title>{{ title }}</title>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
	<style>
		:root {
			--color-text-main: #1e293b;
			--color-text-muted: #64748b;
			--color-border: #e2e8f0;
			--color-primary: #3b82f6;
		}
		
		* {
			box-sizing: border-box;
		}

		body {
			font-family: 'Inter', sans-serif;
			color: var(--color-text-main);
			line-height: 1.5;
			margin: 0;
			padding: 20px;
			background: #f8fafc;
		}

		.invoice-container {
			max-width: 800px;
			margin: 0 auto;
			background: #ffffff;
			padding: 40px;
			border: 1px solid var(--color-border);
			border-radius: 8px;
			box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
		}

		.header-row {
			display: flex;
			justify-content: space-between;
			align-items: flex-start;
			border-bottom: 2px solid var(--color-border);
			padding-bottom: 20px;
			margin-bottom: 30px;
		}

		.store-info h1 {
			margin: 0 0 5px 0;
			font-size: 1.5rem;
			color: var(--color-primary);
			font-weight: 700;
		}

		.store-info p {
			margin: 2px 0;
			font-size: 0.85rem;
			color: var(--color-text-muted);
		}

		.invoice-meta {
			text-align: right;
		}

		.invoice-meta h2 {
			margin: 0 0 5px 0;
			font-size: 1.75rem;
			font-weight: 700;
		}

		.invoice-meta p {
			margin: 2px 0;
			font-size: 0.85rem;
			color: var(--color-text-muted);
		}

		.address-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 20px;
			margin-bottom: 30px;
		}

		.address-box {
			border: 1px solid var(--color-border);
			border-radius: 6px;
			padding: 15px;
			font-size: 0.85rem;
		}

		.address-box h3 {
			margin: 0 0 10px 0;
			font-size: 0.95rem;
			border-bottom: 1px solid var(--color-border);
			padding-bottom: 5px;
			color: var(--color-text-main);
		}

		.address-box p {
			margin: 3px 0;
		}

		.products-table {
			width: 100%;
			border-collapse: collapse;
			margin-bottom: 30px;
		}

		.products-table th {
			background: #f1f5f9;
			border-bottom: 2px solid var(--color-border);
			padding: 10px;
			font-size: 0.85rem;
			font-weight: 600;
			text-align: left;
			color: var(--color-text-muted);
		}

		.products-table td {
			padding: 12px 10px;
			border-bottom: 1px solid var(--color-border);
			font-size: 0.85rem;
		}

		.text-right {
			text-align: right !important;
		}

		.totals-section {
			display: flex;
			justify-content: flex-end;
		}

		.totals-table {
			width: 300px;
			border-collapse: collapse;
		}

		.totals-table td {
			padding: 8px 10px;
			font-size: 0.85rem;
		}

		.totals-table tr:not(:last-child) td {
			border-bottom: 1px solid var(--color-border);
		}

		.totals-table tr:last-child td {
			font-size: 1.1rem;
			font-weight: 700;
			color: var(--color-primary);
		}

		.no-print-bar {
			max-width: 800px;
			margin: 0 auto 20px auto;
			display: flex;
			justify-content: flex-end;
			gap: 10px;
		}

		.btn {
			padding: 8px 16px;
			border-radius: 4px;
			font-weight: 600;
			font-size: 0.85rem;
			cursor: pointer;
			text-decoration: none;
			display: inline-flex;
			align-items: center;
			gap: 8px;
			border: 1px solid transparent;
		}

		.btn-primary {
			background: var(--color-primary);
			color: white;
		}

		.btn-secondary {
			background: #e2e8f0;
			color: var(--color-text-main);
		}

		@media print {
			body {
				background: #ffffff;
				padding: 0;
			}
			.invoice-container {
				border: none;
				box-shadow: none;
				padding: 0;
			}
			.no-print {
				display: none !important;
			}
		}
	</style>
</head>
<body>

	<div class="no-print-bar no-print">
		<button onclick="window.close();" class="btn btn-secondary">
			<i class="fas fa-times"></i> Fechar Janela
		</button>
		<button onclick="window.print();" class="btn btn-primary">
			<i class="fas fa-print"></i> Imprimir Fatura
		</button>
	</div>

	<div class="invoice-container">
		
		<!-- Cabeçalho da Fatura -->
		<div class="header-row">
			<div class="store-info">
				<h1>{{ store.name }}</h1>
				{% if store.address %}<p>{{ store.address|nl2br }}</p>{% endif %}
				<p>Telefone: {{ store.telephone }}</p>
				<p>E-mail: {{ store.email }}</p>
				<p>Site: {{ store.url }}</p>
			</div>
			<div class="invoice-meta">
				<h2>FATURA</h2>
				<p><strong>Pedido:</strong> #{{ order.id }}</p>
				<p><strong>Data:</strong> {{ order.date_added|date('d/m/Y H:i') }}</p>
				<p><strong>Status:</strong> {{ order.payment_method }}</p>
			</div>
		</div>

		<!-- Grid de Endereços -->
		<div class="address-grid">
			
			<!-- Dados do Cliente & Cobrança -->
			<div class="address-box">
				<h3>Cobrar De</h3>
				<p><strong>{{ order.payment_firstname }} {{ order.payment_lastname }}</strong></p>
				{% if order.payment_company %}<p>{{ order.payment_company }}</p>{% endif %}
				<p>{{ order.payment_street }}, {{ order.payment_number }}</p>
				{% if order.payment_complement %}<p>{{ order.payment_complement }}</p>{% endif %}
				<p>{{ order.payment_district }}</p>
				<p>{{ order.payment_city }} - CEP: {{ order.payment_postcode }}</p>
				<p>{{ order.payment_zone }}, {{ order.payment_country }}</p>
				<p style="margin-top: 10px;"><strong>E-mail:</strong> {{ order.email }}</p>
				<p><strong>Telefone:</strong> {{ order.telephone }}</p>
			</div>

			<!-- Dados de Entrega -->
			<div class="address-box">
				<h3>Enviar Para</h3>
				<p><strong>{{ order.shipping_firstname }} {{ order.shipping_lastname }}</strong></p>
				{% if order.shipping_company %}<p>{{ order.shipping_company }}</p>{% endif %}
				<p>{{ order.shipping_street }}, {{ order.shipping_number }}</p>
				{% if order.shipping_complement %}<p>{{ order.shipping_complement }}</p>{% endif %}
				<p>{{ order.shipping_district }}</p>
				<p>{{ order.shipping_city }} - CEP: {{ order.shipping_postcode }}</p>
				<p>{{ order.shipping_zone }}, {{ order.shipping_country }}</p>
				<p style="margin-top: 10px;"><strong>Método de Envio:</strong> {{ order.shipping_method }}</p>
			</div>

		</div>

		<!-- Tabela de Produtos -->
		<table class="products-table">
			<thead>
				<tr>
					<th>Descrição do Produto</th>
					<th>Modelo</th>
					<th class="text-right" style="width: 80px;">Qtd</th>
					<th class="text-right" style="width: 120px;">Unitário</th>
					<th class="text-right" style="width: 120px;">Total</th>
				</tr>
			</thead>
			<tbody>
				{% for product in products %}
					<tr>
						<td>
							<strong>{{ product.name }}</strong>
							{% if product.options %}
								<div style="font-size: 0.75rem; color: var(--color-text-muted); margin-top: 3px;">
									{% for opt in product.options %}
										- {{ opt.name }}: {{ opt.value }}<br>
									{% endfor %}
								</div>
							{% endif %}
						</td>
						<td>{{ product.model }}</td>
						<td class="text-right">{{ product.quantity }}</td>
						<td class="text-right">{{ product.price }}</td>
						<td class="text-right" style="font-weight: 500;">{{ product.total }}</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>

		<!-- Resumo de Totais -->
		<div class="totals-section">
			<table class="totals-table">
				<tbody>
					{% for total in totals %}
						<tr>
							<td class="text-muted">{{ total.title }}:</td>
							<td class="text-right text-semibold">
								R$ {{ total.value|number_format(2, ',', '.') }}
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

	</div>

</body>
</html>
