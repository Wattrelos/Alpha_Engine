<!DOCTYPE html>
<html lang="{{ admin_lang_code|default('pt-BR') }}">
<head>
	<meta charset="UTF-8">
	<title>{{ title }}</title>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
	<link rel="stylesheet" href="/css/admin/admin.css">
</head>
<body class="invoice-body">

	<div class="no-print-bar no-print">
		<button onclick="window.close();" class="btn btn-secondary">
			<i class="fas fa-times"></i> {{ AdminLang.button_close }}
		</button>
		<button onclick="window.print();" class="btn btn-primary">
			<i class="fas fa-print"></i> {{ AdminLang.button_print }}
		</button>
	</div>

	<div class="invoice-container">
		
		<!-- Cabeçalho da Fatura -->
		<div class="header-row">
			<div class="store-info">
				<h1>{{ store.name }}</h1>
				{% if store.address %}<p>{{ store.address|nl2br }}</p>{% endif %}
				<p>{{ AdminLang.text_telephone_label }} {{ store.telephone }}</p>
				<p>{{ AdminLang.text_email_label }} {{ store.email }}</p>
				<p>{{ AdminLang.text_site_label }} {{ store.url }}</p>
			</div>
			<div class="invoice-meta">
				<h2>{{ AdminLang.text_invoice_title }}</h2>
				<p><strong>{{ AdminLang.text_order_label }}</strong> #{{ order.id }}</p>
				<p><strong>{{ AdminLang.text_date_label }}</strong> {{ order.date_added|date('d/m/Y H:i') }}</p>
				<p><strong>{{ AdminLang.text_status_label }}</strong> {{ order.payment_method }}</p>
			</div>
		</div>

		<!-- Grid de Endereços -->
		<div class="address-grid">
			
			<!-- Dados do Cliente & Cobrança -->
			<div class="address-box">
				<h3>{{ AdminLang.text_bill_to }}</h3>
				<p><strong>{{ order.payment_firstname }} {{ order.payment_lastname }}</strong></p>
				{% if order.payment_company %}<p>{{ order.payment_company }}</p>{% endif %}
				<p>{{ order.payment_street }}, {{ order.payment_number }}</p>
				{% if order.payment_complement %}<p>{{ order.payment_complement }}</p>{% endif %}
				<p>{{ order.payment_district }}</p>
				<p>{{ order.payment_city }} - CEP: {{ order.payment_postcode }}</p>
				<p>{{ order.payment_zone }}, {{ order.payment_country }}</p>
				<p class="mt-3"><strong>{{ AdminLang.text_email_label }}</strong> {{ order.email }}</p>
				<p><strong>{{ AdminLang.text_telephone_label }}</strong> {{ order.telephone }}</p>
			</div>

			<!-- Dados de Entrega -->
			<div class="address-box">
				<h3>{{ AdminLang.text_ship_to }}</h3>
				<p><strong>{{ order.shipping_firstname }} {{ order.shipping_lastname }}</strong></p>
				{% if order.shipping_company %}<p>{{ order.shipping_company }}</p>{% endif %}
				<p>{{ order.shipping_street }}, {{ order.shipping_number }}</p>
				{% if order.shipping_complement %}<p>{{ order.shipping_complement }}</p>{% endif %}
				<p>{{ order.shipping_district }}</p>
				<p>{{ order.shipping_city }} - CEP: {{ order.shipping_postcode }}</p>
				<p>{{ order.shipping_zone }}, {{ order.shipping_country }}</p>
				<p class="mt-3"><strong>{{ AdminLang.text_shipping_method_label }}</strong> {{ order.shipping_method }}</p>
			</div>

		</div>

		<!-- Tabela de Produtos -->
		<table class="products-table">
			<thead>
				<tr>
					<th>{{ AdminLang.column_description }}</th>
					<th>{{ AdminLang.column_model }}</th>
					<th class="text-right w-80">{{ AdminLang.column_qty }}</th>
					<th class="text-right w-120">{{ AdminLang.column_unit_price }}</th>
					<th class="text-right w-120">{{ AdminLang.column_total }}</th>
				</tr>
			</thead>
			<tbody>
				{% for product in products %}
					<tr>
						<td>
							<strong>{{ product.name }}</strong>
							{% if product.options %}
								<div class="product-options-details">
									{% for opt in product.options %}
										- {{ opt.name }}: {{ opt.value }}<br>
									{% endfor %}
								</div>
							{% endif %}
						</td>
						<td>{{ product.model }}</td>
						<td class="text-right">{{ product.quantity }}</td>
						<td class="text-right">{{ product.price }}</td>
						<td class="text-right text-medium">{{ product.total }}</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>

		<!-- Resumo de Totais -->
		<div class="totals-section">
			<table class="totals-table">
				<tbody>
					{% for total in totals %}
						<tr>
							<td class="text-muted">{{ total.title }}:</td>
							<td class="text-right text-semibold">
								R$ {{ total.value|number_format(2, ',', '.') }}
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

	</div>

</body>
</html>
