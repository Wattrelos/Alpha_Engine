{% extends 'admin/layouts/base.html.twig' %}

{% block title %}
	{{ title|default((AdminLang.heading_title|default('Configurações da Loja')) ~ ' | ' ~ (AdminLang.sidebar.title|default('Painel Administrativo'))) }}
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h2>{{ AdminLang.heading_title|default('Configurações da Loja') }}</h2>
			<p class="page-subtitle">{{ AdminLang.text_subtitle|default('Gerencie as informações gerais, metadados SEO, imagens e redes sociais da sua loja.') }}</p>
		</div>
	</div>

	{% if success %}
		<div class="alert-success-custom">
			{{ success }}
		</div>
	{% endif %}

	{% if error %}
		<div class="alert alert-danger">
			{{ error }}
		</div>
	{% endif %}

	{% if errors.warning %}
		<div class="alert alert-danger">
			{{ errors.warning }}
		</div>
	{% endif %}

	<!-- Navegação por Abas -->
	<div class="tab-nav">
		<button onclick="switchTab('general')" id="tab-btn-general" class="tab-button">
			<i class="fas fa-store"></i>
			<span>{{ AdminLang.tab_general|default('Geral') }}</span>
		</button>
		<button onclick="switchTab('seo')" id="tab-btn-seo" class="tab-button">
			<i class="fas fa-search"></i>
			<span>{{ AdminLang.tab_seo|default('Metadados (SEO)') }}</span>
		</button>
		<button onclick="switchTab('images')" id="tab-btn-images" class="tab-button">
			<i class="fas fa-images"></i>
			<span>{{ AdminLang.tab_images|default('Imagens') }}</span>
		</button>
		<button onclick="switchTab('social')" id="tab-btn-social" class="tab-button">
			<i class="fas fa-share-alt"></i>
			<span>{{ AdminLang.tab_social|default('Redes Sociais') }}</span>
		</button>
	</div>

	<div class="card card-large">
		<form action="/LPDHED2dC7Gjrg2b/configuracoes" method="POST" enctype="multipart/form-data">
			{% if csrf %}
				<input type="hidden" name="{{ csrf.keys.name }}" value="{{ csrf.name }}">
				<input type="hidden" name="{{ csrf.keys.value }}" value="{{ csrf.value }}">
			{% endif %}

			<!-- 1. Aba: Geral -->
			<div id="tab-content-general" class="tab-content" style="display: none;">
				<h3 class="section-title">{{ AdminLang.title_general|default('Informações da Loja') }}</h3>
				
				<div class="grid-2-cols grid-form-row">
					<div>
						<label for="config_name" class="form-label">{{ AdminLang.entry_name|default('Nome da Loja') }} *</label>
						<input type="text" id="config_name" name="config_name" class="form-control" value="{{ settings.config_name }}" required />
						{% if errors.config_name %}<div class="invalid-feedback">{{ errors.config_name }}</div>{% endif %}
					</div>
					<div>
						<label for="config_owner" class="form-label">{{ AdminLang.entry_owner|default('Proprietário da Loja') }} *</label>
						<input type="text" id="config_owner" name="config_owner" class="form-control" value="{{ settings.config_owner }}" required />
						{% if errors.config_owner %}<div class="invalid-feedback">{{ errors.config_owner }}</div>{% endif %}
					</div>
				</div>

				<div class="grid-2-cols grid-form-row">
					<div>
						<label for="config_email" class="form-label">{{ AdminLang.entry_email|default('E-mail de Contato') }} *</label>
						<input type="email" id="config_email" name="config_email" class="form-control" value="{{ settings.config_email }}" required />
						{% if errors.config_email %}<div class="invalid-feedback">{{ errors.config_email }}</div>{% endif %}
					</div>
					<div>
						<label for="config_telephone" class="form-label">{{ AdminLang.entry_telephone|default('Telefone de Contato') }} *</label>
						<input type="text" id="config_telephone" name="config_telephone" class="form-control" value="{{ settings.config_telephone }}" required />
						{% if errors.config_telephone %}<div class="invalid-feedback">{{ errors.config_telephone }}</div>{% endif %}
					</div>
				</div>

				<div class="mb-6">
					<label for="config_address" class="form-label">{{ AdminLang.entry_address|default('Endereço Físico') }} *</label>
					<textarea id="config_address" name="config_address" class="form-control" required>{{ settings.config_address }}</textarea>
					{% if errors.config_address %}<div class="invalid-feedback">{{ errors.config_address }}</div>{% endif %}
				</div>
			</div>

			<!-- 2. Aba: SEO -->
			<div id="tab-content-seo" class="tab-content" style="display: none;">
				<h3 class="section-title">{{ AdminLang.title_seo|default('Metadados da Loja (SEO)') }}</h3>
				
				<div class="mb-6">
					<label for="meta_title" class="form-label">{{ AdminLang.entry_meta_title|default('Meta Título') }} *</label>
					<input type="text" id="meta_title" name="meta_title" class="form-control" value="{{ meta_title }}" required />
					{% if errors.meta_title %}<div class="invalid-feedback">{{ errors.meta_title }}</div>{% endif %}
				</div>

				<div class="mb-6">
					<label for="meta_description" class="form-label">{{ AdminLang.entry_meta_description|default('Meta Descrição') }}</label>
					<textarea id="meta_description" name="meta_description" class="form-control">{{ meta_description }}</textarea>
				</div>

				<div class="mb-6">
					<label for="meta_keyword" class="form-label">{{ AdminLang.entry_meta_keyword|default('Meta Palavras-chave') }}</label>
					<textarea id="meta_keyword" name="meta_keyword" class="form-control" placeholder="{{ AdminLang.placeholder_meta_keyword|default('Separadas por vírgula...') }}">{{ meta_keyword }}</textarea>
				</div>
			</div>

			<!-- 3. Aba: Imagens -->
			<div id="tab-content-images" class="tab-content" style="display: none;">
				<h3 class="section-title">{{ AdminLang.title_images|default('Imagens e Logotipos') }}</h3>
				
				<div class="grid-images">
					<!-- Logotipo -->
					<div class="image-upload-card">
						<div class="text-center w-100">
							<h4 class="image-upload-title">{{ AdminLang.entry_logo|default('Logotipo da Loja') }}</h4>
							<div class="image-preview-container">
								{% if logo_url %}
									<img src="{{ logo_url }}" alt="Logotipo Atual" class="image-preview-logo" id="logo-preview" />
								{% else %}
									<span class="image-preview-placeholder" id="logo-preview-placeholder">{{ AdminLang.text_no_logo|default('Nenhum logotipo enviado') }}</span>
								{% endif %}
							</div>
						</div>
						<div class="w-100">
							<input type="file" id="config_logo" name="config_logo" accept="image/*" class="d-none" onchange="previewImage(this, 'logo-preview')" />
							<label for="config_logo" class="btn btn-primary btn-upload">
								<i class="fas fa-upload"></i> {{ AdminLang.button_upload_logo|default('Enviar Logotipo') }}
							</label>
							{% if settings.config_logo %}
								<div class="remove-image-wrapper">
									<input type="checkbox" name="remove_logo" id="remove_logo" value="1" class="remove-image-checkbox" />
									<label for="remove_logo" class="remove-image-label">{{ AdminLang.text_remove_logo|default('Remover logotipo atual') }}</label>
								</div>
							{% endif %}
							{% if errors.config_logo %}<div class="invalid-feedback">{{ errors.config_logo }}</div>{% endif %}
						</div>
					</div>

					<!-- Favicon / Ícone -->
					<div class="image-upload-card">
						<div class="text-center w-100">
							<h4 class="image-upload-title">{{ AdminLang.entry_icon|default('Ícone da Loja (Favicon)') }}</h4>
							<div class="image-preview-container">
								{% if icon_url %}
									<img src="{{ icon_url }}" alt="Ícone Atual" class="image-preview-icon" id="icon-preview" />
								{% else %}
									<span class="image-preview-placeholder" id="icon-preview-placeholder">{{ AdminLang.text_no_icon|default('Nenhum ícone enviado') }}</span>
								{% endif %}
							</div>
						</div>
						<div class="w-100">
							<input type="file" id="config_icon" name="config_icon" accept="image/*" class="d-none" onchange="previewImage(this, 'icon-preview')" />
							<label for="config_icon" class="btn btn-primary btn-upload">
								<i class="fas fa-upload"></i> {{ AdminLang.button_upload_icon|default('Enviar Favicon') }}
							</label>
							{% if settings.config_icon %}
								<div class="remove-image-wrapper">
									<input type="checkbox" name="remove_icon" id="remove_icon" value="1" class="remove-image-checkbox" />
									<label for="remove_icon" class="remove-image-label">{{ AdminLang.text_remove_icon|default('Remover favicon atual') }}</label>
								</div>
							{% endif %}
							{% if errors.config_icon %}<div class="invalid-feedback">{{ errors.config_icon }}</div>{% endif %}
						</div>
					</div>
				</div>
			</div>

			<!-- 4. Aba: Redes Sociais -->
			<div id="tab-content-social" class="tab-content" style="display: none;">
				<h3 class="section-title">{{ AdminLang.title_social|default('Redes Sociais') }}</h3>
				
				<div class="mb-6">
					<label for="config_facebook" class="form-label">{{ AdminLang.entry_facebook|default('Página do Facebook') }}</label>
					<div class="input-group">
						<span class="input-group-addon"><i class="fab fa-facebook-f"></i></span>
						<input type="url" id="config_facebook" name="config_facebook" class="form-control input-group-control" value="{{ settings.config_facebook|default('https://facebook.com') }}" />
					</div>
				</div>

				<div class="mb-6">
					<label for="config_instagram" class="form-label">{{ AdminLang.entry_instagram|default('Perfil do Instagram') }}</label>
					<div class="input-group">
						<span class="input-group-addon"><i class="fab fa-instagram"></i></span>
						<input type="url" id="config_instagram" name="config_instagram" class="form-control input-group-control" value="{{ settings.config_instagram|default('https://instagram.com') }}" />
					</div>
				</div>

				<div class="mb-8">
					<label for="config_youtube" class="form-label">{{ AdminLang.entry_youtube|default('Canal do YouTube') }}</label>
					<div class="input-group">
						<span class="input-group-addon"><i class="fab fa-youtube"></i></span>
						<input type="url" id="config_youtube" name="config_youtube" class="form-control input-group-control" value="{{ settings.config_youtube|default('https://youtube.com') }}" />
					</div>
				</div>
			</div>

			<!-- Botões de Ação -->
			<div class="form-actions">
				<button type="submit" class="btn btn-primary btn-lg">
					<i class="fas fa-save"></i>
					<span>{{ AdminLang.button_save|default('Salvar Configurações') }}</span>
				</button>
			</div>
		</form>
	</div>

	<script>
		// Switcher de abas Twig / JS amigável
		function switchTab(tabName) {
			// Esconde todas as abas
			document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
			// Remove classe de ativação dos botões
			document.querySelectorAll('.tab-button').forEach(el => {
				el.classList.remove('active');
			});

			// Mostra a aba selecionada
			const contentEl = document.getElementById('tab-content-' + tabName);
			if (contentEl) {
				contentEl.style.display = 'block';
			}

			// Ativa o botão da aba selecionada
			const btnEl = document.getElementById('tab-btn-' + tabName);
			if (btnEl) {
				btnEl.classList.add('active');
			}

			// Atualiza a URL sem recarregar a página
			const url = new URL(window.location);
			url.searchParams.set('tab', tabName);
			window.history.pushState({}, '', url);
		}

		// Pré-visualização de imagem selecionada
		function previewImage(input, previewId) {
			const file = input.files[0];
			if (file) {
				const reader = new FileReader();
				reader.onload = function(e) {
					// Remove placeholder or update existing img tag
					const previewImg = document.getElementById(previewId);
					if (previewImg) {
						previewImg.src = e.target.result;
						previewImg.style.display = 'block';
					}
					
					// Hide placeholder if exists
					const placeholder = document.getElementById(previewId + '-placeholder');
					if (placeholder) {
						placeholder.style.display = 'none';
					}
				};
				reader.readAsDataURL(file);
			}
		}

		// Inicializa a aba correta com base no parâmetro 'tab'
		document.addEventListener('DOMContentLoaded', function() {
			const urlParams = new URLSearchParams(window.location.search);
			const activeTab = urlParams.get('tab') || 'general';
			switchTab(activeTab);
		});
	</script>
{% endblock %}
