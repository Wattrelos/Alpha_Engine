{% extends 'layouts/base.html.twig' %}

{% block title %}{{ store.metaTitle|default(Home.metaTitle)|default('Início | AgSonhos — Materiais de Construção') }}{% endblock %}

{% block content %}
	<div class="egen-stucco4">
		<div id="common-home" class="container py-4">
			<div class="egen-row">
				{% if column_left %}
					<div class="col-lg-3 col-md-4 col-sm-12">
						{{ column_left }}
					</div>
				{% endif %}

				<div id="content" class="col">
					{{ content_top }}

					{# ── Seção Hero Premium ── #}
					<section class="egen-hero-section mb-5">
						<div class="egen-hero-card">
							<div class="egen-hero-content">
								<h1 class="egen-hero-title">{{ Home.hero.title }}</h1>
								<p class="egen-hero-subtitle">{{ Home.hero.subtitle }}</p>
							</div>
						</div>
					</section>

					{# ── Diferenciais Premium ── #}
					<section class="egen-advantages mb-5">
						<div class="egen-advantage-card">
							<span class="egen-advantage-icon">🚚</span>
							<div class="egen-advantage-info">
								<h4 class="egen-advantage-title">{{ Home.advantages.shipping.title }}</h4>
								<p class="egen-advantage-desc">{{ Home.advantages.shipping.desc }}</p>
							</div>
						</div>
						<div class="egen-advantage-card">
							<span class="egen-advantage-icon">💳</span>
							<div class="egen-advantage-info">
								<h4 class="egen-advantage-title">{{ Home.advantages.payment.title }}</h4>
								<p class="egen-advantage-desc">{{ Home.advantages.payment.desc }}</p>
							</div>
						</div>
						<div class="egen-advantage-card">
							<span class="egen-advantage-icon">🛡️</span>
							<div class="egen-advantage-info">
								<h4 class="egen-advantage-title">{{ Home.advantages.quality.title }}</h4>
								<p class="egen-advantage-desc">{{ Home.advantages.quality.desc }}</p>
							</div>
						</div>
						<div class="egen-advantage-card">
							<span class="egen-advantage-icon">💬</span>
							<div class="egen-advantage-info">
								<h4 class="egen-advantage-title">{{ Home.advantages.support.title }}</h4>
								<p class="egen-advantage-desc">{{ Home.advantages.support.desc }}</p>
							</div>
						</div>
					</section>

					{# ── Seção de destaque: grade de categorias principais ── #}
					{% if featured_categories %}
						<section class="egen-home-categories mb-5" id="content-start">
							<div class="egen-section-header">
								<h2 class="egen-section-title">{{ Home.departments.title }}</h2>
								<p class="egen-section-subtitle">{{ Home.departments.subtitle }}</p>
							</div>
							<div class="egen-category-grid">
								{% for cat in featured_categories %}
									{% include 'pages/category/category-card.html.twig' with {'cat': cat, 'subcategories_label': Home.departments.subcategories} %}
								{% else %}
									<p class="egen-empty-state">{{ Home.departments.empty }}</p>
								{% endfor %}
							</div>
						</section>
					{% endif %}

					{# ── Banner da Home Injetado ── #}
					{% if home_banner %}
						<div class="swiper-viewport mb-4">
							<div id="carousel-home" class="swiper">
								<div class="swiper-wrapper">
									{% for banner in home_banner %}
										<div class="swiper-slide text-center">
											{% if banner.link %}
												<a href="{{ banner.link }}"><img src="{{ banner.image }}" alt="{{ banner.title }}" class="img-fluid"/></a>
											{% else %}
												<img src="{{ banner.image }}" alt="{{ banner.title }}" class="img-fluid"/>
											{% endif %}
										</div>
									{% endfor %}
								</div>
							</div>
						</div>
					{% endif %}

					{# ── Produtos em Destaque Injetados ── #}
					{% if featured_products %}
						<div class="egen-section-header">
							<h3 class="egen-section-title">{{ Home.headingTitleFeatured|default(Home.featured.title) }}</h3>
							<p class="egen-section-subtitle">{{ Home.featured.subtitle }}</p>
						</div>
						<div class="egen-product-grid mb-5">
							{% for product in featured_products %}
								{% include 'pages/product/product-card.html.twig' with {'prod': product} %}
							{% endfor %}
						</div>
					{% endif %}

					{# ── Produtos Mais Recentes Injetados ── #}
					{% if latest_products %}
						<div class="egen-section-header">
							<h3 class="egen-section-title">{{ Home.headingTitleLatest|default(Home.latest.title) }}</h3>
							<p class="egen-section-subtitle">{{ Home.latest.subtitle }}</p>
						</div>
						<div class="egen-product-grid mb-5">
							{% for product in latest_products %}
								{% include 'pages/product/product-card.html.twig' with {'prod': product} %}
							{% endfor %}
						</div>
					{% endif %}


					{{ content_bottom }}
				</div>

				{% if column_right %}
					<div class="col-lg-3 col-md-4 col-sm-12">
						{{ column_right }}
					</div>
				{% endif %}
			</div>
		</div>
	</div>
{% endblock %}
