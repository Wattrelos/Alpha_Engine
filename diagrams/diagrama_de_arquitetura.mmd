graph TD
    subgraph Apresentacao ["1. Camada de Apresentação (Interface & Controllers)"]
        View["Views / Templates (Twig)"]
        BaseCtrl["BaseController\n[Padrão: Template Method, Mediator]\n(Master Controller, Injeção de Dependências)"]
        AlphaContainer["AlphaContainer & Proxies\n[Padrão: Proxy, Interceptor]\n(Intercepta chamadas do legadodo código legado)"]
    end

    subgraph Dominio ["2. Camada de Domínio (Business Logic & DDD)"]
        RepoFactory["RepositoryFactory\n[Padrão: Factory, Singleton]"]
        Repos["Repositories\n(Ex: CouponRepository, CartRepository)\n[Padrão: Repository, Identity Map, Lazy Load]"]
        Entities["Entities\n(Ex: BaseEntity, Order, Coupon)\n[Padrão: DTO estruturado, Snapshot]"]
        Observers["Observers\n(Ex: OrderObserverInterface)\n[Padrão: Observer]"]
    end

    subgraph Persistencia ["3. Camada de Persistência (SQL Isolation)"]
        Mappers["Entity Mappers\n(Ex: CouponMapper, OrderMapper)\n[Padrão: Data Mapper]"]
        DAO["DataAccessObject (DAO)\n& Unit of Work\n[Padrão: DAO]\n(Transações Aninhadas, Hidratação)"]
        QB["QueryBuilder\n[Padrão: Builder]\n(Montagem segura de SQL)"]
    end

    subgraph Infraestrutura ["4. Infraestrutura & Dados"]
        MySQL[("Banco de Dados\nMySQL 8.0+\n(PK/FK Long Int, Padrão snake_case)")]
        Support["Support & Utils\n(Security, Logging, PSR-4)"]
    end

    %% Relacionamentos e Fluxo de Dados
    View --> BaseCtrl
    BaseCtrl --> RepoFactory
    BaseCtrl --> Repos
    
    %% O Container legado consome os repositórios modernos
    AlphaContainer --> Repos 
    
    RepoFactory -. "Instancia" .-> Repos
    
    %% Repositories orquestram entidades e mappers
    Repos --> Entities
    Repos --> Mappers
    
    %% Mappers disparam observers e usam DAO
    Mappers -. "Notifica" .-> Observers
    Mappers --> DAO
    
    %% DAO orquestra QueryBuilder e fala com o banco
    DAO --> QB
    DAO --> MySQL
    QB --> MySQL
    
    %% Estilização base para melhorar a leitura
    classDef pres fill:#e1f5fe,stroke:#039be5,stroke-width:2px,color:#000;
    classDef dom fill:#e8f5e9,stroke:#43a047,stroke-width:2px,color:#000;
    classDef pers fill:#fff3e0,stroke:#fb8c00,stroke-width:2px,color:#000;
    classDef infra fill:#f3e5f5,stroke:#8e24aa,stroke-width:2px,color:#000;

    class View,BaseCtrl,AlphaContainer pres;
    class RepoFactory,Repos,Entities,Observers dom;
    class Mappers,DAO,QB pers;
    class MySQL,Support infra;
