# Alpha Engine: Hardening do Diretório de Mídias e Uploads (public_html/image/)
# Previne a execução remota de código (RCE) via upload de scripts maliciosos.

# 1. Desativa a listagem pública de diretórios
Options -Indexes

# 2. Bloqueia a execução de qualquer extensão de código executável
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|phar|inc|sh|cgi|pl|py|exe|bat|asp|aspx)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Desativa o módulo PHP caso esteja rodando como mod_php
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
